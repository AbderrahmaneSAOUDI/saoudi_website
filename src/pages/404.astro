---
/**
 * 404 Not Found Page
 *
 * Material 3 Dark-mode compliant error page with zero client-side JavaScript.
 * Strictly adheres to the absolute shadow ban and Google brand palette invariants.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ActionButton from '../components/ActionButton.astro';

// Set strict 404 HTTP response status for search engine crawlers
Astro.response.status = 404;
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found.">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24 max-w-4xl min-h-[70vh] flex items-center justify-center">
		<section class="w-full text-center animate-fade-in">
			<div class="relative bg-surface-container border border-white/10 rounded-3xl p-8 sm:p-12 md:p-16 hover-card-border hover:border-primary/80 transition-all duration-300">
				<!-- Ambient Glow Badge -->
				<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-primary/10 border border-primary/20 text-primary mb-6">
					<Icon name="close" size={36} class="text-primary" />
				</div>

				<h1 class="text-6xl sm:text-7xl md:text-8xl font-black text-white tracking-tight mb-4">
					4<span class="text-primary">0</span>4
				</h1>

				<h2 class="text-xl sm:text-2xl font-bold text-white mb-3">
					Page Not Found
				</h2>

				<p class="text-white/60 text-sm sm:text-base max-w-md mx-auto mb-8 leading-relaxed">
					The requested page doesn't exist, was moved, or is temporarily unavailable.
				</p>

				<!-- Navigation Actions -->
				<div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
					<ActionButton href="/" type="primary">
						<Icon name="home" size={18} />
						<span>Back to Home</span>
					</ActionButton>
					<ActionButton href="/projects" type="surface">
						<Icon name="projects" size={18} />
						<span>Explore Projects</span>
					</ActionButton>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
