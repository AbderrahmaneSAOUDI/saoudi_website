---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import HomeCountsIsland from "../components/HomeCountsIsland.astro";
import ContactCard from "../components/ContactCard.astro";
import SkeletonCardGrid from "../components/SkeletonCardGrid.astro";
import { getFirebaseAdminDb } from "../lib/server/firebase-admin";
import { CACHE_TTL_MS, getOrSetCached } from "../lib/server/cache";
import { getPublicMediaUrl } from "../lib/media";
import type { TrustedCompany } from "../types";

let trustedCompanies: TrustedCompany[] = [];

try {
	trustedCompanies = await getOrSetCached<TrustedCompany[]>(
		"trusted_companies_list",
		async () => {
			const db = getFirebaseAdminDb();
			const snapshot = await db.collection("trusted_companies").orderBy("order", "asc").get();
			const list = snapshot.docs.map((doc) => {
				const data = doc.data();
				return {
					id: doc.id,
					name: typeof data.name === 'string' ? data.name : '',
					logoUrl: getPublicMediaUrl(data.logoUrl, 'trusted_companies', doc.id) ?? data.logoUrl ?? '',
					websiteUrl: typeof data.websiteUrl === 'string' ? data.websiteUrl : '#',
					order: Number.isFinite(Number(data.order)) ? Number(data.order) : 0,
					createdAt: typeof data.createdAt === 'string' ? data.createdAt : '',
					updatedAt: typeof data.updatedAt === 'string' ? data.updatedAt : '',
				};
			});
			return list;
		},
		CACHE_TTL_MS.PUBLIC_DATA,
	);
} catch (error) {
	console.warn("Failed to fetch trusted companies for public page:", error);
}

// Fallback default companies if database collection is not yet populated
if (!trustedCompanies || trustedCompanies.length === 0) {
	trustedCompanies = [
		{
			id: 'default-gdg',
			name: 'Google Developer Groups',
			logoUrl: '/partners/gdg.svg',
			websiteUrl: 'https://gdg.community.dev/',
			order: 1,
		},
		{
			id: 'default-google',
			name: 'Google for Developers',
			logoUrl: '/partners/google.svg',
			websiteUrl: 'https://developers.google.com/',
			order: 2,
		},
		{
			id: 'default-mobilis',
			name: 'ATM Mobilis',
			logoUrl: '/partners/mobilis.svg',
			websiteUrl: 'https://www.mobilis.dz/',
			order: 3,
		},
		{
			id: 'default-at',
			name: 'Algérie Télécom',
			logoUrl: '/partners/algerie_telecom.svg',
			websiteUrl: 'https://www.algerietelecom.dz/',
			order: 4,
		},
		{
			id: 'default-mpt',
			name: 'Ministry of Post & Telecoms',
			logoUrl: '/partners/mpt.webp',
			websiteUrl: 'https://www.mpt.gov.dz/',
			order: 5,
		},
	];
}


---

<BaseLayout title="Home">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 pt-2 md:pt-4 max-w-7xl">
		<!-- Hero Section -->
		<section class="animate-fade-in flex items-center pb-2">
			<div class="relative w-full">
				<div
					class="absolute inset-0 bg-linear-to-tr from-primary/5 via-transparent to-secondary/5 blur-3xl"
				>
				</div>

				<div
					class="relative bg-surface-container border border-white/10 rounded-3xl p-6 md:p-8 lg:p-10 hover-card-border hover:border-primary/80 transition-all duration-300"
				>
					<div
						class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-10 items-center"
					>
						<!-- Left Column: Profile Image with Entrance Animation -->
						<div
							class="lg:col-span-1 flex justify-center animate-hero-image"
						>
							<div class="relative">
								<!-- Animated Glow Under Photo -->
								<div
									class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-3/4 h-8 bg-linear-to-r from-primary/0 via-primary/50 to-primary/0 blur-xl animate-glow-pulse"
								>
								</div>
								<div
									class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-1/2 h-4 bg-linear-to-r from-secondary/0 via-secondary/40 to-secondary/0 blur-lg animate-glow-pulse"
									style="animation-delay: 0.5s;"
								>
								</div>

								<div
									class="absolute inset-0 bg-linear-to-br from-primary/30 to-secondary/30 rounded-full blur-2xl animate-orb-pulse"
								>
								</div>
								<div
									class="relative w-48 h-48 md:w-56 md:h-56 lg:w-64 lg:h-64 rounded-full border-4 border-primary/40 overflow-hidden bg-linear-to-br from-primary/10 to-secondary/10"
								>
									<img
										src="/profile.webp"
										alt="Abderrahmane SAOUDI Profile Picture"
										width="256"
										height="256"
										fetchpriority="high"
										decoding="async"
										class="w-full h-full object-cover border-4 border-primary rounded-full"
										onerror="if(!this.getAttribute('data-fallback-tried')){this.setAttribute('data-fallback-tried','1');this.setAttribute('src','/profile.webp');}"
									/>
								</div>
							</div>
						</div>

						<!-- Right Column: Titles, Subtitles, Roles & Badges with Entrance Animation -->
						<div
							class="lg:col-span-2 text-center lg:text-left animate-hero-text"
						>
							<div>
								<h1
									class="mb-2 font-bold text-white text-3xl md:text-4xl lg:text-5xl xl:text-6xl leading-tight"
								>
									Hi, I'm <span
										class="text-primary animate-hero-typing"
										>Abderrahmane SAOUDI</span
									>
								</h1>
								<p
									class="text-white/80 text-lg md:text-xl lg:text-2xl leading-relaxed font-light animate-hero-subtitle"
								>
									Passionate technologist and community leader
									crafting digital experiences
								</p>
							</div>

							<div class="space-y-2 animate-hero-roles mt-8">
								<h3
									class="text-white/60 text-xs md:text-sm font-semibold uppercase tracking-wider"
								>
									Professional Roles
								</h3>
								<div
									class="flex flex-wrap justify-center lg:justify-start gap-2"
								>
									<span
										class="px-3.5 py-1.5 bg-primary/10 text-primary border border-primary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-primary/40 transition-colors duration-300"
										>Graphic Designer</span
									>
									<span
										class="px-3.5 py-1.5 bg-primary/10 text-primary border border-primary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-primary/40 transition-colors duration-300"
										>Mobile Developer</span
									>
									<span
										class="px-3.5 py-1.5 bg-primary/10 text-primary border border-primary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-primary/40 transition-colors duration-300"
										>Web Frontend Developer</span
									>
								</div>
							</div>

							<div
								class="space-y-2 mt-8 md:mt-10 animate-hero-community"
							>
								<h3
									class="text-white/60 text-xs md:text-sm font-semibold uppercase tracking-wider"
								>
									Community & Leadership
								</h3>
								<div
									class="flex flex-wrap justify-center lg:justify-start gap-2"
								>
									<span
										class="px-3.5 py-1.5 bg-secondary/10 text-secondary border border-secondary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-secondary/40 transition-colors duration-300"
										>Former GDG Ghardaia President (2022-2026)</span
									>
									<span
										class="px-3.5 py-1.5 bg-secondary/10 text-secondary border border-secondary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-secondary/40 transition-colors duration-300"
										>GDG Ghardaia Advisor (Aug 2026-Now)</span
									>
									<span
										class="px-3.5 py-1.5 bg-secondary/10 text-secondary border border-secondary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-secondary/40 transition-colors duration-300"
										>University Teacher</span
									>
									<span
										class="px-3.5 py-1.5 bg-secondary/10 text-secondary border border-secondary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-secondary/40 transition-colors duration-300"
										>DevFest Lead 2023-2025</span
									>
									<span
										class="px-3.5 py-1.5 bg-secondary/10 text-secondary border border-secondary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-secondary/40 transition-colors duration-300"
										>Google I/O Lead 2023-2025</span
									>
								</div>
							</div>

							<div
								class="space-y-2 mt-8 md:mt-10 animate-hero-achievements"
							>
								<h3
									class="text-white/60 text-xs md:text-sm font-semibold uppercase tracking-wider"
								>
									Achievements
								</h3>
								<div
									class="flex flex-wrap justify-center lg:justify-start gap-2"
								>
									<span
										class="px-3.5 py-1.5 bg-tertiary/10 text-tertiary border border-tertiary/20 rounded-xl text-xs md:text-sm font-semibold hover:border-tertiary/40 transition-colors duration-300"
										>🥉 3rd Place - StartUp City Hackathon</span
									>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Who Trusts Me Section -->
		<section class="mt-4 animate-fade-in" style="animation-delay: 0.15s;">
			<div class="relative w-full">
				<div
					class="absolute inset-0 bg-linear-to-r from-primary/5 via-secondary/5 to-tertiary/5 blur-3xl"
				>
				</div>
				<div
					class="relative bg-surface-container border border-white/10 rounded-3xl p-6 sm:p-8 lg:p-10 hover-card-border hover:border-primary/80 transition-all duration-300 overflow-hidden"
				>
					<!-- Header Row -->
					<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8 border-b border-white/10 pb-5">
						<div>
							<div class="flex items-center gap-2 mb-1.5">
								<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
								<h3 class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-primary">
									Partners & Collaborators
								</h3>
							</div>
							<h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
								Who <span class="text-primary">Trusts Me</span>
							</h2>
						</div>
						<p class="text-xs sm:text-sm text-white/60 max-w-md font-light">
							Proud to have collaborated with, contributed to, and delivered digital solutions and leadership for forward-thinking organizations.
						</p>
					</div>

					<!-- Companies Grid -->
					<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3.5 sm:gap-5 items-stretch">
						{trustedCompanies.map((company, index) => {
							const href = company.websiteUrl.startsWith('http') ? company.websiteUrl : `https://${company.websiteUrl}`;
							return (
								<a
									href={href}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex flex-col items-center justify-between p-4 sm:p-5 rounded-2xl bg-[#141218]/90 border border-white/10 hover:border-primary/60 hover:bg-white/[0.03] hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden"
									title={`Visit ${company.name} homepage`}
									style={`animation-delay: ${(index * 0.08).toFixed(2)}s;`}
								>
									<!-- Top corner external link icon -->
									<div class="absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-primary">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
											<line x1="10" y1="14" x2="21" y2="3"></line>
										</svg>
									</div>

									<!-- Logo Container -->
									<div class="w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center p-2 rounded-xl bg-white/5 border border-white/10 group-hover:border-primary/40 group-hover:bg-primary/10 transition-all duration-300 shrink-0">
										<img
											src={company.logoUrl}
											alt={company.name}
											class="w-full h-full object-contain transition-all duration-300 group-hover:scale-110"
											loading="lazy"
											decoding="async"
											onerror="if(!this.getAttribute('data-fallback-tried')){this.setAttribute('data-fallback-tried','1');this.classList.add('hidden');if(this.nextElementSibling){this.nextElementSibling.classList.remove('hidden');}}"
										/>
										<span class="hidden text-sm font-bold text-primary text-center px-1">
											{company.name.slice(0, 3).toUpperCase()}
										</span>
									</div>

									<!-- Company Name -->
									<div class="mt-3 text-center w-full">
										<span class="block text-xs sm:text-sm font-semibold text-white/80 group-hover:text-primary transition-colors duration-200 truncate">
											{company.name}
										</span>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			</div>
		</section>

		<!-- About Me & Education Row -->
		<div class="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-6">
			<!-- Professional Summary -->
			<section class="animate-fade-in" style="animation-delay: 0.2s;">
				<div class="relative h-full">
					<div
						class="absolute inset-0 bg-linear-to-br from-primary/5 via-transparent to-primary/5 blur-3xl"
					>
					</div>
					<div
						class="relative bg-surface-container border border-white/10 rounded-3xl overflow-hidden hover-card-border hover:border-primary/80 transition-all duration-300 h-full flex flex-col"
					>
						<img
							src="/cover.webp"
							alt="Profile"
							class="w-full h-48 object-cover"
							loading="lazy"
							fetchpriority="low"
							decoding="async"
							width="1280"
							height="192"
							onerror="if(!this.getAttribute('data-fallback-tried')){this.setAttribute('data-fallback-tried','1');this.setAttribute('src','/cover.webp');}"
						/>
						<div class="p-8 flex-1">
							<h2
								class="text-3xl font-bold text-primary mb-6 flex items-center gap-3"
							>
								About Me
							</h2>
							<div class="text-white/80 text-lg leading-relaxed">
								<p class="mb-4">
									I am a Computer Science Master's student
									from Ghardaia, Algeria, driven by software
									engineering and tech community leadership.
								</p>
								<p>
									Beyond engineering, I serve as the volunteer
									President of GDG Ghardaia, managing a
									structured team to run events and tech
									sessions (online and in-person).
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Education Timeline -->
			<section class="animate-fade-in" style="animation-delay: 0.3s;">
				<div class="relative h-full">
					<div
						class="absolute inset-0 bg-linear-to-br from-secondary/5 via-transparent to-secondary/5 blur-3xl"
					>
					</div>
					<div
						class="relative bg-surface-container border border-white/10 rounded-3xl p-8 hover-card-border hover:border-primary/80 transition-all duration-300 h-full"
					>
						<h2
							class="text-3xl font-bold text-primary mb-6 flex items-center gap-3"
						>
							Education
						</h2>
						<div class="relative">
							<!-- Timeline Line -->
							<div
								class="absolute left-4.5 top-0 bottom-0 w-0.5 bg-primary/35 overflow-hidden"
							>
								<!-- Animated Gradient Line -->
								<div
									class="absolute inset-0 bg-primary rounded-full animate-timeline-progress"
								>
								</div>
								<!-- Electricity Dots -->
								<div
									class="electric-dot w-2 h-2 bg-primary rounded-full absolute left-1/2 -translate-x-1/2"
								>
								</div>
								<div
									class="electric-dot w-1.5 h-1.5 bg-secondary rounded-full absolute left-1/2 -translate-x-1/2"
									style="animation-delay: 0.6s;"
								>
								</div>
								<div
									class="electric-dot w-1 h-1 bg-tertiary rounded-full absolute left-1/2 -translate-x-1/2"
									style="animation-delay: 1.2s;"
								>
								</div>
							</div>

							<div class="space-y-5 pl-10">
								<!-- Item 1 -->
								<div class="relative">
									<div
										class="absolute -left-8.25 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-primary border-4 border-surface z-20 animate-dot-pulse"
									>
									</div>
									<div
										class="bg-surface-container-high border border-white/10 rounded-2xl p-5 hover-card-border hover:border-primary/60 transition-all duration-300"
									>
										<h3
											class="text-lg font-bold text-white"
										>
											University of Ghardaia
										</h3>
										<p class="text-primary font-semibold">
											Master of Science in Intelligent
											Systems for Knowledge Extraction
											(SIEC)
										</p>
										<p class="text-white/60 mt-1">
											Ongoing (2nd Year)
										</p>
									</div>
								</div>
								<!-- Item 2 -->
								<div class="relative">
									<div
										class="absolute -left-8.25 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-secondary border-4 border-surface z-20 animate-dot-pulse"
										style="animation-delay: 0.3s;"
									>
									</div>
									<div
										class="bg-surface-container-high border border-white/10 rounded-2xl p-5 hover-card-border hover:border-secondary/60 transition-all duration-300"
									>
										<h3
											class="text-lg font-bold text-white"
										>
											University of Ghardaia
										</h3>
										<p class="text-secondary font-semibold">
											Bachelor of Science in Information
											Systems (SI)
										</p>
										<p class="text-white/60 mt-1">
											Graduated June 2022
										</p>
									</div>
								</div>
								<!-- Item 3 -->
								<div class="relative">
									<div
										class="absolute -left-8.25 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-tertiary border-4 border-surface z-20 animate-dot-pulse"
										style="animation-delay: 0.6s;"
									>
									</div>
									<div
										class="bg-surface-container-high border border-white/10 rounded-2xl p-5 hover-card-border hover:border-tertiary/60 transition-all duration-300"
									>
										<h3
											class="text-lg font-bold text-white"
										>
											Algerian Red Crescent
										</h3>
										<p class="text-tertiary font-semibold">
											First Aid Trainee
										</p>
										<p class="text-white/60 mt-1">
											Completed April 2026
										</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>

		<!-- Statistics Grid (deferred — loads after page shell) -->
		<section class="mt-6 animate-fade-in" style="animation-delay: 0.4s;">
			<div class="relative">
				<!-- Ambient Glow -->
				<div
					class="absolute inset-0 bg-linear-to-r from-primary/5 via-transparent to-secondary/5 blur-3xl rounded-3xl"
				>
				</div>

				<HomeCountsIsland server:defer>
					<SkeletonCardGrid slot="fallback" variant="stat" />
				</HomeCountsIsland>
			</div>
		</section>

		<!-- Technical Skills -->
		<section class="mt-6 animate-fade-in" style="animation-delay: 0.5s;">
			<div class="relative">
				<div
					class="absolute inset-0 bg-linear-to-br from-secondary/5 via-transparent to-secondary/5 blur-3xl"
				>
				</div>
				<div
					class="relative bg-surface-container border border-white/10 rounded-3xl p-8 md:p-12 hover-card-border hover:border-primary/80 transition-all duration-300 overflow-hidden"
				>
					<div
						class="absolute -top-20 right-0 w-56 h-56 bg-secondary/10 blur-3xl rounded-full"
					>
					</div>
					<div class="relative">
						<div
							class="flex flex-wrap items-end justify-between gap-4 mb-8"
						>
							<div>
								<h2
									class="text-3xl md:text-4xl font-bold text-primary flex items-center gap-3"
								>
									Technical Skills
								</h2>
							</div>
						</div>

						<div
							class="skills-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-6"
						>
							<div
								class="xl:col-span-5 bg-surface-container-high border border-secondary/20 rounded-2xl p-6 hover-card-border hover:border-secondary/70 transition-all duration-300 hover:-translate-y-1 group"
							>
								<div
									class="flex items-center justify-between mb-4"
								>
									<h3
										class="text-secondary font-bold text-xl"
									>
										Development
									</h3>
									<div class="relative flex items-center justify-center">
										<Icon name="projects" size={28} class="group-hover:hidden! text-secondary" />
										<Icon name="projects" filled size={28} class="hidden! group-hover:inline-flex! text-secondary" />
									</div>
								</div>
								<div class="flex flex-wrap gap-2.5">
									<span
										class="px-3 py-1.5 bg-secondary/10 text-secondary border border-secondary/25 rounded-lg text-sm font-medium"
										>Mobile development</span
									>
									<span
										class="px-3 py-1.5 bg-secondary/10 text-secondary border border-secondary/25 rounded-lg text-sm font-medium"
										>WordPress CMS customization</span
									>
									<span
										class="px-3 py-1.5 bg-secondary/10 text-secondary border border-secondary/25 rounded-lg text-sm font-medium"
										>UI/UX implementation</span
									>
								</div>
							</div>

							<div
								class="xl:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6"
							>
								<div
									class="bg-surface-container-high border border-primary/20 rounded-2xl p-6 hover-card-border hover:border-primary/70 transition-all duration-300 hover:-translate-y-1 group"
								>
									<div
										class="flex items-center justify-between mb-3"
									>
										<h3
											class="text-primary font-bold text-lg"
										>
											Automation
