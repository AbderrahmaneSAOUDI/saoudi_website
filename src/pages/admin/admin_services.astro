---
import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import AdminNavDock from "../../components/admin/AdminNavDock.astro";
import GlobalLightbox from "../../components/GlobalLightbox.astro";
import { getFirebaseAdminDb } from "../../lib/server/firebase-admin";
import Icon from "../../components/Icon.astro";
import AdminControlsStrip from "../../components/admin/AdminControlsStrip.astro";
import { getEnv } from "../../lib/server/env";
import type { Service } from "../../types";
import { getPublicMediaUrl } from "../../lib/media";

const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect("/admin/admin_login");

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const currentAdminEmail = (adminEmail || '').toLowerCase().trim();
const isPrimaryAdmin = currentAdminEmail === primaryEmail && primaryEmail !== '';

let services: Service[] = [];
let errorMsg = '';

try {
	const db = getFirebaseAdminDb();
	const snapshot = await db.collection("services").get();
	services = snapshot.docs.map(doc => {
		const data = doc.data();
		return {
			id: doc.id,
			order: Number.isFinite(Number(data.order)) ? Number(data.order) : 0,
			title: typeof data.title === 'string' ? data.title : '',
			description: typeof data.description === 'string' ? data.description : '',
			logoUrl: getPublicMediaUrl(data.logoUrl, 'services', doc.id) ?? null,
			features: Array.isArray(data.features) ? data.features.filter((feature: unknown): feature is string => typeof feature === 'string') : [],
			createdAt: typeof data.createdAt === 'string' ? data.createdAt : '',
			updatedAt: typeof data.updatedAt === 'string' ? data.updatedAt : '',
		};
	}) as Service[];

	services.sort((a, b) => a.order - b.order);
} catch (error: any) {
	console.warn("Failed to fetch services from Firestore:", error);
	errorMsg = "Degraded mode: Firestore is not configured or offline.";
}
---

<BackgroundBaseLayout title="Services Workspace — Admin">
	<AdminLayout title="Services">
		<div class="relative min-h-[calc(100vh-140px)]">
			
			<!-- Main Content Area -->
			<div class="space-y-6">
				<!-- Top Controls Strip -->
				<AdminControlsStrip
					searchId="search-input"
					searchPlaceholder="Search services by title, capabilities..."
					newBtnId="btn-new-service"
					newBtnLabel="New"
				/>

				{errorMsg && (
					<div class="p-4 rounded-2xl bg-[#DB4437]/10 border border-[#DB4437]/30 text-[#DB4437] text-sm flex items-center gap-2.5">
						<Icon name="alert" size={20} class="w-5 h-5 shrink-0" />
						<span>{errorMsg}</span>
					</div>
				)}

				<!-- Grid of Services -->
				<div id="services-grid" class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-5 gap-6">
					{/* Cards will be dynamically rendered via JS */}
				</div>

				<!-- Load More Button -->
				<div id="load-more-container" class="flex justify-center">
					<button
						id="btn-load-more"
						class="px-6 py-2.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer"
					>
						Load More
					</button>
				</div>
			</div>

			<!-- Drawer Backdrop -->
			<div
				id="editor-backdrop"
				class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] transition-opacity duration-300 opacity-0"
			></div>

			<!-- Sliding Drawer Detail Editor -->
			<div
				id="editor-panel"
				class="fixed top-0 right-0 h-full w-full sm:w-[480px] bg-[#1D1B20] border-l border-[#2B2930] transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 id="editor-heading" class="text-lg font-bold text-white">Create Service</h2>
							<p id="editor-subheading" class="text-xs text-[#E6E1E5]/50 mt-1">Add a new professional service offering</p>
						</div>
						<button
							type="button"
							id="btn-delete"
							class="hidden p-2.5 rounded-xl text-[#DB4437] hover:bg-[#DB4437]/10 border border-transparent hover:border-[#DB4437]/20 transition-all cursor-pointer shrink-0 flex items-center gap-1.5"
							title="Delete Service"
						>
							<Icon name="trash" size={20} class="w-5 h-5" />
							<kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-[#DB4437]/20 text-[#DB4437] rounded border border-[#DB4437]/30">Del</kbd>
						</button>
					</div>

					<form id="service-form" class="space-y-4">
						<!-- Logo Dropzone -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Service Logo / Icon (Optional)</label>
							<div
								id="logo-drop-zone"
								class="border-2 border-dashed border-[#2B2930] hover:border-primary/50 rounded-2xl p-4 text-center transition-all duration-300 cursor-pointer group relative overflow-hidden min-h-[120px] flex flex-col items-center justify-center bg-[#141218]"
							>
								<input
									type="file"
									id="logo-file-input"
									accept="image/*"
									class="hidden"
								/>
								
								<img
									id="logo-preview"
									src=""
									alt="Preview"
									class="hidden absolute inset-0 w-full h-full object-contain p-4 group-hover:scale-105 transition-all duration-300"
								/>

								<div id="drop-zone-prompt" class="relative z-10 flex flex-col items-center gap-1.5">
									<div class="p-2 rounded-full bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
										<Icon name="image" size={20} class="w-5 h-5" />
									</div>
									<div>
										<p class="text-xs font-medium text-white flex items-center gap-1.5">
											Drop logo or <span class="text-primary font-semibold">browse</span>
										</p>
										<p class="text-[10px] text-[#E6E1E5]/40 mt-0.5">Any image format, converted to WebP automatically</p>
									</div>
								</div>

								<div id="file-details" class="hidden relative z-10 text-[10px] bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 px-2 py-1 rounded-md font-semibold mt-2">
									✓ File Selected
								</div>
							</div>
						</div>

						<!-- Read-only ID -->
						<div class="hidden">
							<input type="text" id="form-id" name="id" readonly />
						</div>

						<!-- Title & Order -->
						<div class="grid grid-cols-3 gap-3">
							<div class="col-span-2">
								<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Service Title *</label>
								<input
									type="text"
									id="form-title"
									name="title"
									required
									placeholder="e.g., Full-Stack Web App Development"
									class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
								/>
							</div>
							<div>
								<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Display Order</label>
								<input
									type="number"
									id="form-order"
									name="order"
									min="0"
									value="0"
									class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
								/>
							</div>
						</div>

						<!-- Description -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Description *</label>
							<textarea
								id="form-description"
								name="description"
								required
								rows="3"
								placeholder="Describe the scope, deliverables, and value of this service..."
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors resize-y min-h-[90px]"
							></textarea>
						</div>

						<!-- Capabilities / Features -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Key Capabilities (1 per line)</label>
							<textarea
								id="form-features"
								name="features"
								rows="4"
								placeholder="React / Next.js / Astro applications&#10;RESTful & GraphQL API integration&#10;Performance & SEO optimization"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs font-mono focus:outline-none focus:border-primary transition-colors resize-y min-h-[100px]"
							></textarea>
						</div>

						<!-- Status Panel -->
						<div id="form-status" class="hidden p-3.5 rounded-xl border text-xs font-medium text-center"></div>

						<!-- Form Buttons -->
						<div class="flex gap-3 pt-2">
							<button
								type="button"
								id="btn-cancel"
								class="flex-1 py-3 px-4 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer text-center flex items-center justify-center gap-1.5"
							>
								<span>Cancel</span>
								<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">Esc</kbd>
							</button>
							<button
								type="submit"
								id="btn-save"
								class="flex-1 py-3 px-4 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-sm transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
							>
								<Icon name="save" size={16} class="w-4 h-4" />
								<span id="save-btn-text">Save</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>
	</AdminLayout>
	<AdminNavDock currentPath={Astro.url.pathname} />
	<GlobalLightbox />
</BackgroundBaseLayout>

<script is:inline define:vars={{ initialServices: services, isPrimaryAdmin }}>
	Object.assign(window, { services: initialServices || [], isPrimaryAdminUser: isPrimaryAdmin });
</script>

<script>
	import { compressImageToWebpUnderTargetKB } from '../../lib/client-image';
	import { escapeAttribute, escapeHtml, getSafeImageSrc } from '../../lib/client-safety';

	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('search-input') as HTMLInputElement;
		const btnNewService = document.getElementById('btn-new-service') as HTMLButtonElement;
		const servicesGrid = document.getElementById('services-grid') as HTMLDivElement;
		const loadMoreBtn = document.getElementById('btn-load-more') as HTMLButtonElement;
		const loadMoreContainer = document.getElementById('load-more-container') as HTMLDivElement;

		const editorPanel = document.getElementById('editor-panel') as HTMLDivElement;
		const editorBackdrop = document.getElementById('editor-backdrop') as HTMLDivElement;
		const btnCancel = document.getElementById('btn-cancel') as HTMLButtonElement;
		const editorHeading = document.getElementById('editor-heading') as HTMLHeadingElement;
		const editorSubheading = document.getElementById('editor-subheading') as HTMLParagraphElement;
		
		const serviceForm = document.getElementById('service-form') as HTMLFormElement;
		const formId = document.getElementById('form-id') as HTMLInputElement;
		const formTitle = document.getElementById('form-title') as HTMLInputElement;
		const formOrder = document.getElementById('form-order') as HTMLInputElement;
		const formDescription = document.getElementById('form-description') as HTMLTextAreaElement;
		const formFeatures = document.getElementById('form-features') as HTMLTextAreaElement;

		const formStatus = document.getElementById('form-status') as HTMLDivElement;
		const btnDelete = document.getElementById('btn-delete') as HTMLButtonElement;
		const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
		const saveBtnText = document.getElementById('save-btn-text') as HTMLSpanElement;

		const logoDropZone = document.getElementById('logo-drop-zone') as HTMLDivElement;
		const logoFileInput = document.getElementById('logo-file-input') as HTMLInputElement;
		const logoPreview = document.getElementById('logo-preview') as HTMLImageElement;
		const dropZonePrompt = document.getElementById('drop-zone-prompt') as HTMLDivElement;
		const fileDetails = document.getElementById('file-details') as HTMLDivElement;

		let selectedLogoFile: File | null = null;
		let ITEMS_PER_PAGE = 6;
		let displayedCount = 0;
		let allServices: any[] = (window as any).services || [];

		renderServices();
		initFromUrl();

		function showEmptyState(title: string, subtitle: string) {
			servicesGrid.querySelector('.empty-state')?.remove();
			const emptyState = document.createElement('div');
			emptyState.className = 'empty-state col-span-full py-16 text-center text-[#E6E1E5]/50 bg-[#1D1B20] rounded-3xl border border-[#2B2930]';
			emptyState.innerHTML = `
				<img src="/no_data.webp" alt="No data" class="w-28 h-28 mx-auto mb-4 object-contain opacity-90" />
				<p class="font-semibold text-white">${escapeHtml(title)}</p>
				<p class="text-xs mt-1">${escapeHtml(subtitle)}</p>
			`;
			servicesGrid.appendChild(emptyState);
		}

		function renderServices() {
			const newCards = allServices.slice(displayedCount, displayedCount + ITEMS_PER_PAGE);
			newCards.forEach(service => {
				const card = createServiceCard(service);
				servicesGrid.appendChild(card);
			});
			
			displayedCount += newCards.length;
			if (displayedCount >= allServices.length) {
				loadMoreContainer.classList.add('hidden');
			} else {
				loadMoreContainer.classList.remove('hidden');
			}

			if (displayedCount === 0 && allServices.length === 0) {
				showEmptyState('No services listed', 'Click "New" to create your first service offering.');
			} else {
				servicesGrid.querySelector('.empty-state')?.remove();
			}
			
			attachCardEventListeners();
		}

		function rerenderAllServices() {
			allServices.sort((a: any, b: any) => (Number(a.order) || 0) - (Number(b.order) || 0));
			servicesGrid.innerHTML = '';
			displayedCount = 0;
			renderServices();
		}

		function createServiceCard(service: any) {
			const cardWrapper = document.createElement('div');
			const features = Array.isArray(service.features) ? service.features : [];
			const featuresList = features
				.map((feature: unknown) => `<li class="flex items-start gap-2 text-xs text-[#E6E1E5]/80"><span class="w-1.5 h-1.5 rounded-full bg-primary/60 mt-1 shrink-0"></span><span>${escapeHtml(feature)}</span></li>`)
				.join('');
			const logoUrl = getSafeImageSrc(service.logoUrl);
			const order = Number.isFinite(Number(service.order)) ? Number(service.order) : 0;

			cardWrapper.innerHTML = `
				<article 
					class="service-card group border rounded-3xl p-6 transition-all duration-300 flex flex-col justify-between h-full border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer relative overflow-hidden"
					data-id="${escapeAttribute(service.id)}"
				>
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<div class="w-12 h-12 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-300">
								${logoUrl ? `
									<img src="${escapeAttribute(logoUrl)}" alt="${escapeAttribute(service.title)}" class="w-full h-full object-contain p-2" />
								` : `
									<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
								`}
							</div>
							<span class="px-2.5 py-1 rounded-full bg-[#211F26] border border-[#2B2930] text-[11px] font-mono text-[#E6E1E5]/60">
								Order: ${order}
							</span>
						</div>

						<div>
							<h3 class="font-bold text-white text-lg sm:text-xl group-hover:text-primary transition-colors leading-snug">
								${escapeHtml(service.title)}
							</h3>
							<p class="text-xs text-[#E6E1E5]/70 mt-2 line-clamp-3 leading-relaxed">
								${escapeHtml(service.description)}
							</p>
						</div>

						${featuresList ? `
							<div class="pt-3 border-t border-[#2B2930]">
								<ul class="space-y-1.5">
									${featuresList}
								</ul>
							</div>
						` : ''}
					</div>
				</article>
			`;
			return cardWrapper.firstElementChild as HTMLElement;
		}

		function attachCardEventListeners() {
			const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
			cards.forEach(card => {
				if (card.dataset.eventsBound === 'true') return;
				card.dataset.eventsBound = 'true';
				card.addEventListener('click', () => {
					const id = card.getAttribute('data-id');
					const service = allServices.find((s: any) => s.id === id);
					if (service) {
						const newUrl = new URL(window.location.href);
						newUrl.searchParams.set('id', service.id);
						window.history.pushState(null, '', newUrl.toString());
						
						selectService(service);
						openDrawer();
					}
				});
			});
		}

		loadMoreBtn.addEventListener('click', renderServices);

		function initFromUrl() {
			const urlParams = new URLSearchParams(window.location.search);
			const urlId = urlParams.get('id');
			if (urlId) {
				const service = allServices.find((s: any) => s.id === urlId);
				if (service) {
					selectService(service);
					openDrawer();
				}
			}
		}

		function openDrawer() {
			editorBackdrop.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
			setTimeout(() => {
				editorBackdrop.classList.add('opacity-100');
				editorPanel.classList.remove('translate-x-full');
				editorPanel.classList.add('translate-x-0');
			}, 10);
		}

		function closeDrawer() {
			editorBackdrop.classList.remove('opacity-100');
			editorPanel.classList.remove('translate-x-0');
			editorPanel.classList.add('translate-x-full');

			const newUrl = new URL(window.location.href);
			newUrl.searchParams.delete('id');
			window.history.pushState(null, '', newUrl.toString());

			const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
			cards.forEach(c => c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50'));

			setTimeout(() => {
				editorBackdrop.classList.add('hidden');
				document.body.style.overflow = '';
			}, 350);
		}

		btnNewService.addEventListener('click', () => {
			setNewServiceState();
			openDrawer();
		});

		btnCancel.addEventListener('click', closeDrawer);
		editorBackdrop.addEventListener('click', closeDrawer);

		function setNewServiceState() {
			const shortId = (crypto && crypto.randomUUID) 
				? crypto.randomUUID().substring(0, 8) 
				: Math.random().toString(36).substring(2, 10);

			formId.value = `service_${shortId}`;
			formTitle.value = '';
			formOrder.value = '0';
			formDescription.value = '';
			formFeatures.value = '';

			selectedLogoFile = null;
			logoPreview.src = '';
			logoPreview.classList.add('hidden');
			dropZonePrompt.classList.remove('hidden');
			fileDetails.classList.add('hidden');

			editorHeading.textContent = 'Create Service';
			editorSubheading.textContent = 'Add a new service offering';
			btnDelete.classList.add('hidden');
			clearStatus();
		}

		function selectService(service: any) {
			formId.value = service.id;
			formTitle.value = service.title || '';
			formOrder.value = String(service.order ?? 0);
			formDescription.value = service.description || '';
			formFeatures.value = Array.isArray(service.features) ? service.features.join('\n') : '';

			selectedLogoFile = null;
			if (service.logoUrl) {
				logoPreview.src = service.logoUrl;
				logoPreview.classList.remove('hidden');
				dropZonePrompt.classList.add('hidden');
				fileDetails.textContent = '✓ Current Logo';
				fileDetails.classList.remove('hidden');
			} else {
				logoPreview.src = '';
				logoPreview.classList.add('hidden');
				dropZonePrompt.classList.remove('hidden');
				fileDetails.classList.add('hidden');
			}

			const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
			cards.forEach(c => {
				if (c.getAttribute('data-id') === service.id) {
					c.classList.add('ring-2', 'ring-primary/60', 'border-primary/50');
				} else {
					c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50');
				}
			});

			editorHeading.textContent = 'Edit Service';
			editorSubheading.textContent = 'Modify service details';
			btnDelete.classList.remove('hidden');
			if (!(window as any).isPrimaryAdminUser) {
				btnDelete.classList.add('opacity-40', 'cursor-not-allowed');
				btnDelete.title = 'Only website owner can do this action';
			}

			clearStatus();
		}

		// --- Search Filter ---
		searchInput.addEventListener('input', () => {
			const query = searchInput.value.toLowerCase().trim();
			const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
			let matches = 0;

			cards.forEach(card => {
				const id = card.getAttribute('data-id');
				const service = allServices.find((s: any) => s.id === id);
				if (!service) return;

				const titleMatch = service.title.toLowerCase().includes(query);
				const descMatch = service.description.toLowerCase().includes(query);
				const featMatch = (service.features || []).some((f: string) => f.toLowerCase().includes(query));

				if (titleMatch || descMatch || featMatch) {
					card.classList.remove('hidden');
					matches++;
				} else {
					card.classList.add('hidden');
				}
			});

			if (query && matches === 0) {
				showEmptyState('No matching services', `No results found for "${query}"`);
			} else {
				servicesGrid.querySelector('.empty-state')?.remove();
			}
		});

		// --- Logo File Upload Setup ---
		logoDropZone.addEventListener('click', () => logoFileInput.click());
		logoDropZone.addEventListener('dragover', (e) => {
			e.preventDefault();
			logoDropZone.classList.add('border-primary', 'bg-primary/5');
		});
		logoDropZone.addEventListener('dragleave', () => {
			logoDropZone.classList.remove('border-primary', 'bg-primary/5');
		});
		logoDropZone.addEventListener('drop', (e) => {
			e.preventDefault();
			logoDropZone.classList.remove('border-primary', 'bg-primary/5');
			if (e.dataTransfer?.files.length) {
				handleLogoFile(e.dataTransfer.files[0]);
			}
		});

		logoFileInput.addEventListener('change', () => {
			if (logoFileInput.files?.length) {
				handleLogoFile(logoFileInput.files[0]);
			}
		});

		async function handleLogoFile(file: File) {
			if (!file.type.startsWith('image/')) {
				showStatus('Please select an image file.', 'error');
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Please select an image file.', 'error');
				}
				return;
			}
			try {
				const oldKB = Math.round(file.size / 1024);
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Compressing logo to WebP (<10KB)...', 'info');
				}
				const webpFile = await compressImageToWebpUnderTargetKB(file, 10, 256);
				selectedLogoFile = webpFile;
				logoPreview.src = URL.createObjectURL(webpFile);
				logoPreview.classList.remove('hidden');
				dropZonePrompt.classList.add('hidden');
				const newKB = parseFloat((webpFile.size / 1024).toFixed(1));
				const diffPct = oldKB > 0 ? Math.round(((newKB - oldKB) / oldKB) * 100) : 0;
				fileDetails.textContent = `✓ ${file.name} (${newKB}KB WebP)`;
				fileDetails.classList.remove('hidden');
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast(`Compressed: ${oldKB}KB → ${newKB}KB (${diffPct}%) WebP`, 'success');
				}
			} catch (err) {
				console.error('Failed to convert image to WebP:', err);
				showStatus('Could not process image.', 'error');
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Could not process image.', 'error');
				}
			}
		}

		// --- Submit Form ---
		serviceForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			clearStatus();

			const formData = new FormData();
			formData.append('action', 'save');
			formData.append('id', formId.value);
			formData.append('title', formTitle.value.trim());
			formData.append('order', formOrder.value.trim());
			formData.append('description', formDescription.value.trim());
			formData.append('features', formFeatures.value.trim());
			if (selectedLogoFile) {
				formData.append('logo', selectedLogoFile);
			}

			btnSave.disabled = true;
			saveBtnText.textContent = 'Saving...';

			try {
				const response = await fetch('/admin/admin_services_api', {
					method: 'POST',
					body: formData,
				});

				const result = await response.json();
				if (!response.ok || result.error) {
					showStatus(result.error || 'Failed to save service.', 'error');
					if (typeof (window as any).showToast === 'function') {
						(window as any).showToast(result.error || 'Failed to save service.', 'error');
					}
				} else {
					showStatus('Service saved successfully!', 'success');
					if (typeof (window as any).showToast === 'function') {
						(window as any).showToast('Service saved successfully!', 'success');
					}
					if (result.service) {
						const savedSvc = result.service;
						const existingIdx = allServices.findIndex((s: any) => s && s.id === savedSvc.id);
						if (existingIdx >= 0) {
							allServices[existingIdx] = savedSvc;
						} else {
							allServices.unshift(savedSvc);
						}
						rerenderAllServices();
						if (searchInput.value) searchInput.dispatchEvent(new Event('input'));
					}
					const newUrl = new URL(window.location.href);
					newUrl.searchParams.delete('id');
					window.history.replaceState(null, '', newUrl.toString());
					editorBackdrop.classList.remove('opacity-100');
					editorPanel.classList.remove('translate-x-0');
					editorPanel.classList.add('translate-x-full');
					const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
					cards.forEach(c => c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50'));
					setTimeout(() => {
						document.body.style.overflow = '';
						editorBackdrop.classList.add('hidden');
					}, 350);
				}
			} catch (err) {
				showStatus('Network error while saving.', 'error');
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Network error while saving.', 'error');
				}
			} finally {
				btnSave.disabled = false;
				saveBtnText.textContent = 'Save';
			}
		});

		// --- Delete Service ---
		btnDelete.addEventListener('click', async () => {
			if (!(window as any).isPrimaryAdminUser) {
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Only the website owner can delete services.', 'error');
				}
				return;
			}

			if (!confirm('Are you sure you want to delete this service offering?')) return;

			const formData = new FormData();
			formData.append('action', 'delete');
			formData.append('id', formId.value);

			btnDelete.disabled = true;

			try {
				const response = await fetch('/admin/admin_services_api', {
					method: 'POST',
					body: formData,
				});

				const result = await response.json();
				if (!response.ok || result.error) {
					showStatus(result.error || 'Failed to delete service.', 'error');
					if (typeof (window as any).showToast === 'function') {
						(window as any).showToast(result.error || 'Failed to delete service.', 'error');
					}
				} else {
					showStatus('Service deleted!', 'success');
					if (typeof (window as any).showToast === 'function') {
						(window as any).showToast('Service deleted successfully!', 'success');
					}
					const deletedId = formId.value;
					const delIdx = allServices.findIndex((s: any) => s && s.id === deletedId);
					if (delIdx >= 0) allServices.splice(delIdx, 1);
					const cards = servicesGrid.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
					cards.forEach(c => {
						if (c.getAttribute('data-id') === deletedId) c.remove();
					});
					if (allServices.length === 0) {
						showEmptyState('No services listed', 'Click "New" to create your first service offering.');
						loadMoreContainer.classList.add('hidden');
					}
					const newUrl = new URL(window.location.href);
					newUrl.searchParams.delete('id');
					window.history.replaceState(null, '', newUrl.toString());
					editorBackdrop.classList.remove('opacity-100');
					editorPanel.classList.remove('translate-x-0');
					editorPanel.classList.add('translate-x-full');
					cards.forEach(c => c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50'));
					setTimeout(() => {
						document.body.style.overflow = '';
						editorBackdrop.classList.add('hidden');
					}, 350);
				}
			} catch (err) {
				showStatus('Network error while deleting.', 'error');
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast('Network error while deleting.', 'error');
				}
			} finally {
				btnDelete.disabled = false;
			}
		});

		function showStatus(msg: string, type: 'error' | 'success') {
			formStatus.textContent = msg;
			formStatus.classList.remove('hidden', 'bg-[#DB4437]/10', 'border-[#DB4437]/30', 'text-[#DB4437]', 'bg-[#0F9D58]/10', 'border-[#0F9D58]/30', 'text-[#0F9D58]');
			if (type === 'error') {
				formStatus.classList.add('bg-[#DB4437]/10', 'border-[#DB4437]/30', 'text-[#DB4437]');
			} else {
				formStatus.classList.add('bg-[#0F9D58]/10', 'border-[#0F9D58]/30', 'text-[#0F9D58]');
			}
		}

		function clearStatus() {
			formStatus.textContent = '';
			formStatus.classList.add('hidden');
		}
	});
</script>
