---
/**
 * Admin Workspace Dashboard Page
 * 
 * Main entry point for the protected admin area. 
 * Connects to Firebase Firestore to fetch aggregate statistics 
 * (counts of projects, experience, designs, certificates, volunteering).
 * Requires the user to be authenticated (enforced via middleware).
 */

import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import AdminDashboard from "../../components/AdminDashboard.astro";
import AdminNavDock from "../../components/admin/AdminNavDock.astro";
import { getFirebaseAdminDb } from "../../lib/server/firebase-admin";
import { CACHE_TTL_MS, getOrSetCached } from "../../lib/server/cache";
import { getEnv } from "../../lib/server/env";

// Extra safety: double-check that the middleware successfully set Astro.locals.adminEmail
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect("/admin/admin_login");

let projectsCount = 0;
let experienceCount = 0;
let designsCount = 0;
let certificatesCount = 0;
let servicesCount = 0;
let volunteeringCount = 0;
let resumeDownloadsCount = 0;
let systemStatus = "Connected";

// Use a short TTL for admin metrics while still reducing repeated Firestore reads.
const cacheKeyAdminCounts = 'admin_dashboard_counts';
type DashboardCounts = {
  projects: number;
  experience: number;
  designs: number;
  certificates: number;
  services: number;
  volunteering: number;
  resumeDownloads: number;
};

try {
    const counts = await getOrSetCached<DashboardCounts>(
      cacheKeyAdminCounts,
      async () => {
    const db = getFirebaseAdminDb();
    
    // Parallel asynchronous fetching of the collections' count metrics
    const [projectsSnap, experienceSnap, designsSnap, certificatesSnap, servicesSnap, volunteeringSnap, configSnap] = await Promise.all([
      db.collection("projects").count().get(),
      db.collection("experience").count().get(),
      db.collection("designs").count().get(),
      db.collection("certificates").count().get(),
      db.collection("services").count().get(),
      db.collection("volunteering").count().get(),
      db.collection("configuration").doc("static_data").get(),
    ]);

    return {
      projects: projectsSnap.data().count,
      experience: experienceSnap.data().count,
      designs: designsSnap.data().count,
      certificates: certificatesSnap.data().count,
      services: servicesSnap.data().count,
      volunteering: volunteeringSnap.data().count,
      resumeDownloads: configSnap.exists ? (configSnap.data()?.resumeDownloads || 0) : 0,
    };
      },
      CACHE_TTL_MS.ADMIN_DATA,
    );
    projectsCount = counts.projects;
    experienceCount = counts.experience;
    designsCount = counts.designs;
    certificatesCount = counts.certificates;
    servicesCount = counts.services;
    volunteeringCount = counts.volunteering;
    resumeDownloadsCount = counts.resumeDownloads;
  } catch (error) {
    console.warn("Firestore access degraded or unconfigured. Falling back to mock dashboard metrics.", error);
    systemStatus = "Degraded (Mock Stats)";
    
    // Clean mock statistics matching user's collections structure
    projectsCount = -1;
    experienceCount = -1;
    designsCount = -1;
    certificatesCount = -1;
    servicesCount = -1;
    volunteeringCount = -1;
}

import { getSystemLogs } from "../../lib/server/system-logs";

let initialAcceptedEmails: any[] = [];
let initialTodos: any[] = [];
let initialLogs: any[] = [];

try {
  const db = getFirebaseAdminDb();
  const [emailsSnap, todosSnap, logsList] = await Promise.all([
    db.collection('accepted_admin_emails').orderBy('addedAt', 'asc').get(),
    db.collection('admin_todos').orderBy('createdAt', 'desc').get(),
    getSystemLogs(50),
  ]);

  initialAcceptedEmails = emailsSnap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
  initialTodos = todosSnap.docs.map(doc => ({ id: doc.id, ...doc.data() }));
  initialLogs = logsList;
} catch (err) {
  console.warn('Could not pre-fetch admin emails/todos/logs in frontmatter:', err);
}

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const currentAdminEmail = (adminEmail || '').toLowerCase().trim();
const isPrimaryAdmin = currentAdminEmail === primaryEmail;

if (!isPrimaryAdmin) {
  initialTodos = initialTodos.filter(
    (todo) => String(todo.createdBy || primaryEmail).toLowerCase().trim() === currentAdminEmail,
  );
  initialAcceptedEmails = initialAcceptedEmails.filter(
    (item) => String(item.email || item.id).toLowerCase().trim() === currentAdminEmail,
  );
}

if (isPrimaryAdmin && primaryEmail && !initialAcceptedEmails.some(e => e.email?.toLowerCase() === primaryEmail)) {
  initialAcceptedEmails.unshift({
    id: 'primary_env_email',
    email: primaryEmail,
    addedAt: new Date().toISOString(),
    addedBy: 'system',
    isPrimary: true,
    notes: 'Primary System Administrator',
  });
}

const metrics = {
  counts: {
    projects: projectsCount,
    experience: experienceCount,
    designs: designsCount,
    certificates: certificatesCount,
    services: servicesCount,
    volunteering: volunteeringCount,
    resumeDownloads: resumeDownloadsCount,
  },
  systemStatus: systemStatus,
};
---

<BackgroundBaseLayout title="Admin Workspace Dashboard">
  <AdminLayout systemStatus={systemStatus}>
    <AdminDashboard metrics={metrics} initialAcceptedEmails={initialAcceptedEmails} initialTodos={initialTodos} initialLogs={initialLogs} isPrimaryAdmin={isPrimaryAdmin} />
  </AdminLayout>
  <AdminNavDock currentPath={Astro.url.pathname} />
</BackgroundBaseLayout>
