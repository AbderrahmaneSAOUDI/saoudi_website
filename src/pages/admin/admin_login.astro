---
import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import Icon from '../../components/Icon.astro';
import { OAuth2Client } from 'google-auth-library';
import { createSessionToken } from '../../lib/server/session';

import { getEnv } from '../../lib/server/env';

const GOOGLE_CLIENT_ID = getEnv('GOOGLE_CLIENT_ID');
const ADMIN_EMAIL = getEnv('ADMIN_EMAIL');

// Handle authentication POST request
if (Astro.request.method === 'POST') {
  try {
    const { credential, rememberMe } = await Astro.request.json();
    if (!credential) {
      return Response.json({ error: 'Missing credential token' }, { status: 400 });
    }

    if (!ADMIN_EMAIL || !GOOGLE_CLIENT_ID) {
      console.error('Admin authentication environment variables are not configured.');
      return Response.json({ error: 'Server authentication misconfigured.' }, { status: 500 });
    }

    // Verify the Google GSI ID Token
    const client = new OAuth2Client(GOOGLE_CLIENT_ID);
    const ticket = await client.verifyIdToken({
      idToken: credential,
      audience: GOOGLE_CLIENT_ID,
    });
    const payload = ticket.getPayload();

    if (!payload || !payload.email) {
      return Response.json({ error: 'Invalid token payload.' }, { status: 400 });
    }

    // Check if the email matches primary ADMIN_EMAIL or is listed in Firestore accepted_admin_emails
    const userEmail = payload.email.toLowerCase().trim();
    let isAuthorized = userEmail === (ADMIN_EMAIL || '').toLowerCase().trim();
    
    if (!isAuthorized) {
      try {
        const { getFirebaseAdminDb } = await import('../../lib/server/firebase-admin');
        const db = getFirebaseAdminDb();
        const docSnap = await db.collection('accepted_admin_emails').doc(userEmail).get();
        if (docSnap.exists) {
          isAuthorized = true;
        }
      } catch (err) {
        console.warn('Error checking accepted_admin_emails collection:', err);
      }
    }

    if (!isAuthorized) {
      console.warn(`Unauthorized admin login attempt from: ${payload.email}`);
      return Response.json({ error: 'Unauthorized access. Email not accepted.' }, { status: 403 });
    }

    // Issue a secure HTTP-Only, Secure, SameSite cookie configured with expiration (30 days if rememberMe, 7 days default)
    const isRemember = rememberMe !== false;
    const maxAgeSeconds = isRemember ? 30 * 24 * 60 * 60 : 7 * 24 * 60 * 60;
    const sessionToken = await createSessionToken(payload.email);
    
    // Log authentication event in system_logs
    try {
      const { addSystemLog } = await import('../../lib/server/system-logs');
      const isPrimary = userEmail === (ADMIN_EMAIL || '').toLowerCase().trim();
      await addSystemLog({
        type: 'auth',
        action: isPrimary ? 'PRIMARY_ADMIN_LOGIN' : 'SECONDARY_ADMIN_LOGIN',
        title: isPrimary ? 'Owner logged into Admin Dashboard' : `Admin email entered Admin Dashboard: ${userEmail}`,
        details: `Authenticated via Google GSI for ${userEmail} (Remember Me: ${isRemember})`,
        userEmail: userEmail,
      });
    } catch (logErr) {
      console.warn('Could not record system login log:', logErr);
    }
    
    Astro.cookies.set('admin_session', sessionToken, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: maxAgeSeconds,
    });

    Astro.cookies.set('admin_remember', isRemember ? 'true' : 'false', {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: 30 * 24 * 60 * 60,
    });

    return Response.json({ success: true });
  } catch (error) {
    console.error('Google GSI verification error:', error);
    return Response.json({ error: 'Token verification failed.' }, { status: 400 });
  }
}

const title = "Admin — Login";
const gsiHtml = `
<script src="https://accounts.google.com/gsi/client" async defer><\/script>
<script>
  function handleCredentialResponse(response) {
    var rememberEl = document.getElementById('remember-me-checkbox');
    var rememberMe = rememberEl ? rememberEl.checked : true;

    fetch('/admin/admin_login', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        credential: response.credential,
        rememberMe: rememberMe
      })
    })
    .then(async res => {
      const data = await res.json();
      if (res.ok) {
        window.location.href = '/admin';
      } else {
        alert(data.error || 'Login verification failed.');
      }
    })
    .catch(err => {
      console.error('Login failed:', err);
      alert('An error occurred during authentication.');
    });
  }

  window.onload = function () {
    /* SECURITY: Read client_id from a data attribute instead of template literal
     * interpolation into executable JavaScript. This prevents XSS if the env
     * var were ever malformed or contained special characters. */
    var clientId = document.getElementById('gsi-config').dataset.clientId;
    google.accounts.id.initialize({
      client_id: clientId,
      callback: handleCredentialResponse
    });
    google.accounts.id.renderButton(
      document.getElementById('g_id_signin'),
      { 
        theme: 'filled_black', 
        size: 'medium',
        width: '100%',
        shape: 'pill',
        text: 'continue_with',
      }
    );
  };
<\/script>
`;
---

<BackgroundBaseLayout title={title}>
  <main class="min-h-screen flex items-center justify-center">
    <section class="max-w-md w-full px-4" aria-labelledby="login-heading">
      <div class="p-6 rounded-3xl shadow-lg border border-[var(--color-surface-container)]" style="background:var(--color-surface-container); color:var(--color-google-white);">
        <header class="mb-6 text-center flex flex-col items-center">
          <Icon name="lock" size={48} class="w-12 h-12 mb-3" style="color:var(--color-primary);" />
          <h1 id="login-heading" class="text-2xl font-bold tracking-tight text-[#FFFFFF]">saoudi.online</h1>
        </header>

        {/* SECURITY: Pass client_id via data attribute, not JS interpolation */}
        <div id="gsi-config" data-client-id={GOOGLE_CLIENT_ID}></div>
        <div id="g_id_onload"
          class="rounded-3xl"
          data-client_id={GOOGLE_CLIENT_ID}
          data-callback="handleCredentialResponse">
        </div>
        <div class="w-full flex justify-center rounded-3xl" id="g_id_signin" data-type="standard" data-size="medium" data-theme="dark"></div>

        <div class="mt-4 flex items-center justify-center">
          <label class="inline-flex items-center gap-2 cursor-pointer text-xs text-[#E6E1E5]/70 hover:text-white transition select-none">
            <input
              type="checkbox"
              id="remember-me-checkbox"
              checked
              class="w-4 h-4 rounded border border-white/20 bg-surface-container text-primary focus:ring-primary/40 cursor-pointer accent-[#4285F4]"
            />
            <span>Remember me (don't count admin downloads)</span>
          </label>
        </div>

        <div set:html={gsiHtml}></div>
      </div>
    </section>
  </main>
</BackgroundBaseLayout>
