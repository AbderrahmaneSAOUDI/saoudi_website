										/>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Month</label>
										<select
											id="form-start-date-month"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
										>
											<option value="">-- Month --</option>
											<option value="01">01 - Jan</option>
											<option value="02">02 - Feb</option>
											<option value="03">03 - Mar</option>
											<option value="04">04 - Apr</option>
											<option value="05">05 - May</option>
											<option value="06">06 - Jun</option>
											<option value="07">07 - Jul</option>
											<option value="08">08 - Aug</option>
											<option value="09">09 - Sep</option>
											<option value="10">10 - Oct</option>
											<option value="11">11 - Nov</option>
											<option value="12">12 - Dec</option>
										</select>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Year</label>
										<input
											type="text"
											id="form-start-date-year"
											inputmode="numeric"
											pattern="[0-9]*"
											maxlength="4"
											value="2026"
											placeholder="2026"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors text-center font-medium"
										/>
									</div>
								</div>
								<input type="hidden" id="form-start-date" name="startDate" />
							</div>
						</div>

						<!-- End Date (Optional - Empty = Present) -->
						<div>
							<div class="flex justify-between items-center mb-1.5">
								<div class="flex items-center gap-1.5">
									<label class="block text-xs font-semibold text-[#E6E1E5]/70">End Date</label>
									<span class="text-[10px] text-primary/80 font-medium">(Empty = Present)</span>
								</div>
								<button
									type="button"
									id="btn-clear-end-date"
									class="text-[11px] text-[#E6E1E5]/40 hover:text-primary transition-colors cursor-pointer hidden"
								>
									Clear Date
								</button>
							</div>
							<div class="space-y-2">
								<div class="grid grid-cols-3 gap-2">
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Day</label>
										<input
											type="text"
											id="form-end-date-day"
											inputmode="numeric"
											pattern="[0-9]*"
											maxlength="2"
											placeholder="DD"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors text-center font-medium"
										/>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Month</label>
										<select
											id="form-end-date-month"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
										>
											<option value="">-- Month --</option>
											<option value="01">01 - Jan</option>
											<option value="02">02 - Feb</option>
											<option value="03">03 - Mar</option>
											<option value="04">04 - Apr</option>
											<option value="05">05 - May</option>
											<option value="06">06 - Jun</option>
											<option value="07">07 - Jul</option>
											<option value="08">08 - Aug</option>
											<option value="09">09 - Sep</option>
											<option value="10">10 - Oct</option>
											<option value="11">11 - Nov</option>
											<option value="12">12 - Dec</option>
										</select>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Year</label>
										<input
											type="text"
											id="form-end-date-year"
											inputmode="numeric"
											pattern="[0-9]*"
											maxlength="4"
											placeholder="2026"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors text-center font-medium"
										/>
