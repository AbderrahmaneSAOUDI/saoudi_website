---
import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import AdminNavDock from "../../components/admin/AdminNavDock.astro";
import GlobalLightbox from "../../components/GlobalLightbox.astro";
import ConfirmDialog from "../../components/admin/ConfirmDialog.astro";
import Toast from "../../components/Toast.astro";
import { getFirebaseAdminDb } from "../../lib/server/firebase-admin";
import Icon from "../../components/Icon.astro";
import AdminControlsStrip from "../../components/admin/AdminControlsStrip.astro";
import { getEnv } from "../../lib/server/env";
import type { Experience } from "../../types";
import { EMPLOYMENT_TYPES } from "../../types";

const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect("/admin/admin_login");

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const currentAdminEmail = (adminEmail || '').toLowerCase().trim();
const isPrimaryAdmin = currentAdminEmail === primaryEmail && primaryEmail !== '';

let experiences: Experience[] = [];
let companies: string[] = [];
let years: string[] = [];
let errorMsg = '';

try {
	const db = getFirebaseAdminDb();
	const snapshot = await db.collection("experience").get();
	experiences = snapshot.docs.map(doc => {
		const data = doc.data();
		return {
			id: doc.id,
			order: data.order ?? 0,
			role: data.role ?? '',
			company: data.company ?? '',
			logoUrl: data.logoUrl ?? null,
			employmentType: data.employmentType ?? 'Full-time',
			startDate: data.startDate ?? '',
			endDate: data.endDate ?? null,
			responsibilities: data.responsibilities ?? '',
		};
	}) as Experience[];

	// Extract unique companies & years
	companies = [...new Set(experiences.map(e => e.company).filter((c): c is string => Boolean(c)))].sort((a, b) => a.localeCompare(b));
	years = [...new Set(experiences.map(e => {
		if (typeof e.startDate === 'string' && e.startDate.includes('-')) {
			return e.startDate.split('-')[0];
		}
		return null;
	}).filter((y): y is string => Boolean(y)))].sort((a, b) => b.localeCompare(a));

	// Sort by startDate desc
	experiences.sort((a, b) => b.startDate.localeCompare(a.startDate));
} catch (error: any) {
	console.warn("Failed to fetch experiences from Firestore:", error);
	errorMsg = "Degraded mode: Firestore is not configured or offline.";
}
---

<BackgroundBaseLayout title="Experience Management — Admin">
	<AdminLayout title="Experience">
		<div class="relative min-h-[calc(100vh-140px)]">
			
			<!-- Main Content Area -->
			<div class="space-y-6">
				<!-- Top Controls Strip -->
				<AdminControlsStrip
					searchId="search-input"
					searchPlaceholder="Search role, company..."
					filterToggleId="btn-filter-toggle"
					filterBadgeId="filter-badge"
					newBtnId="btn-new-experience"
					newBtnLabel="New"
				/>

				{errorMsg && (
					<div class="p-4 rounded-2xl bg-[#DB4437]/10 border border-[#DB4437]/30 text-[#DB4437] text-sm flex items-center gap-2.5">
						<Icon name="alert" size={20} class="w-5 h-5 shrink-0" />
						<span>{errorMsg}</span>
					</div>
				)}

				<!-- Grid of Experiences -->
				<div id="experiences-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
					{/* Cards will be dynamically rendered via JS */}
				</div>

				<!-- Load More Button -->
				<div id="load-more-container" class="flex justify-center">
					<button
						id="btn-load-more"
						class="px-6 py-2.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer"
					>
						Load More
					</button>
				</div>
			</div>

			<!-- Drawer Backdrop -->
			<div
				id="editor-backdrop"
				class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] transition-opacity duration-300 opacity-0"
			></div>

			<!-- Sliding Filter Drawer (Starts offscreen translated left) -->
			<div
				id="filter-panel"
				class="fixed top-0 left-0 h-full w-full sm:w-[360px] bg-[#1D1B20] border-r border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform -translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 class="text-lg font-bold text-white">Filter Experience</h2>
							<p class="text-xs text-[#E6E1E5]/50 mt-1">Refine position listing</p>
						</div>
						<button
							type="button"
							id="btn-close-filters"
							class="group p-1.5 rounded-lg text-[#E6E1E5]/60 hover:text-white hover:bg-white/5 transition-all cursor-pointer"
							title="Close Filters"
						>
							<Icon name="close" size={18} class="w-4.5 h-4.5 group-hover:hidden" />
							<Icon name="close" filled size={18} class="w-4.5 h-4.5 hidden group-hover:block" />
						</button>
					</div>

					<div class="space-y-4">
						<!-- Employment Type Select -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Employment Type</label>
							<select
								id="filter-type"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Types</option>
								{EMPLOYMENT_TYPES.map(t => (
									<option value={t}>{t}</option>
								))}
							</select>
						</div>

						<!-- Company Select -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Company</label>
							<select
								id="filter-company"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Companies</option>
								{companies.map(comp => (
									<option value={comp}>{comp}</option>
								))}
							</select>
						</div>

						<!-- Year Select -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Start Year</label>
							<select
								id="filter-year"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Years</option>
								{years.map(y => (
									<option value={y}>{y}</option>
								))}
							</select>
						</div>
					</div>
				</div>

				<div class="flex gap-3 mt-8 pt-4 border-t border-[#2B2930]/40">
					<button
						type="button"
						id="btn-clear-filters"
						class="w-full py-2.5 bg-transparent border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5]/60 hover:text-white font-semibold rounded-xl text-xs transition-all cursor-pointer text-center"
					>
						Clear Filters
					</button>
				</div>
			</div>

			<!-- Sliding Drawer Detail Editor (Starts offscreen translated right) -->
			<div
				id="editor-panel"
				class="fixed top-0 right-0 h-full w-full sm:w-[460px] bg-[#1D1B20] border-l border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 id="editor-heading" class="text-lg font-bold text-white">Create Experience</h2>
							<p id="editor-subheading" class="text-xs text-[#E6E1E5]/50 mt-1">Add a new professional role</p>
						</div>
						<button
							type="button"
							id="btn-delete"
							class="hidden p-2.5 rounded-xl text-[#DB4437] hover:bg-[#DB4437]/10 border border-transparent hover:border-[#DB4437]/20 transition-all cursor-pointer shrink-0 flex items-center gap-1.5"
							title="Delete Experience (Delete)"
						>
							<Icon name="trash" size={20} class="w-5 h-5" />
							<kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-[#DB4437]/20 text-[#DB4437] rounded border border-[#DB4437]/30">Del</kbd>
						</button>
					</div>

					<form id="experience-form" class="space-y-4">
						<!-- Company Logo File Dropzone (Moved to the Top) -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Company Logo (Optional WebP ≤50KB)</label>
							<div
								id="image-drop-zone"
								class="border-2 border-dashed border-[#2B2930] hover:border-primary/50 rounded-2xl p-4 text-center transition-all duration-300 cursor-pointer group relative overflow-hidden min-h-[140px] flex flex-col items-center justify-center bg-[#141218]"
							>
								<input
									type="file"
									id="image-file-input"
									accept="image/jpeg,image/png,image/webp"
									class="hidden"
								/>
								<img
									id="image-preview"
									src=""
									alt="Preview"
									class="hidden absolute inset-0 w-full h-full object-contain p-2 opacity-80 group-hover:scale-105 transition-all duration-500 z-10"
								/>
								<div id="drop-zone-prompt" class="relative z-10 flex flex-col items-center gap-1.5">
									<div class="p-2 rounded-full bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
										<Icon name="image" size={20} class="w-5 h-5" />
									</div>
									<div>
										<p class="text-xs font-medium text-white flex items-center gap-1.5">
											Drop logo or <span class="text-primary font-semibold">browse</span>
											<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">CapsLock</kbd>
										</p>
										<p class="text-[10px] text-[#E6E1E5]/40 mt-0.5">JPEG, PNG, WebP (Max 50KB)</p>
									</div>
								</div>
								<div id="file-details" class="hidden relative z-10 text-[10px] bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 px-2 py-1 rounded-md font-semibold mt-2">
									✓ File Selected
								</div>
							</div>
						</div>

						<!-- Read-only experience ID -->
						<div class="hidden">
							<input type="text" id="form-id" name="id" readonly />
						</div>

						<!-- Job Title / Role -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Job Title / Role *</label>
							<input
								type="text"
								id="form-role"
								name="role"
								required
								placeholder="e.g. Senior Software Engineer"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
							/>
						</div>

						<!-- Company Name -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Company Name *</label>
							<input
								type="text"
								id="form-company"
								name="company"
								required
								placeholder="e.g. Google"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
							/>
						</div>

						<!-- Employment Type -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Employment Type *</label>
							<select
								id="form-employment-type"
								name="employmentType"
								required
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								{EMPLOYMENT_TYPES.map(t => (
									<option value={t}>{t}</option>
								))}
							</select>
						</div>

						<!-- Start Date (Design Panel Granular Logic) -->
						<div>
							<div class="flex justify-between items-center mb-1.5">
								<label class="block text-xs font-semibold text-[#E6E1E5]/70">Start Date *</label>
								<button
									type="button"
									id="btn-clear-start-date"
									class="text-[11px] text-[#E6E1E5]/40 hover:text-primary transition-colors cursor-pointer hidden"
								>
									Clear Date
								</button>
							</div>
							<div class="space-y-2">
								<div class="grid grid-cols-3 gap-2">
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Day</label>
										<input
											type="text"
											id="form-start-date-day"
											inputmode="numeric"
											pattern="[0-9]*"
