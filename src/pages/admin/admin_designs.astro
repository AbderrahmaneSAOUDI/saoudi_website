---
import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import AdminNavDock from "../../components/admin/AdminNavDock.astro";
import { getFirebaseAdminDb } from "../../lib/server/firebase-admin";
import Icon from "../../components/Icon.astro";
import GlobalLightbox from "../../components/GlobalLightbox.astro";
import AdminControlsStrip from "../../components/admin/AdminControlsStrip.astro";

// Extra safety: double-check authentication
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect("/admin/admin_login");

let designs: any[] = [];
let companies: string[] = ['Google', 'GDG', 'Freelance', 'Personal'];
let years: string[] = [];
let errorMsg = '';

try {
	const db = getFirebaseAdminDb();
	
	// Fetch companies and designs in parallel to improve page load speed
	const [companiesDoc, snapshot] = await Promise.all([
		db.collection("configuration").doc("designs_companies").get(),
		db.collection("designs").orderBy("date", "desc").get()
	]);

	if (companiesDoc.exists) {
		companies = companiesDoc.data()?.companies || companies;
	} else {
		// Auto-initialize companies configuration in DB
		await db.collection("configuration").doc("designs_companies").set({ companies });
	}

	designs = snapshot.docs.map(doc => ({
		id: doc.id,
		...doc.data()
	}));
	
	// Extract unique sorted years
	years = [...new Set(designs.map(d => {
		if (typeof d.date === 'string' && d.date.includes('-')) {
			return d.date.split('-')[0];
		}
		return null;
	}).filter(Boolean))].sort((a, b) => b.localeCompare(a));
} catch (error: any) {
	console.warn("Failed to fetch designs from Firestore:", error);
	errorMsg = "Degraded mode: Firestore is not configured or offline.";
}
---

<BackgroundBaseLayout title="Designs Workspace">
	<AdminLayout title="Designs">
		<div class="relative min-h-[calc(100vh-140px)]">
			
			<!-- Main Left Area: Full width list since panel is drawer -->
			<div class="space-y-6">
				
				<!-- Top Controls Strip -->
				<AdminControlsStrip
					searchId="search-input"
					searchPlaceholder="Search designs by title or company..."
					filterToggleId="btn-filter-toggle"
					filterBadgeId="filter-badge"
					newBtnId="btn-new-design"
					newBtnLabel="New"
				/>

				{errorMsg && (
					<div class="p-4 rounded-2xl bg-[#DB4437]/10 border border-[#DB4437]/30 text-[#DB4437] text-sm flex items-center gap-2.5">
						<Icon name="alert" size={20} class="w-5 h-5 shrink-0" />
						<span>{errorMsg}</span>
					</div>
				)}

				<!-- Grid of Designs -->
				<div id="designs-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
					{/* Cards will be dynamically rendered via JS */}
				</div>

				<!-- Load More Button -->
				<div id="load-more-container" class="flex justify-center">
					<button
						id="btn-load-more"
						class="px-6 py-2.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer"
					>
						Load More
					</button>
				</div>
			</div>

			<!-- Drawer Backdrop -->
			<div
				id="editor-backdrop"
				class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] transition-opacity duration-300 opacity-0"
			></div>

			<!-- Sliding Filter Drawer (Starts offscreen translated left) -->
			<div
				id="filter-panel"
				class="fixed top-0 left-0 h-full w-full sm:w-[360px] bg-[#1D1B20] border-r border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform -translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 class="text-lg font-bold text-white">Filter Designs</h2>
							<p class="text-xs text-[#E6E1E5]/50 mt-1">Refine mockup listing</p>
						</div>
						<button
							type="button"
							id="btn-close-filters"
							class="text-[#E6E1E5]/60 hover:text-white transition-colors cursor-pointer text-xl font-bold"
						>
							&times;
						</button>
					</div>

					<div class="space-y-4">
						<!-- Company Select -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Company</label>
							<select
								id="filter-company"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Companies</option>
								{companies.map(comp => (
									<option value={comp}>{comp}</option>
								))}
							</select>
						</div>

						<!-- Year Select -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Year</label>
							<select
								id="filter-year"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Years</option>
								{years.map(y => (
									<option value={y}>{y}</option>
								))}
							</select>
						</div>

						<!-- Date Interval -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Date Interval</label>
							<div class="grid grid-cols-2 gap-2">
								<div>
									<span class="text-[10px] text-[#E6E1E5]/40 mb-1 block">From</span>
									<input
										type="date"
										id="filter-start-date"
										class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
									/>
								</div>
								<div>
									<span class="text-[10px] text-[#E6E1E5]/40 mb-1 block">To</span>
									<input
										type="date"
										id="filter-end-date"
										class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
									/>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="flex gap-3 mt-8 pt-4 border-t border-[#2B2930]/40">
					<button
						type="button"
						id="btn-clear-filters"
						class="w-full py-2.5 bg-transparent border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5]/60 hover:text-white font-semibold rounded-xl text-xs transition-all cursor-pointer text-center"
					>
						Clear Filters
					</button>
				</div>
			</div>

			<!-- Sliding Drawer Detail Editor (Starts offscreen translated right) -->
			<div
				id="editor-panel"
				class="fixed top-0 right-0 h-full w-full sm:w-[460px] bg-[#1D1B20] border-l border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 id="editor-heading" class="text-lg font-bold text-white">Create Design</h2>
							<p id="editor-subheading" class="text-xs text-[#E6E1E5]/50 mt-1">Add a new portfolio entry</p>
						</div>
						<button
							type="button"
							id="btn-delete"
							class="hidden p-2.5 rounded-xl text-[#DB4437] hover:bg-[#DB4437]/10 border border-transparent hover:border-[#DB4437]/20 transition-all cursor-pointer shrink-0 flex items-center gap-1.5"
							title="Delete Design (Delete)"
						>
							<Icon name="trash" size={20} class="w-5 h-5" />
							<kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-[#DB4437]/20 text-[#DB4437] rounded border border-[#DB4437]/30">Del</kbd>
						</button>
					</div>

					<form id="design-form" class="space-y-4" onsubmit="event.preventDefault();">
						
						<!-- Image Dropzone (Moved to the Top) -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Mockup Image *</label>
							<div
								id="image-drop-zone"
								class="border-2 border-dashed border-[#2B2930] hover:border-primary/50 rounded-2xl p-4 text-center transition-all duration-300 cursor-pointer group relative overflow-hidden min-h-[140px] flex flex-col items-center justify-center bg-[#141218]"
							>
								<input
									type="file"
									id="image-file-input"
									accept="image/jpeg,image/png,image/webp"
									class="hidden"
								/>
								
								<!-- Hover/Preview overlay -->
								<img
									id="image-preview"
									src=""
									alt="Preview"
									class="hidden absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-all duration-500"
								/>

								<div id="drop-zone-prompt" class="relative z-10 flex flex-col items-center gap-1.5">
									<div class="p-2 rounded-full bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
										<Icon name="image" size={20} class="w-5 h-5" />
									</div>
									<div>
										<p class="text-xs font-medium text-white flex items-center gap-1.5">
											Drop cover or <span class="text-primary font-semibold">browse</span>
											<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">CapsLock</kbd>
										</p>
										<p class="text-[10px] text-[#E6E1E5]/40 mt-0.5">JPEG, PNG, WebP (Max 10MB)</p>
									</div>
								</div>

								<div id="file-details" class="hidden relative z-10 text-[10px] bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 px-2 py-1 rounded-md font-semibold mt-2">
									✓ File Selected
								</div>
							</div>
						</div>

						<!-- Read-only design ID -->
						<div class="hidden">
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Design ID</label>
							<input
								type="text"
								id="form-id"
								name="id"
								readonly
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-[#E6E1E5]/40 text-xs focus:outline-none"
							/>
						</div>

						<!-- Title -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Title (Optional)</label>
							<input
								type="text"
								id="form-title"
								name="title"
								placeholder="e.g., E-Commerce App Dashboard (Optional)"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
							/>
						</div>

						<!-- Company Dropdown with Manage Button -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Company *</label>
							<div class="flex gap-2 items-center">
								<select
									id="form-company"
									name="company"
									required
									class="flex-grow px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
								>
									{companies.map(comp => (
										<option value={comp}>{comp}</option>
									))}
								</select>
								<button
									type="button"
									id="btn-edit-companies"
									title="Manage Companies"
									class="p-2.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] hover:border-primary/50 text-primary transition-all cursor-pointer flex items-center justify-center shrink-0"
								>
									<Icon name="settings" size={20} class="w-5 h-5" />
								</button>
							</div>
						</div>

						<!-- Date (Optional) -->
						<div>
							<div class="flex justify-between items-center mb-1.5">
								<label class="block text-xs font-semibold text-[#E6E1E5]/70">Design Date (Optional)</label>
								<button
									type="button"
									id="btn-clear-date"
									class="text-[11px] text-[#E6E1E5]/40 hover:text-primary transition-colors cursor-pointer hidden"
								>
									Clear Date
								</button>
							</div>

							<div class="space-y-2">
								<!-- Granular Inputs: Day, Month, Year -->
								<div class="grid grid-cols-3 gap-2">
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Day</label>
										<input
											type="text"
											id="form-date-day"
											inputmode="numeric"
											pattern="[0-9]*"
											maxlength="2"
											placeholder="DD"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors text-center font-medium"
										/>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Month</label>
										<select
											id="form-date-month"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
										>
											<option value="">-- Month --</option>
											<option value="01">01 - Jan</option>
											<option value="02">02 - Feb</option>
											<option value="03">03 - Mar</option>
											<option value="04">04 - Apr</option>
											<option value="05">05 - May</option>
											<option value="06">06 - Jun</option>
											<option value="07">07 - Jul</option>
											<option value="08">08 - Aug</option>
											<option value="09">09 - Sep</option>
											<option value="10">10 - Oct</option>
											<option value="11">11 - Nov</option>
											<option value="12">12 - Dec</option>
										</select>
									</div>
									<div>
										<label class="block text-[10px] text-[#E6E1E5]/50 mb-1 font-medium">Year</label>
										<input
											type="text"
											id="form-date-year"
											inputmode="numeric"
											pattern="[0-9]*"
											maxlength="4"
											value="2026"
											placeholder="2026"
											class="w-full px-2.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors text-center font-medium"
										/>
									</div>
								</div>

								<!-- Hidden field for form submission -->
								<input type="hidden" id="form-date" name="date" />
							</div>
						</div>

						<!-- Status Panel -->
						<div id="form-status" class="hidden p-3.5 rounded-xl border text-xs font-medium text-center"></div>

						<!-- Form Buttons (Includes Cancel Button) -->
						<div class="flex gap-3 pt-2">
							<button
								type="button"
								id="btn-cancel"
								class="flex-1 py-3 px-4 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer text-center flex items-center justify-center gap-1.5"
							>
								<span>Cancel</span>
								<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">Esc</kbd>
							</button>
							<button
								type="submit"
								id="btn-save"
								class="flex-1 py-3 px-4 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-sm transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer shadow-md"
							>
								<Icon name="save" size={16} class="w-4 h-4" />
								<span id="save-btn-text">Save</span>
							</button>
						</div>
					</form>
				</div>
			</div>

		</div>

		<!-- Manage Categories Modal -->
		<!-- Manage Companies Modal -->
		<div id="companies-modal" class="hidden fixed inset-0 z-[80] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
			<div class="bg-[#1D1B20] border border-[#2B2930] w-full max-w-md rounded-3xl p-6 space-y-6 shadow-2xl relative max-h-[90vh] flex flex-col justify-between">
				<div>
					<div class="border-b border-[#2B2930]/60 pb-3 flex justify-between items-center mb-4">
						<h3 class="text-lg font-bold text-white">Manage Companies</h3>
						<button id="close-companies-modal" class="text-[#E6E1E5]/60 hover:text-white transition-colors cursor-pointer text-xl font-bold">&times;</button>
					</div>

					<!-- Scrollable companies list with rearrange handles -->
					<div id="modal-companies-list" class="space-y-2 max-h-[300px] overflow-y-auto pr-1">
						<!-- Dynamically populated via JS -->
					</div>

					<!-- Add Company input -->
					<div class="mt-4 pt-4 border-t border-[#2B2930]/60 flex gap-2">
						<input
							type="text"
							id="new-company-input"
							placeholder="New company name..."
							class="flex-grow bg-[#141218] border border-[#2B2930] rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:border-primary transition-colors"
						/>
						<button
							type="button"
							id="btn-add-company"
							class="px-4 py-2 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl text-xs transition-all cursor-pointer"
						>
							Add
						</button>
					</div>
				</div>

				<div class="flex gap-3 mt-4 pt-4 border-t border-[#2B2930]/40">
					<button
						type="button"
						id="close-companies-modal-btn"
						class="flex-grow py-2.5 bg-transparent border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5]/60 hover:text-white font-semibold rounded-xl text-xs transition-all cursor-pointer text-center"
					>
						Cancel
					</button>
					<button
						type="button"
						id="btn-save-companies"
						class="flex-grow py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-xl text-xs transition-all cursor-pointer flex items-center justify-center gap-2"
					>
							<Icon name="save" size={14} class="w-3.5 h-3.5" />
						Save Changes
					</button>
				</div>
			</div>
		</div>

	</AdminLayout>
	<AdminNavDock currentPath={Astro.url.pathname} />

	<!-- Render Lightbox outside transform scopes -->
	<GlobalLightbox />
</BackgroundBaseLayout>

<script define:vars={{ designs, initialCompanies: companies }} is:inline>
	// Make server-fetched items available to client script
	window.designs = designs || [];
	window.companies = initialCompanies || [];
</script>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Element Declarations
		const searchInput = document.getElementById('search-input') as HTMLInputElement;
		const btnNewDesign = document.getElementById('btn-new-design') as HTMLButtonElement;
		const designsGrid = document.getElementById('designs-grid') as HTMLDivElement;
		const loadMoreBtn = document.getElementById('btn-load-more') as HTMLButtonElement;
		const loadMoreContainer = document.getElementById('load-more-container') as HTMLDivElement;

		// Local State
		let ITEMS_PER_PAGE = 5;
		let displayedCount = 0;
		let allDesigns: any[] = (window as any).designs || [];

		// Filter Elements
		const btnFilterToggle = document.getElementById('btn-filter-toggle') as HTMLButtonElement;
		const filterBadge = document.getElementById('filter-badge') as HTMLSpanElement;
		const filterPanel = document.getElementById('filter-panel') as HTMLDivElement;
		const filterCompany = document.getElementById('filter-company') as HTMLSelectElement;
		const filterYear = document.getElementById('filter-year') as HTMLSelectElement;
		const filterStartDate = document.getElementById('filter-start-date') as HTMLInputElement;
		const filterEndDate = document.getElementById('filter-end-date') as HTMLInputElement;
		const btnClearFilters = document.getElementById('btn-clear-filters') as HTMLButtonElement;
		const btnCloseFilters = document.getElementById('btn-close-filters') as HTMLButtonElement;

		// Drawer Elements
		const editorPanel = document.getElementById('editor-panel') as HTMLDivElement;
		const editorBackdrop = document.getElementById('editor-backdrop') as HTMLDivElement;
		const btnCancel = document.getElementById('btn-cancel') as HTMLButtonElement;

		const editorHeading = document.getElementById('editor-heading') as HTMLHeadingElement;
		const editorSubheading = document.getElementById('editor-subheading') as HTMLParagraphElement;
		
		const designForm = document.getElementById('design-form') as HTMLFormElement;
		const formId = document.getElementById('form-id') as HTMLInputElement;
		const formTitle = document.getElementById('form-title') as HTMLInputElement;
		const formCompany = document.getElementById('form-company') as HTMLSelectElement;
		const btnClearDate = document.getElementById('btn-clear-date') as HTMLButtonElement;
		const formDateDay = document.getElementById('form-date-day') as HTMLInputElement;
		const formDateMonth = document.getElementById('form-date-month') as HTMLSelectElement;
		const formDateYear = document.getElementById('form-date-year') as HTMLInputElement;
		const formDate = document.getElementById('form-date') as HTMLInputElement;

		const imageDropZone = document.getElementById('image-drop-zone') as HTMLDivElement;
		const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement;
		const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
		const dropZonePrompt = document.getElementById('drop-zone-prompt') as HTMLDivElement;
		const fileDetails = document.getElementById('file-details') as HTMLDivElement;

		const formStatus = document.getElementById('form-status') as HTMLDivElement;
		const btnDelete = document.getElementById('btn-delete') as HTMLButtonElement;
		const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
		const saveBtnText = document.getElementById('save-btn-text') as HTMLSpanElement;

		// Companies Modal Elements
		const btnEditCompanies = document.getElementById('btn-edit-companies') as HTMLButtonElement;
		const companiesModal = document.getElementById('companies-modal') as HTMLDivElement;
		const closeCompaniesModal = document.getElementById('close-companies-modal') as HTMLButtonElement;
		const closeCompaniesModalBtn = document.getElementById('close-companies-modal-btn') as HTMLButtonElement;
		const modalCompaniesList = document.getElementById('modal-companies-list') as HTMLDivElement;
		const newCompanyInput = document.getElementById('new-company-input') as HTMLInputElement;
		const btnAddCompany = document.getElementById('btn-add-company') as HTMLButtonElement;
		const btnSaveCompanies = document.getElementById('btn-save-companies') as HTMLButtonElement;

		// Local State
		let selectedImageFile: File | null = null;
		let currentSelectedId: string | null = null;
		
		// Modal Working Drafts
		interface ModalItem {
			originalName: string;
			currentName: string;
		}
		let modalCompanies: ModalItem[] = [];

		// --- Core Setup & Initialization ---
		populateCompanyDropdown();
		initDateInputListeners();
		renderDesigns();
		initFromUrl();

		function updateCombinedDate() {
			let combinedDate = '';
			const yearVal = formDateYear ? formDateYear.value.trim() : '';
			const monthVal = formDateMonth ? formDateMonth.value : '';
			let dayVal = formDateDay ? formDateDay.value.trim() : '';

			if (dayVal && dayVal.length === 1) {
				dayVal = dayVal.padStart(2, '0');
			}

			if (yearVal && yearVal.length === 4) {
				if (monthVal) {
					if (dayVal) {
						combinedDate = `${yearVal}-${monthVal}-${dayVal}`;
					} else {
						combinedDate = `${yearVal}-${monthVal}`;
					}
				} else {
					combinedDate = yearVal;
				}
			}

			if (formDate) formDate.value = combinedDate;

			if (combinedDate) {
				if (btnClearDate) btnClearDate.classList.remove('hidden');
			} else {
				if (btnClearDate) btnClearDate.classList.add('hidden');
			}
		}

		function setDateFields(dateStr?: string) {
			if (!dateStr || !dateStr.trim()) {
				if (formDateYear) formDateYear.value = '2026';
				if (formDateMonth) formDateMonth.value = '';
				if (formDateDay) formDateDay.value = '';
				if (formDate) formDate.value = '2026';
				if (btnClearDate) btnClearDate.classList.add('hidden');
				return;
			}

			const trimmed = dateStr.trim();
			const parts = trimmed.split('-');
			if (parts.length === 3) {
				if (formDateYear) formDateYear.value = parts[0];
				if (formDateMonth) formDateMonth.value = parts[1];
				if (formDateDay) formDateDay.value = parts[2];
			} else if (parts.length === 2) {
				if (formDateYear) formDateYear.value = parts[0];
				if (formDateMonth) formDateMonth.value = parts[1];
				if (formDateDay) formDateDay.value = '';
			} else if (parts.length === 1 && parts[0].length === 4) {
				if (formDateYear) formDateYear.value = parts[0];
				if (formDateMonth) formDateMonth.value = '';
				if (formDateDay) formDateDay.value = '';
			} else {
				if (formDateYear) formDateYear.value = '2026';
				if (formDateMonth) formDateMonth.value = '';
				if (formDateDay) formDateDay.value = '';
			}
			if (formDate) formDate.value = trimmed;
			if (btnClearDate) btnClearDate.classList.remove('hidden');
		}

		let monthKeyBuffer = '';
		let monthBufferTimer: any = null;

		function handleMonthKeydown(e: KeyboardEvent) {
			const key = e.key;

			// Shortcut 'o' or 'O' -> October ('10')
			if (key === 'o' || key === 'O') {
				e.preventDefault();
				if (formDateMonth) {
					formDateMonth.value = '10';
					updateCombinedDate();
				}
				return;
			}

			// Numeric shortcuts (e.g. typing '10' or '1'..'12')
			if (/^[0-9]$/.test(key)) {
				e.preventDefault();
				monthKeyBuffer += key;

				if (monthBufferTimer) clearTimeout(monthBufferTimer);
				monthBufferTimer = setTimeout(() => {
					monthKeyBuffer = '';
				}, 1000);

				let num = parseInt(monthKeyBuffer, 10);
				if (num > 12) {
					num = parseInt(key, 10);
					monthKeyBuffer = key;
				}

				if (num >= 1 && num <= 12 && formDateMonth) {
					const formattedVal = String(num).padStart(2, '0');
					formDateMonth.value = formattedVal;
					updateCombinedDate();
				}
			}
		}

		function initDateInputListeners() {
			if (formCompany) {
				formCompany.addEventListener('change', () => {
					if (formCompany.value) {
						localStorage.setItem('admin_last_selected_company', formCompany.value);
					}
				});
			}

			if (formDateDay) {
				formDateDay.addEventListener('input', () => {
					let val = formDateDay.value.replace(/\D/g, '').slice(0, 2);
					formDateDay.value = val;
					updateCombinedDate();
				});
			}

			if (formDateMonth) {
				formDateMonth.addEventListener('change', () => updateCombinedDate());
				formDateMonth.addEventListener('keydown', handleMonthKeydown);
			}

			if (formDateYear) {
				formDateYear.addEventListener('focus', () => {
					if (!formDateYear.value) {
						formDateYear.value = '2026';
						updateCombinedDate();
					}
				});
				formDateYear.addEventListener('input', () => {
					let val = formDateYear.value.replace(/\D/g, '').slice(0, 4);
					formDateYear.value = val;
					updateCombinedDate();
				});
			}

			if (btnClearDate) btnClearDate.addEventListener('click', () => setDateFields(''));
		}

		function showEmptyState(title: string, subtitle: string) {
			const existingEmptyState = designsGrid.querySelector('.empty-state');
			if (existingEmptyState) {
				existingEmptyState.remove();
			}

			const emptyState = document.createElement('div');
			emptyState.className = 'empty-state col-span-full pb-8 text-center text-[#E6E1E5]/50 bg-[#1D1B20] rounded-3xl border border-[#2B2930]';
			emptyState.innerHTML = `
				<img src="/no_data.webp" alt="No data" class="w-48 h-48 mx-auto mb-4 object-contain opacity-90" />
				<p class="font-semibold text-white">${title}</p>
				<p class="text-xs mt-1">${subtitle}</p>
			`;
			designsGrid.appendChild(emptyState);
		}

		function hideEmptyState() {
			designsGrid.querySelector('.empty-state')?.remove();
		}

		function renderDesigns() {
			const newCards = allDesigns.slice(displayedCount, displayedCount + ITEMS_PER_PAGE);
			
			newCards.forEach(design => {
				const card = createDesignCard(design);
				designsGrid.appendChild(card);
			});
			
			displayedCount += newCards.length;
			
			if (displayedCount >= allDesigns.length) {
				loadMoreContainer.classList.add('hidden');
			} else {
				loadMoreContainer.classList.remove('hidden');
			}

			// Check if we need to show the "no designs" message
			if (displayedCount === 0 && allDesigns.length === 0) {
				const noDesignsDiv = document.createElement('div');
				noDesignsDiv.className = 'col-span-full py-16 text-center text-[#E6E1E5]/40 bg-[#1D1B20] rounded-3xl border border-[#2B2930]';
				noDesignsDiv.innerHTML = `
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 mx-auto mb-3 opacity-30 text-primary">
					  <circle cx="12" cy="12" r="10"></circle>
					  <path d="M8 12l2 2 4-4"></path>
					</svg>
					<p class="font-medium text-white">No designs found</p>
					<p class="text-xs mt-1">Click "New" to add your first mockup.</p>
				`;
				designsGrid.appendChild(noDesignsDiv);
			}
			
			// Re-attach event listeners to new cards
			attachCardEventListeners();
		}

		function createDesignCard(design: any) {
			const formattedDate = (() => {
				if (!design.date || !design.date.trim()) return '';
				try {
					const parts = design.date.trim().split('-');
					if (parts.length === 3) {
						const year = parseInt(parts[0], 10);
						const month = parseInt(parts[1], 10) - 1;
						const day = parseInt(parts[2], 10);
						const d = new Date(year, month, day);
						if (!isNaN(d.getTime())) {
							return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
						}
					} else if (parts.length === 2) {
						const year = parseInt(parts[0], 10);
						const month = parseInt(parts[1], 10) - 1;
						const d = new Date(year, month, 1);
						if (!isNaN(d.getTime())) {
							return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
						}
					} else if (parts.length === 1 && parts[0].length === 4) {
						return parts[0];
					}
					const d = new Date(design.date);
					if (!isNaN(d.getTime())) {
						return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
					}
				} catch (e) {}
				return design.date;
			})();

			const cardWrapper = document.createElement('div');
			cardWrapper.innerHTML = `
				<article 
					class="design-card group border rounded-3xl p-4 transition-all duration-300 flex flex-col justify-between h-full border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer"
					data-id="${design.id}"
				>
					<div>
						<a 
							href="${design.imageUrl}"
							target="_blank"
							data-lightbox-src="${design.imageUrl}"
							data-lightbox-title="${design.title || design.company}"
							data-lightbox-subtitle="${design.title ? (design.company || '') : ''}"
							class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-0 border border-white/10 flex items-center justify-center cursor-pointer image-zoom-trigger block"
						>
							<div class="absolute inset-0 skeleton"></div>
							<img
								src="${design.imageUrl}"
								alt="${design.title || design.company}"
								class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-transform duration-500 relative z-10 opacity-0 transition-opacity duration-300"
								loading="lazy"
								decoding="async"
								onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
								onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
							/>
						</a>
					</div>

					<div class="design-card-footer mt-3.5 flex justify-between items-center text-xs">
						${formattedDate ? `
							<span class="text-white/40 flex items-center gap-1 font-medium whitespace-nowrap shrink-0">
								<Icon name="calendar" size={14} class="w-3.5 h-3.5" />
								${formattedDate}
							</span>
						` : '<span></span>'}
						${design.company ? `
							<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary">
								${design.company}
							</span>
						` : ''}
					</div>
				</article>
			`;

			return cardWrapper.firstElementChild as HTMLElement;
		}

		function attachCardEventListeners() {
			const designCards = designsGrid.querySelectorAll('.design-card') as NodeListOf<HTMLDivElement>;
			designCards.forEach(card => {
				card.addEventListener('click', (e) => {
					// If clicking the image link, let the CSS lightbox handle it and stop propagation
					if ((e.target as HTMLElement).closest('.image-zoom-trigger')) {
						return;
					}
					const id = card.getAttribute('data-id');
					const design = allDesigns.find((d: any) => d.id === id);
					if (design) {
						// Set URL query param
						const newUrl = new URL(window.location.href);
						newUrl.searchParams.set('id', design.id);
						window.history.pushState(null, '', newUrl.toString());
						
						selectDesign(design);
						openDrawer();
					}
				});
			});
		}

		loadMoreBtn.addEventListener('click', () => {
			ITEMS_PER_PAGE = allDesigns.length;
			renderDesigns();
		});

		// Handle URL state initialization
		function initFromUrl() {
			const urlParams = new URLSearchParams(window.location.search);
			const urlId = urlParams.get('id');

			if (urlId) {
				const design = allDesigns.find((d: any) => d.id === urlId);
				if (design) {
					selectDesign(design);
					openDrawer();
					return;
				}
			}
		}

		// --- Drawer Controls ---
		function openDrawer() {
			editorBackdrop.classList.remove('hidden');
			// Allow reflow for transition
			setTimeout(() => {
				editorBackdrop.classList.add('opacity-100');
				editorPanel.classList.remove('translate-x-full');
				editorPanel.classList.add('translate-x-0');
			}, 10);
		}

		function closeDrawer() {
			editorBackdrop.classList.remove('opacity-100');
			editorPanel.classList.remove('translate-x-0');
			editorPanel.classList.add('translate-x-full');

			// Clean query params on close
			const newUrl = new URL(window.location.href);
			newUrl.searchParams.delete('id');
			window.history.pushState(null, '', newUrl.toString());

			// Highlights cards off
			const designCards = designsGrid.querySelectorAll('.design-card') as NodeListOf<HTMLDivElement>;
			designCards.forEach(c => c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50'));

			setTimeout(() => {
				editorBackdrop.classList.add('hidden');
			}, 350);
		}

		function openFilterDrawer() {
			editorBackdrop.classList.remove('hidden');
			// Allow reflow for transition
			setTimeout(() => {
				editorBackdrop.classList.add('opacity-100');
				filterPanel.classList.remove('-translate-x-full');
				filterPanel.classList.add('translate-x-0');
			}, 10);
		}

		function closeFilterDrawer() {
			editorBackdrop.classList.remove('opacity-100');
			filterPanel.classList.remove('translate-x-0');
			filterPanel.classList.add('-translate-x-full');

			setTimeout(() => {
				editorBackdrop.classList.add('hidden');
			}, 350);
		}

		btnCancel.addEventListener('click', closeDrawer);
		if (btnCloseFilters) {
			btnCloseFilters.addEventListener('click', closeFilterDrawer);
		}
		editorBackdrop.addEventListener('click', () => {
			closeDrawer();
			closeFilterDrawer();
		});

		// --- Form State Management ---
		function setNewDesignState() {
			currentSelectedId = null;
			
			// Generate short safe random UUID/ID
			const shortId = (crypto && crypto.randomUUID) 
				? crypto.randomUUID().substring(0, 8) 
				: Math.random().toString(36).substring(2, 10);
			
			formId.value = `design_${shortId}`;
			formTitle.value = '';

			// Default company selection (cached for next additions)
			const comps = (window as any).companies || [];
			const cachedCompany = localStorage.getItem('admin_last_selected_company');
			if (cachedCompany && comps.includes(cachedCompany)) {
				formCompany.value = cachedCompany;
			} else if (comps.length > 0) {
				formCompany.value = comps[0];
			} else {
				formCompany.value = '';
			}
			
			// Date is optional and empty by default for new designs
			setDateFields('');

			// Reset image preview state
			selectedImageFile = null;
			imageFileInput.value = '';
			imagePreview.classList.add('hidden');
			imagePreview.src = '';
			dropZonePrompt.classList.remove('hidden');
			fileDetails.classList.add('hidden');

			// Adjust UI panel headers and buttons
			editorHeading.textContent = 'Create Design';
			editorSubheading.textContent = 'Add a new portfolio entry';
			btnDelete.classList.add('hidden');
			
			// Clear status alert
			clearStatus();
		}

		function selectDesign(design: any) {
			currentSelectedId = design.id;

			formId.value = design.id;
			formTitle.value = design.title || '';
			formCompany.value = design.company || '';
			setDateFields(design.date || '');

			// Setup preview image
			selectedImageFile = null;
			imageFileInput.value = '';
			if (design.imageUrl) {
				imagePreview.src = design.imageUrl;
				imagePreview.classList.remove('hidden');
				dropZonePrompt.classList.add('hidden');
				fileDetails.classList.add('hidden');
			} else {
				imagePreview.classList.add('hidden');
				imagePreview.src = '';
				dropZonePrompt.classList.remove('hidden');
				fileDetails.classList.add('hidden');
			}

			// Highlights active design card in list
			const designCards = designsGrid.querySelectorAll('.design-card') as NodeListOf<HTMLDivElement>;
			designCards.forEach(c => {
				if (c.getAttribute('data-id') === design.id) {
					c.classList.add('ring-2', 'ring-primary/60', 'border-primary/50');
				} else {
					c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50');
				}
			});

			editorHeading.textContent = 'Edit Design';
			editorSubheading.textContent = 'Modify your mockup credentials';
			btnDelete.classList.remove('hidden');

			clearStatus();
		}

		// --- Populating selects dropdowns ---
		
		// --- Populating selects dropdowns ---
		
		function populateCompanyDropdown(selectedValue = '') {
			const cachedCompany = localStorage.getItem('admin_last_selected_company');
			const activeValue = selectedValue || formCompany.value || cachedCompany || '';
			formCompany.innerHTML = '';

			const filterActiveValue = filterCompany ? filterCompany.value : '';
			if (filterCompany) {
				filterCompany.innerHTML = `
					<option value="">All Companies</option>
				`;
			}
			
			const companies = (window as any).companies || [];
			companies.forEach((comp: string) => {
				const opt = document.createElement('option');
				opt.value = comp;
				opt.textContent = comp;
				formCompany.appendChild(opt);

				if (filterCompany) {
					const filterOpt = document.createElement('option');
					filterOpt.value = comp;
					filterOpt.textContent = comp;
					filterCompany.appendChild(filterOpt);
				}
			});

			if (companies.includes(activeValue)) {
				formCompany.value = activeValue;
			} else if (cachedCompany && companies.includes(cachedCompany)) {
				formCompany.value = cachedCompany;
			} else if (companies.length > 0) {
				formCompany.value = companies[0];
			}
			if (filterCompany && companies.includes(filterActiveValue)) {
				filterCompany.value = filterActiveValue;
			}
		}

		// --- Companies management modal logic ---

		function renderModalCompanies() {
			if (!modalCompaniesList) return;
			modalCompaniesList.innerHTML = '';

			if (modalCompanies.length === 0) {
				modalCompaniesList.innerHTML = '<p class="text-xs text-[#E6E1E5]/50 text-center py-6">No companies. Create one below.</p>';
				return;
			}

			modalCompanies.forEach((comp, index) => {
				const designCount = allDesigns.filter((d: any) => d.company === comp.originalName).length;

				const row = document.createElement('div');
				row.className = 'flex items-center gap-2.5 bg-[#211F26] p-2.5 rounded-xl border border-[#2B2930]';
				
				row.innerHTML = `
					<div class="flex flex-col gap-1 shrink-0">
						<button 
							type="button" 
							class="btn-move-up-comp p-1 rounded hover:bg-[#141218] text-[#E6E1E5]/60 hover:text-primary transition-all disabled:opacity-20 cursor-pointer"
							data-index="${index}"
							${index === 0 ? 'disabled' : ''}
							title="Move Up"
						>
							<Icon name="chevron_up" size={14} class="w-3.5 h-3.5" />
						</button>
						<button 
							type="button" 
							class="btn-move-down-comp p-1 rounded hover:bg-[#141218] text-[#E6E1E5]/60 hover:text-primary transition-all disabled:opacity-20 cursor-pointer"
							data-index="${index}"
							${index === modalCompanies.length - 1 ? 'disabled' : ''}
							title="Move Down"
						>
							<Icon name="chevron_down" size={14} class="w-3.5 h-3.5" />
						</button>
					</div>
					<div class="flex-grow min-w-0">
						<input 
							type="text" 
							value="${comp.currentName}" 
							class="company-input-field w-full bg-[#141218] border border-[#2B2930] rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-primary transition-colors font-medium"
							data-index="${index}"
						/>
						<span class="text-[9px] text-[#E6E1E5]/40 ml-1 mt-0.5 block">${designCount} associated designs</span>
					</div>
					<button 
						type="button" 
						class="btn-delete-comp p-2 rounded-lg bg-[#DB4437]/10 border border-[#DB4437]/20 hover:bg-[#DB4437] text-[#DB4437] hover:text-white transition-all shrink-0 cursor-pointer"
						data-index="${index}"
						title="Delete Company"
					>
						<Icon name="trash" size={16} class="w-4 h-4" />
					</button>
				`;

				modalCompaniesList.appendChild(row);
			});

			modalCompaniesList.querySelectorAll('.btn-move-up-comp').forEach(btn => {
				btn.addEventListener('click', () => {
					const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
					moveCompanyItem(idx, -1);
				});
			});

			modalCompaniesList.querySelectorAll('.btn-move-down-comp').forEach(btn => {
				btn.addEventListener('click', () => {
					const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
					moveCompanyItem(idx, 1);
				});
			});

			modalCompaniesList.querySelectorAll('.btn-delete-comp').forEach(btn => {
				btn.addEventListener('click', () => {
					const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
					const item = modalCompanies[idx];
					if (item.originalName) {
						const count = ((window as any).designs || []).filter((d: any) => d.company === item.originalName).length;
						if (count > 0) {
							const confirmDelete = confirm(`Warning: "${item.originalName}" is associated with ${count} designs. Do you still want to delete it?`);
							if (!confirmDelete) return;
						}
					}
					modalCompanies.splice(idx, 1);
					renderModalCompanies();
				});
			});

			modalCompaniesList.querySelectorAll('.company-input-field').forEach(input => {
				input.addEventListener('input', (e) => {
					const idx = parseInt(input.getAttribute('data-index') || '0', 10);
					modalCompanies[idx].currentName = (e.target as HTMLInputElement).value;
				});
			});
		}

		function moveCompanyItem(index: number, shift: number) {
			const targetIndex = index + shift;
			if (targetIndex < 0 || targetIndex >= modalCompanies.length) return;
			
			const temp = modalCompanies[index];
			modalCompanies[index] = modalCompanies[targetIndex];
			modalCompanies[targetIndex] = temp;
			renderModalCompanies();
		}

		btnEditCompanies.addEventListener('click', () => {
			const currentComps = (window as any).companies || [];
			modalCompanies = currentComps.map((name: string) => ({
				originalName: name,
				currentName: name
			}));
			companiesModal.classList.remove('hidden');
			renderModalCompanies();
		});

		closeCompaniesModal.addEventListener('click', () => {
			companiesModal.classList.add('hidden');
		});

		if (closeCompaniesModalBtn) {
			closeCompaniesModalBtn.addEventListener('click', () => {
				companiesModal.classList.add('hidden');
			});
		}

		// Add Company
		btnAddCompany.addEventListener('click', () => {
			const newName = newCompanyInput.value.trim();
			if (!newName) return;
			
			if (modalCompanies.some(c => c.currentName.toLowerCase() === newName.toLowerCase())) {
				if ((window as any).showToast) {
					(window as any).showToast('Company already exists!', 'warning');
				}
				return;
			}

			modalCompanies.push({ originalName: '', currentName: newName });
			newCompanyInput.value = '';
			renderModalCompanies();
		});

		// Save Companies Changes
		btnSaveCompanies.addEventListener('click', async () => {
			const cleanComps = modalCompanies.map(c => ({
				originalName: c.originalName,
				currentName: c.currentName.trim()
			})).filter(c => c.currentName !== '');

			btnSaveCompanies.disabled = true;
			btnSaveCompanies.textContent = 'Saving...';

			const companiesList = cleanComps.map(c => c.currentName);
			const renames: Record<string, string> = {};
			
			cleanComps.forEach(c => {
				if (c.originalName && c.originalName !== c.currentName) {
					renames[c.originalName] = c.currentName;
				}
			});

			try {
				const formData = new FormData();
				formData.append('action', 'save_companies');
				formData.append('companies', JSON.stringify(companiesList));
				formData.append('renames', JSON.stringify(renames));

				const res = await fetch('/admin/admin_designs_api', {
					method: 'POST',
					body: formData
				});
				const data = await res.json();

				if (res.ok && data.success) {
					(window as any).companies = companiesList;
					
					Object.keys(renames).forEach(oldComp => {
						const newComp = renames[oldComp];
						allDesigns.forEach((d: any) => {
							if (d.company === oldComp) d.company = newComp;
						});
					});

					// Update DOM cards displaying company names
					document.querySelectorAll('.design-card').forEach(card => {
						const cardId = card.getAttribute('data-id');
						const design = allDesigns.find((d: any) => d && d.id === cardId);
						if (design) {
							// Update company pill if it exists or delete it
							const footer = card.querySelector('.design-card-footer');
							if (footer) {
								let companySpan = footer.querySelector('.company-pill') as HTMLElement | undefined;
								if (design.company) {
									if (!companySpan) {
										companySpan = document.createElement('span');
										companySpan.className = 'company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary';
										footer.appendChild(companySpan);
									}
									companySpan.textContent = design.company;
								} else if (companySpan) {
									companySpan.remove();
								}
							}
						}
					});

					populateCompanyDropdown();
					companiesModal.classList.add('hidden');
					if ((window as any).showToast) {
						(window as any).showToast('Companies updated successfully!', 'success');
					}
				} else {
					if ((window as any).showToast) {
						(window as any).showToast(data.error || 'Failed to save companies.', 'error');
					}
				}
			} catch (err: any) {
				if ((window as any).showToast) {
					(window as any).showToast('Error saving companies: ' + (err?.message || err), 'error');
				}
			} finally {
				btnSaveCompanies.disabled = false;
				btnSaveCompanies.textContent = 'Save Changes';
			}
		});

		// --- Search & Filter Logic ---
		function applyFilters() {
			const query = searchInput.value.toLowerCase().trim();
			const selectedCompany = filterCompany.value;
			const selectedYear = filterYear.value;
			const startDateVal = filterStartDate.value;
			const endDateVal = filterEndDate.value;

			let activeFiltersCount = 0;
			if (selectedCompany) activeFiltersCount++;
			if (selectedYear) activeFiltersCount++;
			if (startDateVal) activeFiltersCount++;
			if (endDateVal) activeFiltersCount++;

			// Update badge and clear button state
			if (activeFiltersCount > 0) {
				filterBadge.textContent = String(activeFiltersCount);
				filterBadge.classList.remove('hidden');
				btnClearFilters.classList.remove('opacity-50', 'cursor-not-allowed');
				btnClearFilters.disabled = false;
				btnFilterToggle.classList.add('border-primary', 'bg-primary/5');
			} else {
				filterBadge.classList.add('hidden');
				btnClearFilters.classList.add('opacity-50', 'cursor-not-allowed');
				btnClearFilters.disabled = true;
				btnFilterToggle.classList.remove('border-primary', 'bg-primary/5');
			}

			// Parse date limits if provided
			const startDate = startDateVal ? new Date(startDateVal) : null;
			const endDate = endDateVal ? new Date(endDateVal) : null;

			const designCards = designsGrid.querySelectorAll('.design-card') as NodeListOf<HTMLDivElement>;
			designCards.forEach(card => {
				const cardId = card.getAttribute('data-id') || '';
				const design = allDesigns.find((d: any) => d.id === cardId);
				if (!design) return;

				const title = (design.title || '').toLowerCase();
				const company = (design.company || '');

				const matchesSearch = !query || 
					title.includes(query) || 
					company.toLowerCase().includes(query);

				let matchesCompany = true;
				if (selectedCompany !== '') {
					matchesCompany = design.company === selectedCompany;
				}

				let matchesYear = true;
				if (selectedYear !== '') {
					if (typeof design.date === 'string' && design.date.includes('-')) {
						const year = design.date.split('-')[0];
						matchesYear = year === selectedYear;
					} else {
						matchesYear = false;
					}
				}

				let matchesDateInterval = true;
				if (design.date) {
					const designDate = new Date(design.date);
					if (startDate && designDate < startDate) {
						matchesDateInterval = false;
					}
					if (endDate && designDate > endDate) {
						matchesDateInterval = false;
					}
				} else if (startDate || endDate) {
					matchesDateInterval = false;
				}

				if (matchesSearch && matchesCompany && matchesYear && matchesDateInterval) {
					card.classList.remove('hidden');
				} else {
					card.classList.add('hidden');
				}
			});

			const visibleCards = Array.from(designCards).filter(card => !card.classList.contains('hidden'));
			if (visibleCards.length === 0) {
				showEmptyState('No designs match your filters', 'Try clearing the filters or searching for something else.');
			} else {
				hideEmptyState();
			}
		}

		// Filter Toggle Panel
		btnFilterToggle.addEventListener('click', () => {
			openFilterDrawer();
		});

		// Clear Filters
		btnClearFilters.addEventListener('click', () => {
			filterCompany.value = '';
			filterYear.value = '';
			filterStartDate.value = '';
			filterEndDate.value = '';
			applyFilters();
		});

		// Event Listeners for Filters
		filterCompany.addEventListener('change', applyFilters);
		filterYear.addEventListener('change', applyFilters);
		filterStartDate.addEventListener('change', applyFilters);
		filterEndDate.addEventListener('change', applyFilters);
		searchInput.addEventListener('input', applyFilters);

		btnNewDesign.addEventListener('click', () => {
			setNewDesignState();
			openDrawer();
		});

		// --- Image Drop Zone Controls ---
		imageDropZone.addEventListener('click', () => imageFileInput.click());

		imageFileInput.addEventListener('change', () => {
			const file = imageFileInput.files?.[0];
			if (file) handleFileSelection(file);
		});

		imageDropZone.addEventListener('dragover', (e) => {
			e.preventDefault();
			imageDropZone.classList.add('border-primary', 'bg-primary/5');
		});

		imageDropZone.addEventListener('dragleave', () => {
			imageDropZone.classList.remove('border-primary', 'bg-primary/5');
		});

		imageDropZone.addEventListener('drop', (e) => {
			e.preventDefault();
			imageDropZone.classList.remove('border-primary', 'bg-primary/5');
			const file = e.dataTransfer?.files?.[0];
			if (file) handleFileSelection(file);
		});

		function processAndCompressImage(file: File): Promise<File> {
			return new Promise((resolve, reject) => {
				const img = new Image();
				img.src = URL.createObjectURL(file);
				
				img.onload = () => {
					URL.revokeObjectURL(img.src);

					const maxDim = 1024;
					let width = img.width;
					let height = img.height;
					const needsResize = width > maxDim || height > maxDim;

					if (needsResize) {
						if (width > height) {
							height = Math.round((height * maxDim) / width);
							width = maxDim;
						} else {
							width = Math.round((width * maxDim) / height);
							height = maxDim;
						}
					}

					const canvas = document.createElement('canvas');
					canvas.width = width;
					canvas.height = height;
					const ctx = canvas.getContext('2d');
					if (!ctx) {
						resolve(file);
						return;
					}

					ctx.drawImage(img, 0, 0, width, height);

					canvas.toBlob((blob) => {
						if (blob) {
							const baseName = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
							const newFile = new File([blob], `${baseName}.webp`, {
								type: 'image/webp',
								lastModified: Date.now()
							});
							resolve(newFile);
						} else {
							resolve(file);
						}
					}, 'image/webp', 0.8);
				};

				img.onerror = () => {
					reject(new Error('Failed to load image file for processing.'));
				};
			});
		}

		async function handleFileSelection(file: File) {
			const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
			if (!allowedTypes.includes(file.type)) {
				showStatus('error', 'Only JPEG, PNG, or WebP files are allowed.');
				return;
			}
			if (file.size > 10 * 1024 * 1024) {
				showStatus('error', 'Image size must be under 10MB.');
				return;
			}

			showStatus('success', 'Optimizing and converting image to WebP...');

			try {
				const processedFile = await processAndCompressImage(file);
				if (processedFile.size > 800 * 1024) {
					showStatus('error', `Optimized image is too large (${(processedFile.size / 1024).toFixed(0)}KB). Please upload a smaller or less complex image.`);
					selectedImageFile = null;
					return;
				}
				selectedImageFile = processedFile;

				const formatBytes = (bytes: number) => {
					if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
					return `${(bytes / 1024).toFixed(0)} KB`;
				};

				const oldSize = formatBytes(file.size);
				const newSize = formatBytes(processedFile.size);
				const diffPercent = Math.round(((processedFile.size - file.size) / file.size) * 100);
				const diffStr = diffPercent > 0 ? `+${diffPercent}%` : `${diffPercent}%`;

				showStatus('success', `Image converted: ${oldSize} → ${newSize} (${diffStr})`);

				// Generate locally readable preview URL
				const reader = new FileReader();
				reader.onload = (e) => {
					if (e.target?.result) {
						imagePreview.src = e.target.result as string;
						imagePreview.classList.remove('hidden');
						dropZonePrompt.classList.add('hidden');
						fileDetails.classList.remove('hidden');
						fileDetails.textContent = `✓ ${processedFile.name} (${oldSize} → ${newSize}, ${diffStr})`;
					}
				};
				reader.readAsDataURL(processedFile);
			} catch (err: any) {
				showStatus('error', err.message || 'Failed to process image.');
			}
		}

		// --- CRUD Network Handlers ---
		
		// SAVE (Create or Update)
		designForm.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Image validation for new creation
			if (!currentSelectedId && !selectedImageFile) {
				showStatus('error', 'Please upload a mockup image for the new design.');
				return;
			}

			// Lock buttons
			setFormLoading(true, 'Saving...');

			const formData = new FormData();
			formData.append('action', 'save');
			formData.append('id', formId.value);
			formData.append('title', formTitle.value);
			formData.append('company', formCompany.value);
			formData.append('date', formDate.value);

			if (formCompany.value) {
				localStorage.setItem('admin_last_selected_company', formCompany.value);
			}

			if (selectedImageFile) {
				formData.append('image', selectedImageFile);
			}

			try {
				const response = await fetch('/admin/admin_designs_api', {
					method: 'POST',
					body: formData
				});
				const result = await response.json();

				if (response.ok && result.success && result.design) {
					const savedDesign = result.design;
					const existingIndex = allDesigns.findIndex((d: any) => d && d.id === savedDesign.id);

					if (existingIndex !== -1) {
						// Update existing design in state array
						allDesigns[existingIndex] = savedDesign;

						// Update existing card in DOM
						const existingCard = designsGrid.querySelector(`.design-card[data-id="${savedDesign.id}"]`);
						const updatedCard = createDesignCard(savedDesign);
						updatedCard.addEventListener('click', () => {
							selectDesign(savedDesign);
							openDrawer();
						});

						if (existingCard) {
							existingCard.replaceWith(updatedCard);
						}
						showStatus('success', 'Design saved successfully!');
					} else {
						// Add new design to state array
						allDesigns.unshift(savedDesign);

						// Remove empty state if present
						const emptyState = designsGrid.querySelector('.empty-state');
						if (emptyState) emptyState.remove();

						// Insert new card at top of grid
						const newCard = createDesignCard(savedDesign);
						newCard.addEventListener('click', () => {
							selectDesign(savedDesign);
							openDrawer();
						});
						designsGrid.prepend(newCard);

						showStatus('success', 'Design created successfully!');
					}

					setFormLoading(false);
					closeDrawer();
					setNewDesignState();
				} else {
					showStatus('error', result.error || 'Failed to save design.');
					setFormLoading(false);
				}
			} catch (err: any) {
				console.error('Error saving design:', err);
				showStatus('error', 'A network error occurred. Please try again.');
				setFormLoading(false);
			}
		});

		// DELETE
		btnDelete.addEventListener('click', async () => {
			if (!currentSelectedId) return;

			const confirmed = confirm('Are you sure you want to delete this design project? This action will permanently remove the record and its cover image.');
			if (!confirmed) return;

			setFormLoading(true, 'Deleting...');

			const formData = new FormData();
			formData.append('action', 'delete');
			formData.append('id', currentSelectedId);

			try {
				const response = await fetch('/admin/admin_designs_api', {
					method: 'POST',
					body: formData
				});
				const result = await response.json();

				if (response.ok && result.success) {
					// Remove from state array
					allDesigns = allDesigns.filter((d: any) => d && d.id !== currentSelectedId);

					// Remove card from DOM
					const cardToRemove = designsGrid.querySelector(`.design-card[data-id="${currentSelectedId}"]`);
					if (cardToRemove) cardToRemove.remove();

					// If grid is empty, show empty state
					if (allDesigns.length === 0) {
						showEmptyState('No designs found', 'Create a new design entry to get started.');
					}

					showStatus('success', 'Design deleted successfully!');
					setFormLoading(false);
					closeDrawer();
					setNewDesignState();
				} else {
					showStatus('error', result.error || 'Failed to delete design.');
					setFormLoading(false);
				}
			} catch (err: any) {
				console.error('Error deleting design:', err);
				showStatus('error', 'A network error occurred. Please try again.');
				setFormLoading(false);
			}
		});

		// --- Helper Utilities ---
		function showStatus(type: 'success' | 'error', message: string) {
			if ((window as any).showToast) {
				(window as any).showToast(message, type);
			}
			if (formStatus) {
				formStatus.classList.remove('hidden', 'bg-[#0F9D58]/10', 'text-[#0F9D58]', 'border-[#0F9D58]/30', 'bg-[#DB4437]/10', 'text-[#DB4437]', 'border-[#DB4437]/30');
				if (type === 'success') {
					formStatus.classList.add('bg-[#0F9D58]/10', 'text-[#0F9D58]', 'border', 'border-[#0F9D58]/30');
				} else {
					formStatus.classList.add('bg-[#DB4437]/10', 'text-[#DB4437]', 'border', 'border-[#DB4437]/30');
				}
				formStatus.textContent = message;
				formStatus.classList.remove('hidden');
			}
		}

		function clearStatus() {
			formStatus.classList.add('hidden');
			formStatus.textContent = '';
		}

		function setFormLoading(loading: boolean, label = 'Save') {
			if (loading) {
				btnSave.disabled = true;
				btnCancel.disabled = true;
				btnDelete.disabled = true;
				saveBtnText.textContent = label;
				btnSave.classList.add('opacity-75', 'cursor-not-allowed');
			} else {
				btnSave.disabled = false;
				btnCancel.disabled = false;
				btnDelete.disabled = false;
				saveBtnText.textContent = 'Save';
				btnSave.classList.remove('opacity-75', 'cursor-not-allowed');
			}
		}

		// --- Keyboard Shortcuts ---
		let highlightedCardIndex = -1;

		function updateCardHighlighting(cards: HTMLElement[]) {
			cards.forEach((c, idx) => {
				if (idx === highlightedCardIndex) {
					c.classList.add('ring-2', 'ring-primary', 'border-primary/50');
					c.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
				} else {
					c.classList.remove('ring-2', 'ring-primary', 'border-primary/50');
				}
			});
		}

		document.addEventListener('keydown', (e: KeyboardEvent) => {
			const activeEl = document.activeElement as HTMLElement | null;
			const isEditingText = activeEl && (
				['INPUT', 'TEXTAREA', 'SELECT'].includes(activeEl.tagName) ||
				activeEl.isContentEditable
			);

			// 0. [/] key: Focus Search Bar (when not editing text)
			if (e.key === '/' && !isEditingText) {
				e.preventDefault();
				if (searchInput) {
					searchInput.focus();
					searchInput.select();
				}
				return;
			}

			// 1. [Esc] key: Close lightbox, active modals, drawers, or blur active inputs
			if (e.key === 'Escape') {
				if (window.location.hash === '#global-lightbox') {
					window.location.hash = '#';
					return;
				}
				if (companiesModal && !companiesModal.classList.contains('hidden')) {
					closeCompaniesModal.click();
					return;
				}
				if (filterPanel && filterPanel.classList.contains('translate-x-0')) {
					closeFilterDrawer();
					return;
				}
				if (editorPanel && editorPanel.classList.contains('translate-x-0')) {
					closeDrawer();
					return;
				}
				if (isEditingText) {
					activeEl?.blur();
					return;
				}
			}

			// Numeric Date fields ArrowUp/ArrowDown adjustment
			if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && activeEl && activeEl.tagName === 'INPUT') {
				const inputEl = activeEl as HTMLInputElement;
				const isNumericInput = inputEl.inputMode === 'numeric' || inputEl.type === 'number' || inputEl.id === 'form-date-day' || inputEl.id === 'form-date-year';
				if (isNumericInput) {
					e.preventDefault();
					let val = parseInt(inputEl.value, 10);
					const delta = e.key === 'ArrowUp' ? 1 : -1;

					if (inputEl.id === 'form-date-day') {
						if (isNaN(val)) val = delta > 0 ? 1 : 31;
						else val = val + delta;
						if (val > 31) val = 1;
						if (val < 1) val = 31;
						inputEl.value = String(val).padStart(2, '0');
					} else if (inputEl.id === 'form-date-year') {
						const currentYear = new Date().getFullYear();
						if (isNaN(val)) val = currentYear;
						else val = val + delta;
						inputEl.value = String(val);
					} else {
						if (isNaN(val)) val = 0;
						else val = val + delta;
						inputEl.value = String(val);
					}
					inputEl.dispatchEvent(new Event('input', { bubbles: true }));
					inputEl.dispatchEvent(new Event('change', { bubbles: true }));
					return;
				}
			}

			// 2. [CapsLock] key: When editor panel drawer is open, trigger image chooser
			if (e.key === 'CapsLock' && editorPanel && editorPanel.classList.contains('translate-x-0')) {
				e.preventDefault();
				if (imageFileInput) imageFileInput.click();
				return;
			}

			// Do not trigger letter/action shortcuts while typing in an input field
			if (isEditingText) return;

			// 3. [L] key: Toggle / Open Image Lightbox
			if (e.key === 'l' || e.key === 'L') {
				e.preventDefault();
				if (window.location.hash === '#global-lightbox') {
					window.location.hash = '#';
					return;
				}
				if (editorPanel && editorPanel.classList.contains('translate-x-0') && currentSelectedId) {
					const card = designsGrid.querySelector(`.design-card[data-id="${currentSelectedId}"]`);
					const trigger = card?.querySelector('[data-lightbox-src]') as HTMLElement;
					if (trigger) trigger.click();
					return;
				}
				const visibleCards = Array.from(designsGrid.querySelectorAll('.design-card:not(.hidden)')) as HTMLElement[];
				if (visibleCards.length > 0) {
					const targetCard = highlightedCardIndex >= 0 ? visibleCards[highlightedCardIndex] : visibleCards[0];
					const trigger = targetCard?.querySelector('[data-lightbox-src]') as HTMLElement;
					if (trigger) trigger.click();
				}
				return;
			}

			// 4. [Arrow Keys & Enter]: Card grid navigation
			if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Enter'].includes(e.key)) {
				const isDrawerOpen = (editorPanel && editorPanel.classList.contains('translate-x-0')) ||
				                     (filterPanel && filterPanel.classList.contains('translate-x-0'));
				if (!isDrawerOpen) {
					const visibleCards = Array.from(designsGrid.querySelectorAll('.design-card:not(.hidden)')) as HTMLElement[];
					if (visibleCards.length > 0) {
						if (e.key === 'Enter' && highlightedCardIndex >= 0 && highlightedCardIndex < visibleCards.length) {
							e.preventDefault();
							visibleCards[highlightedCardIndex].click();
							return;
						}

						if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) {
							e.preventDefault();
							const cols = window.innerWidth >= 768 ? 5 : window.innerWidth >= 640 ? 2 : 1;

							if (highlightedCardIndex < 0) {
								highlightedCardIndex = 0;
							} else if (e.key === 'ArrowRight') {
								highlightedCardIndex = (highlightedCardIndex + 1) % visibleCards.length;
							} else if (e.key === 'ArrowLeft') {
								highlightedCardIndex = (highlightedCardIndex - 1 + visibleCards.length) % visibleCards.length;
							} else if (e.key === 'ArrowDown') {
								highlightedCardIndex = Math.min(visibleCards.length - 1, highlightedCardIndex + cols);
							} else if (e.key === 'ArrowUp') {
								highlightedCardIndex = Math.max(0, highlightedCardIndex - cols);
							}

							updateCardHighlighting(visibleCards);
							return;
						}
					}
				}
			}

			// 5. [N] key: Open New Design panel
			if (e.key === 'n' || e.key === 'N') {
				e.preventDefault();
				setNewDesignState();
				openDrawer();
				return;
			}

			// 6. [F] key: Open / close Filter drawer panel
			if (e.key === 'f' || e.key === 'F') {
				e.preventDefault();
				if (filterPanel && filterPanel.classList.contains('translate-x-0')) {
					closeFilterDrawer();
				} else {
					openFilterDrawer();
				}
				return;
			}

			// 7. [Delete] key: Delete card item if editor panel is open with an active item
			if (e.key === 'Delete') {
				if (editorPanel && editorPanel.classList.contains('translate-x-0') && currentSelectedId && !btnDelete.classList.contains('hidden')) {
					e.preventDefault();
					btnDelete.click();
					return;
				}
			}
		});
	});
</script>