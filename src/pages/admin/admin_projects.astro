		function renderBlocksList() {
			if (!blocksListContainer) return;
			
			if (currentBlocks.length === 0) {
				blocksListContainer.innerHTML = `
					<div class="py-8 text-center border border-dashed border-[#2B2930] rounded-2xl bg-[#141218]">
						<p class="text-xs font-semibold text-[#E6E1E5]/60">No content blocks added yet</p>
						<p class="text-[10px] text-[#E6E1E5]/40 mt-1">Use the icons above to add headings, text, or images.</p>
					</div>
				`;
				return;
			}

			blocksListContainer.innerHTML = '';
			if (dragDropLine) blocksListContainer.appendChild(dragDropLine);

			currentBlocks.forEach((block, index) => {
				const blockCard = document.createElement('div');
				blockCard.className = 'p-3 rounded-2xl bg-[#141218] border border-[#2B2930] relative transition-all group';
				blockCard.setAttribute('draggable', 'true');
				blockCard.setAttribute('data-index', String(index));

				// Drag events
				blockCard.addEventListener('dragstart', (e) => {
					draggedBlockIndex = index;
					blockCard.classList.add('opacity-30');
					if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
				});

				blockCard.addEventListener('dragend', () => {
					draggedBlockIndex = null;
					dropTargetIndex = null;
					blockCard.classList.remove('opacity-30');
					if (dragDropLine) dragDropLine.classList.add('hidden');
				});

				blockCard.addEventListener('dragover', (e) => {
					e.preventDefault();
					if (draggedBlockIndex === null) return;
					
					const rect = blockCard.getBoundingClientRect();
					const midY = rect.top + rect.height / 2;
					if (e.clientY < midY) {
						dropTargetIndex = index;
						blockCard.parentNode?.insertBefore(dragDropLine, blockCard);
					} else {
						dropTargetIndex = index + 1;
						blockCard.parentNode?.insertBefore(dragDropLine, blockCard.nextSibling);
					}
					if (dragDropLine) dragDropLine.classList.remove('hidden');
				});

				blockCard.addEventListener('drop', (e) => {
					e.preventDefault();
					if (dragDropLine) dragDropLine.classList.add('hidden');
					if (draggedBlockIndex !== null && dropTargetIndex !== null) {
						let targetIdx = dropTargetIndex;
						if (draggedBlockIndex < targetIdx) targetIdx--;
						const moved = currentBlocks.splice(draggedBlockIndex, 1)[0];
						currentBlocks.splice(targetIdx, 0, moved);
						updateBlocksUI();
					}
				});

				// Card Body Layout with 6-dot handle inside on left, remove icon top right
