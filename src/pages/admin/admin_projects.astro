---
import BackgroundBaseLayout from "../../layouts/BackgroundBaseLayout.astro";
import AdminLayout from "../../components/admin/AdminLayout.astro";
import AdminNavDock from "../../components/admin/AdminNavDock.astro";
import GlobalLightbox from "../../components/GlobalLightbox.astro";
import { getFirebaseAdminDb } from "../../lib/server/firebase-admin";
import Icon from "../../components/Icon.astro";
import AdminControlsStrip from "../../components/admin/AdminControlsStrip.astro";

// Extra safety: double-check that the middleware successfully set Astro.locals.adminEmail
const adminEmail = Astro.locals.adminEmail;
if (!adminEmail) return Astro.redirect("/admin/admin_login");

let projects: any[] = [];
let fields: string[] = ['Web Development', 'Mobile App', 'UI/UX Design', 'Full-Stack', 'AI / ML'];
let technologiesList: string[] = [];
let years: string[] = [];
let errorMsg = '';

try {
	const db = getFirebaseAdminDb();
	
	const [fieldsDoc, snapshot] = await Promise.all([
		db.collection("configuration").doc("projects_fields").get(),
		db.collection("projects").orderBy("date", "desc").get()
	]);

	if (fieldsDoc.exists) {
		const data = fieldsDoc.data();
		if (Array.isArray(data?.fields) && data.fields.length > 0) {
			fields = data.fields;
		}
	} else {
		await db.collection("configuration").doc("projects_fields").set({ fields });
	}

	projects = snapshot.docs.map(doc => ({
		id: doc.id,
		...doc.data()
	}));

	// Extract unique sorted technologies
	const techSet = new Set<string>();
	projects.forEach(p => {
		if (Array.isArray(p.technologies)) {
			p.technologies.forEach((t: string) => t && techSet.add(t));
		}
	});
	technologiesList = Array.from(techSet).sort((a, b) => a.localeCompare(b));
	
	// Extract unique sorted years from date (YYYY-MM)
	years = [...new Set(projects.map(p => {
		if (typeof p.date === 'string' && p.date.includes('-')) {
			return p.date.split('-')[0];
		}
		return null;
	}).filter(Boolean) as string[])].sort((a, b) => b.localeCompare(a));
} catch (error: any) {
	console.warn("Failed to fetch projects from Firestore:", error);
	errorMsg = "Degraded mode: Firestore is not configured or offline.";
}
---

<BackgroundBaseLayout title="Projects Workspace">
	<AdminLayout title="Projects">
		<div class="relative min-h-[calc(100vh-140px)]">
			
			<!-- Main Content Area -->
			<div class="space-y-6">
			
			<!-- Top Controls Strip -->
			<AdminControlsStrip
				searchId="search-input"
				searchPlaceholder="Search projects by title, technology..."
				filterToggleId="btn-filter-toggle"
				filterBadgeId="filter-badge"
				newBtnId="btn-new-project"
				newBtnLabel="New Project"
			/>

			{errorMsg && (
				<div class="p-4 rounded-2xl bg-[#DB4437]/10 border border-[#DB4437]/30 text-[#DB4437] text-sm flex items-center gap-2.5">
					<Icon name="alert" size={20} class="w-5 h-5 shrink-0" />
					<span>{errorMsg}</span>
				</div>
			)}

			<!-- Grid of Projects -->
			<div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
				{/* Cards will be dynamically rendered via JS */}
			</div>

			<!-- Load More Button -->
			<div id="load-more-container" class="flex justify-center">
				<button
					id="btn-load-more"
					class="px-6 py-2.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer"
				>
					Load More
				</button>
			</div>
		</div>

			<!-- Drawer Backdrop -->
			<div
				id="editor-backdrop"
				class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] transition-opacity duration-300 opacity-0"
			></div>

			<!-- Sliding Filter Drawer (Starts offscreen translated left) -->
			<div
				id="filter-panel"
				class="fixed top-0 left-0 h-full w-full sm:w-[360px] bg-[#1D1B20] border-r border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform -translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-6">
					<div class="flex items-center justify-between border-b border-[#2B2930]/60 pb-4">
						<h2 class="text-base font-bold text-white flex items-center gap-2">
							<Icon name="filter" size={18} class="text-primary" />
							Filter Projects
						</h2>
						<button
							id="btn-close-filters"
							class="p-1.5 rounded-xl hover:bg-white/10 text-[#E6E1E5]/60 hover:text-white transition-colors cursor-pointer text-sm font-semibold"
						>
							&times;
						</button>
					</div>

					<div class="space-y-4">
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Technology</label>
							<select
								id="filter-technology"
								class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Technologies</option>
								{technologiesList.map(t => (
									<option value={t}>{t}</option>
								))}
							</select>
						</div>

						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Year</label>
							<select
								id="filter-year"
								class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<option value="">All Years</option>
								{years.map(y => (
									<option value={y}>{y}</option>
								))}
							</select>
						</div>
					</div>
				</div>

				<div class="pt-4 border-t border-[#2B2930]">
					<button
						id="btn-clear-filters"
						disabled
						class="w-full py-2.5 px-4 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-xs transition-all duration-300 opacity-50 cursor-not-allowed"
					>
						Reset All Filters
					</button>
				</div>
			</div>

			<!-- Sliding Drawer Editor Panel (Right Side Panel) -->
			<div
				id="editor-panel"
				class="fixed top-0 right-0 h-full w-full sm:w-[480px] bg-[#1D1B20] border-l border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform translate-x-full z-[70] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-6">
					<!-- Drawer Header -->
					<div class="flex items-center justify-between border-b border-[#2B2930]/60 pb-4">
						<div>
							<h2 id="editor-heading" class="text-base font-bold text-white">Create Project</h2>
							<p id="editor-subheading" class="text-xs text-[#E6E1E5]/50 mt-0.5">Add a new showcase project</p>
						</div>
						<button
							id="btn-delete"
							type="button"
							class="hidden p-2 rounded-xl bg-[#DB4437]/10 hover:bg-[#DB4437]/20 border border-[#DB4437]/30 text-[#DB4437] transition-all duration-300 cursor-pointer"
							title="Delete project"
						>
							<Icon name="trash" size={16} class="w-4 h-4" />
						</button>
					</div>

					<!-- Form -->
					<form id="project-form" class="space-y-4">
						<!-- Cover Image File Upload Drop Zone -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Project Thumbnail Image</label>
							<div
								id="image-drop-zone"
								class="relative group cursor-pointer border-2 border-dashed border-[#2B2930] hover:border-primary/60 rounded-2xl p-4 text-center bg-[#141218] transition-all duration-300 overflow-hidden min-h-[120px] flex flex-col items-center justify-center"
							>
								<input
									type="file"
									id="image-file-input"
									accept="image/jpeg,image/png,image/webp"
									class="hidden"
								/>
								<img
									id="image-preview"
									src=""
									alt="Preview"
									class="hidden absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-all duration-500"
								/>

								<div id="drop-zone-prompt" class="relative z-10 flex flex-col items-center gap-1.5">
									<div class="p-2 rounded-full bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
										<Icon name="image" size={20} class="w-5 h-5" />
									</div>
									<div>
										<p class="text-xs font-medium text-white flex items-center gap-1.5">
											Drop cover image or <span class="text-primary font-semibold">browse</span>
											<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">CapsLock</kbd>
										</p>
										<p class="text-[10px] text-[#E6E1E5]/40 mt-0.5">JPEG, PNG, WebP (Max 10MB)</p>
									</div>
								</div>

								<div id="file-details" class="hidden relative z-10 text-[10px] bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 px-2 py-1 rounded-md font-semibold mt-2">
									✓ File Selected
								</div>
							</div>
						</div>

						<!-- Read-only Project ID -->
						<div class="hidden">
							<input
								type="text"
								id="form-id"
								name="id"
								readonly
							/>
						</div>

						<!-- Project Title -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Project Title *</label>
							<input
								type="text"
								id="form-title"
								name="title"
								required
								placeholder="e.g., Saoudi Portfolio Website"
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors"
							/>
						</div>

						<!-- Main Field (Dropdown with Settings button) -->
						<div>
							<div class="flex items-center justify-between mb-1.5">
								<label class="block text-xs font-semibold text-[#E6E1E5]/70">Main Field *</label>
								<button
									type="button"
									id="btn-manage-fields"
									class="text-[11px] text-primary hover:underline flex items-center gap-1 cursor-pointer font-medium"
									title="Manage Fields"
								>
									<span>⚙</span> Manage Fields
								</button>
							</div>
							<select
								id="form-field"
								name="field"
								required
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							>
								<!-- Populated via JS -->
							</select>
						</div>

						<!-- Date Selection -->
						<div>
							<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-1.5">Completion / Release Date *</label>
							<input
								type="month"
								id="form-date"
								name="date"
								required
								class="w-full px-4 py-2.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-sm focus:outline-none focus:border-primary transition-colors cursor-pointer"
							/>
						</div>

						<!-- Project Details & Links -->
						<div class="p-3.5 rounded-2xl bg-[#141218] border border-[#2B2930] space-y-3">
							<p class="text-xs font-bold text-white/90">Project Details & Links</p>
							
							<div>
								<label class="block text-[11px] font-semibold text-[#E6E1E5]/70 mb-1">Technology Tags (Comma-separated)</label>
								<input
									type="text"
									id="form-technologies"
									name="technologies"
									placeholder="e.g., Astro, React, TypeScript, Tailwind CSS, Firebase"
									class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors"
								/>
							</div>

							<div>
								<label class="block text-[11px] font-semibold text-[#E6E1E5]/70 mb-1">Live Website Link (Optional)</label>
								<input
									type="url"
									id="form-project-url"
									name="projectUrl"
									placeholder="https://..."
									class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors"
								/>
							</div>

							<div>
								<label class="block text-[11px] font-semibold text-[#E6E1E5]/70 mb-1">Source-Code Link (Optional)</label>
								<input
									type="url"
									id="form-github-url"
									name="githubUrl"
									placeholder="https://github.com/..."
									class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary transition-colors"
								/>
							</div>
						</div>

						<!-- Hidden input for blocks JSON payload -->
						<input type="hidden" id="form-blocks" name="blocks" value="[]" />

						<!-- Manage Blocks Button -->
						<div>
							<button
								type="button"
								id="btn-open-block-editor"
								class="w-full py-3 px-4 rounded-xl bg-[#211F26] hover:bg-primary/20 border border-[#2B2930] hover:border-primary/40 text-white font-semibold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer group"
							>
								<Icon name="edit" size={14} class="w-3.5 h-3.5 text-primary group-hover:scale-110 transition-transform" />
								<span>Manage Blocks</span>
								<span class="text-primary font-bold">←</span>
							</button>
						</div>

						<!-- Status Panel -->
						<div id="form-status" class="hidden p-3.5 rounded-xl border text-xs font-medium text-center"></div>

						<!-- Form Buttons -->
						<div class="flex gap-3 pt-2">
							<button
								type="button"
								id="btn-cancel"
								class="flex-1 py-3 px-4 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5] font-semibold text-sm transition-all duration-300 cursor-pointer text-center flex items-center justify-center gap-1.5"
							>
								<span>Cancel</span>
								<kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-white/10 text-white/50 rounded border border-white/10">Esc</kbd>
							</button>
							<button
								type="submit"
								id="btn-save"
								class="flex-1 py-3 px-4 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-sm transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer shadow-md"
							>
								<Icon name="save" size={16} class="w-4 h-4" />
								<span id="save-btn-text">Save</span>
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Sliding Drawer Block Editor (Left side panel) -->
			<div
				id="block-editor-panel"
				class="fixed top-0 left-0 h-full w-full sm:w-[500px] bg-[#1D1B20] border-r border-[#2B2930] shadow-2xl transition-transform duration-350 ease-[cubic-bezier(0.2,0,0.2,1)] transform -translate-x-full z-[80] p-6 pb-28 sm:pb-6 overflow-y-auto flex flex-col justify-between"
			>
				<div class="space-y-5">
					<div class="border-b border-[#2B2930]/60 pb-4 flex justify-between items-center">
						<div>
							<h2 class="text-base font-bold text-white">Content Blocks Editor</h2>
							<p class="text-xs text-[#E6E1E5]/50 mt-0.5">Drag to reorder story blocks</p>
						</div>
						<button
							type="button"
							id="btn-close-block-panel-icon"
							class="p-2 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-colors cursor-pointer text-xl font-bold"
							title="Close Block Editor"
						>
							&times;
						</button>
					</div>

					<!-- Quick Add Toolbar (Single Row Icons Only - Container Background Removed) -->
					<div>
						<label class="block text-xs font-semibold text-[#E6E1E5]/70 mb-2">Add New Content Block</label>
						<div class="flex items-center justify-between gap-1.5 py-1">
							<button type="button" data-add-block="heading" title="Heading (H1-H6)" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-primary/20 hover:border-primary/40 border border-white/5 text-white font-bold text-xs flex items-center justify-center cursor-pointer transition-all">H</button>
							<button type="button" data-add-block="rich_text" title="Rich Text Paragraph" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-primary/20 hover:border-primary/40 border border-white/5 text-white font-bold text-xs flex items-center justify-center cursor-pointer transition-all">¶</button>
							<button type="button" data-add-block="callout" title="Callout Box" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-[#F9AB00]/20 hover:border-[#F9AB00]/40 border border-white/5 text-[#F9AB00] font-bold text-xs flex items-center justify-center cursor-pointer transition-all">⚡</button>
							<button type="button" data-add-block="single_image" title="Single Image" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-[#34A853]/20 hover:border-[#34A853]/40 border border-white/5 text-[#34A853] font-bold text-xs flex items-center justify-center cursor-pointer transition-all">🖼</button>
							<button type="button" data-add-block="carousel" title="Image Carousel" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-[#34A853]/20 hover:border-[#34A853]/40 border border-white/5 text-[#34A853] font-bold text-xs flex items-center justify-center cursor-pointer transition-all">🎠</button>
							<button type="button" data-add-block="metrics_grid" title="Metrics Grid" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-[#4285F4]/20 hover:border-[#4285F4]/40 border border-white/5 text-[#4285F4] font-bold text-xs flex items-center justify-center cursor-pointer transition-all">📊</button>
							<button type="button" data-add-block="action_buttons" title="Action Buttons" class="flex-1 py-2 rounded-xl bg-[#211F26] hover:bg-[#EA4335]/20 hover:border-[#EA4335]/40 border border-white/5 text-[#EA4335] font-bold text-xs flex items-center justify-center cursor-pointer transition-all">🔗</button>
						</div>
					</div>

					<!-- Dynamic Blocks Container -->
					<div class="space-y-3">
						<div class="flex items-center justify-between">
							<label class="text-xs font-semibold text-[#E6E1E5]/70">Configured Blocks</label>
							<button type="button" id="btn-clear-all-blocks" class="text-[11px] text-[#DB4437] hover:underline cursor-pointer">Clear All</button>
						</div>

						<div id="blocks-list-container" class="space-y-3 min-h-[120px] relative">
							<!-- Horizontal Drop Indicator Line -->
							<div id="drag-drop-line" class="hidden h-1 bg-primary rounded-full my-1.5 transition-all"></div>
							<!-- Blocks rendered dynamically via JS -->
						</div>
					</div>
				</div>

				<div class="pt-4 border-t border-[#2B2930]">
					<button
						type="button"
						id="btn-apply-blocks"
						class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-sm transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md"
					>
						<span>Save Blocks</span>
					</button>
				</div>
			</div>

			<!-- Manage Fields Modal -->
			<div id="fields-modal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-sm z-[100] flex items-center justify-center p-4">
				<div class="bg-[#1D1B20] border border-[#2B2930] rounded-3xl p-6 w-full max-w-md space-y-4 shadow-2xl animate-page-slide-up">
					<div class="flex justify-between items-center border-b border-[#2B2930] pb-3">
						<h3 class="text-base font-bold text-white">Manage Main Fields</h3>
						<button id="btn-close-fields-modal" type="button" class="text-white/60 hover:text-white text-lg font-bold">&times;</button>
					</div>

					<div class="space-y-3">
						<div class="flex gap-2">
							<input
								type="text"
								id="new-field-input"
								placeholder="Add new field name..."
								class="flex-1 px-3.5 py-2 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary"
							/>
							<button
								type="button"
								id="btn-add-field"
								class="px-4 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white text-xs font-bold transition-all"
							>
								Add
							</button>
						</div>

						<div id="fields-list" class="space-y-2 max-h-60 overflow-y-auto pr-1">
							<!-- Populated via JS -->
						</div>
					</div>

					<div class="pt-3 border-t border-[#2B2930] flex justify-end gap-2">
						<button
							type="button"
							id="btn-save-fields"
							class="w-full py-2.5 px-4 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-xs transition-all cursor-pointer text-center"
						>
							Save Fields Configuration
						</button>
					</div>
				</div>
			</div>

		</div>
	</AdminLayout>
	<AdminNavDock currentPath={Astro.url.pathname} />
	<GlobalLightbox />
</BackgroundBaseLayout>

<script is:inline define:vars={{ initialProjects: projects, initialFields: fields }}>
	Object.assign(window, { 
		projects: initialProjects || [],
		projectsFields: initialFields || ['Web Development', 'Mobile App', 'UI/UX Design', 'Full-Stack', 'AI / ML']
	});
</script>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Element Declarations
		const searchInput = document.getElementById('search-input') as HTMLInputElement;
		const btnNewProject = document.getElementById('btn-new-project') as HTMLButtonElement;
		const projectsGrid = document.getElementById('projects-grid') as HTMLDivElement;
		const loadMoreBtn = document.getElementById('btn-load-more') as HTMLButtonElement;
		const loadMoreContainer = document.getElementById('load-more-container') as HTMLDivElement;

		// Filter Elements
		const btnFilterToggle = document.getElementById('btn-filter-toggle') as HTMLButtonElement;
		const filterBadge = document.getElementById('filter-badge') as HTMLSpanElement;
		const filterPanel = document.getElementById('filter-panel') as HTMLDivElement;
		const filterTechnology = document.getElementById('filter-technology') as HTMLSelectElement;
		const filterYear = document.getElementById('filter-year') as HTMLSelectElement;
		const btnClearFilters = document.getElementById('btn-clear-filters') as HTMLButtonElement;
		const btnCloseFilters = document.getElementById('btn-close-filters') as HTMLButtonElement;

		// Drawer Elements
		const editorPanel = document.getElementById('editor-panel') as HTMLDivElement;
		const editorBackdrop = document.getElementById('editor-backdrop') as HTMLDivElement;
		const btnCancel = document.getElementById('btn-cancel') as HTMLButtonElement;

		const editorHeading = document.getElementById('editor-heading') as HTMLHeadingElement;
		const editorSubheading = document.getElementById('editor-subheading') as HTMLParagraphElement;
		
