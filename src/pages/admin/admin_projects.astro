							<label class="block text-[10px] text-[#E6E1E5]/60">Buttons (Label|URL per line)</label>
							<textarea data-field="buttons_str" rows="2" placeholder="Live Demo|https://example.com&#10;GitHub|https://github.com" class="w-full px-3 py-1.5 rounded-xl border border-[#2B2930] bg-[#211F26] text-white text-xs focus:outline-none focus:border-primary">${btnsStr}</textarea>
						</div>
					`;
				}

				// Remove block button top right of card body
				const deleteBtn = document.createElement('button');
				deleteBtn.type = 'button';
				deleteBtn.className = 'text-xs text-[#DB4437] hover:bg-[#DB4437]/10 p-1 rounded cursor-pointer transition-colors';
				deleteBtn.title = 'Delete Block';
				deleteBtn.textContent = '✕';
				deleteBtn.addEventListener('click', () => {
					currentBlocks.splice(index, 1);
					updateBlocksUI();
				});

				cardBody.appendChild(dragHandle);
				cardBody.appendChild(contentWrapper);
				cardBody.appendChild(deleteBtn);
				blockCard.appendChild(cardBody);

				contentWrapper.addEventListener('input', (e) => {
					const target = e.target as HTMLElement;
					const field = target.getAttribute('data-field');
					if (!field) return;

					const val = (target as HTMLInputElement).value;
					if (field === 'level') {
						block.level = parseInt(val, 10);
					} else if (field === 'metrics_str') {
						block.items = val.split(',').map(pair => {
							const [label, value] = pair.split(':').map(s => s.trim());
							return { label: label || '', value: value || '' };
						}).filter(it => it.label || it.value);
					} else if (field === 'buttons_str') {
						block.buttons = val.split('\n').map(line => {
							const [label, url] = line.split('|').map(s => s.trim());
							return { label: label || '', url: url || '' };
						}).filter(b => b.label || b.url);
					} else {
						block[field] = val;
					}
					if (formBlocks) formBlocks.value = JSON.stringify(currentBlocks);
				});

				blocksListContainer.appendChild(blockCard);
			});
		}

		// Projects Rendering
		function renderProjects(resetPagination = false) {
			if (resetPagination) {
				displayedCount = ITEMS_PER_PAGE;
			} else {
				displayedCount += ITEMS_PER_PAGE;
			}

			const visibleProjects = filteredProjects.slice(0, displayedCount);
			projectsGrid.innerHTML = '';

			if (visibleProjects.length === 0) {
				projectsGrid.innerHTML = `
					<div class="col-span-full py-12 text-center border border-dashed border-[#2B2930] rounded-3xl bg-[#141218]">
						<div class="p-3 w-fit rounded-full bg-white/5 text-white/40 mx-auto mb-3">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
						</div>
						<h3 class="text-sm font-semibold text-white">No projects found</h3>
						<p class="text-xs text-[#E6E1E5]/50 mt-1">Try adjusting your search query or filter parameters.</p>
					</div>
				`;
				loadMoreContainer.classList.add('hidden');
				return;
			}

			visibleProjects.forEach(project => {
				const cardEl = createProjectCard(project);
				projectsGrid.appendChild(cardEl);
			});

			attachCardEventListeners();

			if (displayedCount >= filteredProjects.length) {
				loadMoreContainer.classList.add('hidden');
			} else {
				loadMoreContainer.classList.remove('hidden');
			}
		}

		function createProjectCard(project: any) {
			const formattedDate = (() => {
				if (!project.date) return '';
				try {
					const parts = project.date.split('-');
					if (parts.length >= 2) {
						const year = parseInt(parts[0], 10);
						const month = parseInt(parts[1], 10) - 1;
						const date = new Date(year, month);
						if (!isNaN(date.getTime())) {
							return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
						}
					}
				} catch (e) {}
				return project.date;
			})();

			const fieldText = project.field || 'Web Development';

			const cardWrapper = document.createElement('div');
			cardWrapper.innerHTML = `
				<article 
					class="project-card group border rounded-3xl p-4 transition-all duration-300 flex flex-col justify-between h-full border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer"
					data-id="${project.id}"
				>
					<div>
						${project.imageUrl ? `
							<a
								href="#global-lightbox"
								data-lightbox-src="${project.imageUrl}"
								data-lightbox-title="${project.title || ''}"
								data-lightbox-subtitle="${project.field || ''}"
								class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-3 border border-white/10 flex items-center justify-center cursor-pointer image-zoom-trigger block bg-[#1D1B20]"
							>
								<div class="absolute inset-0 skeleton"></div>
								<img
									src="${project.imageUrl}"
									alt="${project.title}"
									class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-all duration-300 relative z-10 opacity-0"
									loading="lazy"
									decoding="async"
									onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
									onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
								/>
							</a>
						` : `
							<div class="p-3 w-fit rounded-2xl bg-primary/10 text-primary border border-primary/20 mb-3 group-hover:scale-110 transition-transform duration-300">
								<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
							</div>
						`}

						<h3 class="font-bold text-white text-base group-hover:text-primary transition-colors line-clamp-1">
							${project.title}
						</h3>
					</div>

					<div class="mt-3.5 pt-3 flex justify-between items-center text-xs border-t border-white/5 text-white/40 font-medium">
						${formattedDate ? `
							<span class="flex items-center gap-1 font-medium whitespace-nowrap shrink-0">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								${formattedDate}
							</span>
						` : '<span></span>'}
						<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary line-clamp-1 max-w-[140px]">
							${fieldText}
						</span>
					</div>
				</article>
			`;

			return cardWrapper.firstElementChild as HTMLElement;
		}

		function attachCardEventListeners() {
			const projectCards = projectsGrid.querySelectorAll('.project-card') as NodeListOf<HTMLDivElement>;
			projectCards.forEach(card => {
				card.addEventListener('click', (e) => {
					if ((e.target as HTMLElement).closest('.stop-propagation, .image-zoom-trigger, [data-lightbox-src]')) {
						return;
					}
					const id = card.getAttribute('data-id');
					const project = allProjects.find((p: any) => p.id === id);
					if (project) {
						const newUrl = new URL(window.location.href);
						newUrl.searchParams.set('id', project.id);
						window.history.pushState(null, '', newUrl.toString());
						
						selectProject(project);
						openDrawer();
					}
				});
			});
		}

		loadMoreBtn.addEventListener('click', () => {
			renderProjects();
		});

		function initFromUrl() {
			const urlParams = new URLSearchParams(window.location.search);
			const urlId = urlParams.get('id');

			if (urlId) {
				const project = allProjects.find((p: any) => p.id === urlId);
				if (project) {
					selectProject(project);
					openDrawer();
					return;
				}
			}
		}

		// --- Drawer Controls (Opens BOTH drawers on card click) ---
		function openDrawer() {
			editorBackdrop.classList.remove('hidden');
			setTimeout(() => {
				editorBackdrop.classList.add('opacity-100');
				editorPanel.classList.remove('translate-x-full');
				editorPanel.classList.add('translate-x-0');
				openBlockEditorDrawer();
			}, 10);
		}

		function closeDrawer() {
			closeBlockEditorDrawer();
			editorBackdrop.classList.remove('opacity-100');
			editorPanel.classList.remove('translate-x-0');
			editorPanel.classList.add('translate-x-full');

			const newUrl = new URL(window.location.href);
			newUrl.searchParams.delete('id');
			window.history.pushState(null, '', newUrl.toString());

			const projectCards = projectsGrid.querySelectorAll('.project-card') as NodeListOf<HTMLDivElement>;
			projectCards.forEach(c => c.classList.remove('ring-2', 'ring-primary/60', 'border-primary/50'));

			setTimeout(() => {
				editorBackdrop.classList.add('hidden');
			}, 350);
		}

