---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalLightbox from '../components/GlobalLightbox.astro';
import CertificationsIsland from '../components/CertificationsIsland.astro';
import SkeletonCardGrid from '../components/SkeletonCardGrid.astro';

---

<BaseLayout title="Certifications" description="Professional certifications, credentials, and achievements of Abderrahmane SAOUDI.">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 pt-8 max-w-7xl">
		<CertificationsIsland server:defer>
			<SkeletonCardGrid slot="fallback" variant="certificate" count={8} groups={2} />
		</CertificationsIsland>
	</div>

	{/* Render Lightbox outside transform scopes */}
	<GlobalLightbox />
</BaseLayout>
