---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter & Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
      :root {
        --ai-accent-tint: #e6f7f1;
        --brand-green: #1E824C;
        --brand-green-dark: #006233;
        --brand-green-light: #e6f7f1;
        --text-dark: #1A202C;
        --text-muted: #64748B;
        --ease-m3: cubic-bezier(0.2, 0, 0.2, 1);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--ai-accent-tint);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }

      /* Animated Particle Background System (matching website constellation) */
      body::before,
      body::after {
        content: '';
        position: fixed;
        inset: -50px;
        pointer-events: none;
        z-index: 0;
        will-change: transform;
      }

      body::before {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.35) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(0, 128, 200, 0.28) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(30, 130, 76, 0.25) 1.2px, transparent 1.2px),
          radial-gradient(circle, rgba(249, 171, 0, 0.25) 1.5px, transparent 1.5px);
        background-size: 70px 70px, 95px 95px, 70px 70px, 120px 120px;
        background-position: 0 0, 30% 15%, 25% 68%, 82% 88%;
        background-repeat: repeat;
        animation: bgPoints 48s linear infinite;
        opacity: 0.85;
      }

      body::after {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.2) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 128, 200, 0.18) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 98, 51, 0.15) 1px, transparent 1.5px),
          radial-gradient(circle, rgba(255, 255, 255, 0.6) 1px, transparent 1.5px);
        background-repeat: repeat;
        background-size: 120px 120px, 100px 100px, 24px 24px, 24px 24px;
        background-position: 8% 90%, 85% 60%, 0 0, 14px 14px;
        animation: bgStars 24s linear infinite;
        opacity: 0.9;
      }

      @keyframes bgPoints {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-50px, 40px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      @keyframes bgStars {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(80px, -80px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      /* Main presentation frame: ~94% of screen view with 16:9 ratio and visible border */
      .presentation-frame {
        width: min(94vw, calc(94vh * 16 / 9));
        height: min(94vh, calc(94vw * 9 / 16));
        background-color: #FFFFFF;
        border-radius: 32px;
        border: 2px solid rgba(0, 98, 51, 0.22);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(2.2rem, 4.5vw, 4.2rem) clamp(2.8rem, 5.8vw, 5.5rem);
        overflow: hidden;
        z-index: 10;
        animation: frameEntrance 0.7s var(--ease-m3) forwards;
      }

      @keyframes frameEntrance {
        from {
          opacity: 0;
          transform: scale(0.96) translateY(12px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      /* Subtle inner botanical light texture */
      .bg-overlay {
        position: absolute;
        inset: 0;
        background: 
          radial-gradient(ellipse at 90% 25%, rgba(230, 247, 241, 0.7) 0%, transparent 60%),
          radial-gradient(ellipse at 75% 85%, rgba(240, 249, 245, 0.5) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      .content-layer {
        position: relative;
        z-index: 10;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      /* Animated Speaker Pill */
      .speaker-pill {
        display: inline-flex;
        align-items: center;
        background-color: var(--brand-green);
        color: #FFFFFF;
        font-weight: 700;
        font-size: clamp(1rem, 1.6vw, 1.4rem);
        padding: 0.6rem 1.8rem;
        border-radius: 9999px;
        letter-spacing: -0.01em;
        width: fit-content;
        animation: slideDownFade 0.6s var(--ease-m3) 0.15s backwards;
        transition: transform 0.2s var(--ease-m3), background-color 0.2s;
        user-select: none;
      }

      .speaker-pill:hover {
        transform: translateY(-2px);
        background-color: var(--brand-green-dark);
      }

      @keyframes slideDownFade {
        from {
          opacity: 0;
          transform: translateY(-16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Session Title Container */
      .title-container {
        display: flex;
        flex-direction: column;
        gap: clamp(0.25rem, 0.8vw, 0.75rem);
      }

      /* First line: Digital Productivity (Large & Green, Single Line) */
      .title-highlight {
        font-size: clamp(2.6rem, 5.2vw, 5.4rem);
        font-weight: 900;
        color: var(--brand-green);
        letter-spacing: -0.03em;
        line-height: 1.08;
        white-space: nowrap;
        animation: slideRightFade 0.65s var(--ease-m3) 0.25s backwards;
      }

      /* Second line: Work Smarter, Not Harder */
      .title-subtext {
        font-size: clamp(1.8rem, 3.4vw, 3.4rem);
        font-weight: 800;
        color: var(--text-dark);
        letter-spacing: -0.025em;
        line-height: 1.15;
        animation: slideRightFade 0.65s var(--ease-m3) 0.35s backwards;
      }

      @keyframes slideRightFade {
        from {
          opacity: 0;
          transform: translateX(-24px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      /* Animated Horizontal Divider Line */
      .divider-container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        margin: 0.5rem 0 1rem 0;
      }

      .divider-line {
        width: 100%;
        height: 2px;
        background-color: #1A202C;
        transform-origin: left;
        animation: expandLine 0.75s var(--ease-m3) 0.45s backwards;
      }

      @keyframes expandLine {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      /* Animated Play Button with Pulse Micro-interaction */
      .play-circle {
        position: absolute;
        right: 0;
        width: clamp(2.6rem, 3.4vw, 3.4rem);
        height: clamp(2.6rem, 3.4vw, 3.4rem);
        border-radius: 9999px;
        background-color: var(--brand-green);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        cursor: pointer;
        animation: popIn 0.5s var(--ease-m3) 0.6s backwards;
        transition: transform 0.25s var(--ease-m3), background-color 0.2s;
        border: 2px solid #FFFFFF;
      }

      .play-circle:hover {
        transform: scale(1.1) rotate(5deg);
        background-color: var(--brand-green-dark);
      }

      @keyframes popIn {
        from {
          opacity: 0;
          transform: scale(0);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      /* Animated Program & Category Tag */
      .program-tag {
        color: var(--brand-green);
        font-weight: 800;
        font-size: clamp(1.15rem, 1.85vw, 1.6rem);
        letter-spacing: -0.015em;
        animation: slideUpFade 0.6s var(--ease-m3) 0.55s backwards;
      }

      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Animated Logos Row */
      .logos-row {
        display: flex;
        align-items: center;
        gap: clamp(1.8rem, 3.8vw, 4rem);
        margin-top: clamp(1rem, 2.2vw, 2.2rem);
        animation: slideUpFade 0.6s var(--ease-m3) 0.7s backwards;
      }

      .logo-wrapper {
        display: flex;
        align-items: center;
        transition: transform 0.25s var(--ease-m3);
      }

      .logo-wrapper:hover {
        transform: translateY(-3px);
      }

      .logo-img-ministre {
        height: clamp(3rem, 4.8vw, 4.5rem);
        width: auto;
        object-fit: contain;
      }

      .logo-img-at {
        height: clamp(2.2rem, 3.4vw, 3.2rem);
        width: auto;
        object-fit: contain;
      }

      .logo-img-mobilis {
        height: clamp(1.8rem, 2.7vw, 2.5rem);
        width: auto;
        object-fit: contain;
      }

      /* Respect Reduced Motion */
      @media (prefers-reduced-motion: reduce) {
        body::before,
        body::after,
        .presentation-frame,
        .speaker-pill,
        .title-highlight,
        .title-subtext,
        .divider-line,
        .play-circle,
        .program-tag,
        .logos-row {
          animation: none !important;
          transition: none !important;
          transform: none !important;
          opacity: 1 !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- Main Presentation Card (94% screen view, 16:9 ratio, bordered) -->
    <main class="presentation-frame">
      <div class="bg-overlay"></div>

      <div class="content-layer">
        <!-- Top: Speaker's Name in Green Pill -->
        <div class="pt-1">
          <div class="speaker-pill" title="Intervenant">
            Abderrahmane SAOUDI
          </div>
        </div>

        <!-- Middle: Title -->
        <div class="my-auto py-2">
          <div class="title-container">
            <!-- First Line: Green & Larger -->
            <h1 class="title-highlight">
              Digital Productivity
            </h1>
            <!-- Second Line: Dark & Complementary -->
            <h2 class="title-subtext">
              Work Smarter, Not Harder
            </h2>
          </div>
        </div>

        <!-- Bottom: Dividing Line + Program Tag + Logos -->
        <div class="pb-1">
          <!-- Line with Right Play Circle -->
          <div class="divider-container">
            <div class="divider-line"></div>
            <div class="play-circle" title="Lancer la session">
              <svg class="w-4 h-4 ml-0.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>

          <!-- Program & Age Tag -->
          <div class="program-tag">
            7.77 Program | Age: 24-30
          </div>

          <!-- Institutional Logos -->
          <div class="logos-row">
            <!-- Ministère de la Poste et des Télécommunications -->
            <div class="logo-wrapper">
              <img 
                src={logoMinistere.src} 
                alt="Ministère de la Poste et des Télécommunications" 
                class="logo-img-ministre"
              />
            </div>

            <!-- Algérie Télécom -->
            <div class="logo-wrapper">
              <img 
                src={logoAlgerieTelecom.src} 
                alt="Algérie Télécom" 
                class="logo-img-at"
              />
            </div>

            <!-- Mobilis -->
            <div class="logo-wrapper">
              <img 
                src={logoMobilis.src} 
                alt="Mobilis" 
                class="logo-img-mobilis"
              />
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
