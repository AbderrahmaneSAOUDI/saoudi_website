---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
import videoSrc from './_assets/video.mp4';
import '../../styles/global.css';
import './_styles/presentation.css';
---

<!doctype html>
<html lang="fr" class="w-full h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#e6f7f1] text-slate-800 font-sans w-screen h-screen overflow-hidden flex items-center justify-center relative bg-particles antialiased select-none">
    <!-- 1. Background Ambient Multi-Aurora Morphing Blobs -->
    <div class="bg-aurora-container">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
      <div class="aurora-blob aurora-blob-4"></div>
    </div>

    <!-- 2. Twinkling Keynote Sparkle Stars -->
    <svg class="sparkle-star sparkle-1 w-5 h-5 text-emerald-800/40" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-2 w-4 h-4 text-sky-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-3 w-4 h-4 text-amber-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-4 w-5 h-5 text-emerald-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>

    <!-- 3. Floating Background Geometric Tech Nodes -->
    <svg class="floating-node node-1 w-6 h-6 text-emerald-800/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>
    <svg class="floating-node node-2 w-5 h-5 text-sky-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="12 2 22 12 12 22 2 12" />
    </svg>
    <svg class="floating-node node-3 w-5 h-5 text-emerald-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="8" />
    </svg>
    <svg class="floating-node node-4 w-6 h-6 text-amber-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>

    <!-- 4. Main Presentation Card (94% screen view, 16:9 ratio, bordered, levitating, 100% white background) -->
    <main 
      id="presentationDeck" 
      data-current-slide="1" 
      class="presentation-frame frame-border-pulse bg-white rounded-3xl sm:rounded-[32px] border-2 border-emerald-800/25 relative flex flex-col justify-between p-6 sm:p-10 md:p-12 lg:p-14 xl:p-16 overflow-hidden z-10 hover:border-emerald-800/50 transition-colors duration-500"
    >
      <!-- Architectural Corner L-Brackets -->
      <div class="corner-bracket corner-tl"></div>
      <div class="corner-bracket corner-tr"></div>
      <div class="corner-bracket corner-bl"></div>
      <div class="corner-bracket corner-br"></div>

      <div class="content-layer relative z-10 h-full flex flex-col justify-between">
        <!-- Top: Dynamic Header Pills -->
        <div class="pt-1 relative min-h-[44px]">
          <!-- Slide 1 Top: Speaker Pill -->
          <div class="slide1-top-pill transition-all duration-500 flex items-center">
            <div class="speaker-pill relative overflow-hidden inline-flex items-center gap-2.5 bg-[#1E824C] hover:bg-[#006233] text-white font-bold text-sm sm:text-base md:text-lg px-5 sm:px-7 py-2 sm:py-2.5 rounded-full tracking-tight transition-transform duration-200 hover:-translate-y-0.5 cursor-default select-none">
              <span class="relative flex h-2.5 w-2.5">
                <span class="live-dot-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-300"></span>
              </span>
              <span>Abderrahmane SAOUDI</span>
            </div>
          </div>

          <!-- Slide 2 Top: Category & Speaker Profile Pill -->
          <div class="slide2-top-pill absolute inset-0 transition-all duration-500 flex items-center justify-between">
            <div class="inline-flex items-center gap-2.5 bg-emerald-50 border border-emerald-800/20 text-[#006233] font-bold text-xs sm:text-sm md:text-base px-4 sm:px-6 py-2 rounded-full tracking-tight">
              <span class="w-2 h-2 rounded-full bg-[#1E824C]"></span>
              <span>Intervenant • Speaker Profile</span>
            </div>
            <div class="hidden sm:inline-flex items-center gap-2 text-xs font-semibold text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
              <span>Session 7.77 Digital Skills</span>
            </div>
          </div>
        </div>

        <!-- Middle: Dynamic Slide Content Deck Area -->
        <div class="relative w-full my-auto py-2 min-h-[300px] sm:min-h-[360px] md:min-h-[400px] lg:min-h-[440px] flex items-center overflow-hidden">
          
          <!-- ================= SLIDE 1 CONTENT ================= -->
          <section id="slide-1-content" class="slide-pane w-full flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8 lg:gap-8 xl:gap-10">
            <!-- Title Left Block -->
            <div class="flex flex-col gap-1 sm:gap-2 shrink-0">
              <!-- First Line: Green & Larger with Dynamic Shimmer Gradient -->
              <h1 class="title-highlight font-black text-3xl sm:text-4xl md:text-5xl lg:text-[3.8rem] xl:text-[4.4rem] tracking-tight leading-[1.08] whitespace-nowrap">
                Digital Productivity
              </h1>
              <!-- Second Line: Dark & Complementary -->
              <h2 class="title-subtext font-light text-xl sm:text-2xl md:text-3xl lg:text-3xl xl:text-4xl text-slate-900 tracking-tight leading-tight">
                Work Smarter, Not Harder
              </h2>
            </div>

            <!-- Video Right Block (Bigger, borderless, pure transparent fade loop) -->
            <div class="video-wrapper flex-1 w-full max-w-[420px] sm:max-w-[540px] md:max-w-[660px] lg:max-w-[780px] xl:max-w-[880px] 2xl:max-w-[940px] flex justify-center md:justify-end">
              <div class="relative w-full aspect-video rounded-3xl overflow-hidden bg-transparent">
                <video 
                  id="heroVideo"
                  src={videoSrc}
                  autoplay
                  muted
                  playsinline
                  class="hero-video w-full h-full object-contain md:object-cover bg-transparent pointer-events-none opacity-0"
                ></video>
              </div>
            </div>
          </section>

          <!-- ================= SLIDE 2 CONTENT: SPEAKER BIO ================= -->
          <section id="slide-2-content" class="slide-pane w-full grid grid-cols-12 gap-6 lg:gap-10 items-center">
            <!-- Left: Speaker Profile Showcase Card -->
            <div class="col-span-12 md:col-span-4 flex flex-col items-center text-center p-5 sm:p-7 rounded-3xl bg-slate-50/80 border border-slate-200/80">
              <!-- Profile Avatar with Google Colors Ring -->
              <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full p-1 bg-gradient-to-tr from-[#4285F4] via-[#0F9D58] to-[#F9AB00] mb-4 transition-transform duration-300 hover:scale-105">
                <img 
                  src="/profile.webp" 
                  alt="Abderrahmane SAOUDI" 
                  class="w-full h-full object-cover rounded-full bg-slate-100"
                />
                <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white" title="Active Speaker"></span>
              </div>

              <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-sans tracking-tight">
                Abderrahmane SAOUDI
              </h2>
              <p class="text-xs sm:text-sm font-semibold text-[#006233] mt-1">
                Technology Lead & Creative Engineer
              </p>

              <!-- Quick Badges -->
              <div class="flex flex-wrap items-center justify-center gap-2 mt-4 pt-3 border-t border-slate-200/80 w-full text-[11px] font-medium text-slate-600">
                <span class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 font-mono">saoudi.online</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800">Algérie 🇩🇿</span>
              </div>
            </div>

            <!-- Right: 3 Bio Pillars as Modern Material 3 Cards -->
            <div class="col-span-12 md:col-span-8 flex flex-col gap-3 sm:gap-4">
              <!-- Header -->
              <div class="mb-1">
                <h3 class="text-xs font-bold uppercase tracking-wider text-[#006233]">
                  Biographie & Expertises
                </h3>
              </div>

              <!-- Pillar 1: Graphic Designer and Advisor -->
              <div class="flex items-start gap-4 p-3.5 sm:p-4 rounded-2xl bg-white border border-emerald-800/20 transition-all duration-300 hover:-translate-y-1 hover:border-emerald-700/40">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-emerald-100/70 text-[#006233] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm sm:text-base font-bold text-slate-900 tracking-tight">
                    Graphic Designer and Advisor
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                    Conception d'identités visuelles percutantes, direction artistique et conseil stratégique en design de marque et expérience utilisateur (UI/UX).
                  </p>
                </div>
              </div>

              <!-- Pillar 2: Mobile and Frontend Web Developer -->
              <div class="flex items-start gap-4 p-3.5 sm:p-4 rounded-2xl bg-white border border-sky-800/20 transition-all duration-300 hover:-translate-y-1 hover:border-sky-700/40">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-sky-100/70 text-[#0080C8] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm sm:text-base font-bold text-slate-900 tracking-tight">
                    Mobile and Frontend Web Developer
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                    Développement d'applications mobiles cross-platform (Flutter) et d'architectures web SSR modernes et légères à hautes performances.
                  </p>
                </div>
              </div>

              <!-- Pillar 3: Former GDG Ghardaia Club President -->
              <div class="flex items-start gap-4 p-3.5 sm:p-4 rounded-2xl bg-white border border-amber-800/20 transition-all duration-300 hover:-translate-y-1 hover:border-amber-700/40">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-amber-100/70 text-[#D97706] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-sm sm:text-base font-bold text-slate-900 tracking-tight">
                    Former GDG Ghardaia Club President
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-600 mt-0.5 leading-relaxed">
                    Leadership communautaire Google Developers Group, organisation d'ateliers tech, hackathons et vulgarisation du numérique auprès des jeunes talents.
                  </p>
                </div>
              </div>
            </div>
          </section>

        </div>

        <!-- Bottom: Dividing Line + Next/Previous Navigation Buttons + Responsive Footer -->
        <div class="pb-1">
          <!-- Horizontal Dividing Line with Next/Previous Buttons -->
          <div class="relative w-full flex items-center my-2 sm:my-3">
            <div class="divider-line relative w-full h-0.5 bg-slate-900/80 overflow-hidden"></div>
            
            <!-- Dual Next/Previous Control Dock -->
            <div class="absolute right-0 flex items-center gap-2 pl-3 bg-white z-20">
              <!-- Slide Indicator -->
              <span id="slideIndicator" class="text-xs font-bold text-slate-500 font-mono mr-1">
                01 / 02
              </span>

              <!-- Previous Button -->
              <button 
                id="prevSlideBtn" 
                type="button" 
                aria-label="Previous Slide" 
                disabled 
                class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-slate-200 bg-slate-50 text-slate-700 flex items-center justify-center transition-all duration-200 hover:bg-emerald-50 hover:text-[#1E824C] hover:border-emerald-600/40 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed select-none"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <!-- Next Button -->
              <button 
                id="nextSlideBtn" 
                type="button" 
                aria-label="Next Slide" 
                class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#1E824C] hover:bg-[#006233] text-white flex items-center justify-center transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer select-none"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Bottom Row: Left Logos (dynamically scales to corner) & Right Title on Slide 2 -->
          <div class="flex items-center justify-between gap-4 mt-2 sm:mt-4 min-h-[48px] sm:min-h-[56px]">
            <!-- Left Bottom Corner: Institutional Logos & Program Tag -->
            <div class="footer-logos-group flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 md:gap-8">
              <!-- Program & Age Tag -->
              <div class="program-tag text-[#1E824C] font-extrabold text-sm sm:text-base md:text-lg tracking-tight inline-flex items-center gap-2 shrink-0">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                <span>7.77 Program | Age: 24-30</span>
              </div>

              <!-- Logos Group (Shrinks smoothly in bottom left corner on Slide 2) -->
              <div class="flex items-center gap-4 sm:gap-7 md:gap-9">
                <!-- Ministère de la Poste et des Télécommunications -->
                <div class="logo-wrapper-1 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
                  <img 
                    src={logoMinistere.src} 
                    alt="Ministère de la Poste et des Télécommunications" 
                    class="h-10 sm:h-12 md:h-14 w-auto object-contain"
                  />
                </div>

                <!-- Algérie Télécom -->
                <div class="logo-wrapper-2 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
                  <img 
                    src={logoAlgerieTelecom.src} 
                    alt="Algérie Télécom" 
                    class="h-6 sm:h-8 md:h-10 w-auto object-contain"
                  />
                </div>

                <!-- Mobilis -->
                <div class="logo-wrapper-3 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
                  <img 
                    src={logoMobilis.src} 
                    alt="Mobilis" 
                    class="h-5 sm:h-7 md:h-8 w-auto object-contain"
                  />
                </div>
              </div>
            </div>

            <!-- Right Bottom Corner: Presentation Title (Smoothly appears on Slide 2) -->
            <div class="footer-slide2-title text-right shrink-0">
              <div class="title-highlight font-black text-sm sm:text-base md:text-lg tracking-tight leading-tight">
                Digital Productivity
              </div>
              <div class="text-[11px] sm:text-xs font-medium text-slate-700 leading-tight">
                Work Smarter, Not Harder
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>

    <!-- Synchronized Video & Slide Deck Controller -->
    <script is:inline>
      (() => {
        const deck = document.getElementById('presentationDeck');
        const prevBtn = document.getElementById('prevSlideBtn');
        const nextBtn = document.getElementById('nextSlideBtn');
        const indicator = document.getElementById('slideIndicator');
        const video = document.getElementById('heroVideo');

        let currentSlide = 1;
        const totalSlides = 2;
        let isFadingOut = false;

        // Video Synchronized Fade Controller
        const fadeInVideo = () => {
          if (!video) return;
          isFadingOut = false;
          video.style.opacity = '1';
        };

        if (video) {
          video.addEventListener('play', fadeInVideo);
          video.addEventListener('playing', fadeInVideo);

          video.addEventListener('timeupdate', () => {
            if (!video.duration || isFadingOut || currentSlide !== 1) return;
            const timeLeft = video.duration - video.currentTime;
            // Smooth fadeout over final 1.2s of video
            if (timeLeft <= 1.2) {
              isFadingOut = true;
              video.style.opacity = '0';
            }
          });

          video.addEventListener('ended', () => {
            if (currentSlide !== 1) return;
            video.style.opacity = '0';
            setTimeout(() => {
              if (currentSlide !== 1) return;
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            }, 350);
          });

          // Autoplay on slide 1 load
          if (!video.paused && video.currentTime > 0) {
            fadeInVideo();
          } else {
            video.play().then(fadeInVideo).catch(() => {});
          }
        }

        // Slide Deck Navigation
        function setSlide(num) {
          if (num < 1 || num > totalSlides) return;
          currentSlide = num;
          if (deck) deck.setAttribute('data-current-slide', String(currentSlide));
          
          if (prevBtn) prevBtn.disabled = currentSlide === 1;
          if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
          if (indicator) indicator.textContent = `0${currentSlide} / 0${totalSlides}`;

          // Video state management between slides
          if (video) {
            if (currentSlide === 1) {
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            } else {
              video.pause();
            }
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => setSlide(currentSlide - 1));
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => setSlide(currentSlide + 1));
        }

        // Keyboard Navigation
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
            if (currentSlide < totalSlides) {
              e.preventDefault();
              setSlide(currentSlide + 1);
            }
          } else if (e.key === 'ArrowLeft' || e.key === 'Backspace') {
            if (currentSlide > 1) {
              e.preventDefault();
              setSlide(currentSlide - 1);
            }
          }
        });
      })();
    </script>
  </body>
</html>
