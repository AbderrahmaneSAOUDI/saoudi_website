---
import PresentationHeader from './_components/PresentationHeader.astro';
import PresentationFooter from './_components/PresentationFooter.astro';
import Slide1Cover from './_slides/Slide1Cover.astro';
import Slide2Speaker from './_slides/Slide2Speaker.astro';
import Slide3Welcome from './_slides/Slide3Welcome.astro';
import Slide4Initiative from './_slides/Slide4Initiative.astro';
import Slide5ProductivityCheck from './_slides/Slide5ProductivityCheck.astro';
import Slide6DigitalProductivity from './_slides/Slide6DigitalProductivity.astro';
import Slide7EventScenario from './_slides/Slide7EventScenario.astro';
import Slide8BetterEvent from './_slides/Slide8BetterEvent.astro';
import Slide9Toolbox from './_slides/Slide9Toolbox.astro';
import '../../styles/global.css';
import './_styles/presentation.css';
---

<!doctype html>
<html lang="fr" class="w-full h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#e6f7f1] text-slate-800 font-sans w-screen h-screen overflow-hidden flex items-center justify-center relative bg-particles antialiased select-none">
    <!-- 1. Background Ambient Multi-Aurora Morphing Blobs -->
    <div class="aurora-blob blob-1 absolute w-[550px] h-[550px] rounded-full bg-gradient-to-tr from-emerald-300/40 via-teal-200/30 to-green-300/35 blur-3xl pointer-events-none -top-24 -left-24"></div>
    <div class="aurora-blob blob-2 absolute w-[500px] h-[500px] rounded-full bg-gradient-to-br from-teal-300/35 via-emerald-200/25 to-sky-300/30 blur-3xl pointer-events-none -bottom-24 -right-24"></div>
    <div class="aurora-blob blob-3 absolute w-[450px] h-[450px] rounded-full bg-gradient-to-r from-amber-200/25 via-emerald-200/25 to-teal-300/20 blur-3xl pointer-events-none top-1/3 left-1/2 -translate-x-1/2"></div>

    <!-- 2. Interactive Animated Particle Constellations -->
    <div class="sparkle-star star-1 absolute top-[12%] left-[8%] text-emerald-600/40 text-lg">✦</div>
    <div class="sparkle-star star-2 absolute top-[18%] right-[10%] text-teal-600/40 text-xl">✧</div>
    <div class="sparkle-star star-3 absolute bottom-[15%] left-[12%] text-emerald-500/40 text-base">✦</div>
    <div class="sparkle-star star-4 absolute bottom-[12%] right-[14%] text-amber-500/30 text-lg">✧</div>

    <!-- 3. Floating Geometric Node Markers -->
    <svg class="floating-node node-1 w-6 h-6 text-emerald-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 3v18M3 12h18" />
    </svg>
    <svg class="floating-node node-2 w-7 h-7 text-teal-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="m9 9 6 6m0-6-6 6" />
    </svg>
    <svg class="floating-node node-3 w-5 h-5 text-emerald-700/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="8" />
    </svg>
    <svg class="floating-node node-4 w-6 h-6 text-amber-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>

    <!-- 4. Main Presentation Card (94% screen view, 16:9 ratio, bordered, levitating, 100% white background) -->
    <main 
      id="presentationDeck" 
      data-current-slide="1" 
      class="presentation-frame frame-border-pulse bg-white rounded-3xl sm:rounded-[32px] border-2 border-emerald-800/25 relative flex flex-col justify-between p-6 sm:p-10 md:p-12 lg:p-14 xl:p-16 overflow-hidden z-10 hover:border-emerald-800/50 transition-colors duration-500"
    >
      <!-- Architectural Corner L-Brackets -->
      <div class="corner-bracket corner-tl"></div>
      <div class="corner-bracket corner-tr"></div>
      <div class="corner-bracket corner-bl"></div>
      <div class="corner-bracket corner-br"></div>

      <div class="content-layer relative z-10 h-full flex flex-col justify-between">
        <!-- Top: Header Component -->
        <PresentationHeader />

        <!-- Middle: Dynamic Slide Panes Deck Area (Takes each slide from separate Astro files) -->
        <div class="relative w-full flex-1 my-auto flex items-center min-h-0 overflow-hidden">
          <Slide1Cover />
          <Slide2Speaker />
          <Slide3Welcome />
          <Slide4Initiative />
          <Slide5ProductivityCheck />
          <Slide6DigitalProductivity />
          <Slide7EventScenario />
          <Slide8BetterEvent />
          <Slide9Toolbox />
        </div>

        <!-- Bottom: Footer Component (Dividing line, navigation buttons, logos & tag/title) -->
        <PresentationFooter />
      </div>
    </main>

    <!-- Synchronized Video & Slide Deck Controller -->
    <script is:inline>
      (() => {
        const deck = document.getElementById('presentationDeck');
        const prevBtn = document.getElementById('prevSlideBtn');
        const nextBtn = document.getElementById('nextSlideBtn');
        const video = document.getElementById('heroVideo');

        let currentSlide = 1;
        const totalSlides = 9;
        let isFadingOut = false;

        // Support URL parameter (e.g. ?slide=5) or hash (e.g. #slide-5 or #5) while cleanly defaulting to 1
        try {
          const params = new URLSearchParams(window.location.search);
          const paramSlide = params.get('slide');
          const hashSlide = window.location.hash.replace('#slide-', '').replace('#', '');
          const target = paramSlide || hashSlide;
          if (target && !isNaN(Number(target))) {
            const parsed = parseInt(target, 10);
            if (parsed >= 1 && parsed <= totalSlides) {
              currentSlide = parsed;
            }
          }
        } catch (e) {}

        // Video Synchronized Fade Controller
        const fadeInVideo = () => {
          if (!video) return;
          isFadingOut = false;
          video.style.opacity = '1';
        };

        if (video) {
          video.addEventListener('play', fadeInVideo);
          video.addEventListener('playing', fadeInVideo);

          video.addEventListener('timeupdate', () => {
            if (!video.duration || isFadingOut || currentSlide !== 1) return;
            const timeLeft = video.duration - video.currentTime;
            // Smooth fadeout over final 1.2s of video
            if (timeLeft <= 1.2) {
              isFadingOut = true;
              video.style.opacity = '0';
            }
          });

          video.addEventListener('ended', () => {
            if (currentSlide !== 1) return;
            video.style.opacity = '0';
            setTimeout(() => {
              if (currentSlide !== 1) return;
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            }, 350);
          });

          // Autoplay on slide 1 load
          if (!video.paused && video.currentTime > 0) {
            fadeInVideo();
          } else {
            video.play().then(fadeInVideo).catch(() => {});
          }
        }

        // Slide Deck Navigation
        function setSlide(num) {
          if (num < 1 || num > totalSlides) return;
          currentSlide = num;
          if (deck) {
            deck.setAttribute('data-current-slide', String(currentSlide));
            if (currentSlide === totalSlides) {
              deck.setAttribute('data-is-last-slide', 'true');
            } else {
              deck.removeAttribute('data-is-last-slide');
            }
          }

          try {
            history.replaceState(null, '', `#slide-${currentSlide}`);
          } catch (e) {}

          // Video state management between slides
          if (video) {
            if (currentSlide === 1) {
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            } else {
              video.pause();
            }
          }
        }

        // Apply URL parameter or hash if present on initial load
        if (currentSlide !== 1) {
          setSlide(currentSlide);
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => setSlide(currentSlide - 1));
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (currentSlide < totalSlides) {
              setSlide(currentSlide + 1);
            }
          });
        }

        // Keyboard Navigation (Arrow Keys & Space)
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
            if (currentSlide < totalSlides) {
              e.preventDefault();
              setSlide(currentSlide + 1);
            }
          } else if (e.key === 'ArrowLeft' || e.key === 'Backspace') {
            if (currentSlide > 1) {
              e.preventDefault();
              setSlide(currentSlide - 1);
            }
          }
        });
      })();
    </script>
  </body>
</html>
