---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter & Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
      :root {
        --ai-accent-tint: #e6f7f1;
        --brand-green: #1E824C;
        --text-dark: #1E293B;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--ai-accent-tint);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Main frame constrained to 90% of screen view (16:9 aspect ratio) */
      .presentation-frame {
        width: min(90vw, calc(90vh * 16 / 9));
        height: min(90vh, calc(90vw * 9 / 16));
        background-color: #FFFFFF;
        border-radius: 28px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(2rem, 4.5vw, 4rem) clamp(2.5rem, 5.5vw, 5rem);
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.06);
      }

      /* Subtle leaf / ambient light texture overlay matching slide aesthetic */
      .bg-overlay {
        position: absolute;
        inset: 0;
        background: 
          radial-gradient(ellipse at 85% 30%, rgba(240, 245, 242, 0.8) 0%, transparent 60%),
          radial-gradient(ellipse at 70% 80%, rgba(230, 247, 241, 0.4) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      .content-layer {
        position: relative;
        z-index: 10;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      /* Speaker Pill Badge */
      .speaker-pill {
        display: inline-flex;
        align-items: center;
        background-color: var(--brand-green);
        color: #FFFFFF;
        font-weight: 700;
        font-size: clamp(0.95rem, 1.5vw, 1.35rem);
        padding: 0.55rem 1.6rem;
        border-radius: 9999px;
        letter-spacing: -0.01em;
        width: fit-content;
      }

      /* Session Title */
      .session-title {
        font-size: clamp(2rem, 3.8vw, 3.6rem);
        font-weight: 800;
        color: #1A202C;
        letter-spacing: -0.025em;
        line-height: 1.18;
      }

      /* Horizontal line with embedded play button */
      .divider-container {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
        margin: 0.5rem 0 1rem 0;
      }

      .divider-line {
        width: 100%;
        height: 1.5px;
        background-color: #1A202C;
      }

      .play-circle {
        position: absolute;
        right: 0;
        width: clamp(2.5rem, 3.2vw, 3.2rem);
        height: clamp(2.5rem, 3.2vw, 3.2rem);
        border-radius: 9999px;
        background-color: var(--brand-green);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FFFFFF;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1), background-color 0.2s;
      }

      .play-circle:hover {
        transform: scale(1.06);
        background-color: #166534;
      }

      /* Program and Category Text */
      .program-tag {
        color: var(--brand-green);
        font-weight: 800;
        font-size: clamp(1.05rem, 1.7vw, 1.45rem);
        letter-spacing: -0.01em;
      }

      /* Partner Logos Bar */
      .logos-row {
        display: flex;
        align-items: center;
        gap: clamp(1.5rem, 3.5vw, 3.5rem);
        margin-top: clamp(1rem, 2vw, 2rem);
      }

      .logo-img-ministre {
        height: clamp(2.8rem, 4.5vw, 4.2rem);
        width: auto;
        object-fit: contain;
      }

      .logo-img-at {
        height: clamp(2rem, 3.2vw, 3rem);
        width: auto;
        object-fit: contain;
      }

      .logo-img-mobilis {
        height: clamp(1.6rem, 2.5vw, 2.4rem);
        width: auto;
        object-fit: contain;
      }
    </style>
  </head>
  <body>
    <!-- Main Presentation Card (90% of screen view, 16:9 ratio) -->
    <main class="presentation-frame">
      <div class="bg-overlay"></div>

      <div class="content-layer">
        <!-- Top: Speaker's Name in Green Pill -->
        <div class="pt-2">
          <div class="speaker-pill">
            Abderrahmane SAOUDI
          </div>
        </div>

        <!-- Middle: Title -->
        <div class="my-auto py-2">
          <h1 class="session-title">
            Digital Productivity: Work Smarter, Not Harder
          </h1>
        </div>

        <!-- Bottom: Dividing Line + Program Tag + Logos -->
        <div class="pb-2">
          <!-- Line with Right Play Circle -->
          <div class="divider-container">
            <div class="divider-line"></div>
            <div class="play-circle" title="Start Session">
              <svg class="w-4 h-4 ml-0.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>

          <!-- Program & Age Tag -->
          <div class="program-tag">
            7.77 Program | Age: 24-30
          </div>

          <!-- Institutional Logos -->
          <div class="logos-row">
            <!-- Ministère de la Poste et des Télécommunications -->
            <img 
              src={logoMinistere.src} 
              alt="Ministère de la Poste et des Télécommunications" 
              class="logo-img-ministre"
            />

            <!-- Algérie Télécom -->
            <img 
              src={logoAlgerieTelecom.src} 
              alt="Algérie Télécom" 
              class="logo-img-at"
            />

            <!-- Mobilis -->
            <img 
              src={logoMobilis.src} 
              alt="Mobilis" 
              class="logo-img-mobilis"
            />
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
