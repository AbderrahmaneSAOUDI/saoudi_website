---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
import videoSrc from './_assets/video.mp4';
import '../../styles/global.css';
import './_styles/presentation.css';
---

<!doctype html>
<html lang="fr" class="w-full h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#e6f7f1] text-slate-800 font-sans w-screen h-screen overflow-hidden flex items-center justify-center relative bg-particles antialiased select-none">
    <!-- 1. Background Ambient Multi-Aurora Morphing Blobs -->
    <div class="bg-aurora-container">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
      <div class="aurora-blob aurora-blob-4"></div>
    </div>

    <!-- 2. Twinkling Keynote Sparkle Stars (Continuous Loop) -->
    <svg class="sparkle-star sparkle-1 w-5 h-5 text-emerald-800/40" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-2 w-4 h-4 text-sky-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-3 w-4 h-4 text-amber-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>
    <svg class="sparkle-star sparkle-4 w-5 h-5 text-emerald-800/35" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0L14.5 9.5L24 12L14.5 14.5L12 24L9.5 14.5L0 12L9.5 9.5z" />
    </svg>

    <!-- 3. Floating Background Geometric Tech Nodes -->
    <svg class="floating-node node-1 w-6 h-6 text-emerald-800/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>
    <svg class="floating-node node-2 w-5 h-5 text-sky-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="12 2 22 12 12 22 2 12" />
    </svg>
    <svg class="floating-node node-3 w-5 h-5 text-emerald-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="8" />
    </svg>
    <svg class="floating-node node-4 w-6 h-6 text-amber-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>

    <!-- 4. Main Presentation Card (94% screen view, 16:9 ratio, bordered, levitating, 100% white background) -->
    <main 
      id="presentationDeck" 
      data-current-slide="1" 
      class="presentation-frame frame-border-pulse bg-white rounded-3xl sm:rounded-[32px] border-2 border-emerald-800/25 relative flex flex-col justify-between p-6 sm:p-10 md:p-12 lg:p-14 xl:p-16 overflow-hidden z-10 hover:border-emerald-800/50 transition-colors duration-500"
    >
      <!-- Architectural Corner L-Brackets -->
      <div class="corner-bracket corner-tl"></div>
      <div class="corner-bracket corner-tr"></div>
      <div class="corner-bracket corner-bl"></div>
      <div class="corner-bracket corner-br"></div>

      <div class="content-layer relative z-10 h-full flex flex-col justify-between">
        <!-- Top: Header positioned more to the bottom, taking only content-width -->
        <div class="pt-3 sm:pt-5 md:pt-7 lg:pt-8 flex items-center shrink-0">
          <!-- Green Pill: Takes only content width, smoothly morphs text to "7.77 Program" on Slide 2 -->
          <div class="speaker-pill relative overflow-hidden inline-flex items-center gap-2.5 bg-[#1E824C] hover:bg-[#006233] text-white font-bold text-sm sm:text-base md:text-lg px-5 sm:px-7 py-2 sm:py-2.5 rounded-full tracking-tight transition-all duration-400 cursor-default select-none max-w-max">
            <span class="relative flex h-2.5 w-2.5 shrink-0">
              <span class="live-dot-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-300"></span>
            </span>
            <!-- Slide 1 Name (takes its natural content width) -->
            <span class="pill-text-1 whitespace-nowrap">Abderrahmane SAOUDI</span>
            <!-- Slide 2 Converted Name (takes its natural content width) -->
            <span class="pill-text-2 whitespace-nowrap">7.77 Program</span>
          </div>
        </div>

        <!-- Middle: Dynamic Slide Panes Deck Area (Locked flex-1 layout so bottom bar NEVER shifts) -->
        <div class="relative w-full flex-1 my-auto flex items-center min-h-0 overflow-hidden">
          
          <!-- ================= SLIDE 1 PANE (AS IT WAS) ================= -->
          <section id="slide-1-content" class="slide-pane slide-pane-1 w-full flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8 lg:gap-8 xl:gap-10">
            <!-- Title Left Block -->
            <div class="flex flex-col gap-1 sm:gap-2 shrink-0">
              <!-- First Line: Green & Larger with Dynamic Shimmer Gradient -->
              <h1 class="title-highlight font-black text-3xl sm:text-4xl md:text-5xl lg:text-[3.8rem] xl:text-[4.4rem] tracking-tight leading-[1.08] whitespace-nowrap">
                Digital Productivity
              </h1>
              <!-- Second Line: Dark & Complementary -->
              <h2 class="title-subtext font-light text-xl sm:text-2xl md:text-3xl lg:text-3xl xl:text-4xl text-slate-900 tracking-tight leading-tight">
                Work Smarter, Not Harder
              </h2>
            </div>

            <!-- Video Right Block (Bigger, borderless, pure transparent fade loop) -->
            <div class="video-wrapper flex-1 w-full max-w-[420px] sm:max-w-[540px] md:max-w-[660px] lg:max-w-[780px] xl:max-w-[880px] 2xl:max-w-[940px] flex justify-center md:justify-end">
              <div class="relative w-full aspect-video rounded-3xl overflow-hidden bg-transparent">
                <video 
                  id="heroVideo"
                  src={videoSrc}
                  autoplay
                  muted
                  playsinline
                  class="hero-video w-full h-full object-contain md:object-cover bg-transparent pointer-events-none opacity-0"
                ></video>
              </div>
            </div>
          </section>

          <!-- ================= SLIDE 2 PANE (BIGGER LEFT CARD & CLEAN BIO CHIPS) ================= -->
          <section id="slide-2-content" class="slide-pane slide-pane-2 w-full grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 xl:gap-10 items-center">
            <!-- Left Column: Bigger Profile Card with Avatar, Google Colors Ring, Name, & Attractive Website Badge -->
            <div class="col-span-1 md:col-span-5 flex flex-col items-center text-center p-6 sm:p-8 rounded-3xl bg-emerald-50/50 border-2 border-emerald-800/20 card-float">
              <!-- Profile Avatar with Continuous Google Colors Gradient Ring & Spinning Celestial Dashed Orbit -->
              <div class="relative w-36 h-36 sm:w-44 sm:h-44 md:w-48 md:h-48 lg:w-52 lg:h-52 rounded-full p-2 avatar-gradient-ring mb-4 transition-transform duration-300">
                <!-- Spinning Dashed Orbit Ring Around Avatar -->
                <div class="avatar-orbit-ring absolute -inset-3.5 rounded-full border-2 border-dashed border-emerald-600/35 pointer-events-none"></div>
                
                <img 
                  src="/profile.webp" 
                  alt="Abderrahmane SAOUDI" 
                  width="208"
                  height="208"
                  class="w-full h-full object-cover rounded-full bg-white relative z-10"
                  onerror="if(!this.getAttribute('data-fallback-tried')){this.setAttribute('data-fallback-tried','1');this.setAttribute('src','/profile.webp');}"
                />
                <!-- Active Speaker Live Pulse Badge -->
                <span class="absolute bottom-2 right-2 z-20 w-5 h-5 rounded-full bg-[#1E824C] border-2 border-white flex items-center justify-center" title="Intervenant Actif">
                  <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
                </span>
              </div>

              <!-- Speaker Name with Dynamic Shimmer Gradient -->
              <h2 class="title-highlight font-black text-2xl sm:text-3xl md:text-4xl tracking-tight leading-tight">
                Abderrahmane SAOUDI
              </h2>

              <!-- Subtitle Role -->
              <p class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-[#006233] mt-1.5">
                Tech Lead & Creative Engineer
              </p>

              <!-- Attractive Website Badge (www.saoudi.online) with continuous shimmer & light sweep -->
              <a 
                href="https://saoudi.online" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="website-badge mt-4 inline-flex items-center gap-2.5 px-5 sm:px-6 py-2 sm:py-2.5 rounded-full bg-[#1E824C] hover:bg-[#006233] text-white font-mono text-sm sm:text-base font-bold tracking-tight ring-2 ring-emerald-500/40 transition-all duration-300 select-none cursor-pointer"
              >
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span>www.saoudi.online</span>
                <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7m0 0H7m10 0v10" />
                </svg>
              </a>
            </div>

            <!-- Right Column: 3 Clean Punchy Bio Pillars (No Descriptions, High Visual Polish) -->
            <div class="col-span-1 md:col-span-7 flex flex-col gap-4 sm:gap-5">
              <!-- Pillar 1: Graphic Designer and Advisor -->
              <div class="bio-card bio-card-1 flex items-center justify-between p-4 sm:p-5 lg:p-6 rounded-2xl sm:rounded-3xl bg-emerald-50/60 border-2 border-emerald-600/30">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#1E824C] text-white flex items-center justify-center shrink-0 icon-box-pulse">
                    <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-base sm:text-lg lg:text-xl font-black text-slate-900 tracking-tight">
                      Graphic Designer and Advisor
                    </h3>
                  </div>
                </div>
                <span class="hidden sm:inline-flex px-3.5 py-1 rounded-full bg-white border border-emerald-600/25 text-xs font-bold text-[#006233] shrink-0">
                  Art Direction • UI/UX
                </span>
              </div>

              <!-- Pillar 2: Mobile and Frontend Web Developer -->
              <div class="bio-card bio-card-2 flex items-center justify-between p-4 sm:p-5 lg:p-6 rounded-2xl sm:rounded-3xl bg-sky-50/60 border-2 border-sky-600/30">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#0080C8] text-white flex items-center justify-center shrink-0 icon-box-pulse">
                    <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-base sm:text-lg lg:text-xl font-black text-slate-900 tracking-tight">
                      Mobile and Frontend Web Developer
                    </h3>
                  </div>
                </div>
                <span class="hidden sm:inline-flex px-3.5 py-1 rounded-full bg-white border border-sky-600/25 text-xs font-bold text-[#0080C8] shrink-0">
                  Flutter • Web SSR
                </span>
              </div>

              <!-- Pillar 3: Former GDG Ghardaia Club President -->
              <div class="bio-card bio-card-3 flex items-center justify-between p-4 sm:p-5 lg:p-6 rounded-2xl sm:rounded-3xl bg-amber-50/60 border-2 border-amber-600/30">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#D97706] text-white flex items-center justify-center shrink-0 icon-box-pulse">
                    <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-base sm:text-lg lg:text-xl font-black text-slate-900 tracking-tight">
                      Former GDG Ghardaia Club President
                    </h3>
                  </div>
                </div>
                <span class="hidden sm:inline-flex px-3.5 py-1 rounded-full bg-white border border-amber-600/25 text-xs font-bold text-[#D97706] shrink-0">
                  GDG Community Lead
                </span>
              </div>
            </div>
          </section>

        </div>

        <!-- Bottom: Dividing Line + Solid Green Buttons (No Transparency) + Scaled Logos (LOCKED HEIGHT) -->
        <div class="pb-1 shrink-0">
          <!-- Horizontal Line with Previous on Left and Next on Right (Locked Vertical Height) -->
          <div class="relative w-full flex items-center my-2 sm:my-3">
            <!-- Continuous Moving Light Energy Pulse Beam Across the Divider Line -->
            <div class="divider-line relative w-full h-0.5 bg-slate-900 overflow-hidden"></div>

            <!-- Previous Button on the LEFT side of the H line (Solid Green, No Transparency) -->
            <div class="prev-btn-wrapper absolute left-0 flex items-center justify-center z-20">
              <button 
                id="prevSlideBtn" 
                type="button" 
                aria-label="Previous Slide" 
                class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#1E824C] hover:bg-[#006233] text-white border-2 border-white flex items-center justify-center transition-all duration-300 hover:scale-115 hover:-rotate-6 cursor-pointer select-none" 
                title="Slide Précédente"
              >
                <svg class="w-4 h-4 mr-0.5 fill-none stroke-current stroke-[2.5]" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
            </div>

            <!-- Next / Play Button on the RIGHT side of the H line (Solid Green, No Transparency on all slides) -->
            <div class="next-btn-wrapper absolute right-0 flex items-center justify-center z-20">
              <!-- Spinning Dashed Orbit Ring -->
              <div class="orbit-ring absolute -inset-6 rounded-full border border-dashed border-emerald-600/30 pointer-events-none"></div>
              <div class="sonar-wave absolute -inset-1.5 rounded-full border-2 border-emerald-600/45 pointer-events-none"></div>
              <div class="sonar-wave-2 absolute -inset-3.5 rounded-full border-[1.5px] border-sky-600/35 pointer-events-none"></div>
              <div class="sonar-wave-3 absolute -inset-5.5 rounded-full border border-emerald-500/25 pointer-events-none"></div>
              <button 
                id="nextSlideBtn" 
                type="button" 
                aria-label="Next Slide" 
                class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#1E824C] hover:bg-[#006233] text-white border-2 border-white flex items-center justify-center transition-all duration-300 hover:scale-115 hover:rotate-6 cursor-pointer select-none" 
                title="Slide Suivante"
              >
                <svg class="play-icon w-4 h-4 ml-0.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Bottom Row: Logos on Left, Tag (Slide 1) or Title (Slide 2) on Right (Locked Vertical Height) -->
          <div class="flex items-center justify-between gap-4 mt-2 sm:mt-4 h-12 sm:h-14">
            <!-- Left: Institutional Logos Group (Continuous Levitation Animation) -->
            <div class="footer-logos-container flex items-center gap-4 sm:gap-7 md:gap-9">
              <!-- Ministère de la Poste et des Télécommunications -->
              <div class="logo-wrapper-1 flex items-center">
                <img 
                  src={logoMinistere.src} 
                  alt="Ministère de la Poste et des Télécommunications" 
                  class="h-10 sm:h-14 md:h-16 w-auto object-contain"
                />
              </div>

              <!-- Algérie Télécom -->
              <div class="logo-wrapper-2 flex items-center">
                <img 
                  src={logoAlgerieTelecom.src} 
                  alt="Algérie Télécom" 
                  class="h-7 sm:h-10 md:h-12 w-auto object-contain"
                />
              </div>

              <!-- Mobilis -->
              <div class="logo-wrapper-3 flex items-center">
                <img 
                  src={logoMobilis.src} 
                  alt="Mobilis" 
                  class="h-6 sm:h-8 md:h-9 w-auto object-contain"
                />
              </div>
            </div>

            <!-- Right: Tag on Slide 1 -> Morphs to Presentation Title on Slide 2 -->
            <div class="relative flex items-center justify-end shrink-0 h-full">
              <!-- Slide 1: 7.77 Program | Age: 24-30 (Right-aligned per user request) -->
              <div class="footer-slide1-tag program-tag text-[#1E824C] font-extrabold text-base sm:text-xl md:text-2xl tracking-tight inline-flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
                <span>7.77 Program | Age: 24-30</span>
              </div>

              <!-- Slide 2: Digital Productivity: Work Smarter, Not Harder -->
              <div class="footer-slide2-title absolute right-0 text-right">
                <div class="title-highlight font-black text-sm sm:text-base md:text-lg lg:text-xl tracking-tight leading-tight whitespace-nowrap">
                  Digital Productivity
                </div>
                <div class="text-xs sm:text-sm font-light text-slate-700 tracking-tight leading-tight whitespace-nowrap">
                  Work Smarter, Not Harder
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </main>

    <!-- Synchronized Video & Slide Deck Controller -->
    <script is:inline>
      (() => {
        const deck = document.getElementById('presentationDeck');
        const prevBtn = document.getElementById('prevSlideBtn');
        const nextBtn = document.getElementById('nextSlideBtn');
        const video = document.getElementById('heroVideo');

        let currentSlide = 1;
        const totalSlides = 2;
        let isFadingOut = false;

        // Video Synchronized Fade Controller
        const fadeInVideo = () => {
          if (!video) return;
          isFadingOut = false;
          video.style.opacity = '1';
        };

        if (video) {
          video.addEventListener('play', fadeInVideo);
          video.addEventListener('playing', fadeInVideo);

          video.addEventListener('timeupdate', () => {
            if (!video.duration || isFadingOut || currentSlide !== 1) return;
            const timeLeft = video.duration - video.currentTime;
            // Smooth fadeout over final 1.2s of video
            if (timeLeft <= 1.2) {
              isFadingOut = true;
              video.style.opacity = '0';
            }
          });

          video.addEventListener('ended', () => {
            if (currentSlide !== 1) return;
            video.style.opacity = '0';
            setTimeout(() => {
              if (currentSlide !== 1) return;
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            }, 350);
          });

          // Autoplay on slide 1 load
          if (!video.paused && video.currentTime > 0) {
            fadeInVideo();
          } else {
            video.play().then(fadeInVideo).catch(() => {});
          }
        }

        // Slide Deck Navigation
        function setSlide(num) {
          if (num < 1 || num > totalSlides) return;
          currentSlide = num;
          if (deck) deck.setAttribute('data-current-slide', String(currentSlide));

          // Video state management between slides
          if (video) {
            if (currentSlide === 1) {
              video.currentTime = 0;
              isFadingOut = false;
              video.play().then(fadeInVideo).catch(() => {});
            } else {
              video.pause();
            }
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => setSlide(currentSlide - 1));
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (currentSlide < totalSlides) {
              setSlide(currentSlide + 1);
            } else {
              setSlide(1); // Smooth loop back to first slide
            }
          });
        }

        // Keyboard Navigation (Arrow Keys & Space)
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            if (currentSlide < totalSlides) {
              setSlide(currentSlide + 1);
            } else {
              setSlide(1);
            }
          } else if (e.key === 'ArrowLeft' || e.key === 'Backspace') {
            if (currentSlide > 1) {
              e.preventDefault();
              setSlide(currentSlide - 1);
            }
          }
        });
      })();
    </script>
  </body>
</html>
