---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr" class="w-full h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      :root {
        --ai-accent-tint: #e6f7f1;
        --brand-green: #1E824C;
        --brand-green-dark: #006233;
        --brand-blue: #0080C8;
        --text-dark: #1A202C;
        --ease-m3: cubic-bezier(0.2, 0, 0.2, 1);
        --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* Animated Glowing Floating Orbs in Background */
      .bg-orb {
        position: fixed;
        border-radius: 9999px;
        pointer-events: none;
        z-index: 0;
        filter: blur(50px);
        opacity: 0.65;
        will-change: transform;
      }

      .bg-orb-1 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(0, 98, 51, 0.22) 0%, rgba(30, 130, 76, 0.08) 60%, transparent 70%);
        top: -80px;
        left: -80px;
        animation: orbDrift1 22s ease-in-out infinite alternate;
      }

      .bg-orb-2 {
        width: 550px;
        height: 550px;
        background: radial-gradient(circle, rgba(0, 128, 200, 0.18) 0%, rgba(0, 98, 51, 0.06) 60%, transparent 70%);
        bottom: -100px;
        right: -100px;
        animation: orbDrift2 26s ease-in-out infinite alternate;
      }

      .bg-orb-3 {
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(249, 171, 0, 0.12) 0%, transparent 70%);
        top: 40%;
        right: 20%;
        animation: orbDrift3 18s ease-in-out infinite alternate;
      }

      @keyframes orbDrift1 {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(120px, 80px, 0) scale(1.15); }
        100% { transform: translate3d(60px, 140px, 0) scale(0.95); }
      }

      @keyframes orbDrift2 {
        0% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(-140px, -90px, 0) scale(1.1); }
        100% { transform: translate3d(-70px, -150px, 0) scale(1.05); }
      }

      @keyframes orbDrift3 {
        0% { transform: translate3d(0, 0, 0) scale(0.9); }
        100% { transform: translate3d(-80px, 60px, 0) scale(1.2); }
      }

      /* Animated Particle Background System (Pure CSS) */
      .bg-particles::before,
      .bg-particles::after {
        content: '';
        position: fixed;
        inset: -50px;
        pointer-events: none;
        z-index: 0;
        will-change: transform;
      }

      .bg-particles::before {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.4) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(0, 128, 200, 0.3) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(30, 130, 76, 0.3) 1.2px, transparent 1.2px),
          radial-gradient(circle, rgba(249, 171, 0, 0.28) 1.5px, transparent 1.5px);
        background-size: 70px 70px, 95px 95px, 70px 70px, 120px 120px;
        background-position: 0 0, 30% 15%, 25% 68%, 82% 88%;
        background-repeat: repeat;
        animation: bgPoints 42s linear infinite;
        opacity: 0.9;
      }

      .bg-particles::after {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.22) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 128, 200, 0.2) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 98, 51, 0.18) 1px, transparent 1.5px),
          radial-gradient(circle, rgba(255, 255, 255, 0.7) 1px, transparent 1.5px);
        background-repeat: repeat;
        background-size: 120px 120px, 100px 100px, 24px 24px, 24px 24px;
        background-position: 8% 90%, 85% 60%, 0 0, 14px 14px;
        animation: bgStars 20s linear infinite;
        opacity: 0.95;
      }

      @keyframes bgPoints {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-60px, 45px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      @keyframes bgStars {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(90px, -90px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      /* Main presentation frame: ~94% of screen view with 16:9 ratio and animated border */
      .presentation-frame {
        width: min(94vw, calc(94vh * 16 / 9));
        height: min(94vh, calc(94vw * 9 / 16));
        animation: frameEntrance 0.8s var(--ease-spring) forwards, frameLevitate 9s ease-in-out 1s infinite;
      }

      @keyframes frameEntrance {
        from {
          opacity: 0;
          transform: scale(0.93) translateY(24px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes frameLevitate {
        0%, 100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-5px);
        }
      }

      /* Subtle inner botanical light texture */
      .bg-overlay {
        position: absolute;
        inset: 0;
        background: 
          radial-gradient(ellipse at 90% 25%, rgba(230, 247, 241, 0.8) 0%, transparent 60%),
          radial-gradient(ellipse at 75% 85%, rgba(240, 249, 245, 0.6) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      /* Floating Decorative Background Tags */
      .floating-tag {
        position: absolute;
        pointer-events: none;
        user-select: none;
        z-index: 1;
        opacity: 0.75;
      }

      .tag-1 {
        top: 2.5rem;
        right: 3.5rem;
        animation: tagFloat1 6s ease-in-out infinite alternate;
      }

      .tag-2 {
        bottom: 5.5rem;
        right: 4.5rem;
        animation: tagFloat2 7s ease-in-out 0.5s infinite alternate;
      }

      @keyframes tagFloat1 {
        0% { transform: translateY(0px) rotate(0deg); }
        100% { transform: translateY(-8px) rotate(2deg); }
      }

      @keyframes tagFloat2 {
        0% { transform: translateY(0px) rotate(0deg); }
        100% { transform: translateY(8px) rotate(-2deg); }
      }

      /* Speaker Pill Shimmer Sweep */
      .speaker-pill-wrapper {
        animation: slideDownFade 0.65s var(--ease-spring) 0.15s backwards;
      }

      .speaker-pill::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(60deg, transparent 40%, rgba(255, 255, 255, 0.3) 50%, transparent 60%);
        transform: translateX(-100%);
        animation: shimmerSweep 4.5s ease-in-out 1.5s infinite;
      }

      @keyframes shimmerSweep {
        0% { transform: translateX(-100%); }
        25%, 100% { transform: translateX(100%); }
      }

      @keyframes livePulse {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(2.4); opacity: 0; }
      }

      .live-dot-pulse {
        animation: livePulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      @keyframes slideDownFade {
        from {
          opacity: 0;
          transform: translateY(-20px) scale(0.95);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      /* Title Typography Animations */
      .title-highlight {
        background: linear-gradient(110deg, #1E824C 0%, #006233 25%, #0080C8 50%, #1E824C 75%, #006233 100%);
        background-size: 250% 100%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: slideRightFade 0.7s var(--ease-spring) 0.25s backwards, textGradientFlow 8s ease-in-out infinite;
        will-change: background-position;
      }

      .title-subtext {
        animation: slideRightFade 0.7s var(--ease-spring) 0.38s backwards;
      }

      @keyframes textGradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      @keyframes slideRightFade {
        from {
          opacity: 0;
          transform: translateX(-30px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      /* Animated Horizontal Divider Line with Energy Beam */
      .divider-line {
        transform-origin: left;
        animation: expandLine 0.8s var(--ease-m3) 0.45s backwards;
      }

      .divider-line::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 180px;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, #1E824C 40%, #0080C8 80%, transparent 100%);
        animation: beamSweep 3.8s ease-in-out 1.2s infinite;
      }

      @keyframes beamSweep {
        0% { transform: translateX(-180px); }
        40%, 100% { transform: translateX(1800px); }
      }

      @keyframes expandLine {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      /* Animated Play Button with Sonar Radar Wave */
      .play-circle-wrapper {
        animation: popIn 0.6s var(--ease-spring) 0.6s backwards;
      }

      .sonar-wave {
        animation: sonarPulse 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      }

      .sonar-wave-2 {
        animation: sonarPulse 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.7s infinite;
      }

      @keyframes sonarPulse {
        0% {
          transform: scale(0.85);
          opacity: 0.9;
        }
        100% {
          transform: scale(1.6);
          opacity: 0;
        }
      }

      .play-icon {
        animation: iconNudge 2.2s ease-in-out infinite;
      }

      @keyframes iconNudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(2.5px); }
      }

      @keyframes popIn {
        from {
          opacity: 0;
          transform: scale(0) rotate(-45deg);
        }
        to {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }
      }

      /* Animated Program & Category Tag */
      .program-tag {
        animation: slideUpFade 0.65s var(--ease-spring) 0.55s backwards;
      }

      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Animated Logos Row with Sequential Delays */
      .logo-wrapper-1 {
        animation: slideUpFade 0.65s var(--ease-spring) 0.7s backwards, logoBob 5s ease-in-out 1.5s infinite;
      }

      .logo-wrapper-2 {
        animation: slideUpFade 0.65s var(--ease-spring) 0.82s backwards, logoBob 5.5s ease-in-out 1.8s infinite;
      }

      .logo-wrapper-3 {
        animation: slideUpFade 0.65s var(--ease-spring) 0.94s backwards, logoBob 6s ease-in-out 2.1s infinite;
      }

      @keyframes logoBob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
      }

      /* Respect Reduced Motion */
      @media (prefers-reduced-motion: reduce) {
        .bg-particles::before,
        .bg-particles::after,
        .bg-orb,
        .presentation-frame,
        .speaker-pill::after,
        .live-dot-pulse,
        .title-highlight,
        .title-subtext,
        .divider-line,
        .divider-line::after,
        .play-circle-wrapper,
        .sonar-wave,
        .sonar-wave-2,
        .play-icon,
        .program-tag,
        .logo-wrapper-1,
        .logo-wrapper-2,
        .logo-wrapper-3,
        .floating-tag {
          animation: none !important;
          transition: none !important;
          transform: none !important;
          opacity: 1 !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#e6f7f1] text-slate-800 font-sans w-screen h-screen overflow-hidden flex items-center justify-center relative bg-particles antialiased">
    <!-- Background Ambient Glowing Orbs -->
    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-orb bg-orb-3"></div>

    <!-- Main Presentation Card (94% screen view, 16:9 ratio, bordered, levitating) -->
    <main class="presentation-frame bg-white rounded-3xl sm:rounded-[32px] border-2 border-emerald-800/25 relative flex flex-col justify-between p-6 sm:p-10 md:p-14 lg:p-16 overflow-hidden z-10 hover:border-emerald-800/45 transition-colors duration-500">
      <div class="bg-overlay"></div>

     

      <div class="content-layer relative z-10 h-full flex flex-col justify-between">
        <!-- Top: Speaker's Name in Green Pill -->
        <div class="pt-1">
          <div class="speaker-pill-wrapper flex items-center">
            <div class="speaker-pill relative overflow-hidden inline-flex items-center gap-2.5 bg-[#1E824C] hover:bg-[#006233] text-white font-bold text-sm sm:text-base md:text-lg px-5 sm:px-7 py-2 sm:py-2.5 rounded-full tracking-tight transition-transform duration-200 hover:-translate-y-0.5 cursor-default select-none">
              <span class="relative flex h-2.5 w-2.5">
                <span class="live-dot-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-300"></span>
              </span>
              <span>Abderrahmane SAOUDI</span>
            </div>
          </div>
        </div>

        <!-- Middle: Title -->
        <div class="my-auto py-2">
          <div class="flex flex-col gap-1 sm:gap-2">
            <!-- First Line: Green & Larger with Dynamic Shimmer Gradient -->
            <h1 class="title-highlight font-black text-4xl sm:text-6xl md:text-7xl lg:text-[5.2rem] tracking-tight leading-[1.08] whitespace-nowrap">
              Digital Productivity
            </h1>
            <!-- Second Line: Dark & Complementary -->
            <h2 class="title-subtext font-extrabold text-2xl sm:text-4xl md:text-5xl text-slate-900 tracking-tight leading-tight">
              Work Smarter, Not Harder
            </h2>
          </div>
        </div>

        <!-- Bottom: Dividing Line + Program Tag + Logos -->
        <div class="pb-1">
          <!-- Line with Right Play Circle & Sonar Waves -->
          <div class="relative w-full flex items-center my-2 sm:my-3">
            <div class="divider-line relative w-full h-[2px] bg-slate-900 overflow-hidden"></div>
            <div class="play-circle-wrapper absolute right-0 flex items-center justify-center">
              <div class="sonar-wave absolute -inset-1.5 rounded-full border-2 border-emerald-600/40 pointer-events-none"></div>
              <div class="sonar-wave-2 absolute -inset-3 rounded-full border-[1.5px] border-sky-600/30 pointer-events-none"></div>
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#1E824C] hover:bg-[#006233] flex items-center justify-center text-white border-2 border-white transition-all duration-300 hover:scale-110 hover:rotate-6 cursor-pointer select-none" title="Session 7.77">
                <svg class="play-icon w-4 h-4 ml-0.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Program & Age Tag -->
          <div class="program-tag text-[#1E824C] font-extrabold text-base sm:text-xl md:text-2xl tracking-tight inline-flex items-center gap-2">
            <span>7.77 Program | Age: 24-30</span>
          </div>

          <!-- Institutional Logos -->
          <div class="flex items-center gap-6 sm:gap-10 md:gap-14 mt-4 sm:mt-6">
            <!-- Ministère de la Poste et des Télécommunications -->
            <div class="logo-wrapper-1 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
              <img 
                src={logoMinistere.src} 
                alt="Ministère de la Poste et des Télécommunications" 
                class="h-12 sm:h-16 md:h-18 w-auto object-contain"
              />
            </div>

            <!-- Algérie Télécom -->
            <div class="logo-wrapper-2 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
              <img 
                src={logoAlgerieTelecom.src} 
                alt="Algérie Télécom" 
                class="h-8 sm:h-11 md:h-13 w-auto object-contain"
              />
            </div>

            <!-- Mobilis -->
            <div class="logo-wrapper-3 flex items-center transition-transform duration-300 hover:-translate-y-1.5 hover:scale-105">
              <img 
                src={logoMobilis.src} 
                alt="Mobilis" 
                class="h-7 sm:h-9 md:h-10 w-auto object-contain"
              />
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
