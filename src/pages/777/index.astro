---
import logoMinistere from './_assets/logo_ministre.png';
import logoAlgerieTelecom from './_assets/logo_Algérie_Télécom.svg';
import logoMobilis from './_assets/logo_Mobilis.svg';
import '../../styles/global.css';
---

<!doctype html>
<html lang="fr" class="w-full h-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Productivity: Work Smarter, Not Harder • 7.77 Program</title>
    <meta name="description" content="Digital Productivity: Work Smarter, Not Harder by Abderrahmane SAOUDI - 777 Program (Age: 24-30)." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Digital Productivity: Work Smarter, Not Harder • 7.77 Program" />
    <meta property="og:description" content="Presentation by Abderrahmane SAOUDI for the 777 Program." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style>
      :root {
        --ai-accent-tint: #e6f7f1;
        --brand-green: #1E824C;
        --brand-green-dark: #006233;
        --brand-green-light: #e6f7f1;
        --brand-blue: #0080C8;
        --text-dark: #1A202C;
        --ease-m3: cubic-bezier(0.2, 0, 0.2, 1);
        --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* === 1. Multi-Layered Fluid Aurora Mesh Gradients === */
      .bg-aurora-container {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .aurora-blob {
        position: absolute;
        border-radius: 9999px;
        filter: blur(65px);
        opacity: 0.75;
        will-change: transform;
      }

      .aurora-blob-1 {
        width: 520px;
        height: 520px;
        background: radial-gradient(circle, rgba(0, 98, 51, 0.28) 0%, rgba(30, 130, 76, 0.12) 50%, transparent 70%);
        top: -100px;
        left: -100px;
        animation: auroraMorph1 24s ease-in-out infinite alternate;
      }

      .aurora-blob-2 {
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(0, 128, 200, 0.24) 0%, rgba(0, 98, 51, 0.08) 50%, transparent 70%);
        bottom: -120px;
        right: -120px;
        animation: auroraMorph2 28s ease-in-out infinite alternate;
      }

      .aurora-blob-3 {
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgba(249, 171, 0, 0.16) 0%, rgba(30, 130, 76, 0.06) 60%, transparent 70%);
        top: 35%;
        right: 15%;
        animation: auroraMorph3 20s ease-in-out infinite alternate;
      }

      .aurora-blob-4 {
        width: 480px;
        height: 480px;
        background: radial-gradient(circle, rgba(52, 168, 83, 0.2) 0%, rgba(0, 128, 200, 0.08) 60%, transparent 70%);
        bottom: 25%;
        left: 20%;
        animation: auroraMorph4 22s ease-in-out infinite alternate;
      }

      @keyframes auroraMorph1 {
        0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
        50% { transform: translate3d(140px, 100px, 0) scale(1.18) rotate(45deg); }
        100% { transform: translate3d(70px, 180px, 0) scale(0.92) rotate(90deg); }
      }

      @keyframes auroraMorph2 {
        0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
        50% { transform: translate3d(-160px, -110px, 0) scale(1.15) rotate(-45deg); }
        100% { transform: translate3d(-80px, -180px, 0) scale(1.05) rotate(-90deg); }
      }

      @keyframes auroraMorph3 {
        0% { transform: translate3d(0, 0, 0) scale(0.95); }
        50% { transform: translate3d(-100px, 80px, 0) scale(1.25); }
        100% { transform: translate3d(-40px, -60px, 0) scale(1.0); }
      }

      @keyframes auroraMorph4 {
        0% { transform: translate3d(0, 0, 0) scale(1.05); }
        50% { transform: translate3d(110px, -90px, 0) scale(0.9); }
        100% { transform: translate3d(50px, 80px, 0) scale(1.2); }
      }

      /* === 2. Enhanced Floating Particle Constellation === */
      .bg-particles::before,
      .bg-particles::after {
        content: '';
        position: fixed;
        inset: -60px;
        pointer-events: none;
        z-index: 0;
        will-change: transform;
      }

      .bg-particles::before {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.45) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(0, 128, 200, 0.35) 1.5px, transparent 1.5px),
          radial-gradient(circle, rgba(30, 130, 76, 0.35) 1.2px, transparent 1.2px),
          radial-gradient(circle, rgba(249, 171, 0, 0.32) 1.5px, transparent 1.5px);
        background-size: 70px 70px, 95px 95px, 70px 70px, 120px 120px;
        background-position: 0 0, 30% 15%, 25% 68%, 82% 88%;
        background-repeat: repeat;
        animation: bgPoints 36s linear infinite;
        opacity: 0.95;
      }

      .bg-particles::after {
        background-image:
          radial-gradient(circle, rgba(0, 98, 51, 0.25) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 128, 200, 0.22) 1.5px, transparent 2px),
          radial-gradient(circle, rgba(0, 98, 51, 0.2) 1px, transparent 1.5px),
          radial-gradient(circle, rgba(255, 255, 255, 0.8) 1px, transparent 1.5px);
        background-repeat: repeat;
        background-size: 120px 120px, 100px 100px, 24px 24px, 24px 24px;
        background-position: 8% 90%, 85% 60%, 0 0, 14px 14px;
        animation: bgStars 18s linear infinite;
        opacity: 1;
      }

      @keyframes bgPoints {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(-70px, 50px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      @keyframes bgStars {
        0% { transform: translate3d(0, 0, 0); }
        50% { transform: translate3d(100px, -100px, 0); }
        100% { transform: translate3d(0, 0, 0); }
      }

      /* === 3. Floating Ambient Tech Geometric Nodes === */
      .floating-node {
        position: fixed;
        pointer-events: none;
        z-index: 1;
        opacity: 0.35;
        will-change: transform;
      }

      .node-1 { top: 12%; left: 8%; animation: floatNode1 14s ease-in-out infinite; }
      .node-2 { top: 75%; left: 6%; animation: floatNode2 16s ease-in-out 1s infinite; }
      .node-3 { top: 18%; right: 10%; animation: floatNode3 15s ease-in-out 2s infinite; }
      .node-4 { bottom: 12%; right: 8%; animation: floatNode1 18s ease-in-out 3s infinite; }

      @keyframes floatNode1 {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
      }

      @keyframes floatNode2 {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(22px) rotate(-180deg); }
      }

      @keyframes floatNode3 {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(-15px, -20px) rotate(120deg); }
      }

      /* === 4. Main Presentation Frame Dynamics === */
      .presentation-frame {
        width: min(94vw, calc(94vh * 16 / 9));
        height: min(94vh, calc(94vw * 9 / 16));
        animation: frameEntrance 0.85s var(--ease-spring) forwards, frameLevitate 8s ease-in-out 1s infinite;
      }

      @keyframes frameEntrance {
        from {
          opacity: 0;
          transform: scale(0.92) translateY(30px);
        }
        to {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes frameLevitate {
        0%, 100% {
          transform: translateY(0px) rotate(0deg);
        }
        50% {
          transform: translateY(-6px) rotate(0.1deg);
        }
      }

      /* Dynamic Border Hue Shift */
      .frame-border-pulse {
        animation: borderPulse 8s ease-in-out infinite;
      }

      @keyframes borderPulse {
        0%, 100% {
          border-color: rgba(0, 98, 51, 0.25);
        }
        50% {
          border-color: rgba(0, 128, 200, 0.35);
        }
      }

      /* Subtle inner botanical light texture */
      .bg-overlay {
        position: absolute;
        inset: 0;
        background: 
          radial-gradient(ellipse at 90% 25%, rgba(230, 247, 241, 0.85) 0%, transparent 60%),
          radial-gradient(ellipse at 75% 85%, rgba(240, 249, 245, 0.65) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      /* Floating Decorative Background Tags */
      .floating-tag {
        position: absolute;
        pointer-events: none;
        user-select: none;
        z-index: 1;
        opacity: 0.8;
      }

      .tag-1 {
        top: 2.2rem;
        right: 3.5rem;
        animation: tagFloat1 5.5s ease-in-out infinite alternate;
      }

      .tag-2 {
        bottom: 5.5rem;
        right: 4.2rem;
        animation: tagFloat2 6.5s ease-in-out 0.5s infinite alternate;
      }

      .tag-3 {
        top: 48%;
        right: 2.8rem;
        animation: tagFloat3 7s ease-in-out 1s infinite alternate;
      }

      @keyframes tagFloat1 {
        0% { transform: translateY(0px) rotate(0deg); }
        100% { transform: translateY(-10px) rotate(2deg); }
      }

      @keyframes tagFloat2 {
        0% { transform: translateY(0px) rotate(0deg); }
        100% { transform: translateY(10px) rotate(-2deg); }
      }

      @keyframes tagFloat3 {
        0% { transform: translateY(0px) scale(0.98); }
        100% { transform: translateY(-6px) scale(1.02); }
      }

      /* Speaker Pill Shimmer Sweep */
      .speaker-pill-wrapper {
        animation: slideDownFade 0.7s var(--ease-spring) 0.15s backwards;
      }

      .speaker-pill::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(60deg, transparent 35%, rgba(255, 255, 255, 0.4) 50%, transparent 65%);
        transform: translateX(-100%);
        animation: shimmerSweep 4s ease-in-out 1.2s infinite;
      }

      @keyframes shimmerSweep {
        0% { transform: translateX(-100%); }
        30%, 100% { transform: translateX(100%); }
      }

      @keyframes livePulse {
        0% { transform: scale(1); opacity: 0.85; }
        100% { transform: scale(2.6); opacity: 0; }
      }

      .live-dot-pulse {
        animation: livePulse 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      @keyframes slideDownFade {
        from {
          opacity: 0;
          transform: translateY(-24px) scale(0.94);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      /* === 5. Flowing Text Gradient Animation === */
      .title-highlight {
        background: linear-gradient(110deg, #006233 0%, #1E824C 25%, #0080C8 50%, #22C55E 75%, #006233 100%);
        background-size: 250% 100%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: slideRightFade 0.75s var(--ease-spring) 0.25s backwards, textGradientFlow 7s ease-in-out infinite;
        will-change: background-position;
      }

      .title-subtext {
        animation: slideRightFade 0.75s var(--ease-spring) 0.38s backwards;
      }

      @keyframes textGradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }

      @keyframes slideRightFade {
        from {
          opacity: 0;
          transform: translateX(-35px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }

      /* === 6. Energy Beam on Divider Line === */
      .divider-line {
        transform-origin: left;
        animation: expandLine 0.85s var(--ease-m3) 0.45s backwards;
      }

      .divider-line::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 220px;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, #1E824C 30%, #0080C8 70%, #81C784 90%, transparent 100%);
        animation: beamSweep 3.2s ease-in-out 1.2s infinite;
      }

      @keyframes beamSweep {
        0% { transform: translateX(-220px); }
        45%, 100% { transform: translateX(1800px); }
      }

      @keyframes expandLine {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }

      /* === 7. Multi-Ring Sonar Waves & Orbit on Play Button === */
      .play-circle-wrapper {
        animation: popIn 0.65s var(--ease-spring) 0.6s backwards;
      }

      .sonar-wave {
        animation: sonarPulse 2.6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      }

      .sonar-wave-2 {
        animation: sonarPulse 2.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.65s infinite;
      }

      .sonar-wave-3 {
        animation: sonarPulse 2.6s cubic-bezier(0.2, 0.8, 0.2, 1) 1.3s infinite;
      }

      @keyframes sonarPulse {
        0% {
          transform: scale(0.8);
          opacity: 0.95;
        }
        100% {
          transform: scale(1.8);
          opacity: 0;
        }
      }

      .play-icon {
        animation: iconNudge 2s ease-in-out infinite;
      }

      @keyframes iconNudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(3px); }
      }

      @keyframes popIn {
        from {
          opacity: 0;
          transform: scale(0) rotate(-60deg);
        }
        to {
          opacity: 1;
          transform: scale(1) rotate(0deg);
        }
      }

      /* === 8. Program & Category Tag Animation === */
      .program-tag {
        animation: slideUpFade 0.7s var(--ease-spring) 0.55s backwards;
      }

      @keyframes slideUpFade {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* === 9. Animated Logos Row with Dynamic Waves === */
      .logo-wrapper-1 {
        animation: slideUpFade 0.7s var(--ease-spring) 0.7s backwards, logoBob1 4.8s ease-in-out 1.5s infinite;
      }

      .logo-wrapper-2 {
        animation: slideUpFade 0.7s var(--ease-spring) 0.82s backwards, logoBob2 5.2s ease-in-out 1.8s infinite;
      }

      .logo-wrapper-3 {
        animation: slideUpFade 0.7s var(--ease-spring) 0.94s backwards, logoBob3 5.8s ease-in-out 2.1s infinite;
      }

      @keyframes logoBob1 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
      }

      @keyframes logoBob2 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
      }

      @keyframes logoBob3 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3.5px); }
      }

      /* Respect Reduced Motion */
      @media (prefers-reduced-motion: reduce) {
        .bg-particles::before,
        .bg-particles::after,
        .aurora-blob,
        .floating-node,
        .presentation-frame,
        .frame-border-pulse,
        .speaker-pill::after,
        .live-dot-pulse,
        .title-highlight,
        .title-subtext,
        .divider-line,
        .divider-line::after,
        .play-circle-wrapper,
        .sonar-wave,
        .sonar-wave-2,
        .sonar-wave-3,
        .play-icon,
        .program-tag,
        .logo-wrapper-1,
        .logo-wrapper-2,
        .logo-wrapper-3,
        .floating-tag {
          animation: none !important;
          transition: none !important;
          transform: none !important;
          opacity: 1 !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#e6f7f1] text-slate-800 font-sans w-screen h-screen overflow-hidden flex items-center justify-center relative bg-particles antialiased select-none">
    <!-- 1. Background Ambient Multi-Aurora Morphing Blobs -->
    <div class="bg-aurora-container">
      <div class="aurora-blob aurora-blob-1"></div>
      <div class="aurora-blob aurora-blob-2"></div>
      <div class="aurora-blob aurora-blob-3"></div>
      <div class="aurora-blob aurora-blob-4"></div>
    </div>

    <!-- 2. Floating Background Geometric Tech Nodes -->
    <svg class="floating-node node-1 w-6 h-6 text-emerald-800/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>
    <svg class="floating-node node-2 w-5 h-5 text-sky-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polygon points="12 2 22 12 12 22 2 12" />
    </svg>
    <svg class="floating-node node-3 w-5 h-5 text-emerald-800/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="8" />
    </svg>
    <svg class="floating-node node-4 w-6 h-6 text-amber-800/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2v20M2 12h20" />
    </svg>

    <!-- 3. Main Presentation Card (94% screen view, 16:9 ratio, bordered, levitating) -->
    <main class="presentation-frame frame-border-pulse bg-white rounded-3xl sm:rounded-[32px] border-2 border-emerald-800/25 relative flex flex-col justify-between p-6 sm:p-10 md:p-14 lg:p-16 overflow-hidden z-10 hover:border-emerald-800/50 transition-colors duration-500">
      <div class="bg-overlay"></div>

      <div class="content-layer relative z-10 h-full flex flex-col justify-between">
        <!-- Top: Speaker's Name in Green Pill -->
        <div class="pt-1">
          <div class="speaker-pill-wrapper flex items-center">
            <div class="speaker-pill relative overflow-hidden inline-flex items-center gap-2.5 bg-[#1E824C] hover:bg-[#006233] text-white font-bold text-sm sm:text-base md:text-lg px-5 sm:px-7 py-2 sm:py-2.5 rounded-full tracking-tight transition-transform duration-200 hover:-translate-y-0.5 cursor-default select-none">
              <span class="relative flex h-2.5 w-2.5">
                <span class="live-dot-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-300"></span>
              </span>
              <span>Abderrahmane SAOUDI</span>
            </div>
          </div>
        </div>

        <!-- Middle: Title -->
        <div class="my-auto py-2">
          <div class="flex flex-col gap-1 sm:gap-2">
            <!-- First Line: Green & Larger with Dynamic Shimmer Gradient -->
            <h1 class="title-highlight font-black text-4xl sm:text-6xl md:text-7xl lg:text-[5.2rem] tracking-tight leading-[1.08] whitespace-nowrap">
              Digital Productivity
            </h1>
            <!-- Second Line: Dark & Complementary -->
            <h2 class="title-subtext font-extrabold text-2xl sm:text-4xl md:text-5xl text-slate-900 tracking-tight leading-tight">
              Work Smarter, Not Harder
            </h2>
          </div>
        </div>

        <!-- Bottom: Dividing Line + Program Tag + Logos -->
        <div class="pb-1">
          <!-- Line with Right Play Circle & Multi-Ring Sonar Waves -->
          <div class="relative w-full flex items-center my-2 sm:my-3">
            <div class="divider-line relative w-full h-[2px] bg-slate-900 overflow-hidden"></div>
            <div class="play-circle-wrapper absolute right-0 flex items-center justify-center">
              <div class="sonar-wave absolute -inset-1.5 rounded-full border-2 border-emerald-600/45 pointer-events-none"></div>
              <div class="sonar-wave-2 absolute -inset-3.5 rounded-full border-[1.5px] border-sky-600/35 pointer-events-none"></div>
              <div class="sonar-wave-3 absolute -inset-5 rounded-full border border-emerald-500/25 pointer-events-none"></div>
              <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[#1E824C] hover:bg-[#006233] flex items-center justify-center text-white border-2 border-white transition-all duration-300 hover:scale-115 hover:rotate-6 cursor-pointer select-none" title="Session 7.77">
                <svg class="play-icon w-4 h-4 ml-0.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Program & Age Tag -->
          <div class="program-tag text-[#1E824C] font-extrabold text-base sm:text-xl md:text-2xl tracking-tight inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            <span>7.77 Program | Age: 24-30</span>
          </div>

          <!-- Institutional Logos -->
          <div class="flex items-center gap-6 sm:gap-10 md:gap-14 mt-4 sm:mt-6">
            <!-- Ministère de la Poste et des Télécommunications -->
            <div class="logo-wrapper-1 flex items-center transition-transform duration-300 hover:-translate-y-2 hover:scale-105">
              <img 
                src={logoMinistere.src} 
                alt="Ministère de la Poste et des Télécommunications" 
                class="h-12 sm:h-16 md:h-18 w-auto object-contain"
              />
            </div>

            <!-- Algérie Télécom -->
            <div class="logo-wrapper-2 flex items-center transition-transform duration-300 hover:-translate-y-2 hover:scale-105">
              <img 
                src={logoAlgerieTelecom.src} 
                alt="Algérie Télécom" 
                class="h-8 sm:h-11 md:h-13 w-auto object-contain"
              />
            </div>

            <!-- Mobilis -->
            <div class="logo-wrapper-3 flex items-center transition-transform duration-300 hover:-translate-y-2 hover:scale-105">
              <img 
                src={logoMobilis.src} 
                alt="Mobilis" 
                class="h-7 sm:h-9 md:h-10 w-auto object-contain"
              />
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
