---
import PresentationDeck from './_components/PresentationDeck.astro';
import './_styles/presentation.css';
---

<!doctype html>
<html lang="fr" class="deck-mode">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>7.77 Program Presentation Deck • saoudi.online</title>
    <meta name="description" content="Présentation interactive et keynote sur la productivité numérique, les systèmes de travail et Google Workspace pour le Programme National 7.77." />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="7.77 Program Presentation Deck • saoudi.online" />
    <meta property="og:description" content="Keynote interactive pour le Programme National 7.77 par Abderrahmane SAOUDI." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_DZ" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      /* Ensure absolute 0 margins and zero scrollbars */
      * {
        box-sizing: border-box;
      }
      
      body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background-color: #0E0E0E;
        font-family: 'Google Sans', Inter, system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="deck-mode">
    <main>
      <PresentationDeck />
    </main>
  </body>
</html>
