      'Point to website saoudi.online for further resources and contact.',
      'Ask final question: "What is ONE thing you will do differently tomorrow?"',
      'Thank Ministry MPT, Algérie Télécom, Mobilis, and the participants.',
    ],
    darija: 'شكرا بزاف على حضوركم واهتمامكم. متخرجوش بلا ما تديرو خطوة وحدة صغيرة غدوة: خيّرو حاجة وحدة تبدلوها، والتكنولوجيا تولي فخدمتكم ماشي العكس!',
    transition: 'End of presentation.',
  },
];
---

<!-- Presenter Notes Drawer (Toggled via "Notes" button or Pressing 'N' / 'S') -->
<aside 
  id="presenterNotesDrawer" 
  class={`fixed inset-y-0 right-0 w-full sm:w-120 bg-slate-900/98 text-slate-100 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col border-l border-slate-700/80 backdrop-blur-md select-text ${className}`}
  aria-label="Presenter Notes"
>
  <!-- Drawer Header -->
  <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between shrink-0 bg-slate-950/80">
    <div class="flex items-center gap-2.5">
      <span class="w-8 h-8 rounded-lg bg-[#1E824C] text-white flex items-center justify-center text-sm font-bold">
        📝
      </span>
      <div>
        <h3 class="text-sm sm:text-base font-black text-white tracking-tight flex items-center gap-2">
          <span>Speaker Guide & Notes</span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">LIVE SYNC</span>
        </h3>
        <p class="text-[11px] text-slate-400 font-medium">Presenter view only (Hidden from audience)</p>
      </div>
    </div>

    <!-- Close Drawer Button -->
    <button 
      id="closeNotesBtn"
      type="button"
      class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center text-sm transition-colors cursor-pointer"
      title="Close notes (Shortcut: 'N' or 'S')"
    >
      ✕
    </button>
  </div>

  <!-- Drawer Body: Dynamic Slide Content -->
  <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
    
    <!-- Meta Bar: Slide Number, Section, Target Time -->
    <div class="flex items-center justify-between gap-2 p-3 rounded-2xl bg-slate-800/80 border border-slate-700 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-mono font-black text-[#81C784]" id="notesSlideBadge">Slide 1 of 15</span>
        <span class="text-slate-600">•</span>
        <span class="font-bold text-slate-300 truncate" id="notesSectionName">Welcome & Introduction</span>
      </div>

      <span class="px-2.5 py-1 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono text-[11px] font-bold shrink-0" id="notesTimeAlloc">
        ⏱️ 2–3 min
      </span>
    </div>

    <!-- Active Slide Title -->
    <div>
      <span class="text-[10px] font-mono uppercase text-slate-400 font-bold tracking-wider">Current Slide</span>
      <h4 class="text-lg sm:text-xl font-black text-white tracking-tight mt-0.5" id="notesSlideTitle">
        Digital Productivity
      </h4>
    </div>

    <!-- Key Points to Cover -->
    <div class="p-3.5 rounded-2xl bg-slate-800/50 border border-slate-700/60">
      <h5 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 mb-2 flex items-center gap-1.5">
        <span>✦</span> Key Points to Emphasize
      </h5>
      <ul class="space-y-1.5 text-xs sm:text-sm text-slate-300 leading-relaxed" id="notesPointsList">
        <!-- Injected dynamically -->
      </ul>
    </div>

    <!-- Suggested Algerian Darija Phrasing -->
    <div class="p-3.5 rounded-2xl bg-emerald-950/40 border border-emerald-800/60 text-emerald-100">
      <h5 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-400 mb-1.5 flex items-center gap-1.5">
        <span>🗣️</span> Suggested Algerian Darija Phrasing
      </h5>
      <p class="text-xs sm:text-sm leading-relaxed text-emerald-200/90 font-medium font-sans" dir="rtl" id="notesDarijaText">
        <!-- Injected dynamically -->
      </p>
    </div>

    <!-- Suggested Transition -->
    <div class="p-3 rounded-xl bg-slate-800/40 border border-slate-700 text-xs text-slate-400">
      <span class="font-bold text-slate-200 block mb-0.5">➡️ Transition to Next Slide:</span>
      <p class="italic text-slate-300" id="notesTransitionText">
        <!-- Injected dynamically -->
      </p>
    </div>

  </div>

  <!-- Drawer Footer: Quick Tips -->
  <div class="p-3 sm:p-4 border-t border-slate-800 bg-slate-950 flex items-center justify-between text-[11px] text-slate-400 font-mono">
    <span>Hotkey: Press <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 border border-slate-700">N</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 border border-slate-700">S</kbd> to toggle</span>
    <span class="text-emerald-400 font-bold">Total: 60 min</span>
  </div>
</aside>

<!-- Embedded Controller Script for Notes -->
<script is:inline define:vars={{ notesData: notes }}>
  (() => {
    const drawer = document.getElementById('presenterNotesDrawer');
    const closeBtn = document.getElementById('closeNotesBtn');
    const deck = document.getElementById('presentationDeck');

    const slideBadge = document.getElementById('notesSlideBadge');
    const sectionName = document.getElementById('notesSectionName');
    const timeAlloc = document.getElementById('notesTimeAlloc');
    const slideTitle = document.getElementById('notesSlideTitle');
    const pointsList = document.getElementById('notesPointsList');
    const darijaText = document.getElementById('notesDarijaText');
    const transitionText = document.getElementById('notesTransitionText');

    let isOpen = false;

    function renderSlideNotes(slideNum) {
      const note = notesData.find(n => n.slide === slideNum) || notesData[0];
      if (!note) return;

      if (slideBadge) slideBadge.textContent = `Slide ${note.slide} of 15`;
      if (sectionName) sectionName.textContent = note.section;
      if (timeAlloc) timeAlloc.textContent = `⏱️ ${note.time}`;
      if (slideTitle) slideTitle.textContent = note.title;

      if (pointsList) {
        pointsList.innerHTML = note.points.map(p => `<li class="flex items-start gap-2"><span class="text-emerald-400 font-bold">•</span><span>${p}</span></li>`).join('');
      }

      if (darijaText) darijaText.textContent = note.darija;
      if (transitionText) transitionText.textContent = note.transition;
    }

    function toggleNotes() {
      isOpen = !isOpen;
      if (drawer) {
        if (isOpen) {
          drawer.classList.remove('translate-x-full');
          const cur = deck ? parseInt(deck.getAttribute('data-current-slide') || '1', 10) : 1;
          renderSlideNotes(cur);
        } else {
          drawer.classList.add('translate-x-full');
        }
      }
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleNotes();
      });
    }

    // Toggle on hotkey 'N' or 'S'
    window.addEventListener('keydown', (e) => {
      const target = e.target;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }

      if (e.key === 'n' || e.key === 'N' || e.key === 's' || e.key === 'S') {
        // Prevent conflict with search or other shortcuts
        if (!e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          toggleNotes();
        }
      }
    });

    // Expose global updater so slide changes update the notes
    window.updatePresenterNotes = (slideNum) => {
      if (isOpen) {
        renderSlideNotes(slideNum);
      }
    };
  })();
</script>
