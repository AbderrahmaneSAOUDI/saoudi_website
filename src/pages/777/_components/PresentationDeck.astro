---
import Slide01_Intro from '../_slides/Slide01_Intro.astro';
import Slide02_Welcome from '../_slides/Slide02_Welcome.astro';
import Slide03_TheProblem from '../_slides/Slide03_TheProblem.astro';
import Slide04_DigitalChaos from '../_slides/Slide04_DigitalChaos.astro';
import Slide05_TheShift from '../_slides/Slide05_TheShift.astro';
import Slide06_Framework from '../_slides/Slide06_Framework.astro';
import Slide07_Capture from '../_slides/Slide07_Capture.astro';
import Slide08_Organize from '../_slides/Slide08_Organize.astro';
import Slide09_Create from '../_slides/Slide09_Create.astro';
import Slide10_Collaborate from '../_slides/Slide10_Collaborate.astro';
import Slide11_Schedule from '../_slides/Slide11_Schedule.astro';
import Slide12_Automate from '../_slides/Slide12_Automate.astro';
import Slide13_BeyondGoogle from '../_slides/Slide13_BeyondGoogle.astro';
import Slide14_Challenge from '../_slides/Slide14_Challenge.astro';
import Slide15_BuildWorkflow from '../_slides/Slide15_BuildWorkflow.astro';
import Slide16_Final from '../_slides/Slide16_Final.astro';

const slideTitles = [
  "01 • Introduction & Speaker",
  "02 • Speaker Bio & Contact",
  "03 • Welcome Everyone",
  "04 • 7.77 Digital Skills Overview",
  "05 • Le Paradoxe des Outils",
  "06 • Le Chaos Numérique",
  "07 • Le Déclic : Workflows",
  "08 • Le Framework en 6 Piliers",
  "09 • Pilier 1 : CAPTURE",
  "10 • Pilier 2 : ORGANIZE",
  "11 • Pilier 3 : CREATE",
  "12 • Pilier 4 : COLLABORATE",
  "13 • Pilier 5 : SCHEDULE",
  "14 • Pilier 6 : AUTOMATE",
  "15 • Défi Interactif & Outils",
  "16 • Message de Clôture & Contact"
];
---

<div class="deck-stage-wrapper">
  <div class="deck-stage" id="deck-stage">
    <!-- Top Progress Bar -->
    <div class="deck-progress-bar">
      <div class="deck-progress-fill" id="deck-progress-fill"></div>
    </div>

    <!-- 16 Slides Stack -->
    <div class="relative w-full h-full" id="slides-viewport">
      <Slide01_Intro />
      <Slide02_Welcome />
      <Slide03_TheProblem />
      <Slide04_DigitalChaos />
      <Slide05_TheShift />
      <Slide06_Framework />
      <Slide07_Capture />
      <Slide08_Organize />
      <Slide09_Create />
      <Slide10_Collaborate />
      <Slide11_Schedule />
      <Slide12_Automate />
      <Slide13_BeyondGoogle />
      <Slide14_Challenge />
      <Slide15_BuildWorkflow />
      <Slide16_Final />
    </div>

    <!-- Floating Navigation Dock -->
    <nav class="deck-dock" aria-label="Contrôles de la présentation">
      <button type="button" id="deck-prev-btn" aria-label="Slide précédente (Flèche gauche)" title="Précédent (←)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <span class="deck-counter" id="deck-counter-display">01 / 16</span>

      <button type="button" id="deck-next-btn" aria-label="Slide suivante (Flèche droite ou Espace)" title="Suivant (→ ou Espace)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>

      <div class="h-4 w-px bg-slate-700 mx-0.5"></div>

      <button type="button" id="toggle-overview-btn" aria-label="Aperçu des slides" title="Aperçu (O)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      </button>

      <button type="button" id="toggle-fullscreen-btn" aria-label="Plein écran" title="Plein écran (F)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
      </button>

      <button type="button" id="toggle-shortcuts-btn" aria-label="Raccourcis clavier" title="Raccourcis (?)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </button>
    </nav>

    <!-- Slide Overview Drawer Modal -->
    <div class="deck-overview-drawer" id="deck-overview-modal">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <span class="text-sm font-extrabold text-white tracking-wide">APERÇU DES SLIDES 777</span>
          <span class="text-xs text-teal-400 font-semibold">16 Diapositives</span>
        </div>
        <button type="button" id="close-overview-btn" class="text-slate-400 hover:text-white text-base px-2 py-1 rounded bg-slate-800 border border-slate-700 cursor-pointer">
          ✕ Fermer (Échap)
        </button>
      </div>

      <div class="deck-overview-grid">
        {slideTitles.map((title, idx) => (
          <button 
            type="button" 
            class="overview-thumbnail" 
            data-target-slide={idx + 1}
          >
            <div class="text-[11px] font-bold text-teal-300">SLIDE {String(idx + 1).padStart(2, '0')}</div>
            <div class="text-xs font-bold text-white line-clamp-2">{title}</div>
            <div class="text-[10px] text-slate-400">Cliquez pour afficher</div>
          </button>
        ))}
      </div>
    </div>

    <!-- Keyboard Shortcuts Help Modal -->
    <div id="shortcuts-modal" class="hidden absolute inset-0 z-50 bg-slate-950/80 flex items-center justify-center p-4">
      <div class="card-777-dark max-w-md w-full border-teal-500/40 p-5 bg-slate-900">
        <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-800">
          <span class="text-xs font-bold text-teal-300 uppercase tracking-wider">Raccourcis Clavier</span>
          <button type="button" id="close-shortcuts-btn" class="text-slate-400 hover:text-white text-sm">✕</button>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700">
            <span class="text-slate-300">Slide suivante</span>
            <div class="flex gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">ESPACE</kbd> <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">→</kbd> <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">ENTRÉE</kbd></div>
          </div>
          <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700">
            <span class="text-slate-300">Slide précédente</span>
            <div class="flex gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">←</kbd> <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">RETOUR</kbd></div>
          </div>
          <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700">
            <span class="text-slate-300">Plein écran</span>
            <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">F</kbd>
          </div>
          <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700">
            <span class="text-slate-300">Grille des slides</span>
            <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">O</kbd>
          </div>
          <div class="flex items-center justify-between p-2 rounded bg-slate-800/60 border border-slate-700">
            <span class="text-slate-300">Début / Fin</span>
            <div class="flex gap-1"><kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">HOME</kbd> <kbd class="px-1.5 py-0.5 rounded bg-slate-700 text-white font-mono">END</kbd></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Central Presentation Controller
  class PresentationController {
    private currentSlideIndex: number = 1;
    private totalSlides: number = 16;
    private slides: HTMLElement[] = [];
    private counterDisplay: HTMLElement | null = null;
    private progressFill: HTMLElement | null = null;
    private prevBtn: HTMLButtonElement | null = null;
    private nextBtn: HTMLButtonElement | null = null;
    private overviewModal: HTMLElement | null = null;
    private shortcutsModal: HTMLElement | null = null;

    constructor() {
      this.initElements();
      this.initEvents();
      this.readHashOrInit();
    }

    private initElements() {
      this.slides = Array.from(document.querySelectorAll('.deck-slide'));
      this.totalSlides = this.slides.length || 16;
      this.counterDisplay = document.getElementById('deck-counter-display');
      this.progressFill = document.getElementById('deck-progress-fill');
      this.prevBtn = document.getElementById('deck-prev-btn') as HTMLButtonElement;
      this.nextBtn = document.getElementById('deck-next-btn') as HTMLButtonElement;
      this.overviewModal = document.getElementById('deck-overview-modal');
      this.shortcutsModal = document.getElementById('shortcuts-modal');
    }

    private initEvents() {
      // Prev / Next button clicks
      this.prevBtn?.addEventListener('click', () => this.prevSlide());
      this.nextBtn?.addEventListener('click', () => this.nextSlide());

      // Next buttons embedded inside slides
      document.querySelectorAll('[data-deck-next]').forEach(btn => {
        btn.addEventListener('click', () => this.nextSlide());
      });

      // Jump to slide buttons
      document.querySelectorAll('[data-deck-goto]').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = parseInt(btn.getAttribute('data-deck-goto') || '1', 10);
          this.goToSlide(target);
        });
      });

      // Overview modal triggers
      document.getElementById('toggle-overview-btn')?.addEventListener('click', () => this.toggleOverview());
      document.getElementById('close-overview-btn')?.addEventListener('click', () => this.closeOverview());

      // Overview thumbnails
      document.querySelectorAll('.overview-thumbnail').forEach(thumb => {
        thumb.addEventListener('click', () => {
          const target = parseInt(thumb.getAttribute('data-target-slide') || '1', 10);
          this.goToSlide(target);
          this.closeOverview();
        });
      });

      // Fullscreen toggle
      document.getElementById('toggle-fullscreen-btn')?.addEventListener('click', () => this.toggleFullscreen());

      // Shortcuts modal
      document.getElementById('toggle-shortcuts-btn')?.addEventListener('click', () => this.toggleShortcuts());
      document.getElementById('close-shortcuts-btn')?.addEventListener('click', () => this.closeShortcuts());

      // Global keyboard navigation
      window.addEventListener('keydown', (e) => this.handleKeyDown(e));

      // Hash change listener (back/forward browser history support)
      window.addEventListener('hashchange', () => this.readHashOrInit());
    }

    private readHashOrInit() {
      const hash = window.location.hash;
      const match = hash.match(/^#slide-(\d+)$/);
      if (match) {
        const slideNum = parseInt(match[1], 10);
        if (slideNum >= 1 && slideNum <= this.totalSlides) {
          this.goToSlide(slideNum, false);
          return;
        }
      }
      this.goToSlide(1, false);
    }

    public goToSlide(index: number, updateHash: boolean = true) {
      if (index < 1) index = 1;
      if (index > this.totalSlides) index = this.totalSlides;

      this.currentSlideIndex = index;

      // Update slide active states
      this.slides.forEach((slide, idx) => {
        const slideNum = idx + 1;
        if (slideNum === index) {
          slide.classList.add('active');
          slide.classList.remove('prev-slide');
        } else if (slideNum < index) {
          slide.classList.remove('active');
          slide.classList.add('prev-slide');
        } else {
          slide.classList.remove('active', 'prev-slide');
        }
      });

      // Update Counter
      if (this.counterDisplay) {
        this.counterDisplay.textContent = `${String(index).padStart(2, '0')} / ${String(this.totalSlides).padStart(2, '0')}`;
      }

      // Update Progress Bar
      if (this.progressFill) {
        const percent = ((index - 1) / (this.totalSlides - 1)) * 100;
        this.progressFill.style.width = `${percent}%`;
      }

      // Update Prev / Next Buttons disabled state
      if (this.prevBtn) this.prevBtn.disabled = (index === 1);
      if (this.nextBtn) this.nextBtn.disabled = (index === this.totalSlides);

      // Update thumbnails active state
      document.querySelectorAll('.overview-thumbnail').forEach((t, idx) => {
        if (idx + 1 === index) {
          t.classList.add('active-thumb');
        } else {
          t.classList.remove('active-thumb');
        }
      });

      // Update URL Hash
      if (updateHash) {
        history.replaceState(null, '', `#slide-${index}`);
      }
    }

    public nextSlide() {
      if (this.currentSlideIndex < this.totalSlides) {
        this.goToSlide(this.currentSlideIndex + 1);
      }
    }

    public prevSlide() {
      if (this.currentSlideIndex > 1) {
        this.goToSlide(this.currentSlideIndex - 1);
      }
    }

    private toggleOverview() {
      this.overviewModal?.classList.toggle('open');
    }

    private closeOverview() {
      this.overviewModal?.classList.remove('open');
    }

    private toggleShortcuts() {
      this.shortcutsModal?.classList.toggle('hidden');
    }

    private closeShortcuts() {
      this.shortcutsModal?.classList.add('hidden');
    }

    private toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    private handleKeyDown(e: KeyboardEvent) {
      // Don't intercept if user is typing in an input
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) {
        return;
      }

      switch (e.key) {
        case 'ArrowRight':
        case ' ':
        case 'Enter':
        case 'PageDown':
        case 'l':
        case 'j':
          e.preventDefault();
          this.nextSlide();
          break;

        case 'ArrowLeft':
        case 'Backspace':
        case 'PageUp':
        case 'h':
        case 'k':
          e.preventDefault();
          this.prevSlide();
          break;

        case 'f':
        case 'F':
          e.preventDefault();
          this.toggleFullscreen();
          break;

        case 'o':
        case 'O':
          e.preventDefault();
          this.toggleOverview();
          break;

        case 'Escape':
          e.preventDefault();
          this.closeOverview();
          this.closeShortcuts();
          break;

        case '?':
          e.preventDefault();
          this.toggleShortcuts();
          break;

        case 'Home':
          e.preventDefault();
          this.goToSlide(1);
          break;

        case 'End':
          e.preventDefault();
          this.goToSlide(this.totalSlides);
          break;
      }
    }
  }

  // Initialize on page load
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      new PresentationController();
    });
  }
</script>
