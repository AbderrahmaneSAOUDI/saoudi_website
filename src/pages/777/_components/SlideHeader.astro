---
interface Props {
  category?: string;
  topic?: string;
}

const { category = "7.77 Program", topic = "Digital Skills & Workflows" } = Astro.props;
---

<header class="relative z-10 w-full flex items-center justify-between border-b border-slate-100 pb-4 mb-3 select-none">
  <div class="flex items-center gap-2.5">
    <span class="text-xs uppercase tracking-widest font-bold text-[#006233] bg-[#E6F4EA] px-3 py-1 rounded-lg border border-[#006233]/20">
      7.77 Program
    </span>
    <span class="text-xs uppercase tracking-wider font-semibold text-slate-400">
      | {category}
    </span>
  </div>

  <div class="flex items-center gap-3">
    <span class="text-xs font-medium text-slate-500 hidden sm:inline">{topic}</span>
    <span class="text-xs font-mono font-bold text-[#006233] bg-slate-50 px-2.5 py-1 rounded border border-slate-200">
      777.mpt.gov.dz
    </span>
  </div>
</header>
