---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showPartners?: boolean;
}

const { size = 'md', showPartners = true } = Astro.props;
const heightClass = size === 'sm' ? 'w-10 h-10' : size === 'lg' ? 'w-14 h-14' : 'w-12 h-12';
---

<div class="flex items-center justify-between w-full border-b border-slate-100 pb-4 select-none">
  <!-- Ministry Emblem & Name -->
  <div class="flex items-center gap-3.5">
    <div class={`${heightClass} rounded-full border-2 border-[#006233] flex flex-col items-center justify-center bg-white font-cairo font-bold text-[#D21034] text-xs leading-none`}>
      <span class="text-[#006233] text-[9px] font-black">MPT</span>
      <span class="text-[9px] font-black">🇩🇿</span>
    </div>
    <div>
      <p class="font-cairo text-sm font-bold text-slate-900 leading-tight">وزارة البريد والمواصلات السلكية واللاسلكية</p>
      <p class="text-[11px] text-slate-500 font-medium tracking-wide">Ministère de la Poste et des Télécommunications</p>
    </div>
  </div>

  <!-- Partners & 7.77 Tag -->
  {showPartners && (
    <div class="flex items-center gap-3 text-xs font-semibold">
      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#E8F5FD] text-[#0080C8] border border-[#0080C8]/20">
        <span class="font-bold tracking-tight">Algérie Télécom</span>
        <span class="text-[10px] font-cairo">إتصالات الجزائر</span>
      </div>
      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[#F2F8EA] text-[#72A92E] border border-[#72A92E]/20">
        <span class="font-bold tracking-tight">Mobilis</span>
        <span class="text-[10px] font-cairo">موبيليس</span>
      </div>
    </div>
  )}
</div>
