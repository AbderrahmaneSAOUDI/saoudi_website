---
interface Props {
  showTag?: boolean;
}

const { showTag = true } = Astro.props;
---

<div class="flex items-center justify-between w-full border-b border-white/10 pb-4 select-none">
  <!-- Brand Logo & Domain -->
  <div class="flex items-center gap-3">
    <!-- Google 4-color dot icon -->
    <div class="w-10 h-10 rounded-2xl bg-surface-container-high border border-white/15 flex items-center justify-center gap-1">
      <span class="w-2 h-2 rounded-full bg-[#8AB4F8]"></span>
      <span class="w-2 h-2 rounded-full bg-[#81C784]"></span>
      <span class="w-2 h-2 rounded-full bg-[#FDD663]"></span>
      <span class="w-2 h-2 rounded-full bg-[#F28B82]"></span>
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-sm text-white tracking-tight font-sans">saoudi.online</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-slate-300 font-mono text-[10px]">7.77</span>
      </div>
      <p class="text-[11px] text-white/60 font-medium">Digital Productivity & Workflows</p>
    </div>
  </div>

  <!-- Program Badge -->
  {showTag && (
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#8AB4F8]/10 text-[#8AB4F8] border border-[#8AB4F8]/30">
        Programme National 7.77 • 24–30 ans
      </span>
    </div>
  )}
</div>
