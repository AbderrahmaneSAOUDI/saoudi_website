---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="9">
  <div class="m3-glow-green"></div>

  <SlideHeader category="Pilier 01" topic="CAPTURE : De l'Information Brute à la Donnée Structurée" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-3">
      <div>
        <span class="text-xs font-bold text-[#81C784] tracking-wider uppercase bg-[#81C784]/10 px-2.5 py-1 rounded-md border border-[#81C784]/30">
          Google Forms ➔ Google Sheets
        </span>
        <h2 class="title-h1 text-white mt-1">
          Ne demandez plus « Envoyez vos noms par message »
        </h2>
      </div>
      <div class="hidden sm:block text-right">
        <span class="text-xs font-bold text-[#81C784] bg-[#81C784]/10 px-3 py-1 rounded-full border border-[#81C784]/30">
          ⚡ Synchronisation Directe 100% Automatique
        </span>
      </div>
    </div>

    <!-- Live Interactive Demo Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 my-2">
      <!-- Mini Mock Form (5 cols) -->
      <div class="md:col-span-5 card-m3 bg-surface-container p-3.5 border-white/10">
        <div class="flex items-center gap-2 pb-2 mb-2.5 border-b border-white/10">
          <div class="w-5 h-5 rounded bg-purple-600 text-white flex items-center justify-center font-bold text-[10px]">F</div>
          <div>
            <h4 class="font-bold text-xs text-white leading-tight">Formulaire Inscription 7.77</h4>
            <span class="text-[10px] text-white/40">Atelier Numérique Wilayas</span>
          </div>
        </div>

        <form id="capture-mock-form" class="space-y-2">
          <div>
            <label class="block text-[10px] font-semibold text-white/70 mb-0.5">Nom & Prénom</label>
            <input type="text" id="cap-name" value="Amina Benali" required class="w-full text-xs px-2.5 py-1.5 rounded-lg border border-white/15 focus:border-[#8AB4F8] focus:outline-none bg-surface text-white" />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-semibold text-white/70 mb-0.5">Wilaya</label>
              <select id="cap-wilaya" class="w-full text-xs px-2.5 py-1.5 rounded-lg border border-white/15 focus:border-[#8AB4F8] focus:outline-none bg-surface text-white">
                <option value="16 - Alger">16 - Alger</option>
                <option value="31 - Oran">31 - Oran</option>
                <option value="25 - Constantine">25 - Constantine</option>
                <option value="09 - Blida">09 - Blida</option>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-white/70 mb-0.5">Domaine</label>
              <select id="cap-domain" class="w-full text-xs px-2.5 py-1.5 rounded-lg border border-white/15 focus:border-[#8AB4F8] focus:outline-none bg-surface text-white">
                <option value="Dev Web">Dev Web</option>
                <option value="Data & IA">Data & IA</option>
                <option value="Design UX">Design UX</option>
                <option value="Management">Management</option>
              </select>
            </div>
          </div>

          <button type="submit" class="w-full btn-m3 btn-m3-green text-xs py-1.5 mt-1.5 cursor-pointer">
            <span>SOUMETTRE L'INSCRIPTION →</span>
          </button>
        </form>
      </div>

      <!-- Arrow Indicator (1 col) -->
      <div class="hidden md:flex md:col-span-1 items-center justify-center">
        <div class="w-7 h-7 rounded-full bg-surface-container-high text-[#8AB4F8] flex items-center justify-center font-bold text-xs border border-white/10">
          ➔
        </div>
      </div>

      <!-- Live Mock Sheet (6 cols) -->
      <div class="md:col-span-6 card-m3 bg-surface-container p-3.5 border-white/10 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10">
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded bg-[#81C784] text-slate-900 flex items-center justify-center font-bold text-[10px]">S</div>
              <div>
                <h4 class="font-bold text-xs text-white leading-tight">Inscriptions_7.77 (Réponses)</h4>
                <span class="text-[10px] text-[#81C784] font-semibold">● Connecté en direct</span>
              </div>
            </div>
            <span class="text-[10px] bg-surface-container-high text-white/60 px-2 py-0.5 rounded font-mono border border-white/10">Google Sheets</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-[10px] text-left border-collapse" id="mock-sheets-table">
              <thead>
                <tr class="bg-surface-container-high text-white/70 border-b border-white/10 font-bold">
                  <th class="p-1">Horodatage</th>
                  <th class="p-1">Nom</th>
                  <th class="p-1">Wilaya</th>
                  <th class="p-1">Domaine</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-mono text-[10px]">
                <tr class="text-white/80">
                  <td class="p-1 text-white/40">10:14:02</td>
                  <td class="p-1 font-sans font-medium text-white">Karim Meziane</td>
                  <td class="p-1">16 - Alger</td>
                  <td class="p-1 text-[#8AB4F8] font-semibold">Data & IA</td>
                </tr>
                <tr class="text-white/80">
                  <td class="p-1 text-white/40">10:18:45</td>
                  <td class="p-1 font-sans font-medium text-white">Sara Dahmani</td>
                  <td class="p-1">31 - Oran</td>
                  <td class="p-1 text-purple-300 font-semibold">Design UX</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-2.5 pt-2 border-t border-white/10 flex items-center justify-between text-[10px] text-white/50">
          <span>0 saisie manuelle, 100% exploitable</span>
          <span class="font-semibold text-[#81C784]">Filtres & TCD prêts</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>Règle d'or : Ne traitez jamais manuellement ce qu'un formulaire peut structurer</span>
    <button type="button" class="btn-m3 btn-m3-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>PILIER 2 : ORGANISATION DRIVE →</span>
    </button>
  </div>
</section>

<script>
  const form = document.getElementById('capture-mock-form') as HTMLFormElement;
  const tableBody = document.querySelector('#mock-sheets-table tbody');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('cap-name') as HTMLInputElement;
    const wilayaInput = document.getElementById('cap-wilaya') as HTMLSelectElement;
    const domainInput = document.getElementById('cap-domain') as HTMLSelectElement;

    if (!nameInput || !tableBody) return;

    const now = new Date();
    const timeStr = now.toTimeString().split(' ')[0];

    const tr = document.createElement('tr');
    tr.className = 'bg-[#81C784]/15 text-white font-bold transition-all';
    tr.innerHTML = `
      <td class="p-1 text-[#81C784]">${timeStr}</td>
      <td class="p-1 font-sans">${nameInput.value}</td>
      <td class="p-1">${wilayaInput.value}</td>
      <td class="p-1 text-[#8AB4F8] font-semibold">${domainInput.value}</td>
    `;

    tableBody.prepend(tr);

    const sampleNames = ['Yacine Kaci', 'Meriem Bouzid', 'Reda Zerrouki', 'Samia Tlemcani'];
    const randomName = sampleNames[Math.floor(Math.random() * sampleNames.length)];
    nameInput.value = randomName;
  });
</script>
