---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="4">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="National Initiative" topic="7.77 Overview & Metrics" />

  <div class="space-y-6 my-auto max-w-5xl relative z-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8AB4F8]/10 text-[#8AB4F8] border border-[#8AB4F8]/30 text-xs font-bold uppercase">
        ⚡ National Digital Empowerment
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight font-sans">
        7.77 Digital Skills for Every Generation
      </h2>
      <p class="text-white/70 text-base max-w-4xl leading-relaxed">
        A national digital empowerment initiative aiming to strengthen digital competencies for citizens aged 7 to 77 through practical, inclusive, and accessible training in artificial intelligence, cloud technologies, data management, and software productivity.
      </p>
    </div>

    <!-- Highlight Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="card-m3 bg-surface-container border-white/15 p-6 flex items-center gap-6">
        <div class="text-6xl font-black text-[#8AB4F8] font-mono tracking-tighter shrink-0">7→77</div>
        <div>
          <h4 class="text-lg font-bold text-white font-sans">Age Range Covered</h4>
          <p class="text-xs text-white/60 mt-1 leading-relaxed">Continuous digital learning pathways tailored from young students (7) to lifelong adult learners (77).</p>
        </div>
      </div>

      <div class="card-m3 bg-surface-container border-white/15 p-6 flex items-center gap-6">
        <div class="text-6xl font-black text-[#81C784] font-mono tracking-tighter shrink-0">07</div>
        <div>
          <h4 class="text-lg font-bold text-white font-sans">Skill Centers</h4>
          <p class="text-xs text-white/60 mt-1 leading-relaxed">Core specialized technology and training hubs deployed across Algerian wilayas.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>7.77 National Program • Algeria</span>
    <button type="button" class="btn-m3 btn-m3-yellow text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>LE PROBLÈME DES OUTILS →</span>
    </button>
  </div>
</section>
