---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="4">
  <div class="light-brand-accent-1"></div>

  <SlideHeader category="Analyse" topic="Le Syndrome du Fichier Final" />

  <div class="my-auto max-w-4xl w-full relative z-10">
    <div class="mb-3">
      <span class="text-xs font-bold text-[#D21034] tracking-wider uppercase bg-[#FDECEF] px-2.5 py-1 rounded border border-[#D21034]/20">
        Anti-Pattern Fréquent
      </span>
      <h2 class="title-h1 text-slate-900 mt-2 font-cairo">
        Le Chaos Numérique en 5 Étapes
      </h2>
      <p class="text-xs text-slate-600 mt-1">
        Comment un travail collaboratif simple devient une crise de gestion de versions :
      </p>
    </div>

    <!-- Stepper Simulator -->
    <div class="card-777 p-4 mb-3 border-slate-200">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-2.5 relative" id="chaos-steps">
        <!-- Step 1 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-slate-200 bg-slate-50 transition-all" data-step="1">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-slate-500 uppercase">Étape 1</span>
            <span class="text-xs">💬</span>
          </div>
          <div class="font-bold text-xs text-slate-800 font-cairo">Groupe WhatsApp</div>
          <p class="text-[10px] text-slate-500 mt-1">« Je viens d'envoyer le doc, regardez ! »</p>
          <div class="mt-2 text-[9px] bg-white p-1 rounded border border-slate-200 text-slate-600 truncate font-mono">
            Rapport.docx
          </div>
        </div>

        <!-- Step 2 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-slate-200 bg-slate-50 opacity-40 transition-all" data-step="2">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-slate-500 uppercase">Étape 2</span>
            <span class="text-xs">💾</span>
          </div>
          <div class="font-bold text-xs text-slate-800 font-cairo">Téléchargement</div>
          <p class="text-[10px] text-slate-500 mt-1">Chaque membre télécharge en local sur son PC.</p>
          <div class="mt-2 text-[9px] bg-white p-1 rounded border border-slate-200 text-slate-600 truncate font-mono">
            Rapport (1).docx
          </div>
        </div>

        <!-- Step 3 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-slate-200 bg-slate-50 opacity-40 transition-all" data-step="3">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-slate-500 uppercase">Étape 3</span>
            <span class="text-xs">✏️</span>
          </div>
          <div class="font-bold text-xs text-slate-800 font-cairo">Modifs Isolées</div>
          <p class="text-[10px] text-slate-500 mt-1">3 personnes modifient le texte en parallèle.</p>
          <div class="mt-2 text-[9px] bg-white p-1 rounded border border-slate-200 text-slate-600 truncate font-mono">
            Rapport_modifie_AS.docx
          </div>
        </div>

        <!-- Step 4 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-slate-200 bg-slate-50 opacity-40 transition-all" data-step="4">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-slate-500 uppercase">Étape 4</span>
            <span class="text-xs">⚠️</span>
          </div>
          <div class="font-bold text-xs text-slate-800 font-cairo">Conflit Total</div>
          <p class="text-[10px] text-slate-500 mt-1">Qui a la vraie vérité ? Comment tout fusionner ?</p>
          <div class="mt-2 text-[9px] bg-amber-50 p-1 rounded border border-amber-200 text-amber-800 truncate font-mono font-bold">
            Rapport_FINAL_v2_ok.docx
          </div>
        </div>

        <!-- Step 5 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-[#D21034]/30 bg-[#FDECEF]/60 opacity-40 transition-all" data-step="5">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-[#D21034] uppercase">Étape 5</span>
            <span class="text-xs">🚨</span>
          </div>
          <div class="font-bold text-xs text-slate-900 font-cairo">Le Message Fatal</div>
          <p class="text-[10px] text-[#D21034] mt-1">« Quelqu'un peut renvoyer la dernière version ? »</p>
          <div class="mt-2 text-[9px] bg-[#FDECEF] p-1 rounded border border-[#D21034]/30 text-[#D21034] truncate font-mono font-bold">
            Rapport_VRAIMENT_FINAL.docx
          </div>
        </div>
      </div>

      <!-- Controls for Step Animation -->
      <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-slate-100">
        <button type="button" id="play-chaos-btn" class="btn-777 btn-777-outline text-xs px-3 py-1.5 cursor-pointer">
          <span id="play-chaos-label">▶ Lancer la simulation</span>
        </button>
        <div class="text-xs font-bold text-slate-800 font-cairo" id="chaos-status">
          Ça vous rappelle quelque chose ?
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100 relative z-10">
    <span>Le problème n'est pas le fichier, c'est l'absence de workflow</span>
    <button type="button" class="btn-777 btn-777-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>LE DÉCLIC : WORKFLOWS →</span>
    </button>
  </div>
</section>

<script>
  let currentStep = 1;
  const maxSteps = 5;
  const chaosSteps = document.querySelectorAll('.chaos-step');
  const playBtn = document.getElementById('play-chaos-btn');
  const playLabel = document.getElementById('play-chaos-label');
  let intervalId: any = null;

  function setStep(step: number) {
    chaosSteps.forEach(el => {
      const s = parseInt(el.getAttribute('data-step') || '1', 10);
      if (s <= step) {
        el.classList.remove('opacity-40');
        el.classList.add('border-[#0080C8]', 'bg-[#E8F5FD]/40');
        if (s === 5) {
          el.classList.remove('border-[#0080C8]', 'bg-[#E8F5FD]/40');
          el.classList.add('border-[#D21034]', 'bg-[#FDECEF]');
        }
      } else {
        el.classList.add('opacity-40');
        el.classList.remove('border-[#0080C8]', 'bg-[#E8F5FD]/40', 'border-[#D21034]', 'bg-[#FDECEF]');
      }
    });
  }

  playBtn?.addEventListener('click', () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
      if (playLabel) playLabel.textContent = '▶ Recommencer';
      return;
    }

    currentStep = 1;
    setStep(1);
    if (playLabel) playLabel.textContent = '⏸ Pause';

    intervalId = setInterval(() => {
      currentStep++;
      if (currentStep > maxSteps) {
        clearInterval(intervalId);
        intervalId = null;
        if (playLabel) playLabel.textContent = '🔄 Rejouer';
      } else {
        setStep(currentStep);
      }
    }, 750);
  });
</script>
