---
import BrandLogo from '../_components/BrandLogo.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="1">
  <div class="m3-glow-blue"></div>
  <div class="m3-glow-green"></div>

  <!-- Header -->
  <BrandLogo showTag={true} />

  <!-- Main Content -->
  <div class="my-auto space-y-5 max-w-4xl relative z-10">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8AB4F8]/10 border border-[#8AB4F8]/30 text-[#8AB4F8] text-xs font-bold tracking-wide">
      <span class="w-2 h-2 rounded-full bg-[#8AB4F8] animate-pulse"></span>
      <span>7.77 Program</span>
      <span class="text-white/30">|</span>
      <span>Age : 24–30 ans</span>
    </div>

    <h1 class="title-display font-black text-white tracking-tight leading-tight">
      Productivité Numérique :<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8AB4F8] via-[#81C784] to-[#FDD663]">
        Systèmes, Workflows & Outils de Travail
      </span>
    </h1>

    <p class="text-lg text-white/70 leading-relaxed font-normal max-w-3xl">
      Comment structurer son flux de travail quotidien, éliminer le chaos des fichiers dispersés et maîtriser la collaboration moderne avec l'écosystème Google Workspace.
    </p>

    <!-- Action Buttons -->
    <div class="flex items-center gap-4 pt-2">
      <button type="button" class="btn-m3 btn-m3-blue text-sm px-6 py-2.5 cursor-pointer" data-deck-next>
        <span>COMMENCER LA PRÉSENTATION</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>

      <button type="button" id="toggle-speaker-bio-btn" class="btn-m3 btn-m3-outline text-xs px-3.5 py-2 cursor-pointer">
        <svg class="w-4 h-4 text-[#8AB4F8]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Profil & Bio</span>
      </button>
    </div>
  </div>

  <!-- Interactive Popover for Speaker Details -->
  <div id="speaker-bio-modal" class="hidden absolute bottom-20 left-16 z-30 max-w-lg card-m3 border-white/20 p-5 bg-surface-container-high">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold text-[#8AB4F8] uppercase tracking-wider">Profil de l'Intervenant</span>
      <button type="button" id="close-bio-btn" class="text-white/60 hover:text-white text-sm">✕</button>
    </div>
    <p class="text-xs text-white/80 mb-3 leading-relaxed">
      Ingénieur logiciel et formateur, spécialisé dans les architectures logicielles modernes, les systèmes de productivité et le renforcement des compétences numériques des jeunes talents.
    </p>
    <div class="grid grid-cols-2 gap-2 text-[11px] text-white/80">
      <div class="p-2 bg-surface rounded-lg border border-white/10">🎯 Google Workspace Architecture</div>
      <div class="p-2 bg-surface rounded-lg border border-white/10">⚡ Automatisation & Apps Script</div>
      <div class="p-2 bg-surface rounded-lg border border-white/10">👥 Collaboration Temps Réel</div>
      <div class="p-2 bg-surface rounded-lg border border-white/10">📊 Gestion de Données & IA</div>
    </div>
  </div>

  <!-- Footer Speaker Info -->
  <div class="flex items-center justify-between pt-4 border-t border-white/10 text-sm relative z-10">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-surface-container-high border border-white/15 flex items-center justify-center font-bold text-[#8AB4F8] text-sm">
        AS
      </div>
      <div>
        <p class="font-bold text-white text-sm">Abderrahmane SAOUDI</p>
        <p class="text-xs text-white/60 font-medium">Session Speaker & Technology Lead • <span class="font-mono text-[#8AB4F8]">saoudi.online</span></p>
      </div>
    </div>
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-container border border-white/10 font-mono text-[#8AB4F8] font-bold text-xs">
      <span>🌐</span> saoudi.online/777
    </div>
  </div>
</section>

<script>
  const bioBtn = document.getElementById('toggle-speaker-bio-btn');
  const bioModal = document.getElementById('speaker-bio-modal');
  const closeBioBtn = document.getElementById('close-bio-btn');

  bioBtn?.addEventListener('click', () => {
    bioModal?.classList.toggle('hidden');
  });

  closeBioBtn?.addEventListener('click', () => {
    bioModal?.classList.add('hidden');
  });
</script>
