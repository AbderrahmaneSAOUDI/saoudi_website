---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Realistic illustrative numbers representing a chaotic workday
const overloadStats = [
  {
    num: '46',
    label: 'Unread Chat Messages',
    detail: 'WhatsApp groups, Slack channels, direct pings',
    tag: 'Scattered attention',
    color: 'emerald',
    icon: '💬',
  },
  {
    num: '21',
    label: 'Emails Needing Replies',
    detail: 'Invoices, approvals, requests, attachments',
    tag: 'Inbox backlog',
    color: 'sky',
    icon: '✉️',
  },
  {
    num: '04',
    label: 'Fragmented Meetings',
    detail: 'Breaking morning and afternoon focus blocks',
    tag: 'Interrupted time',
    color: 'amber',
    icon: '📅',
  },
  {
    num: '14',
    label: 'Open Browser Tabs & Files',
    detail: 'Draft_v2.docx, final_new.pdf, spreadsheets',
    tag: 'Lost documents',
    color: 'purple',
    icon: '📂',
  },
];
---

<!-- ================= SLIDE 4 PANE (A TYPICAL BUSY DAY) ================= -->
<section 
  id="slide-4-content" 
  class={`slide-pane slide-pane-4 w-full flex flex-col justify-between items-center text-center my-auto py-2 sm:py-3 h-full relative overflow-hidden ${className}`}
>
  <!-- Top Tag & Header -->
  <div class="flex flex-col items-center space-y-1.5 shrink-0 pt-1">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rose-500/10 border-2 border-rose-600/30 text-xs sm:text-sm font-bold text-[#EA4335] uppercase tracking-wider">
      <span class="w-2.5 h-2.5 rounded-full bg-[#EA4335] animate-ping"></span>
      <span>The Real-World Dilemma</span>
    </div>

    <h2 class="font-black text-2xl sm:text-4xl md:text-5xl lg:text-6xl text-slate-900 tracking-tight leading-tight">
      A Typical Busy Day
    </h2>

    <p class="text-xs sm:text-sm md:text-base text-slate-500 font-medium max-w-lg">
      Illustrative example of constant context-switching across modern digital channels
    </p>
  </div>

  <!-- Illustrative Overload Grid (Clean, impactful cards) -->
  <div class="w-full max-w-5xl mx-auto my-auto grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 px-2 py-2">
    {overloadStats.map((item) => (
      <div class="overload-card p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-white border-2 border-slate-200/90 hover:border-slate-400 transition-all duration-300 flex flex-col justify-between text-left relative overflow-hidden group">
        <div class="flex items-center justify-between mb-2">
          <span class="text-2xl sm:text-3xl group-hover:scale-110 transition-transform">{item.icon}</span>
          <span class="px-2 py-0.5 rounded-full bg-slate-100 text-[10px] sm:text-xs font-bold text-slate-600 uppercase">
            {item.tag}
          </span>
        </div>

        <div class="my-2">
          <div class="font-mono text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-none group-hover:text-[#006233] transition-colors">
            {item.num}
          </div>
          <h3 class="text-sm sm:text-base font-black text-slate-800 tracking-tight mt-1 leading-snug">
            {item.label}
          </h3>
        </div>

        <p class="text-[11px] sm:text-xs text-slate-500 font-medium leading-relaxed border-t border-slate-100 pt-2 mt-1">
          {item.detail}
        </p>
      </div>
    ))}
  </div>

  <!-- Central Provocative Question Box (High Visual Hierarchy) -->
  <div class="w-full max-w-4xl mx-auto p-4 sm:p-5 rounded-3xl bg-emerald-50/80 border-2 border-emerald-600/40 text-center relative overflow-hidden shrink-0 mb-1">
    <div class="flex flex-col items-center space-y-1.5">
      <span class="text-xs font-extrabold uppercase tracking-widest text-[#006233]">
        The End-of-Day Question
      </span>
      <h3 class="text-xl sm:text-2xl md:text-3xl lg:text-[2rem] font-black text-slate-900 tracking-tight leading-snug">
        “Busy all day. <span class="text-[#006233] underline decoration-emerald-500 decoration-3 underline-offset-4">But what did I actually finish?</span>”
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 font-medium max-w-2xl">
        Being constantly active in digital apps is not the same as moving your important work forward.
      </p>
    </div>
  </div>
</section>
