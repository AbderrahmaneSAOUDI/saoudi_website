---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="6">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="Analyse" topic="Le Syndrome du Fichier Final" />

  <div class="my-auto max-w-4xl w-full relative z-10">
    <div class="mb-3">
      <span class="text-xs font-bold text-[#F28B82] tracking-wider uppercase bg-[#F28B82]/10 px-2.5 py-1 rounded-md border border-[#F28B82]/30">
        Anti-Pattern Fréquent
      </span>
      <h2 class="title-h1 text-white mt-2">
        Le Chaos Numérique en 5 Étapes
      </h2>
      <p class="text-xs text-white/60 mt-1">
        Comment un travail collaboratif simple devient une crise de gestion de versions :
      </p>
    </div>

    <!-- Stepper Simulator -->
    <div class="card-m3 p-4 mb-3 border-white/15 bg-surface-container">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-2.5 relative" id="chaos-steps">
        <!-- Step 1 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-white/10 bg-surface-container-high transition-all" data-step="1">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-white/40 uppercase">Étape 1</span>
            <span class="text-xs">💬</span>
          </div>
          <div class="font-bold text-xs text-white">Groupe WhatsApp</div>
          <p class="text-[10px] text-white/60 mt-1">« Je viens d'envoyer le doc, regardez ! »</p>
          <div class="mt-2 text-[9px] bg-surface p-1 rounded border border-white/10 text-white/80 truncate font-mono">
            Rapport.docx
          </div>
        </div>

        <!-- Step 2 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-white/10 bg-surface-container-high opacity-40 transition-all" data-step="2">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-white/40 uppercase">Étape 2</span>
            <span class="text-xs">💾</span>
          </div>
          <div class="font-bold text-xs text-white">Téléchargement</div>
          <p class="text-[10px] text-white/60 mt-1">Chaque membre télécharge en local sur son PC.</p>
          <div class="mt-2 text-[9px] bg-surface p-1 rounded border border-white/10 text-white/80 truncate font-mono">
            Rapport (1).docx
          </div>
        </div>

        <!-- Step 3 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-white/10 bg-surface-container-high opacity-40 transition-all" data-step="3">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-white/40 uppercase">Étape 3</span>
            <span class="text-xs">✏️</span>
          </div>
          <div class="font-bold text-xs text-white">Modifs Isolées</div>
          <p class="text-[10px] text-white/60 mt-1">3 personnes modifient le texte en parallèle.</p>
          <div class="mt-2 text-[9px] bg-surface p-1 rounded border border-white/10 text-white/80 truncate font-mono">
            Rapport_modifie_AS.docx
          </div>
        </div>

        <!-- Step 4 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-white/10 bg-surface-container-high opacity-40 transition-all" data-step="4">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-white/40 uppercase">Étape 4</span>
            <span class="text-xs">⚠️</span>
          </div>
          <div class="font-bold text-xs text-white">Conflit Total</div>
          <p class="text-[10px] text-white/60 mt-1">Qui a la vraie vérité ? Comment tout fusionner ?</p>
          <div class="mt-2 text-[9px] bg-[#FDD663]/20 p-1 rounded border border-[#FDD663]/30 text-[#FDD663] truncate font-mono font-bold">
            Rapport_FINAL_v2_ok.docx
          </div>
        </div>

        <!-- Step 5 -->
        <div class="chaos-step p-2.5 rounded-xl border-2 border-[#F28B82]/40 bg-[#F28B82]/10 opacity-40 transition-all" data-step="5">
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[9px] font-bold text-[#F28B82] uppercase">Étape 5</span>
            <span class="text-xs">🚨</span>
          </div>
          <div class="font-bold text-xs text-white">Le Message Fatal</div>
          <p class="text-[10px] text-[#F28B82] mt-1">« Quelqu'un peut renvoyer la dernière version ? »</p>
          <div class="mt-2 text-[9px] bg-[#F28B82]/20 p-1 rounded border border-[#F28B82]/40 text-[#F28B82] truncate font-mono font-bold">
            Rapport_VRAIMENT_FINAL.docx
          </div>
        </div>
      </div>

      <!-- Controls for Step Animation -->
      <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-white/10">
        <button type="button" id="play-chaos-btn" class="btn-m3 btn-m3-outline text-xs px-3 py-1.5 cursor-pointer">
          <span id="play-chaos-label">▶ Lancer la simulation</span>
        </button>
        <div class="text-xs font-bold text-white" id="chaos-status">
          Ça vous rappelle quelque chose ?
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>Le problème n'est pas le fichier, c'est l'absence de workflow</span>
    <button type="button" class="btn-m3 btn-m3-blue text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>LE DÉCLIC : WORKFLOWS →</span>
    </button>
  </div>
</section>

<script>
  let currentStep = 1;
  const maxSteps = 5;
  const chaosSteps = document.querySelectorAll('.chaos-step');
  const playBtn = document.getElementById('play-chaos-btn');
  const playLabel = document.getElementById('play-chaos-label');
  let intervalId: any = null;

  function setStep(step: number) {
    chaosSteps.forEach(el => {
      const s = parseInt(el.getAttribute('data-step') || '1', 10);
      if (s <= step) {
        el.classList.remove('opacity-40');
        el.classList.add('border-[#8AB4F8]', 'bg-[#8AB4F8]/10');
        if (s === 5) {
          el.classList.remove('border-[#8AB4F8]', 'bg-[#8AB4F8]/10');
          el.classList.add('border-[#F28B82]', 'bg-[#F28B82]/20');
        }
      } else {
        el.classList.add('opacity-40');
        el.classList.remove('border-[#8AB4F8]', 'bg-[#8AB4F8]/10', 'border-[#F28B82]', 'bg-[#F28B82]/20');
      }
    });
  }

  playBtn?.addEventListener('click', () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
      if (playLabel) playLabel.textContent = '▶ Recommencer';
      return;
    }

    currentStep = 1;
    setStep(1);
    if (playLabel) playLabel.textContent = '⏸ Pause';

    intervalId = setInterval(() => {
      currentStep++;
      if (currentStep > maxSteps) {
        clearInterval(intervalId);
        intervalId = null;
        if (playLabel) playLabel.textContent = '🔄 Rejouer';
      } else {
        setStep(currentStep);
      }
    }, 750);
  });
</script>
