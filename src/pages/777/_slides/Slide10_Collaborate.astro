---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="10">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="Pilier 02" topic="ORGANIZE : Architecture & Hygiène de Google Drive" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-3">
      <div>
        <span class="text-xs font-bold text-[#8AB4F8] tracking-wider uppercase bg-[#8AB4F8]/10 px-2.5 py-1 rounded-md border border-[#8AB4F8]/30">
          Système de Fichiers & Conventions
        </span>
        <h2 class="title-h1 text-white mt-1">
          « Une arborescence claire élimine 90% du stress d'équipe. »
        </h2>
      </div>
      <div class="hidden sm:block text-right">
        <span class="text-xs font-semibold text-white/70 font-mono bg-surface-container px-2.5 py-1 rounded-lg border border-white/10">
          Convention : [NUM]_[CATÉGORIE]
        </span>
      </div>
    </div>

    <!-- Interactive Fake Drive Workspace -->
    <div class="card-m3 p-0 border-white/10 bg-surface-container overflow-hidden flex flex-col md:flex-row h-64">
      <!-- Drive Sidebar (5 cols) -->
      <div class="w-full md:w-5/12 bg-surface border-r border-white/10 p-3 overflow-y-auto">
        <div class="flex items-center gap-2 pb-2 mb-2 border-b border-white/10">
          <div class="w-4 h-4 rounded bg-[#8AB4F8] flex items-center justify-center text-slate-900 text-[10px] font-bold">▲</div>
          <span class="font-bold text-xs text-white">Drive Partagé • Projet 7.77</span>
        </div>

        <div class="space-y-1" id="drive-folder-list">
          <button type="button" class="drive-folder-item w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-[#8AB4F8] bg-[#8AB4F8]/15 border border-[#8AB4F8]/30 text-left cursor-pointer transition-all" data-folder="admin">
            <span>📁</span>
            <span>01_Administration & Budget</span>
          </button>
          
          <button type="button" class="drive-folder-item w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-white/70 hover:bg-surface-container-high text-left cursor-pointer transition-all" data-folder="design">
            <span>📁</span>
            <span>02_Design & Identité Visuelle</span>
          </button>

          <button type="button" class="drive-folder-item w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-white/70 hover:bg-surface-container-high text-left cursor-pointer transition-all" data-folder="participants">
            <span>📁</span>
            <span>03_Participants & Inscriptions</span>
          </button>

          <button type="button" class="drive-folder-item w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-white/70 hover:bg-surface-container-high text-left cursor-pointer transition-all" data-folder="speakers">
            <span>📁</span>
            <span>04_Intervenants & Présentations</span>
          </button>

          <button type="button" class="drive-folder-item w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs font-medium text-white/70 hover:bg-surface-container-high text-left cursor-pointer transition-all" data-folder="reports">
            <span>📁</span>
            <span>05_Rapports & Clôture</span>
          </button>
        </div>
      </div>

      <!-- Drive File Explorer (7 cols) -->
      <div class="w-full md:w-7/12 p-3.5 flex flex-col justify-between bg-surface-container overflow-y-auto" id="drive-file-viewer">
        <div>
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10">
            <span class="text-xs font-bold text-white" id="current-folder-title">
              📁 Contenu de : 01_Administration & Budget
            </span>
            <span class="text-[10px] text-white/40">3 éléments</span>
          </div>

          <div class="space-y-1.5" id="folder-files-container">
            <div class="flex items-center justify-between p-2 rounded-lg bg-surface border border-white/10 text-xs">
              <div class="flex items-center gap-2 font-medium text-white">
                <span class="text-[#81C784] font-bold">📊</span>
                <span>2026_09_Budget_Previsionnel_v1.xlsx</span>
              </div>
              <span class="text-[10px] text-white/40">Modifié il y a 2h</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-surface border border-white/10 text-xs">
              <div class="flex items-center gap-2 font-medium text-white">
                <span class="text-[#8AB4F8] font-bold">📄</span>
                <span>Convention_Partenariat_Signee.pdf</span>
              </div>
              <span class="text-[10px] text-white/40">Hier</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-surface border border-white/10 text-xs">
              <div class="flex items-center gap-2 font-medium text-white">
                <span class="text-blue-400 font-bold">📝</span>
                <span>Ordre_du_Jour_Reunion_Cadrage.gdoc</span>
              </div>
              <span class="text-[10px] text-white/40">28 Août</span>
            </div>
          </div>
        </div>

        <div class="mt-2 p-2 rounded-lg bg-[#8AB4F8]/10 border border-[#8AB4F8]/20 flex items-center justify-between text-[10px] text-[#8AB4F8]">
          <span>💡 <strong>Bonne pratique :</strong> Préfixez toujours les dossiers par un numéro (01, 02) pour fixer l'ordre logique.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>Un dossier bien structuré fait gagner un temps précieux à chaque collaborateur</span>
    <button type="button" class="btn-m3 btn-m3-blue text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>PILIER 3 : CRÉER SANS REFAIRE →</span>
    </button>
  </div>
</section>

<script>
  const folderData: Record<string, { title: string; files: Array<{ icon: string; name: string; date: string }> }> = {
    admin: {
      title: "📁 Contenu de : 01_Administration & Budget",
      files: [
        { icon: "📊", name: "2026_09_Budget_Previsionnel_v1.xlsx", date: "Modifié il y a 2h" },
        { icon: "📄", name: "Convention_Partenariat_Signee.pdf", date: "Hier" },
        { icon: "📝", name: "Ordre_du_Jour_Reunion_Cadrage.gdoc", date: "28 Août" }
      ]
    },
    design: {
      title: "📁 Contenu de : 02_Design & Identité Visuelle",
      files: [
        { icon: "🎨", name: "777_Master_Logo_Vectoriel.svg", date: "22 Août" },
        { icon: "🖼️", name: "Banniere_LinkedIn_1200x627.png", date: "24 Août" },
        { icon: "🎨", name: "Palette_Couleurs_Tokens.pdf", date: "26 Août" }
      ]
    },
    participants: {
      title: "📁 Contenu de : 03_Participants & Inscriptions",
      files: [
        { icon: "📊", name: "Inscriptions_Atelier_Alger_LIVE.gsheet", date: "À l'instant" },
        { icon: "🪪", name: "Generateur_Badges_Participants.gdoc", date: "Hier" },
        { icon: "📋", name: "Feuille_Emargement_Matinale.pdf", date: "30 Août" }
      ]
    },
    speakers: {
      title: "📁 Contenu de : 04_Intervenants & Présentations",
      files: [
        { icon: "📽️", name: "Session_01_Productivite_Numerique.gslides", date: "Aujourd'hui" },
        { icon: "👤", name: "Bio_Photos_HD_Saoudi.zip", date: "27 Août" },
        { icon: "📝", name: "Questions_Reponses_Public.gdoc", date: "Hier" }
      ]
    },
    reports: {
      title: "📁 Contenu de : 05_Rapports & Clôture",
      files: [
        { icon: "📄", name: "Modele_Rapport_Activite_Final.gdoc", date: "20 Août" },
        { icon: "📊", name: "Statistiques_Evaluation_Satisfaction.gsheet", date: "29 Août" }
      ]
    }
  };

  const folderBtns = document.querySelectorAll('.drive-folder-item');
  const folderTitle = document.getElementById('current-folder-title');
  const filesContainer = document.getElementById('folder-files-container');

  folderBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      folderBtns.forEach(b => {
        b.classList.remove('text-[#8AB4F8]', 'bg-[#8AB4F8]/15', 'border-[#8AB4F8]/30', 'font-semibold');
        b.classList.add('text-white/70', 'font-medium');
      });
      btn.classList.add('text-[#8AB4F8]', 'bg-[#8AB4F8]/15', 'border-[#8AB4F8]/30', 'font-semibold');
      btn.classList.remove('text-white/70', 'font-medium');

      const folderKey = btn.getAttribute('data-folder') || 'admin';
      const data = folderData[folderKey];
      if (data && folderTitle && filesContainer) {
        folderTitle.textContent = data.title;
        filesContainer.innerHTML = data.files.map(f => `
          <div class="flex items-center justify-between p-2 rounded-lg bg-surface border border-white/10 text-xs">
            <div class="flex items-center gap-2 font-medium text-white">
              <span class="font-bold">${f.icon}</span>
              <span>${f.name}</span>
            </div>
            <span class="text-[10px] text-white/40">${f.date}</span>
          </div>
        `).join('');
      }
    });
  });
</script>
