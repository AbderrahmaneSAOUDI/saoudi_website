---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 3 PANE (WELCOME EVERYONE) ================= -->
<section 
  id="slide-3-content" 
  class={`slide-pane slide-pane-3 w-full flex flex-col justify-between my-auto py-2 gap-6 lg:gap-8 ${className}`}
>
  <!-- Top Center Welcome Hero Block -->
  <div class="flex flex-col items-center text-center space-y-3 sm:space-y-4 max-w-4xl mx-auto">
    <!-- Animated 7.77 Badge with Celestial Orbit & Pulsing Ring -->
    <div class="relative w-16 h-16 sm:w-20 sm:h-20 md:w-22 md:h-22 rounded-3xl bg-emerald-50 border-2 border-emerald-600/30 flex items-center justify-center card-float">
      <!-- Spinning Dashed Orbit Ring -->
      <div class="avatar-orbit-ring absolute -inset-3.5 rounded-3xl border-2 border-dashed border-emerald-600/35 pointer-events-none"></div>
      
      <!-- Central 7.77 Logo / Emblem -->
      <span class="text-2xl sm:text-3xl md:text-4xl font-black text-[#1E824C] font-mono tracking-tight">
        7.77
      </span>

      <!-- Live Ambient Sparkle Ping -->
      <span class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-[#1E824C] border-2 border-white flex items-center justify-center">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
      </span>
    </div>

    <!-- Main Headline with Dynamic Gradient Shimmer -->
    <div class="space-y-1 sm:space-y-2">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-600/25 text-xs sm:text-sm font-bold text-[#006233] mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>National Digital Skills Initiative • Age: 24-30</span>
      </div>
      <h2 class="title-highlight font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl tracking-tight leading-tight">
        Welcome Everyone
      </h2>
      <p class="text-slate-600 text-sm sm:text-base md:text-lg lg:text-xl font-normal max-w-2xl mx-auto leading-relaxed">
        « Strengthening digital productivity through practical, accessible, and future-ready workflows. »
      </p>
    </div>
  </div>

  <!-- 3 Animated Value Pillars Grid (Continuous Autonomous Levitation) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 w-full max-w-5xl mx-auto">
    <!-- Pillar 1: Inclusive -->
    <div class="welcome-card welcome-card-1 p-5 sm:p-6 rounded-3xl bg-emerald-50/60 border-2 border-emerald-600/30 flex flex-col justify-between space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="w-12 h-12 rounded-2xl bg-[#1E824C] text-white flex items-center justify-center shrink-0 icon-box-pulse">
          <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <span class="px-2.5 py-0.5 rounded-full bg-white border border-emerald-600/25 text-[11px] font-bold text-[#006233]">
          01. Universal
        </span>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
          Inclusive & Accessible
        </h3>
        <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mt-1.5">
          Empowering citizens across diverse backgrounds with accessible, modern digital practices.
        </p>
      </div>
      <div class="pt-2 border-t border-emerald-600/15 flex items-center justify-between text-xs text-[#006233] font-bold">
        <span>Tailored Progression</span>
        <span>✦</span>
      </div>
    </div>

    <!-- Pillar 2: Practical -->
    <div class="welcome-card welcome-card-2 p-5 sm:p-6 rounded-3xl bg-sky-50/60 border-2 border-sky-600/30 flex flex-col justify-between space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="w-12 h-12 rounded-2xl bg-[#0080C8] text-white flex items-center justify-center shrink-0 icon-box-pulse">
          <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="px-2.5 py-0.5 rounded-full bg-white border border-sky-600/25 text-[11px] font-bold text-[#0080C8]">
          02. Actionable
        </span>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
          Practical & Applied
        </h3>
        <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mt-1.5">
          Hands-on workflows, real-world case studies, and actionable daily productivity techniques.
        </p>
      </div>
      <div class="pt-2 border-t border-sky-600/15 flex items-center justify-between text-xs text-[#0080C8] font-bold">
        <span>Zero Theory Fluff</span>
        <span>✦</span>
      </div>
    </div>

    <!-- Pillar 3: Impactful -->
    <div class="welcome-card welcome-card-3 p-5 sm:p-6 rounded-3xl bg-amber-50/60 border-2 border-amber-600/30 flex flex-col justify-between space-y-4">
      <div class="flex items-start justify-between gap-3">
        <div class="w-12 h-12 rounded-2xl bg-[#D97706] text-white flex items-center justify-center shrink-0 icon-box-pulse">
          <svg class="w-6 h-6 fill-none stroke-current stroke-[2]" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
        </div>
        <span class="px-2.5 py-0.5 rounded-full bg-white border border-amber-600/25 text-[11px] font-bold text-[#D97706]">
          03. Results
        </span>
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
          Immediate Impact
        </h3>
        <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mt-1.5">
          Eliminate digital friction, optimize your time, and produce higher quality outcomes faster.
        </p>
      </div>
      <div class="pt-2 border-t border-amber-600/15 flex items-center justify-between text-xs text-[#D97706] font-bold">
        <span>Measurable Gains</span>
        <span>✦</span>
      </div>
    </div>
  </div>
</section>
