---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 3 PANE (JUST "WELCOME" IN THE MIDDLE) ================= -->
<section 
  id="slide-3-content" 
  class={`slide-pane slide-pane-3 w-full h-full flex items-center justify-center relative my-auto py-6 sm:py-10 ${className}`}
>
  <div class="relative flex items-center justify-center text-center select-none py-12 sm:py-16 md:py-20">
    <!-- Ambient Celestial Concentric Halos (Continuous Orbit) -->
    <div class="welcome-halo absolute w-64 h-64 sm:w-80 sm:h-80 md:w-[440px] md:h-[440px] lg:w-[540px] lg:h-[540px] rounded-full border-2 border-dashed border-emerald-600/25 pointer-events-none"></div>
    <div class="welcome-halo-outer absolute w-80 h-80 sm:w-[400px] sm:h-[400px] md:w-[560px] md:h-[560px] lg:w-[680px] lg:h-[680px] rounded-full border border-dashed border-sky-600/20 pointer-events-none"></div>

    <!-- Pulsing Inner Energy Ring -->
    <div class="welcome-pulse-ring absolute w-48 h-48 sm:w-64 sm:h-64 md:w-80 md:h-80 rounded-full border border-emerald-500/30 pointer-events-none"></div>

    <!-- Pure Minimalist Animated "Welcome" in the Middle -->
    <h1 class="welcome-title title-highlight font-black text-5xl sm:text-7xl md:text-8xl lg:text-9xl xl:text-[10.5rem] tracking-tight leading-none relative z-10">
      Welcome
    </h1>
  </div>
</section>
