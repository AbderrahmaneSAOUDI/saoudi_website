---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 4 PANE (7.77 DIGITAL SKILLS INITIATIVE) ================= -->
<section 
  id="slide-4-content" 
  class={`slide-pane slide-pane-4 w-full grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 xl:gap-10 items-center my-auto py-1 sm:py-2 ${className}`}
>
  <!-- Left Column: Keynote Title, Institutional Leadership & 6 Interactive Skill Pillars -->
  <div class="col-span-1 md:col-span-7 flex flex-col justify-between space-y-3 sm:space-y-3.5">
    
    <!-- Top Pill: Program Identity & Live Beacon -->
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-600/30 text-xs sm:text-sm font-bold text-[#006233] max-w-max">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#1E824C]"></span>
      </span>
      <span class="tracking-wide uppercase text-[10px] sm:text-xs font-black">National Digital Empowerment Initiative</span>
    </div>

    <!-- Main Headline with Continuous Google-Brand Shimmer Gradient -->
    <div>
      <h2 class="title-highlight font-black text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] tracking-tight leading-[1.06]">
        7.77 Digital Skills
      </h2>
      <h3 class="text-slate-900 font-light text-xl sm:text-2xl md:text-3xl lg:text-[2.2rem] tracking-tight mt-1">
        for Every Generation
      </h3>
    </div>

    <!-- Institutional Partnership Presentation -->
    <div class="p-3 sm:p-3.5 rounded-2xl bg-slate-50/90 border border-slate-200/90 flex flex-col gap-2">
      <p class="text-slate-600 text-xs sm:text-[13px] md:text-sm leading-relaxed">
        A national digital empowerment initiative led by Algeria’s <strong class="text-slate-900 font-bold">Ministry of Post and Telecommunications</strong>, in partnership with <strong class="text-[#0080C8] font-bold">Algérie Télécom</strong> and <strong class="text-[#006233] font-bold">Mobilis</strong>.
      </p>

      <!-- Institutional Badges Row -->
      <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px] sm:text-xs font-bold">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-emerald-600/30 text-[#006233]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1E824C]"></span>
          Ministère MPT
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-sky-600/30 text-[#0080C8]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0080C8]"></span>
          Algérie Télécom
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white border border-emerald-600/30 text-[#006233]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#1E824C]"></span>
          Mobilis
        </span>
      </div>
    </div>

    <!-- 6 Core Skill Disciplines with Custom SVG Icons & Continuous Levitation -->
    <div class="pt-2 border-t border-emerald-800/15">
      <p class="text-xs sm:text-sm text-slate-800 font-bold mb-2 flex items-center gap-1.5">
        <span class="text-[#1E824C]">✦</span>
        <span>Practical, inclusive & accessible training across core disciplines:</span>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-2.5">
        <!-- 1. AI -->
        <div class="skill-pill skill-pill-1 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-emerald-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-emerald-50 text-[#1E824C] border border-emerald-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5z" />
            </svg>
          </span>
          <span class="truncate">Artificial Intelligence</span>
        </div>

        <!-- 2. Cybersecurity -->
        <div class="skill-pill skill-pill-2 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-rose-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-rose-50 text-[#EA4335] border border-rose-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </span>
          <span class="truncate">Cybersecurity</span>
        </div>

        <!-- 3. Coding -->
        <div class="skill-pill skill-pill-3 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-sky-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-sky-50 text-[#0080C8] border border-sky-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </span>
          <span class="truncate">Coding & Software</span>
        </div>

        <!-- 4. Data -->
        <div class="skill-pill skill-pill-4 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-amber-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-amber-50 text-[#D97706] border border-amber-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </span>
          <span class="truncate">Data Intelligence</span>
        </div>

        <!-- 5. Cloud -->
        <div class="skill-pill skill-pill-5 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-indigo-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-indigo-50 text-[#4285F4] border border-indigo-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            </svg>
          </span>
          <span class="truncate">Cloud Technologies</span>
        </div>

        <!-- 6. Entrepreneurship -->
        <div class="skill-pill skill-pill-6 flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-teal-600/30 text-slate-800 text-xs font-bold transition-all duration-300">
          <span class="w-7 h-7 rounded-lg bg-teal-50 text-[#0F9D58] border border-teal-600/25 flex items-center justify-center shrink-0 icon-box-pulse">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
              <path d="M9 12H4s.55-3.03 2-4.5c1.62-1.63 5-2.5 5-2.5"/>
              <path d="M12 15v5s3.03-.55 4.5-2c1.63-1.62 2.5-5 2.5-5"/>
            </svg>
          </span>
          <span class="truncate">Entrepreneurship</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: 2 Commanding Keynote Metric Cards with Animated Orbit Accents & Visual Graphs -->
  <div class="col-span-1 md:col-span-5 flex flex-col gap-4 sm:gap-4.5 justify-center">
    
    <!-- Flagship Metric Card 1: 7 → 77 Age Range with Visual Spectrum -->
    <div class="keynote-metric-card metric-card-1 card-shimmer-sweep p-5 sm:p-5.5 rounded-3xl bg-white border-2 border-emerald-600/30 flex flex-col justify-between space-y-2.5 relative overflow-hidden">
      <!-- Rotating Concentric Orbit Accents -->
      <div class="stat-orbit-ring absolute -top-10 -right-10 w-36 h-36 rounded-full border border-dashed border-emerald-600/30 pointer-events-none"></div>
      <div class="stat-orbit-ring-rev absolute -top-14 -right-14 w-44 h-44 rounded-full border border-dashed border-sky-600/20 pointer-events-none"></div>
      
      <!-- Top Numerals & Tag -->
      <div class="flex items-center justify-between gap-3 relative z-10">
        <div class="flex items-baseline gap-1.5">
          <span class="font-mono text-4xl sm:text-5xl lg:text-[3.5rem] font-black tracking-tight text-[#1E824C] leading-none">
            7 → 77
          </span>
        </div>
        <span class="px-3 py-1 rounded-full bg-emerald-50 border border-emerald-600/30 text-xs font-black text-[#006233] uppercase tracking-wider shrink-0">
          Years Covered
        </span>
      </div>

      <!-- Label & Description -->
      <div class="relative z-10">
        <h4 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Age Range Covered</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-bold">Lifelong</span>
        </h4>
        <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mt-0.5">
          Tailored learning pathways empowering young students, active youths, and lifelong senior citizens.
        </p>
      </div>

      <!-- Visual Age Spectrum Graphic with Moving Light Pulse -->
      <div class="p-2.5 rounded-2xl bg-emerald-50/70 border border-emerald-600/20 flex flex-col gap-1.5 relative z-10">
        <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-extrabold text-slate-700">
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#1E824C]"></span> 7 Yrs (Youth)</span>
          <span class="text-[#006233]">24-30 Yrs (Active)</span>
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#0080C8]"></span> 77 Yrs (Senior)</span>
        </div>
        <!-- Progress Bar Track with Pulsing Light Beam -->
        <div class="relative h-2 w-full rounded-full bg-slate-200 overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-r from-[#1E824C] via-[#F9AB00] to-[#0080C8] rounded-full"></div>
          <div class="spectrum-light-pulse absolute inset-y-0 w-12 bg-white/75 rounded-full blur-[1px]"></div>
        </div>
      </div>
    </div>

    <!-- Flagship Metric Card 2: 07 Skill Centers with Constellation Hub Graphic -->
    <div class="keynote-metric-card metric-card-2 card-shimmer-sweep p-5 sm:p-5.5 rounded-3xl bg-white border-2 border-sky-600/30 flex flex-col justify-between space-y-2.5 relative overflow-hidden">
      <!-- Rotating Concentric Orbit Accents -->
      <div class="stat-orbit-ring absolute -top-10 -right-10 w-36 h-36 rounded-full border border-dashed border-sky-600/30 pointer-events-none"></div>
      <div class="stat-orbit-ring-rev absolute -top-14 -right-14 w-44 h-44 rounded-full border border-dashed border-emerald-600/20 pointer-events-none"></div>

      <!-- Top Numerals & Tag -->
      <div class="flex items-center justify-between gap-3 relative z-10">
        <div class="flex items-baseline gap-1.5">
          <span class="font-mono text-4xl sm:text-5xl lg:text-[3.5rem] font-black tracking-tight text-[#0080C8] leading-none">
            07
          </span>
        </div>
        <span class="px-3 py-1 rounded-full bg-sky-50 border border-sky-600/30 text-xs font-black text-[#0080C8] uppercase tracking-wider shrink-0">
          Across Algeria
        </span>
      </div>

      <!-- Label & Description -->
      <div class="relative z-10">
        <h4 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Specialized Skill Centers</span>
          <span class="text-xs px-2 py-0.5 rounded-full bg-sky-50 text-[#0080C8] font-bold">Nationwide</span>
        </h4>
        <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mt-0.5">
          Regional technology centers delivering hands-on workshops and digital mastery across wilayas.
        </p>
      </div>

      <!-- Constellation Network Graphic -->
      <div class="p-2.5 rounded-2xl bg-sky-50/70 border border-sky-600/20 flex items-center justify-between gap-2 relative z-10">
        <div class="flex items-center gap-2">
          <div class="relative w-7 h-7 rounded-xl bg-[#0080C8] text-white flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9"/>
              <circle cx="12" cy="12" r="2" fill="currentColor"/>
              <circle cx="12" cy="6" r="1.2" fill="currentColor"/>
              <circle cx="17" cy="9.5" r="1.2" fill="currentColor"/>
              <circle cx="16" cy="15.5" r="1.2" fill="currentColor"/>
              <circle cx="8" cy="15.5" r="1.2" fill="currentColor"/>
              <circle cx="7" cy="9.5" r="1.2" fill="currentColor"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-[11px] font-bold text-slate-800">Nationwide Hub Network</span>
            <span class="text-[10px] text-slate-500 font-medium">7 High-Impact Centers Across Algerian Wilayas</span>
          </div>
        </div>
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#0080C8]"></span>
        </span>
      </div>
    </div>

  </div>
</section>
