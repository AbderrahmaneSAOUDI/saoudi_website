---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 4 PANE (7.77 DIGITAL SKILLS INITIATIVE) ================= -->
<section 
  id="slide-4-content" 
  class={`slide-pane slide-pane-4 w-full grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 xl:gap-10 items-center my-auto py-1 ${className}`}
>
  <!-- Left Column: Keynote Title, Institutional Leadership & 6 Animated Skill Pillars -->
  <div class="col-span-1 md:col-span-7 flex flex-col justify-between space-y-3 sm:space-y-4">
    
    <!-- Top Pill: Program Identity with Live Breathing Beacon -->
    <div class="program-badge-animated inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-500/10 border-2 border-emerald-600/35 text-xs sm:text-sm md:text-[15px] font-black text-[#006233] max-w-max">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#1E824C]"></span>
      </span>
      <span class="tracking-wide uppercase font-black text-[11px] sm:text-xs md:text-[13px]">National Digital Empowerment Initiative</span>
    </div>

    <!-- Main Headline with Continuous Vibrant Gradient Shimmer & Gentle Breathing -->
    <div class="title-container-animated">
      <h2 class="title-highlight font-black text-4xl sm:text-5xl md:text-[3.35rem] lg:text-[3.85rem] xl:text-[4.2rem] tracking-tight leading-[1.04]">
        7.77 Digital Skills
      </h2>
      <h3 class="text-slate-900 font-light text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] xl:text-[2.85rem] tracking-tight mt-1">
        for Every Generation
      </h3>
    </div>

    <!-- Institutional Partnership Presentation with Animated Badges -->
    <div class="partners-card-animated p-3.5 sm:p-4 rounded-2xl bg-slate-50/95 border-2 border-slate-200/90 flex flex-col gap-2.5">
      <p class="text-slate-700 text-sm sm:text-base md:text-[17px] leading-relaxed font-medium">
        A national digital empowerment initiative led by Algeria’s <strong class="text-slate-900 font-black">Ministry of Post and Telecommunications</strong>, in partnership with <strong class="text-[#0080C8] font-black">Algérie Télécom</strong> and <strong class="text-[#006233] font-black">Mobilis</strong>.
      </p>

      <!-- Institutional Floating Badges Row -->
      <div class="flex flex-wrap items-center gap-2 pt-1 text-xs sm:text-sm font-extrabold">
        <span class="partner-badge partner-badge-1 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-emerald-600/35 text-[#006233]">
          <span class="w-2 h-2 rounded-full bg-[#1E824C] animate-pulse"></span>
          Ministère MPT
        </span>
        <span class="partner-badge partner-badge-2 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-sky-600/35 text-[#0080C8]">
          <span class="w-2 h-2 rounded-full bg-[#0080C8] animate-pulse"></span>
          Algérie Télécom
        </span>
        <span class="partner-badge partner-badge-3 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-emerald-600/35 text-[#006233]">
          <span class="w-2 h-2 rounded-full bg-[#1E824C] animate-pulse"></span>
          Mobilis
        </span>
      </div>
    </div>

    <!-- 6 Core Skill Disciplines with Bigger Text, SVG Icons & Staggered Levitation -->
    <div class="pt-2.5 border-t border-emerald-800/15">
      <p class="text-sm sm:text-base font-black text-slate-900 mb-2.5 flex items-center gap-2">
        <span class="text-[#1E824C] text-base">✦</span>
        <span>Practical, inclusive & accessible training across core disciplines:</span>
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
        <!-- 1. AI -->
        <div class="skill-pill-animated skill-pill-1 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-emerald-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-emerald-50 text-[#1E824C] border border-emerald-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5z" />
            </svg>
          </span>
          <span class="truncate">Artificial Intelligence</span>
        </div>

        <!-- 2. Cybersecurity -->
        <div class="skill-pill-animated skill-pill-2 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-rose-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-rose-50 text-[#EA4335] border border-rose-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </span>
          <span class="truncate">Cybersecurity</span>
        </div>

        <!-- 3. Coding -->
        <div class="skill-pill-animated skill-pill-3 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-sky-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-sky-50 text-[#0080C8] border border-sky-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </span>
          <span class="truncate">Coding & Software</span>
        </div>

        <!-- 4. Data -->
        <div class="skill-pill-animated skill-pill-4 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-amber-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-amber-50 text-[#D97706] border border-amber-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <line x1="18" y1="20" x2="18" y2="10"/>
              <line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </span>
          <span class="truncate">Data Intelligence</span>
        </div>

        <!-- 5. Cloud -->
        <div class="skill-pill-animated skill-pill-5 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-indigo-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-indigo-50 text-[#4285F4] border border-indigo-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            </svg>
          </span>
          <span class="truncate">Cloud Technologies</span>
        </div>

        <!-- 6. Entrepreneurship -->
        <div class="skill-pill-animated skill-pill-6 flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white border-2 border-teal-600/30 text-slate-900 font-extrabold text-xs sm:text-sm md:text-[14px]">
          <span class="w-8 h-8 rounded-xl bg-teal-50 text-[#0F9D58] border border-teal-600/30 flex items-center justify-center shrink-0 icon-pulse-wave">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
              <path d="M9 12H4s.55-3.03 2-4.5c1.62-1.63 5-2.5 5-2.5"/>
              <path d="M12 15v5s3.03-.55 4.5-2c1.63-1.62 2.5-5 2.5-5"/>
            </svg>
          </span>
          <span class="truncate">Entrepreneurship</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: 2 Commanding Keynote Metric Cards with Clean Emerald Spectrum & Constellation Hub -->
  <div class="col-span-1 md:col-span-5 flex flex-col gap-4 sm:gap-5 justify-center">
    
    <!-- Flagship Metric Card 1: 7 → 77 Age Range with Clean Cohesive Emerald Spectrum -->
    <div class="keynote-metric-card metric-card-1 card-shimmer-sweep p-5 sm:p-6 rounded-3xl bg-white border-2 border-emerald-600/35 flex flex-col justify-between space-y-3 relative overflow-hidden">
      <!-- Rotating Concentric Orbit Accents with Revolving Satellite -->
      <div class="stat-orbit-ring absolute -top-10 -right-10 w-40 h-40 rounded-full border border-dashed border-emerald-600/30 pointer-events-none">
        <div class="absolute -top-1.5 left-1/2 w-3 h-3 rounded-full bg-[#1E824C] shadow-none"></div>
      </div>
      <div class="stat-orbit-ring-rev absolute -top-14 -right-14 w-48 h-48 rounded-full border border-dashed border-emerald-600/20 pointer-events-none"></div>
      
      <!-- Top Numerals & Tag -->
      <div class="flex items-center justify-between gap-3 relative z-10">
        <div class="flex items-baseline gap-2">
          <span class="stat-number-pulse font-mono text-5xl sm:text-6xl lg:text-[4rem] xl:text-[4.4rem] font-black tracking-tight text-[#1E824C] leading-none">
            7 → 77
          </span>
        </div>
        <span class="badge-pulse px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-600/35 text-xs sm:text-sm font-black text-[#006233] uppercase tracking-wider shrink-0">
          Years Covered
        </span>
      </div>

      <!-- Label & Description with Bigger Typography -->
      <div class="relative z-10">
        <h4 class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Age Range Covered</span>
          <span class="text-xs sm:text-sm px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-extrabold">Lifelong</span>
        </h4>
        <p class="text-slate-600 text-xs sm:text-sm md:text-base font-semibold leading-relaxed mt-1">
          Tailored learning pathways empowering young students, active youths, and senior citizens.
        </p>
      </div>

      <!-- Clean Cohesive Emerald Age Spectrum with Connected Milestone Cards & Laser Sweep -->
      <div class="p-3 rounded-2xl bg-emerald-50/90 border-2 border-emerald-600/30 flex flex-col gap-2 relative z-10 overflow-hidden">
        <!-- 3 Milestone Cards -->
        <div class="grid grid-cols-3 gap-2 items-center text-center">
          <div class="milestone-box p-1.5 rounded-xl bg-white border border-emerald-600/30 flex flex-col">
            <span class="font-mono text-sm sm:text-base font-black text-[#1E824C]">7 Yrs</span>
            <span class="text-[10px] sm:text-[11px] font-bold text-slate-600">Youth & School</span>
          </div>
          <div class="milestone-box active-milestone p-1.5 rounded-xl bg-[#1E824C] text-white border border-emerald-700 ring-2 ring-emerald-500/40 flex flex-col">
            <span class="font-mono text-sm sm:text-base font-black text-white">24–30 Yrs</span>
            <span class="text-[10px] sm:text-[11px] font-bold text-emerald-100">Active Pros</span>
          </div>
          <div class="milestone-box p-1.5 rounded-xl bg-white border border-emerald-600/30 flex flex-col">
            <span class="font-mono text-sm sm:text-base font-black text-[#006233]">77 Yrs</span>
            <span class="text-[10px] sm:text-[11px] font-bold text-slate-600">Lifelong</span>
          </div>
        </div>

        <!-- Connecting Solid Emerald Laser Track with Smooth 0% to 100% Laser Sweep -->
        <div class="relative h-2 w-full rounded-full bg-emerald-200/80 overflow-hidden">
          <div class="absolute inset-0 bg-[#1E824C] rounded-full"></div>
          <div class="age-laser-sweep absolute inset-y-0 w-28 bg-white/80 rounded-full blur-[1px]"></div>
        </div>
      </div>
    </div>

    <!-- Flagship Metric Card 2: 07 Skill Centers with Constellation Hub Graphic -->
    <div class="keynote-metric-card metric-card-2 card-shimmer-sweep p-5 sm:p-6 rounded-3xl bg-white border-2 border-sky-600/35 flex flex-col justify-between space-y-3 relative overflow-hidden">
      <!-- Rotating Concentric Orbit Accents with Revolving Satellite -->
      <div class="stat-orbit-ring absolute -top-10 -right-10 w-40 h-40 rounded-full border border-dashed border-sky-600/30 pointer-events-none">
        <div class="absolute -top-1.5 left-1/2 w-3 h-3 rounded-full bg-[#0080C8] shadow-none"></div>
      </div>
      <div class="stat-orbit-ring-rev absolute -top-14 -right-14 w-48 h-48 rounded-full border border-dashed border-emerald-600/20 pointer-events-none"></div>

      <!-- Top Numerals & Tag -->
      <div class="flex items-center justify-between gap-3 relative z-10">
        <div class="flex items-baseline gap-2">
          <span class="stat-number-pulse font-mono text-5xl sm:text-6xl lg:text-[4rem] xl:text-[4.4rem] font-black tracking-tight text-[#0080C8] leading-none">
            07
          </span>
        </div>
        <span class="badge-pulse px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-600/35 text-xs sm:text-sm font-black text-[#0080C8] uppercase tracking-wider shrink-0">
          Across Algeria
        </span>
      </div>

      <!-- Label & Description with Bigger Typography -->
      <div class="relative z-10">
        <h4 class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>Specialized Skill Centers</span>
          <span class="text-xs sm:text-sm px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-800 font-extrabold">Nationwide</span>
        </h4>
        <p class="text-slate-600 text-xs sm:text-sm md:text-base font-semibold leading-relaxed mt-1">
          Regional technology centers delivering hands-on workshops and digital mastery across wilayas.
        </p>
      </div>

      <!-- Constellation Network Graphic with Pulsing Radar Hubs -->
      <div class="p-3 rounded-2xl bg-sky-50/90 border-2 border-sky-600/30 flex items-center justify-between gap-3 relative z-10">
        <div class="flex items-center gap-3">
          <div class="relative w-9 h-9 rounded-xl bg-[#0080C8] text-white flex items-center justify-center shrink-0 hub-icon-pulse">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="9"/>
              <circle cx="12" cy="12" r="2" fill="currentColor"/>
              <circle cx="12" cy="6" r="1.3" fill="currentColor"/>
              <circle cx="17" cy="9.5" r="1.3" fill="currentColor"/>
              <circle cx="16" cy="15.5" r="1.3" fill="currentColor"/>
              <circle cx="8" cy="15.5" r="1.3" fill="currentColor"/>
              <circle cx="7" cy="9.5" r="1.3" fill="currentColor"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xs sm:text-sm md:text-[15px] font-black text-slate-900">Nationwide Hub Network</span>
            <span class="text-[11px] sm:text-xs text-slate-600 font-medium">7 High-Impact Centers Across Algerian Wilayas</span>
          </div>
        </div>
        <span class="relative flex h-3 w-3 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-[#0080C8]"></span>
        </span>
      </div>
    </div>

  </div>
</section>
