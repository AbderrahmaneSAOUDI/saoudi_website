---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="11">
  <div class="m3-glow-green"></div>

  <SlideHeader category="Pilier 03" topic="CREATE : Modèles Réutilisables & Composants Intelligents" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-2.5">
      <div>
        <span class="text-xs font-bold text-[#81C784] tracking-wider uppercase bg-[#81C784]/10 px-2.5 py-1 rounded-md border border-[#81C784]/30">
          Google Docs / Sheets / Slides
        </span>
        <h2 class="title-h1 text-white mt-1">
          « Créer une fois. Améliorer continuellement. »
        </h2>
      </div>
      <!-- Template Selector Tabs -->
      <div class="flex items-center gap-1.5 p-1 bg-surface-container rounded-lg border border-white/10" id="doc-template-tabs">
        <button type="button" class="tab-btn text-xs px-2.5 py-1 rounded-md font-bold text-[#81C784] bg-[#81C784]/15 border border-[#81C784]/30 cursor-pointer" data-doc="report">
          📄 Rapport Type
        </button>
        <button type="button" class="tab-btn text-xs px-2.5 py-1 rounded-md font-medium text-white/70 hover:bg-surface-container-high cursor-pointer" data-doc="budget">
          📊 Budget Auto
        </button>
        <button type="button" class="tab-btn text-xs px-2.5 py-1 rounded-md font-medium text-white/70 hover:bg-surface-container-high cursor-pointer" data-doc="roadmap">
          🎯 Plan d'Action
        </button>
      </div>
    </div>

    <!-- Interactive Mock Editor Canvas -->
    <div class="card-m3 p-3.5 border-white/10 bg-surface-container">
      <!-- Editor Toolbar -->
      <div class="flex flex-wrap items-center justify-between pb-2 mb-2.5 border-b border-white/10 gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-white" id="doc-title-display">Rapport_Synthese_Projet_7.77</span>
          <span class="text-[9px] bg-[#81C784]/15 text-[#81C784] px-1.5 py-0.5 rounded border border-[#81C784]/30 font-semibold">Sauvegardé sur Drive</span>
        </div>
        
        <!-- Smart Chips toolbar -->
        <div class="flex items-center gap-1.5 text-xs">
          <span class="text-[10px] text-white/40">Puces :</span>
          <span class="px-2 py-0.5 rounded-full bg-[#8AB4F8]/20 text-[#8AB4F8] border border-[#8AB4F8]/30 text-[9px] font-semibold">@Date: Aujourd'hui</span>
          <span class="px-2 py-0.5 rounded-full bg-[#81C784]/20 text-[#81C784] border border-[#81C784]/30 text-[9px] font-semibold">@Lead: Saoudi</span>
          <span class="px-2 py-0.5 rounded-full bg-[#FDD663]/20 text-[#FDD663] border border-[#FDD663]/30 text-[9px] font-semibold">@Statut: Validé</span>
        </div>
      </div>

      <!-- Editor Body Content -->
      <div id="doc-content-area" class="min-h-[120px] p-3 bg-surface rounded-lg border border-white/10 text-xs font-sans leading-relaxed text-white/90">
        <div class="font-bold text-xs text-white mb-1">1. Contexte & Objectifs du Programme 7.77</div>
        <p class="text-white/70 mb-2 text-[11px]">
          L'initiative nationale vise le développement des compétences numériques clés auprès de la jeunesse algérienne, en se focalisant sur l'autonomie technologique et la maîtrise des flux de travail modernes.
        </p>
        <div class="p-2 rounded bg-surface-container border border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#81C784]"></span>
            <span class="font-semibold text-white/90 text-xs">Livrable 01 : Guide Pratique Workspace</span>
          </div>
          <span class="text-[10px] text-white/50 font-mono">Échéance : 15 Septembre</span>
        </div>
      </div>

      <!-- Footer Principles -->
      <div class="grid grid-cols-3 gap-2 mt-2.5 pt-2 border-t border-white/10 text-[10px]">
        <div class="flex items-center gap-1 text-white/70">
          <span class="text-[#81C784] font-bold">1.</span>
          <span>Ne démarrez jamais d'une page blanche.</span>
        </div>
        <div class="flex items-center gap-1 text-white/70">
          <span class="text-[#8AB4F8] font-bold">2.</span>
          <span>Utilisez des styles de titres hiérarchiques.</span>
        </div>
        <div class="flex items-center gap-1 text-white/70">
          <span class="text-[#FDD663] font-bold">3.</span>
          <span>Intégrez des puces `@` pour lier vos fichiers.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>Un document standardisé garantit une image professionnelle instantanée</span>
    <button type="button" class="btn-m3 btn-m3-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>PILIER 4 : COLLABORATION TEMPS RÉEL →</span>
    </button>
  </div>
</section>

<script>
  const docData: Record<string, { title: string; html: string }> = {
    report: {
      title: "Rapport_Synthese_Projet_7.77",
      html: `
        <div class="font-bold text-xs text-white mb-1">1. Contexte & Objectifs du Programme 7.77</div>
        <p class="text-white/70 mb-2 text-[11px]">
          L'initiative nationale vise le développement des compétences numériques clés auprès de la jeunesse algérienne, en se focalisant sur l'autonomie technologique et la maîtrise des flux de travail modernes.
        </p>
        <div class="p-2 rounded bg-surface-container border border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#81C784]"></span>
            <span class="font-semibold text-white/90 text-xs">Livrable 01 : Guide Pratique Workspace</span>
          </div>
          <span class="text-[10px] text-white/50 font-mono">Échéance : 15 Septembre</span>
        </div>
      `
    },
    budget: {
      title: "Budget_Previsionnel_Automatise_7.77",
      html: `
        <div class="font-bold text-xs text-white mb-1">Tableau des Dépenses & Formules Automatiques</div>
        <div class="grid grid-cols-4 gap-2 text-[10px] font-mono mb-2 bg-surface p-2 rounded border border-white/10">
          <div class="font-bold text-white/90">Poste : Logistique</div>
          <div class="text-white/70">Quantité : 4</div>
          <div class="text-white/70">Prix U : 15 000 DZD</div>
          <div class="font-bold text-[#81C784]">=TOTAL: 60 000 DZD</div>
        </div>
        <p class="text-white/60 text-[10px]">
          ✓ Totaux calculés par formule =SUM(), 0 risque d'erreur manuelle.
        </p>
      `
    },
    roadmap: {
      title: "Plan_Action_Hebdomadaire_Equipe",
      html: `
        <div class="font-bold text-xs text-white mb-1">🎯 Jalons Critiques du Projet</div>
        <ul class="space-y-1 text-white/80 text-[11px]">
          <li class="flex items-center justify-between p-1.5 bg-surface rounded border border-white/10">
            <span>✅ Semaine 1 : Clôture des inscriptions (Forms)</span>
            <span class="text-[9px] bg-[#81C784]/20 text-[#81C784] px-1.5 py-0.5 rounded font-bold">Terminé</span>
          </li>
          <li class="flex items-center justify-between p-1.5 bg-surface rounded border border-white/10">
            <span>⏳ Semaine 2 : Déploiement des ateliers & support</span>
            <span class="text-[9px] bg-[#FDD663]/20 text-[#FDD663] px-1.5 py-0.5 rounded font-bold">En Cours</span>
          </li>
        </ul>
      `
    }
  };

  const tabs = document.querySelectorAll('#doc-template-tabs .tab-btn');
  const titleDisplay = document.getElementById('doc-title-display');
  const contentArea = document.getElementById('doc-content-area');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('font-bold', 'text-[#81C784]', 'bg-[#81C784]/15', 'border-[#81C784]/30');
        t.classList.add('font-medium', 'text-white/70');
      });
      tab.classList.add('font-bold', 'text-[#81C784]', 'bg-[#81C784]/15', 'border-[#81C784]/30');
      tab.classList.remove('font-medium', 'text-white/70');

      const key = tab.getAttribute('data-doc') || 'report';
      const item = docData[key];
      if (item && titleDisplay && contentArea) {
        titleDisplay.textContent = item.title;
        contentArea.innerHTML = item.html;
      }
    });
  });
</script>
