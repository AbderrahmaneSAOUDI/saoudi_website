---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide slide-canvas relative justify-between" data-slide-index="7">
  <div class="diagonal-bg-accent"></div>

  <SlideHeader category="PILIER 01" topic="CAPTURE : De l'Information Brute à la Donnée Structurée" theme="canvas" />

  <div class="relative z-10 my-auto max-w-5xl w-full">
    <div class="flex items-center justify-between mb-4">
      <div>
        <span class="text-xs font-bold text-blue-700 tracking-wider uppercase bg-blue-50 px-2.5 py-1 rounded border border-blue-200">
          Google Forms ➔ Google Sheets
        </span>
        <h2 class="title-h1 text-slate-900 mt-2">
          Ne demandez plus « Envoyez vos noms par WhatsApp »
        </h2>
      </div>
      <div class="hidden sm:block text-right">
        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-full border border-emerald-200">
          ⚡ Synchronisation Directe 100% Automatique
        </span>
      </div>
    </div>

    <!-- Live Interactive Demo Grid: Form on Left, Sheets on Right -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 my-2">
      <!-- Mini Mock Form (5 cols) -->
      <div class="md:col-span-5 card-777 bg-white p-4 border-slate-300">
        <div class="flex items-center gap-2 pb-2 mb-3 border-b border-slate-200">
          <div class="w-6 h-6 rounded bg-purple-600 text-white flex items-center justify-center font-bold text-xs">F</div>
          <div>
            <h4 class="font-bold text-xs text-slate-900 leading-tight">Formulaire Inscription 777</h4>
            <span class="text-[10px] text-slate-400">Atelier Numérique Alger</span>
          </div>
        </div>

        <form id="capture-mock-form" class="space-y-2.5">
          <div>
            <label class="block text-[11px] font-semibold text-slate-700 mb-0.5">Nom & Prénom</label>
            <input type="text" id="cap-name" value="Amina Benali" required class="w-full text-xs px-2.5 py-1.5 rounded border border-slate-300 focus:border-blue-500 focus:outline-none bg-slate-50" />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] font-semibold text-slate-700 mb-0.5">Wilaya</label>
              <select id="cap-wilaya" class="w-full text-xs px-2.5 py-1.5 rounded border border-slate-300 focus:border-blue-500 focus:outline-none bg-slate-50">
                <option value="16 - Alger">16 - Alger</option>
                <option value="31 - Oran">31 - Oran</option>
                <option value="25 - Constantine">25 - Constantine</option>
                <option value="09 - Blida">09 - Blida</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-700 mb-0.5">Domaine</label>
              <select id="cap-domain" class="w-full text-xs px-2.5 py-1.5 rounded border border-slate-300 focus:border-blue-500 focus:outline-none bg-slate-50">
                <option value="Dev Web">Dev Web</option>
                <option value="Data & IA">Data & IA</option>
                <option value="Design UX">Design UX</option>
                <option value="Management">Management</option>
              </select>
            </div>
          </div>

          <button type="submit" class="w-full btn-777 btn-777-blue text-xs py-2 mt-2 cursor-pointer">
            <span>SOUMETTRE LE FORMULAIRE →</span>
          </button>
        </form>
      </div>

      <!-- Arrow Indicator (1 col) -->
      <div class="hidden md:flex md:col-span-1 items-center justify-center">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm">
          ➔
        </div>
      </div>

      <!-- Live Mock Sheet (6 cols) -->
      <div class="md:col-span-6 card-777 bg-white p-4 border-slate-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded bg-emerald-600 text-white flex items-center justify-center font-bold text-xs">S</div>
              <div>
                <h4 class="font-bold text-xs text-slate-900 leading-tight">Inscriptions_777 (Réponses)</h4>
                <span class="text-[10px] text-emerald-600 font-semibold">● Connecté en direct</span>
              </div>
            </div>
            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono">Google Sheets</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-[11px] text-left border-collapse" id="mock-sheets-table">
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-200 font-bold">
                  <th class="p-1.5">Horodatage</th>
                  <th class="p-1.5">Nom</th>
                  <th class="p-1.5">Wilaya</th>
                  <th class="p-1.5">Domaine</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-mono text-[10px]">
                <tr class="text-slate-600">
                  <td class="p-1.5 text-slate-400">10:14:02</td>
                  <td class="p-1.5 font-sans font-medium text-slate-800">Karim Meziane</td>
                  <td class="p-1.5">16 - Alger</td>
                  <td class="p-1.5 text-blue-600 font-semibold">Data & IA</td>
                </tr>
                <tr class="text-slate-600">
                  <td class="p-1.5 text-slate-400">10:18:45</td>
                  <td class="p-1.5 font-sans font-medium text-slate-800">Sara Dahmani</td>
                  <td class="p-1.5">31 - Oran</td>
                  <td class="p-1.5 text-purple-600 font-semibold">Design UX</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
          <span>0 friction, 0 saisie manuelle, 100% exploitable</span>
          <span class="font-semibold text-teal-700">Filtres & TCD prêts</span>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-200">
    <span>Règle d'or : Ne traitez jamais manuellement ce qu'un formulaire peut structurer</span>
    <button type="button" class="btn-777 btn-777-blue text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>PILIER 02 : ORGANISATION DRIVE →</span>
    </button>
  </div>
</section>

<script>
  // Slide 7 Live Form to Sheet Demo
  const form = document.getElementById('capture-mock-form') as HTMLFormElement;
  const tableBody = document.querySelector('#mock-sheets-table tbody');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('cap-name') as HTMLInputElement;
    const wilayaInput = document.getElementById('cap-wilaya') as HTMLSelectElement;
    const domainInput = document.getElementById('cap-domain') as HTMLSelectElement;

    if (!nameInput || !tableBody) return;

    const now = new Date();
    const timeStr = now.toTimeString().split(' ')[0];

    const tr = document.createElement('tr');
    tr.className = 'bg-blue-50/60 text-slate-800 font-bold transition-all';
    tr.innerHTML = `
      <td class="p-1.5 text-blue-700">${timeStr}</td>
      <td class="p-1.5 font-sans">${nameInput.value}</td>
      <td class="p-1.5">${wilayaInput.value}</td>
      <td class="p-1.5 text-teal-700 font-semibold">${domainInput.value}</td>
    `;

    tableBody.prepend(tr);

    // Reset with another sample name
    const sampleNames = ['Yacine Kaci', 'Meriem Bouzid', 'Reda Zerrouki', 'Samia Tlemcani'];
    const randomName = sampleNames[Math.floor(Math.random() * sampleNames.length)];
    nameInput.value = randomName;
  });
</script>
