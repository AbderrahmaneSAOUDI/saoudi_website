---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="14">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="Pilier 06" topic="AUTOMATE : Google Apps Script & Déclencheurs" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-3">
      <div>
        <span class="text-xs font-bold text-[#FDD663] tracking-wider uppercase bg-[#FDD663]/10 px-2.5 py-1 rounded-md border border-[#FDD663]/30">
          Éliminer la Répétition
        </span>
        <h2 class="title-h1 text-white mt-1">
          « Si vous le faites plus de 3 fois, automatisez-le. »
        </h2>
      </div>
      <button type="button" id="trigger-auto-btn" class="btn-m3 btn-m3-yellow text-xs px-3.5 py-2 cursor-pointer">
        <span>⚡ SIMULER L'AUTOMATISATION</span>
      </button>
    </div>

    <!-- Pipeline Flowchart -->
    <div class="card-m3 p-3.5 border-white/10 bg-surface-container mb-3">
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 text-center text-xs" id="auto-pipeline">
        <!-- Node 1 -->
        <div class="auto-node p-2.5 rounded-xl bg-surface border border-white/10 transition-all" id="node-1">
          <div class="text-[9px] font-bold text-white/40 uppercase">1. Entrée</div>
          <div class="font-bold text-white text-xs mt-0.5">Google Forms</div>
          <div class="text-[10px] text-white/50 mt-0.5">Nouvelle réponse</div>
        </div>

        <!-- Node 2 -->
        <div class="auto-node p-2.5 rounded-xl bg-surface border border-white/10 transition-all" id="node-2">
          <div class="text-[9px] font-bold text-white/40 uppercase">2. Données</div>
          <div class="font-bold text-[#81C784] text-xs mt-0.5">Google Sheets</div>
          <div class="text-[10px] text-white/50 mt-0.5">Ligne insérée</div>
        </div>

        <!-- Node 3 -->
        <div class="auto-node p-2.5 rounded-xl bg-surface border border-white/10 transition-all" id="node-3">
          <div class="text-[9px] font-bold text-white/40 uppercase">3. Déclencheur</div>
          <div class="font-bold text-[#FDD663] text-xs mt-0.5">Apps Script</div>
          <div class="text-[10px] text-white/50 mt-0.5">onFormSubmit()</div>
        </div>

        <!-- Node 4 -->
        <div class="auto-node p-2.5 rounded-xl bg-surface border border-white/10 transition-all" id="node-4">
          <div class="text-[9px] font-bold text-white/40 uppercase">4. Action 1</div>
          <div class="font-bold text-[#8AB4F8] text-xs mt-0.5">Gmail API</div>
          <div class="text-[10px] text-white/50 mt-0.5">Email confirmation</div>
        </div>

        <!-- Node 5 -->
        <div class="auto-node p-2.5 rounded-xl bg-surface border border-white/10 transition-all" id="node-5">
          <div class="text-[9px] font-bold text-white/40 uppercase">5. Action 2</div>
          <div class="font-bold text-[#81C784] text-xs mt-0.5">Google Drive</div>
          <div class="text-[10px] text-white/50 mt-0.5">Dossier créé</div>
        </div>
      </div>

      <!-- Code Snippet Preview -->
      <div class="mt-2.5 p-2.5 rounded-lg bg-surface border border-white/10 font-mono text-[10px] text-white/80 overflow-x-auto">
        <span class="text-purple-400">function</span> <span class="text-[#8AB4F8]">onFormSubmit</span>(e) &#123;<br />
        &nbsp;&nbsp;<span class="text-white/40">// Récupération des données du participant 7.77</span><br />
        &nbsp;&nbsp;<span class="text-purple-400">const</span> candidateEmail = e.namedValues[<span class="text-[#FDD663]">'Email'</span>][0];<br />
        &nbsp;&nbsp;<span class="text-white/40">// Envoi automatique de la confirmation personnalisée</span><br />
        &nbsp;&nbsp;GmailApp.<span class="text-[#81C784]">sendEmail</span>(candidateEmail, <span class="text-[#FDD663]">'Confirmation Atelier 7.77'</span>, <span class="text-[#FDD663]">'Bienvenue !'</span>);<br />
        &#125;
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>Votre temps a trop de valeur pour copier-coller des emails manuellement</span>
    <button type="button" class="btn-m3 btn-m3-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>AU-DELÀ DE GOOGLE : L'ÉCOSYSTÈME →</span>
    </button>
  </div>
</section>

<script>
  const triggerBtn = document.getElementById('trigger-auto-btn');
  const nodes = [
    document.getElementById('node-1'),
    document.getElementById('node-2'),
    document.getElementById('node-3'),
    document.getElementById('node-4'),
    document.getElementById('node-5')
  ];

  triggerBtn?.addEventListener('click', () => {
    nodes.forEach(n => n?.classList.remove('border-[#81C784]', 'bg-[#81C784]/15', 'border-[#8AB4F8]', 'bg-[#8AB4F8]/15'));

    nodes.forEach((node, idx) => {
      setTimeout(() => {
        if (node) {
          node.classList.add('border-[#8AB4F8]', 'bg-[#8AB4F8]/15');
          setTimeout(() => {
            node.classList.remove('bg-[#8AB4F8]/15');
            node.classList.add('bg-[#81C784]/15', 'border-[#81C784]');
          }, 350);
        }
      }, idx * 250);
    });
  });
</script>
