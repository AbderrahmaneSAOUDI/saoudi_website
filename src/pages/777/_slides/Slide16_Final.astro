---
import BrandLogo from '../_components/BrandLogo.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="16">
  <!-- Background Brand Accents -->
  <div class="light-brand-accent-1"></div>
  <div class="light-brand-accent-2"></div>

  <!-- Top Institutional Bar -->
  <BrandLogo size="md" showPartners={true} />

  <!-- Main Hero Message -->
  <div class="my-auto space-y-4 max-w-4xl relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#E6F4EA] border border-[#006233]/20 text-[#006233] text-xs font-bold tracking-wide">
      <span>💡 Le Mot de la Fin</span>
      <span class="text-slate-300">|</span>
      <span>Session Terminée</span>
    </div>

    <h1 class="title-display font-black text-slate-900 tracking-tight leading-tight font-cairo">
      TRAVAILLEZ PLUS INTELLIGEMMENT.<br />
      <span class="text-[#006233]">
        Pas avec plus d'outils, mais avec de meilleurs systèmes.
      </span>
    </h1>

    <p class="text-base text-slate-600 leading-relaxed font-normal max-w-2xl">
      Merci à tous les participants du Programme 7.77 ! Construisez vos flux de travail, partagez vos compétences et libérez votre potentiel d'innovation.
    </p>

    <!-- Speaker Contact Card & Actions -->
    <div class="flex flex-wrap items-center gap-4 pt-3 border-t border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-[#006233] text-sm">
          AS
        </div>
        <div>
          <h3 class="font-bold text-slate-900 text-sm leading-tight font-cairo">Abderrahmane SAOUDI</h3>
          <p class="text-xs text-slate-500 font-medium">saoudi.online • saoudi26@gmail.com</p>
        </div>
      </div>

      <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>

      <button type="button" class="btn-777 btn-777-green text-xs px-4 py-2 cursor-pointer" data-deck-goto="1">
        <span>🔄 RECOMMENCER</span>
      </button>

      <button type="button" class="btn-777 btn-777-outline text-xs px-4 py-2 cursor-pointer" id="open-overview-from-final">
        <span>📋 APERÇU DES 16 SLIDES</span>
      </button>
    </div>
  </div>

  <!-- Bottom Brand Footer -->
  <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100 relative z-10">
    <span>Programme 7.77 • Ministère de la Poste et des Télécommunications • Algérie Télécom • Mobilis</span>
    <span class="font-mono text-[#006233] font-bold">777.mpt.gov.dz</span>
  </div>
</section>

<script>
  const openOverviewBtn = document.getElementById('open-overview-from-final');
  openOverviewBtn?.addEventListener('click', () => {
    const drawer = document.getElementById('deck-overview-modal');
    drawer?.classList.add('open');
  });
</script>
