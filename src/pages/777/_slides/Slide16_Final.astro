---
import BrandLogo from '../_components/BrandLogo.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="16">
  <!-- Background Glows -->
  <div class="m3-glow-blue"></div>
  <div class="m3-glow-green"></div>

  <!-- Header -->
  <BrandLogo showTag={true} />

  <!-- Main Hero Message -->
  <div class="my-auto space-y-4 max-w-4xl relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#8AB4F8]/10 border border-[#8AB4F8]/30 text-[#8AB4F8] text-xs font-bold tracking-wide">
      <span>💡 Le Mot de la Fin</span>
      <span class="text-white/30">|</span>
      <span>Session Terminée</span>
    </div>

    <h1 class="title-display font-black text-white tracking-tight leading-tight">
      TRAVAILLEZ PLUS INTELLIGEMMENT.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8AB4F8] via-[#81C784] to-[#FDD663]">
        Pas avec plus d'outils, mais avec de meilleurs systèmes.
      </span>
    </h1>

    <p class="text-base text-white/70 leading-relaxed font-normal max-w-2xl">
      Merci à tous les participants du Programme 7.77 ! Construisez vos flux de travail, partagez vos compétences et libérez votre potentiel de création.
    </p>

    <!-- Speaker Contact Card & Actions -->
    <div class="flex flex-wrap items-center gap-4 pt-3 border-t border-white/10">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-surface-container-high border border-white/15 flex items-center justify-center font-bold text-[#8AB4F8] text-sm">
          AS
        </div>
        <div>
          <h3 class="font-bold text-white text-sm leading-tight">Abderrahmane SAOUDI</h3>
          <p class="text-xs text-white/60 font-medium">saoudi.online • saoudi26@gmail.com</p>
        </div>
      </div>

      <div class="h-8 w-px bg-white/10 hidden sm:block"></div>

      <button type="button" class="btn-m3 btn-m3-blue text-xs px-4 py-2 cursor-pointer" data-deck-goto="1">
        <span>🔄 RECOMMENCER</span>
      </button>

      <button type="button" class="btn-m3 btn-m3-outline text-xs px-4 py-2 cursor-pointer" id="open-overview-from-final">
        <span>📋 APERÇU DES 16 SLIDES</span>
      </button>
    </div>
  </div>

  <!-- Bottom Brand Footer -->
  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>saoudi.online • Programme National 7.77</span>
    <span class="font-mono text-[#8AB4F8] font-bold">saoudi.online/777</span>
  </div>
</section>

<script>
  const openOverviewBtn = document.getElementById('open-overview-from-final');
  openOverviewBtn?.addEventListener('click', () => {
    const drawer = document.getElementById('deck-overview-modal');
    drawer?.classList.add('open');
  });
</script>
