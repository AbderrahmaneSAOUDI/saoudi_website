---
import BrandLogo from '../_components/BrandLogo.astro';
---

<section class="deck-slide slide-dark relative justify-between" data-slide-index="16">
  <div class="diagonal-bg-accent-dark"></div>

  <!-- Top Bar -->
  <div class="relative z-10 flex items-center justify-between">
    <BrandLogo variant="dark" size="md" />
    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-teal-500/10 text-teal-300 border border-teal-500/30">
      Session Terminée • Questions & Échanges
    </span>
  </div>

  <!-- Main Hero Message -->
  <div class="relative z-10 my-auto max-w-4xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-bold tracking-wider uppercase mb-4">
      💡 Le Mot de la Fin
    </div>

    <h1 class="title-display text-white mb-4">
      TRAVAILLEZ PLUS INTELLIGEMMENT.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-blue-400 to-amber-400">
        Pas avec plus d'outils, mais avec de meilleurs systèmes.
      </span>
    </h1>

    <p class="body-lead-dark max-w-2xl text-slate-300 text-base mb-6">
      Merci à tous les participants du Programme 777 ! Construisez vos workflows, partagez vos connaissances et libérez votre potentiel créatif.
    </p>

    <!-- Speaker Contact Card & Outro Actions -->
    <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-white text-base border border-blue-400">
          AS
        </div>
        <div>
          <h3 class="font-bold text-white text-sm leading-tight">Abderrahmane SAOUDI</h3>
          <p class="text-xs text-slate-400">saoudi.online • saoudi26@gmail.com</p>
        </div>
      </div>

      <div class="h-8 w-px bg-slate-800 hidden sm:block"></div>

      <button type="button" class="btn-777 btn-777-orange text-xs px-4 py-2 cursor-pointer" data-deck-goto="1">
        <span>🔄 RECOMMENCER</span>
      </button>

      <button type="button" class="btn-777 btn-777-outline-dark text-xs px-4 py-2 cursor-pointer" id="open-overview-from-final">
        <span>📋 APERÇU DES 16 SLIDES</span>
      </button>
    </div>
  </div>

  <!-- Bottom Brand Footer -->
  <div class="relative z-10 flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-800">
    <span>Programme 777 • Djil & Djil • Ministère de la Poste et des Télécommunications</span>
    <span class="text-teal-400 font-semibold">Alger • 2026</span>
  </div>
</section>

<script>
  const openOverviewBtn = document.getElementById('open-overview-from-final');
  openOverviewBtn?.addEventListener('click', () => {
    const drawer = document.getElementById('deck-overview-modal');
    drawer?.classList.add('open');
  });
</script>
