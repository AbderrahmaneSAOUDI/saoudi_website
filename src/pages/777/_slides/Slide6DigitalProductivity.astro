          </div>

          <!-- Sub-features Tags -->
          <div class="flex items-center gap-2 pt-1">
            <span class="px-2 py-0.5 rounded-md bg-sky-50 text-[10px] font-bold text-[#0080C8] border border-sky-200">✦ Reasoning</span>
