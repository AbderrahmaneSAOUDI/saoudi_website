---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 6 PANE (WHAT IS DIGITAL PRODUCTIVITY?) ================= -->
<section 
  id="slide-6-content" 
  class={`slide-pane slide-pane-6 w-full flex flex-col justify-center items-center text-center my-auto py-3 sm:py-6 h-full ${className}`}
>
  <!-- 1. HERO PRIMARY OBJECT: Grand Keynote Title -->
  <div class="space-y-3 sm:space-y-4 max-w-5xl mx-auto">
    <h2 class="font-black text-4xl sm:text-5xl md:text-6xl lg:text-[4.4rem] xl:text-[5rem] text-slate-900 tracking-tight leading-[1.08]">
      What is <span class="text-[#006233]">Digital Productivity</span>?
    </h2>

    <!-- 2. HERO SECONDARY OBJECT: Prominent, Big Subtitle / Core Definition -->
    <div class="px-5 sm:px-8 py-3.5 sm:py-4.5 rounded-3xl bg-emerald-50/80 border-2 border-emerald-600/30 inline-flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-lg sm:text-2xl md:text-3xl font-bold text-slate-800 tracking-tight max-w-4xl mx-auto">
      <span>Digital productivity = using the right tool to make everyday work</span>
      <div class="inline-flex items-center gap-2 font-black text-base sm:text-xl md:text-2xl">
        <span class="px-3 py-1 rounded-xl bg-emerald-100 text-[#006233] border border-emerald-600/40">easier</span>
        <span class="text-slate-400">•</span>
        <span class="px-3 py-1 rounded-xl bg-sky-100 text-[#0080C8] border border-sky-600/40">faster</span>
        <span class="text-slate-400">•</span>
        <span class="px-3 py-1 rounded-xl bg-amber-100 text-[#D97706] border border-amber-600/40">less messy</span>
      </div>
    </div>
  </div>

  <!-- 3. COMPACT VISUAL AID: Clean, Sleek, Scaled-Down n8n Workflow Graph -->
  <div class="mt-8 sm:mt-10 md:mt-12 w-full max-w-4xl mx-auto">
    
    <!-- Automation Example Label -->
    <div class="flex items-center justify-center gap-2 mb-2 sm:mb-3">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-slate-100 border border-slate-300 text-xs sm:text-sm font-bold text-slate-600 uppercase tracking-wider">
        <svg class="w-3.5 h-3.5 text-[#006233]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
        <span>Workflow Example: Automated Message Processing</span>
      </span>
    </div>

    <!-- Compact Workflow Card (n8n node style, fixed coordinates, 100% attached lines) -->
    <div class="workflow-compact-box relative w-full h-[140px] sm:h-[160px] rounded-2xl bg-white border-2 border-slate-200/90 overflow-hidden flex items-center justify-center p-2">
      <!-- Grid Dots Canvas -->
      <div class="canvas-grid-dots absolute inset-0 pointer-events-none opacity-30"></div>

      <!-- Vector Connection Lines & Nodes in SVG (ViewBox 900 x 140) -->
      <svg class="w-full h-full relative z-10" viewBox="0 0 900 140" fill="none" xmlns="http://www.w3.org/2000/svg">
        
        <!-- Animated Connecting Wire 1: WhatsApp Trigger (x:150, y:70) -> AI Agent (x:370, y:70) -->
        <path d="M 165,70 L 360,70" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round" />
        <path d="M 165,70 L 360,70" stroke="#006233" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
        
        <!-- Animated Packet 1: Gliding to AI Agent -->
        <circle r="4.5" fill="#006233" stroke="#ffffff" stroke-width="1.5">
          <animateMotion dur="1.8s" repeatCount="indefinite" path="M 165,70 L 360,70" />
        </circle>

        <!-- Animated Connecting Wire 2A: AI Agent (x:530, y:50) -> WhatsApp Reply (x:730, y:40) -->
        <path d="M 530,52 C 585,52 645,40 730,40" stroke="#cbd5e1" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 530,52 C 585,52 645,40 730,40" stroke="#006233" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
        
        <!-- Animated Packet 2A: Gliding to WhatsApp Reply -->
        <circle r="4" fill="#006233" stroke="#ffffff" stroke-width="1.5">
          <animateMotion dur="1.8s" begin="0.9s" repeatCount="indefinite" path="M 530,52 C 585,52 645,40 730,40" />
        </circle>

        <!-- Animated Connecting Wire 2B: AI Agent (x:530, y:88) -> Google Sheets (x:730, y:100) -->
        <path d="M 530,88 C 585,88 645,100 730,100" stroke="#cbd5e1" stroke-width="2.5" stroke-linecap="round" />
        <path d="M 530,88 C 585,88 645,100 730,100" stroke="#009954" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
        
        <!-- Animated Packet 2B: Gliding to Google Sheets -->
        <circle r="4" fill="#009954" stroke="#ffffff" stroke-width="1.5">
          <animateMotion dur="1.8s" begin="0.9s" repeatCount="indefinite" path="M 530,88 C 585,88 645,100 730,100" />
        </circle>

        <!-- ================= WORKFLOW NODES ================= -->

        <!-- NODE 1: WHATSAPP TRIGGER (x: 45, y: 32) -->
        <g transform="translate(45, 30)">
          <!-- Node Container Card -->
          <rect x="0" y="0" width="120" height="80" rx="16" fill="#ffffff" stroke="#006233" stroke-width="2" />
          
          <!-- Trigger Flash Pill -->
          <rect x="10" y="8" width="56" height="16" rx="8" fill="#fef2f2" stroke="#ef4444" stroke-width="1" />
          <text x="38" y="20" text-anchor="middle" font-size="9" font-weight="900" fill="#dc2626" font-family="system-ui, sans-serif">⚡ TRIGGER</text>

          <!-- WhatsApp Vector Logo -->
          <g transform="translate(14, 30) scale(0.09)">
            <path fill="#25D366" fill-rule="evenodd" d="M307.546 52.566C273.709 18.684 228.706.017 180.756 0 81.951 0 1.538 80.404 1.504 179.235c-.017 31.594 8.242 62.432 23.928 89.609L0 361.736l95.024-24.925c26.179 14.285 55.659 21.805 85.655 21.814h.077c98.788 0 179.21-80.413 179.244-179.244.017-47.898-18.608-92.926-52.454-126.807v-.008Zm-126.79 275.788h-.06c-26.73-.008-52.952-7.194-75.831-20.765l-5.44-3.231-56.391 14.791 15.05-54.981-3.542-5.638c-14.912-23.721-22.793-51.139-22.776-79.286.035-82.14 66.867-148.973 149.051-148.973 39.793.017 77.198 15.53 105.328 43.695 28.131 28.157 43.61 65.596 43.593 105.398-.035 82.149-66.867 148.982-148.982 148.982v.008Zm81.719-111.577c-4.478-2.243-26.497-13.073-30.606-14.568-4.108-1.496-7.09-2.243-10.073 2.243-2.982 4.487-11.568 14.577-14.181 17.559-2.613 2.991-5.226 3.361-9.704 1.117-4.477-2.243-18.908-6.97-36.02-22.226-13.313-11.878-22.304-26.54-24.916-31.027-2.613-4.486-.275-6.91 1.959-9.136 2.011-2.011 4.478-5.234 6.721-7.847 2.244-2.613 2.983-4.486 4.478-7.469 1.496-2.991.748-5.603-.369-7.847-1.118-2.243-10.073-24.289-13.812-33.253-3.636-8.732-7.331-7.546-10.073-7.692-2.613-.13-5.595-.155-8.586-.155-2.991 0-7.839 1.118-11.947 5.604-4.108 4.486-15.677 15.324-15.677 37.361s16.047 43.344 18.29 46.335c2.243 2.991 31.585 48.225 76.51 67.632 10.684 4.615 19.029 7.374 25.535 9.437 10.727 3.412 20.49 2.931 28.208 1.779 8.604-1.289 26.498-10.838 30.228-21.298 3.73-10.46 3.73-19.433 2.613-21.298-1.117-1.865-4.108-2.991-8.586-5.234l.008-.017Z" clip-rule="evenodd"/>
          </g>

          <text x="50" y="47" font-size="12" font-weight="900" fill="#0f172a" font-family="system-ui, sans-serif">WhatsApp</text>
          <text x="50" y="62" font-size="10" font-weight="700" fill="#64748b" font-family="system-ui, sans-serif">New Message</text>

          <!-- Right Port -->
          <circle cx="120" cy="40" r="5" fill="#ffffff" stroke="#006233" stroke-width="2" />
        </g>

        <!-- NODE 2: CENTRAL AI AGENT (x: 360, y: 22) -->
        <g transform="translate(360, 20)">
          <!-- Main Card Body -->
          <rect x="0" y="0" width="170" height="100" rx="20" fill="#ffffff" stroke="#006233" stroke-width="2.5" />
          
          <!-- Left Input Port -->
          <circle cx="0" cy="50" r="5" fill="#ffffff" stroke="#006233" stroke-width="2" />

          <!-- Top Status Pill -->
          <rect x="105" y="10" width="54" height="16" rx="8" fill="#e8fdf0" stroke="#006233" stroke-width="1" />
          <circle cx="114" cy="18" r="2.5" fill="#006233" />
          <text x="135" y="22" text-anchor="middle" font-size="8.5" font-weight="900" fill="#006233" font-family="system-ui, sans-serif">ACTIVE</text>

          <!-- Robot AI Icon -->
          <g transform="translate(14, 22)">
            <rect x="0" y="6" width="28" height="22" rx="6" fill="#ecfdf5" stroke="#006233" stroke-width="1.8" />
            <circle cx="14" cy="2" r="2.5" fill="#006233" />
            <line x1="14" y1="4" x2="14" y2="6" stroke="#006233" stroke-width="1.8" />
            <circle cx="9" cy="16" r="2" fill="#006233" />
            <circle cx="19" cy="16" r="2" fill="#006233" />
          </g>

          <text x="50" y="38" font-size="16" font-weight="900" fill="#0f172a" font-family="system-ui, sans-serif">AI Agent</text>
          <text x="50" y="52" font-size="10.5" font-weight="700" fill="#006233" font-family="system-ui, sans-serif">Smart Router</text>

          <!-- Sub-modules inside agent -->
          <g transform="translate(14, 68)">
            <rect x="0" y="0" width="66" height="20" rx="6" fill="#f0f9ff" stroke="#0080C8" stroke-width="1" />
            <text x="33" y="14" text-anchor="middle" font-size="9" font-weight="800" fill="#0080C8" font-family="system-ui, sans-serif">✦ LLM Model</text>
          </g>
          <g transform="translate(86, 68)">
            <rect x="0" y="0" width="70" height="20" rx="6" fill="#f8fafc" stroke="#64748b" stroke-width="1" />
            <text x="35" y="14" text-anchor="middle" font-size="9" font-weight="800" fill="#64748b" font-family="system-ui, sans-serif">⛁ Memory</text>
          </g>

          <!-- Right Output Ports (Top for WhatsApp, Bottom for Sheets) -->
          <circle cx="170" cy="32" r="4.5" fill="#ffffff" stroke="#006233" stroke-width="2" />
          <circle cx="170" cy="68" r="4.5" fill="#ffffff" stroke="#009954" stroke-width="2" />
        </g>

        <!-- NODE 3A: SEND WHATSAPP MESSAGE (x: 730, y: 10) -->
        <g transform="translate(730, 8)">
          <!-- Node Container Card -->
          <rect x="0" y="0" width="125" height="56" rx="14" fill="#ffffff" stroke="#006233" stroke-width="1.8" />
          
          <!-- Left Input Port -->
          <circle cx="0" cy="32" r="4.5" fill="#ffffff" stroke="#006233" stroke-width="2" />

          <!-- WhatsApp Vector Logo -->
          <g transform="translate(10, 14) scale(0.08)">
            <path fill="#25D366" fill-rule="evenodd" d="M307.546 52.566C273.709 18.684 228.706.017 180.756 0 81.951 0 1.538 80.404 1.504 179.235c-.017 31.594 8.242 62.432 23.928 89.609L0 361.736l95.024-24.925c26.179 14.285 55.659 21.805 85.655 21.814h.077c98.788 0 179.21-80.413 179.244-179.244.017-47.898-18.608-92.926-52.454-126.807v-.008Zm-126.79 275.788h-.06c-26.73-.008-52.952-7.194-75.831-20.765l-5.44-3.231-56.391 14.791 15.05-54.981-3.542-5.638c-14.912-23.721-22.793-51.139-22.776-79.286.035-82.14 66.867-148.973 149.051-148.973 39.793.017 77.198 15.53 105.328 43.695 28.131 28.157 43.61 65.596 43.593 105.398-.035 82.149-66.867 148.982-148.982 148.982v.008Zm81.719-111.577c-4.478-2.243-26.497-13.073-30.606-14.568-4.108-1.496-7.09-2.243-10.073 2.243-2.982 4.487-11.568 14.577-14.181 17.559-2.613 2.991-5.226 3.361-9.704 1.117-4.477-2.243-18.908-6.97-36.02-22.226-13.313-11.878-22.304-26.54-24.916-31.027-2.613-4.486-.275-6.91 1.959-9.136 2.011-2.011 4.478-5.234 6.721-7.847 2.244-2.613 2.983-4.486 4.478-7.469 1.496-2.991.748-5.603-.369-7.847-1.118-2.243-10.073-24.289-13.812-33.253-3.636-8.732-7.331-7.546-10.073-7.692-2.613-.13-5.595-.155-8.586-.155-2.991 0-7.839 1.118-11.947 5.604-4.108 4.486-15.677 15.324-15.677 37.361s16.047 43.344 18.29 46.335c2.243 2.991 31.585 48.225 76.51 67.632 10.684 4.615 19.029 7.374 25.535 9.437 10.727 3.412 20.49 2.931 28.208 1.779 8.604-1.289 26.498-10.838 30.228-21.298 3.73-10.46 3.73-19.433 2.613-21.298-1.117-1.865-4.108-2.991-8.586-5.234l.008-.017Z" clip-rule="evenodd"/>
          </g>

          <text x="44" y="28" font-size="11.5" font-weight="900" fill="#0f172a" font-family="system-ui, sans-serif">WhatsApp Reply</text>
          <text x="44" y="44" font-size="9.5" font-weight="700" fill="#006233" font-family="system-ui, sans-serif">Instant Response</text>
        </g>

        <!-- NODE 3B: GOOGLE SHEETS (x: 730, y: 74) -->
        <g transform="translate(730, 74)">
          <!-- Node Container Card -->
          <rect x="0" y="0" width="125" height="56" rx="14" fill="#ffffff" stroke="#009954" stroke-width="1.8" />
          
          <!-- Left Input Port -->
          <circle cx="0" cy="26" r="4.5" fill="#ffffff" stroke="#009954" stroke-width="2" />

          <!-- Google Sheets Vector Icon -->
          <g transform="translate(10, 14) scale(0.14)">
            <path fill="#009954" d="M8 74.6c0-8.9 0-13.4 1.4-17a20 20 0 0 1 11.2-11.2C24.2 45 28.7 45 37.6 45h60.8c8.9 0 13.4 0 17 1.4a20 20 0 0 1 11.2 11.2C128 61.2 128 65.7 128 74.6v42.8c0 8.9 0 13.4-1.4 17a20 20 0 0 1-11.2 11.2C111.8 147 107.3 147 98.4 147H37.6c-8.9 0-13.4 0-17-1.4a20 20 0 0 1-11.2-11.2C8 130.8 8 126.3 8 117.4z"/>
            <path fill="#0ebc5f" d="M24 32h160v128H24z" rx="20"/>
            <path stroke="#fff" stroke-linecap="round" stroke-width="12" d="M80 121h84m-20 19V76"/>
          </g>

          <text x="44" y="28" font-size="11.5" font-weight="900" fill="#0f172a" font-family="system-ui, sans-serif">Google Sheets</text>
          <text x="44" y="44" font-size="9.5" font-weight="700" fill="#009954" font-family="system-ui, sans-serif">Log & Save Row</text>
        </g>

      </svg>
    </div>
  </div>
</section>
