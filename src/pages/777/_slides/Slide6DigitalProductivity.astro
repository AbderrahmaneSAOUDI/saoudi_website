          <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 120" fill="none">
            <!-- Wire to WhatsApp Reply (Top) -->
            <path d="M 0,40 C 50,40 50,25 100,25" stroke="#cbd5e1" stroke-width="2.5" stroke-linecap="round" />
            <path d="M 0,40 C 50,40 50,25 100,25" stroke="#006233" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
            <circle r="4" fill="#006233" stroke="#ffffff" stroke-width="1.5">
              <animateMotion dur="1.6s" begin="0.8s" repeatCount="indefinite" path="M 0,40 C 50,40 50,25 100,25" />
            </circle>

            <!-- Wire to Google Sheets (Bottom) -->
            <path d="M 0,80 C 50,80 50,95 100,95" stroke="#cbd5e1" stroke-width="2.5" stroke-linecap="round" />
            <path d="M 0,80 C 50,80 50,95 100,95" stroke="#009954" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
            <circle r="4" fill="#009954" stroke="#ffffff" stroke-width="1.5">
              <animateMotion dur="1.6s" begin="0.8s" repeatCount="indefinite" path="M 0,80 C 50,80 50,95 100,95" />
            </circle>
          </svg>
