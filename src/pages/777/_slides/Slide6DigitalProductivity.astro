      <!-- Background Canvas Grid Dots -->
      <div class="canvas-grid-dots absolute inset-0 pointer-events-none opacity-30"></div>

      <!-- Content Container with 3 Major Stages -->
      <div class="relative z-10 w-full flex flex-col md:flex-row items-center justify-between gap-3 sm:gap-4 md:gap-6">
        
        <!-- STAGE 1: TRIGGER NODE (WhatsApp) -->
        <div class="workflow-node trigger-node w-full md:w-44 lg:w-52 p-3 sm:p-3.5 md:p-4 rounded-2xl bg-white border-2 border-emerald-600/50 flex flex-row md:flex-col items-center md:text-center gap-3 md:gap-0 md:space-y-2 shrink-0 relative transition-transform duration-300 hover:scale-[1.02]">
