---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Load all AI model logos from _logos directory
const logosDir = path.resolve(process.cwd(), 'src/pages/777/_assets/_logos');
const logoFiles = fs.readdirSync(logosDir).filter(f => f.endsWith('.svg')).sort();

const logos = logoFiles.map(file => {
  const content = fs.readFileSync(path.join(logosDir, file), 'utf-8');
  let name = file
    .replace('logo_', '')
    .replace('-color.svg', '')
    .replace('.svg', '');
  
  if (name === 'metaai') name = 'Meta AI';
  else if (name === 'openai') name = 'OpenAI';
  else if (name === 'replit') name = 'Replit';
  else if (name === 'perplexity') name = 'Perplexity';
  else name = name.charAt(0).toUpperCase() + name.slice(1);

  return { file, name, content };
});
---

<!-- ================= SLIDE 6 PANE (WHAT IS DIGITAL PRODUCTIVITY?) ================= -->
<section 
  id="slide-6-content" 
  class={`slide-pane slide-pane-6 w-full flex flex-col justify-between items-center text-center my-auto py-2 sm:py-4 h-full ${className}`}
>
  <!-- 1. HERO TITLE: Strictly in One Single Line -->
  <div class="w-full flex flex-col items-center justify-center shrink-0 mt-1 sm:mt-2 space-y-2 sm:space-y-3">
    <h2 class="font-black text-2xl sm:text-4xl md:text-5xl lg:text-[3.8rem] xl:text-[4.2rem] text-slate-900 tracking-tight leading-none sm:whitespace-nowrap">
      What is <span class="text-[#006233]">Digital Productivity</span>?
    </h2>

    <!-- 2. HERO SUBTITLE: Clean, Spacious, Not Bolded -->
    <div class="px-6 sm:px-8 py-2.5 sm:py-3.5 rounded-3xl bg-emerald-50/70 border-2 border-emerald-600/25 inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-base sm:text-xl md:text-[22px] font-normal text-slate-700 tracking-tight max-w-4xl mx-auto">
      <span>Digital productivity = using the right tool to make everyday work</span>
      <div class="inline-flex items-center gap-2 font-bold text-sm sm:text-lg md:text-xl">
        <span class="px-2.5 py-0.5 rounded-lg bg-emerald-100/90 text-[#006233] border border-emerald-600/30">easier</span>
        <span class="text-slate-400 font-normal">•</span>
        <span class="px-2.5 py-0.5 rounded-lg bg-sky-100/90 text-[#0080C8] border border-sky-600/30">faster</span>
        <span class="text-slate-400 font-normal">•</span>
        <span class="px-2.5 py-0.5 rounded-lg bg-amber-100/90 text-[#D97706] border border-amber-600/30">less messy</span>
      </div>
    </div>
  </div>

  <!-- 3. EXPANDED, CLEAN WORKFLOW CANVAS (Bigger, perfectly contained texts, 100% attached) -->
  <div class="w-full max-w-5xl mx-auto flex-1 flex items-center justify-center my-auto px-2">
