            </svg>
          </div>

          <!-- Fully Contained Text Content -->
          <div class="w-full">
            <h4 class="text-base sm:text-lg font-black text-slate-900 leading-snug">WhatsApp</h4>
            <p class="text-xs font-semibold text-slate-500 mt-0.5">Incoming Message</p>
          </div>

          <!-- Port Dot Right -->
          <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-emerald-600 flex items-center justify-center">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-600"></div>
          </div>
        </div>

        <!-- CONNECTOR PIPE 1: Trigger -> AI Agent -->
        <div class="hidden md:flex flex-1 h-12 items-center justify-center relative min-w-[50px]">
          <svg class="w-full h-8" preserveAspectRatio="none" viewBox="0 0 100 24" fill="none">
            <!-- Base Line -->
            <line x1="0" y1="12" x2="100" y2="12" stroke="#cbd5e1" stroke-width="3" stroke-linecap="round" />
            <!-- Flowing Active Dash -->
            <line x1="0" y1="12" x2="100" y2="12" stroke="#006233" stroke-width="3" stroke-linecap="round" stroke-dasharray="6 6" class="flow-wire-active" />
            <!-- Gliding Packet -->
            <circle r="4.5" fill="#006233" stroke="#ffffff" stroke-width="1.5">
              <animateMotion dur="1.6s" repeatCount="indefinite" path="M 0,12 L 100,12" />
            </circle>
          </svg>
        </div>

        <!-- STAGE 2: CENTRAL AI AGENT (Featuring the 2s Logo Carousel) -->
        <div class="workflow-node agent-node w-full md:w-64 lg:w-72 p-3 sm:p-4 md:p-5 rounded-2xl bg-white border-2 border-[#006233] flex flex-row md:flex-col items-center md:text-center gap-3 md:gap-0 md:space-y-2.5 shrink-0 relative transition-transform duration-300 hover:scale-[1.02]">
          
          <!-- Port Dot Left -->
          <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-[#006233] flex items-center justify-center">
            <div class="w-1.5 h-1.5 rounded-full bg-[#006233]"></div>
          </div>

          <!-- Active Ping Pill -->
          <div class="px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-300 text-[10px] font-black text-[#006233] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#006233] animate-ping"></span>
            <span>ACTIVE AGENT</span>
          </div>

          <!-- Central Icon Slot: The 2-second Animated Logo Carousel -->
          <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-slate-50 border-2 border-emerald-600/30 flex items-center justify-center p-2.5 overflow-hidden shrink-0">
            {logos.map((logo, idx) => (
              <div 
                class={`agent-logo-item ${idx === 0 ? 'active-logo' : ''}`}
                data-logo-name={logo.name}
              >
                <Fragment set:html={logo.content} />
              </div>
            ))}
          </div>

          <!-- Contained Text Content -->
          <div class="w-full space-y-1">
            <h3 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight leading-snug">
              AI Agent
            </h3>
            
            <!-- Dynamic Model Name Label Tag -->
            <div class="flex items-center justify-center">
              <span id="activeModelLabel" class="px-2.5 py-0.5 rounded-full bg-emerald-100/80 text-xs font-bold text-[#006233] border border-emerald-300/80 transition-all duration-300">
                {logos[0]?.name || 'Gemini'}
