          <div class="px-2.5 py-0.5 rounded-full bg-rose-50 border border-rose-200 text-[10px] font-black text-rose-600 tracking-wider flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            <span>TRIGGER</span>
          </div>

          <!-- WhatsApp Vector Logo -->
          <div class="w-12 h-12 rounded-2xl bg-[#e8fdf0] flex items-center justify-center p-2 shrink-0">
            <svg class="w-8 h-8" viewBox="0 0 360 362" fill="none">
