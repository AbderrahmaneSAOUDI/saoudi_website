        <!-- STAGE 3: OUTPUT ACTIONS (Stacked Vertically, 100% Contained) -->
        <div class="flex flex-row md:flex-col gap-3 sm:gap-3.5 md:gap-4 shrink-0 w-full md:w-52 lg:w-60">
          
          <!-- OUTPUT A: WhatsApp Reply -->
          <div class="workflow-node output-node px-4 py-3 rounded-xl bg-white border-2 border-emerald-600/50 flex items-center gap-3 relative transition-transform duration-300 hover:scale-[1.02]">
            <!-- Port Dot Left -->
            <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-emerald-600 flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-emerald-600"></div>
            </div>

            <div class="w-10 h-10 rounded-xl bg-[#e8fdf0] flex items-center justify-center p-1.5 shrink-0">
              <svg class="w-6 h-6" viewBox="0 0 360 362" fill="none">
                <path fill="#25D366" fill-rule="evenodd" d="M307.546 52.566C273.709 18.684 228.706.017 180.756 0 81.951 0 1.538 80.404 1.504 179.235c-.017 31.594 8.242 62.432 23.928 89.609L0 361.736l95.024-24.925c26.179 14.285 55.659 21.805 85.655 21.814h.077c98.788 0 179.21-80.413 179.244-179.244.017-47.898-18.608-92.926-52.454-126.807v-.008Zm-126.79 275.788h-.06c-26.73-.008-52.952-7.194-75.831-20.765l-5.44-3.231-56.391 14.791 15.05-54.981-3.542-5.638c-14.912-23.721-22.793-51.139-22.776-79.286.035-82.14 66.867-148.973 149.051-148.973 39.793.017 77.198 15.53 105.328 43.695 28.131 28.157 43.61 65.596 43.593 105.398-.035 82.149-66.867 148.982-148.982 148.982v.008Zm81.719-111.577c-4.478-2.243-26.497-13.073-30.606-14.568-4.108-1.496-7.09-2.243-10.073 2.243-2.982 4.487-11.568 14.577-14.181 17.559-2.613 2.991-5.226 3.361-9.704 1.117-4.477-2.243-18.908-6.97-36.02-22.226-13.313-11.878-22.304-26.54-24.916-31.027-2.613-4.486-.275-6.91 1.959-9.136 2.011-2.011 4.478-5.234 6.721-7.847 2.244-2.613 2.983-4.486 4.478-7.469 1.496-2.991.748-5.603-.369-7.847-1.118-2.243-10.073-24.289-13.812-33.253-3.636-8.732-7.331-7.546-10.073-7.692-2.613-.13-5.595-.155-8.586-.155-2.991 0-7.839 1.118-11.947 5.604-4.108 4.486-15.677 15.324-15.677 37.361s16.047 43.344 18.29 46.335c2.243 2.991 31.585 48.225 76.51 67.632 10.684 4.615 19.029 7.374 25.535 9.437 10.727 3.412 20.49 2.931 28.208 1.779 8.604-1.289 26.498-10.838 30.228-21.298 3.73-10.46 3.73-19.433 2.613-21.298-1.117-1.865-4.108-2.991-8.586-5.234l.008-.017Z" clip-rule="evenodd" />
              </svg>
            </div>

            <div class="text-left overflow-hidden">
              <h4 class="text-sm font-black text-slate-900 leading-tight truncate">WhatsApp Reply</h4>
              <p class="text-xs font-semibold text-[#006233] leading-tight truncate mt-0.5">Sends instant answer</p>
            </div>
          </div>

          <!-- OUTPUT B: Google Sheets -->
          <div class="workflow-node output-node px-4 py-3 rounded-xl bg-white border-2 border-[#009954]/50 flex items-center gap-3 relative transition-transform duration-300 hover:scale-[1.02]">
            <!-- Port Dot Left -->
            <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-white border-2 border-[#009954] flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[#009954]"></div>
            </div>

            <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center p-1 shrink-0">
              <svg class="w-7 h-7" viewBox="0 0 192 192" fill="none">
                <path fill="#009954" d="M8 74.6c0-8.9 0-13.4 1.4-17a20 20 0 0 1 11.2-11.2C24.2 45 28.7 45 37.6 45h60.8c8.9 0 13.4 0 17 1.4a20 20 0 0 1 11.2 11.2C128 61.2 128 65.7 128 74.6v42.8c0 8.9 0 13.4-1.4 17a20 20 0 0 1-11.2 11.2C111.8 147 107.3 147 98.4 147H37.6c-8.9 0-13.4 0-17-1.4a20 20 0 0 1-11.2-11.2C8 130.8 8 126.3 8 117.4z"/>
                <path fill="#0ebc5f" d="M24 32h160v128H24z" rx="20"/>
                <path stroke="#fff" stroke-linecap="round" stroke-width="12" d="M80 121h84m-20 19V76"/>
              </svg>
            </div>

            <div class="text-left overflow-hidden">
              <h4 class="text-sm font-black text-slate-900 leading-tight truncate">Google Sheets</h4>
              <p class="text-xs font-semibold text-[#009954] leading-tight truncate mt-0.5">Saves & logs copy</p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<!-- Logo Carousel Styles & Script -->
<style>
  .agent-logo-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    opacity: 0;
    transform: scale(0.8) translateY(6px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .agent-logo-item.active-logo {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  .agent-logo-item :global(svg) {
    width: 100% !important;
    height: 100% !important;
    max-width: 36px !important;
    max-height: 36px !important;
    object-fit: contain;
  }
</style>

<script is:inline>
  (() => {
    const logoItems = document.querySelectorAll('.agent-logo-item');
    const modelLabel = document.getElementById('activeModelLabel');
    if (!logoItems || logoItems.length <= 1) return;

    let currentIndex = 0;
    setInterval(() => {
      logoItems[currentIndex].classList.remove('active-logo');
      currentIndex = (currentIndex + 1) % logoItems.length;
      const nextLogo = logoItems[currentIndex];
      nextLogo.classList.add('active-logo');
      
      if (modelLabel && nextLogo.dataset.logoName) {
        modelLabel.textContent = nextLogo.dataset.logoName;
      }
    }, 2000);
  })();
</script>
