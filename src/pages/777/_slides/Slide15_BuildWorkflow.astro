---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="15">
  <div class="m3-glow-green"></div>

  <SlideHeader category="Écosystème & Défi" topic="Matrice des Outils & Résolution de Problème" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-2.5">
      <div>
        <span class="text-xs font-bold text-[#8AB4F8] tracking-wider uppercase bg-[#8AB4F8]/10 px-2.5 py-1 rounded-md border border-[#8AB4F8]/30">
          Scénario Réel 7.77
        </span>
        <h2 class="title-h1 text-white mt-1">
          « Organiser un projet pour 30 personnes en 7 jours. »
        </h2>
      </div>
      <button type="button" id="eval-workflow-btn" class="btn-m3 btn-m3-blue text-xs px-3.5 py-2 cursor-pointer">
        <span>⚡ ÉVALUER MON WORKFLOW</span>
      </button>
    </div>

    <!-- 4 Step Interactive Selector in Dark M3 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5 my-2.5" id="challenge-options-grid">
      <div class="card-m3 bg-surface-container p-2.5 border-white/10">
        <span class="text-[9px] font-bold text-[#8AB4F8] uppercase">1. Inscriptions</span>
        <div class="mt-1.5 space-y-1">
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-inscriptions" value="good" checked class="accent-[#8AB4F8]" />
            <span class="font-medium text-white text-[11px]">Forms ➔ Sheets</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-inscriptions" value="bad" class="accent-[#8AB4F8]" />
            <span class="text-white/60 text-[11px]">Messages WhatsApp</span>
          </label>
        </div>
      </div>

      <div class="card-m3 bg-surface-container p-2.5 border-white/10">
        <span class="text-[9px] font-bold text-[#81C784] uppercase">2. Fichiers & Stockage</span>
        <div class="mt-1.5 space-y-1">
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-files" value="good" checked class="accent-[#81C784]" />
            <span class="font-medium text-white text-[11px]">Drive Partagé (01_)</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-files" value="bad" class="accent-[#81C784]" />
            <span class="text-white/60 text-[11px]">Clé USB & Téléchargements</span>
          </label>
        </div>
      </div>

      <div class="card-m3 bg-surface-container p-2.5 border-white/10">
        <span class="text-[9px] font-bold text-purple-300 uppercase">3. Rédaction & Notes</span>
        <div class="mt-1.5 space-y-1">
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-docs" value="good" checked class="accent-purple-400" />
            <span class="font-medium text-white text-[11px]">Docs en direct + @</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-docs" value="bad" class="accent-purple-400" />
            <span class="text-white/60 text-[11px]">Word par email</span>
          </label>
        </div>
      </div>

      <div class="card-m3 bg-surface-container p-2.5 border-white/10">
        <span class="text-[9px] font-bold text-[#FDD663] uppercase">4. Convocations</span>
        <div class="mt-1.5 space-y-1">
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-auto" value="good" checked class="accent-[#FDD663]" />
            <span class="font-medium text-white text-[11px]">Apps Script auto</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs p-1.5 rounded-lg border border-white/10 hover:bg-surface-container-high cursor-pointer">
            <input type="radio" name="ch-auto" value="bad" class="accent-[#FDD663]" />
            <span class="text-white/60 text-[11px]">30 emails à la main</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Live Diagnosis Result Panel -->
    <div id="challenge-eval-result" class="p-3 rounded-xl bg-surface-container border-2 border-[#81C784] flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-full bg-[#81C784]/20 text-[#81C784] flex items-center justify-center font-bold text-xs" id="eval-icon">
          ✓
        </div>
        <div>
          <h4 class="font-bold text-xs text-white" id="eval-title">Score de Fluidité : 100% — Système Optimal !</h4>
          <p class="text-[10px] text-white/70" id="eval-desc">
            Votre équipe économisera au moins 14 heures de travail répétitif et évitera toute confusion.
          </p>
        </div>
      </div>
      <span class="text-[10px] font-mono font-bold text-[#81C784] bg-[#81C784]/15 px-2.5 py-1 rounded-lg border border-[#81C784]/30" id="eval-badge">
        ZÉRO FRICTION
      </span>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>L'organisation rigoureuse transforme n'importe quel défi en succès</span>
    <button type="button" class="btn-m3 btn-m3-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>MESSAGE DE CLÔTURE →</span>
    </button>
  </div>
</section>

<script>
  const evalBtn = document.getElementById('eval-workflow-btn');
  const resultBox = document.getElementById('challenge-eval-result');
  const evalTitle = document.getElementById('eval-title');
  const evalDesc = document.getElementById('eval-desc');
  const evalBadge = document.getElementById('eval-badge');
  const evalIcon = document.getElementById('eval-icon');

  evalBtn?.addEventListener('click', () => {
    const radios = document.querySelectorAll('#challenge-options-grid input[type="radio"]:checked');
    let badCount = 0;
    radios.forEach((r: any) => {
      if (r.value === 'bad') badCount++;
    });

    if (badCount === 0) {
      if (resultBox) resultBox.className = 'p-3 rounded-xl bg-surface-container border-2 border-[#81C784] flex items-center justify-between';
      if (evalIcon) { evalIcon.textContent = '✓'; evalIcon.className = 'w-7 h-7 rounded-full bg-[#81C784]/20 text-[#81C784] flex items-center justify-center font-bold text-xs'; }
      if (evalTitle) evalTitle.textContent = 'Score de Fluidité : 100% — Système Parfait !';
      if (evalDesc) evalDesc.textContent = 'Votre équipe économisera au moins 14 heures de travail répétitif et évitera toute confusion.';
      if (evalBadge) { evalBadge.textContent = 'ZÉRO FRICTION'; evalBadge.className = 'text-[10px] font-mono font-bold text-[#81C784] bg-[#81C784]/15 px-2.5 py-1 rounded border border-[#81C784]/30'; }
    } else {
      const score = Math.round(((4 - badCount) / 4) * 100);
      if (resultBox) resultBox.className = 'p-3 rounded-xl bg-surface-container border-2 border-[#F28B82] flex items-center justify-between';
      if (evalIcon) { evalIcon.textContent = '⚠️'; evalIcon.className = 'w-7 h-7 rounded-full bg-[#F28B82]/20 text-[#F28B82] flex items-center justify-center font-bold text-xs'; }
      if (evalTitle) evalTitle.textContent = `Score de Fluidité : ${score}% — Risque de Goulots !`;
      if (evalDesc) evalDesc.textContent = `Vous avez ${badCount} point(s) de friction manuel(s) qui risquent de créer des retards.`;
      if (evalBadge) { evalBadge.textContent = 'RISQUE DE RETARD'; evalBadge.className = 'text-[10px] font-mono font-bold text-[#F28B82] bg-[#F28B82]/15 px-2.5 py-1 rounded border border-[#F28B82]/30'; }
    }
  });
</script>
