---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="5">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="Le Constat" topic="Le Paradoxe des Outils" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="mb-3">
      <span class="text-xs font-bold text-[#F28B82] tracking-wider uppercase bg-[#F28B82]/10 px-2.5 py-1 rounded-md border border-[#F28B82]/30">
        Paradoxe Moderne
      </span>
      <h2 class="title-h1 text-white mt-2">
        « Nous sommes entourés d'outils numériques. »
      </h2>
      <p class="text-xs text-white/60 mt-1">
        Cliquez sur un outil pour inspecter le piège classique constaté au quotidien :
      </p>
    </div>

    <!-- Interactive Tool Cloud -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 my-3" id="tool-grid">
      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Passer 4 heures à fabriquer le template Notion parfait sans jamais rédiger le contenu.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-surface-container-high flex items-center justify-center text-xs">📝</span>
          Notion
        </div>
        <p class="text-[10px] text-white/50 mt-1">Notes & Wikis</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="600 messages pour fixer une réunion de 10 min. Les documents clés s'y perdent à jamais.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-[#81C784]/20 text-[#81C784] flex items-center justify-center text-xs">💬</span>
          WhatsApp
        </div>
        <p class="text-[10px] text-white/50 mt-1">Chat Instantané</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Des dizaines de « Dossier sans titre » et des fichiers orphelins introuvables lors des urgences.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-[#8AB4F8]/20 text-[#8AB4F8] flex items-center justify-center text-xs">📁</span>
          Google Drive
        </div>
        <p class="text-[10px] text-white/50 mt-1">Stockage Cloud</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Copier-coller 15 prompts différents sans méthode structurée pour intégrer les réponses.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-purple-500/20 text-purple-300 flex items-center justify-center text-xs">🤖</span>
          Gemini / GPT
        </div>
        <p class="text-[10px] text-white/50 mt-1">IA Générative</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Recevoir 4 feuilles de calcul par email avec des totaux contradictoires.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-[#81C784]/20 text-[#81C784] flex items-center justify-center text-xs">📊</span>
          Google Sheets
        </div>
        <p class="text-[10px] text-white/50 mt-1">Tableaux & Données</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Envoyer des pièces jointes en boucle avec l'objet : « Re: Re: Modification finale ».">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-[#F28B82]/20 text-[#F28B82] flex items-center justify-center text-xs">✉️</span>
          Gmail
        </div>
        <p class="text-[10px] text-white/50 mt-1">Messagerie Pro</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Des tableaux Kanban abandonnés au bout de deux semaines par manque de rigueur.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-sky-500/20 text-sky-300 flex items-center justify-center text-xs">📋</span>
          Trello
        </div>
        <p class="text-[10px] text-white/50 mt-1">Gestion de Tâches</p>
      </button>

      <button type="button" class="tool-chip card-m3 bg-surface-container hover:border-[#8AB4F8] text-left p-3 cursor-pointer transition-all" data-impact="Un agenda vide où tout le travail s'effectue dans l'urgence à la dernière minute.">
        <div class="flex items-center gap-2 font-bold text-white text-xs">
          <span class="w-6 h-6 rounded bg-[#8AB4F8]/20 text-[#8AB4F8] flex items-center justify-center text-xs">📅</span>
          Calendar
        </div>
        <p class="text-[10px] text-white/50 mt-1">Planification</p>
      </button>
    </div>

    <!-- Dynamic Impact Box -->
    <div id="tool-impact-box" class="p-3.5 rounded-xl bg-surface-container border border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="text-[#F28B82] font-bold text-xs uppercase px-2 py-0.5 rounded bg-[#F28B82]/20">Constat :</span>
        <span id="impact-text" class="text-xs font-semibold text-white/90">
          Cliquez sur un outil ci-dessus pour inspecter le piège classique.
        </span>
      </div>
      <div class="text-xs font-bold text-[#81C784]">
        Plus d'outils ≠ Plus d'efficacité
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span class="font-bold text-white">Mais sommes-nous réellement productifs ?</span>
    <button type="button" class="btn-m3 btn-m3-red text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>LE CHAOS NUMÉRIQUE →</span>
    </button>
  </div>
</section>

<script>
  const chips = document.querySelectorAll('.tool-chip');
  const impactText = document.getElementById('impact-text');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('border-[#8AB4F8]', 'bg-surface-container-high'));
      chip.classList.add('border-[#8AB4F8]', 'bg-surface-container-high');
      const impact = chip.getAttribute('data-impact');
      if (impactText && impact) {
        impactText.textContent = impact;
      }
    });
  });
</script>
