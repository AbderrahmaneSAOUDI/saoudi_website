---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 5 PANE (ARE YOU ACTUALLY PRODUCTIVE?) ================= -->
<section 
  id="slide-5-content" 
  data-choice="none"
  class={`slide-pane slide-pane-5 w-full flex flex-col justify-between my-auto py-2 sm:py-3 h-full ${className}`}
>
  <!-- 1. Top Section: Clean Headline (No pill above) -->
  <div class="flex flex-col items-center text-center space-y-1 sm:space-y-2 mt-2 sm:mt-4">
    <h2 class="title-highlight font-black text-4xl sm:text-5xl md:text-6xl lg:text-[3.9rem] xl:text-[4.4rem] tracking-tight leading-[1.05]">
      Are you actually productive?
    </h2>
  </div>

  <!-- 2. Middle Section: Two Action Buttons (Strictly Yes and No, No Option A/B) -->
  <div class="flex items-center justify-center gap-5 sm:gap-8 md:gap-10 my-3 sm:my-5">
    <!-- YES Button -->
    <button
      id="pollBtnYes"
      type="button"
      class="choice-btn choice-btn-yes group relative px-8 sm:px-12 md:px-14 py-3.5 sm:py-5 rounded-2xl sm:rounded-3xl bg-white border-2 border-emerald-600/40 hover:border-emerald-600 flex items-center gap-3.5 sm:gap-4.5 transition-all duration-300 cursor-pointer select-none"
    >
      <span class="choice-icon-box w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-[#1E824C] text-white flex items-center justify-center text-xl sm:text-2xl font-black shrink-0 transition-transform duration-300 group-hover:scale-110">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </span>
      <span class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 group-hover:text-[#1E824C] transition-colors tracking-tight">
        Yes
      </span>
    </button>

    <!-- NO Button -->
    <button
      id="pollBtnNo"
      type="button"
      class="choice-btn choice-btn-no group relative px-8 sm:px-12 md:px-14 py-3.5 sm:py-5 rounded-2xl sm:rounded-3xl bg-white border-2 border-rose-600/40 hover:border-rose-600 flex items-center gap-3.5 sm:gap-4.5 transition-all duration-300 cursor-pointer select-none"
    >
      <span class="choice-icon-box w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-[#EA4335] text-white flex items-center justify-center text-xl sm:text-2xl font-black shrink-0 transition-transform duration-300 group-hover:scale-110">
        <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </span>
      <span class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 group-hover:text-[#EA4335] transition-colors tracking-tight">
        No
      </span>
    </button>
  </div>

  <!-- 3. Bottom Task Container: Completely empty before clicking, animated Minimal Community Task after clicking -->
  <div class="task-reveal-container relative w-full min-h-[170px] sm:min-h-[200px] flex items-center justify-center">
    
    <!-- State 1: When user clicks [NO] -> Minimal Community Task -->
    <div class="task-card task-card-no active-task-card-no w-full max-w-3xl p-6 sm:p-8 rounded-3xl bg-rose-50/95 border-2 border-rose-600/50 flex flex-col items-center text-center space-y-3.5 relative overflow-hidden">
      <!-- Sweeping Laser Beam Across Card -->
      <div class="laser-scanner-beam-task absolute inset-y-0 w-32 bg-gradient-to-r from-transparent via-white/80 to-transparent pointer-events-none"></div>

      <!-- Minimal Title: Community Task -->
      <div class="community-task-pill inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border-2 border-rose-600/40 text-xs sm:text-sm font-black text-[#EA4335] uppercase tracking-wider relative z-10">
        <span class="w-2.5 h-2.5 rounded-full bg-[#EA4335] animate-ping"></span>
        <span>Community Task</span>
      </div>

      <!-- Animated Question -->
      <h3 class="anim-question font-mono text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-black text-slate-900 tracking-tight leading-snug max-w-2xl relative z-10">
        What is the one task you waste the most time on?
      </h3>
    </div>

    <!-- State 2: When user clicks [YES] -> Minimal Community Task -->
    <div class="task-card task-card-yes active-task-card-yes w-full max-w-3xl p-6 sm:p-8 rounded-3xl bg-emerald-50/95 border-2 border-emerald-600/50 flex flex-col items-center text-center space-y-3.5 relative overflow-hidden">
      <!-- Sweeping Laser Beam Across Card -->
      <div class="laser-scanner-beam-task absolute inset-y-0 w-32 bg-gradient-to-r from-transparent via-white/80 to-transparent pointer-events-none"></div>

      <!-- Minimal Title: Community Task -->
      <div class="community-task-pill inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border-2 border-emerald-600/40 text-xs sm:text-sm font-black text-[#006233] uppercase tracking-wider relative z-10">
        <span class="w-2.5 h-2.5 rounded-full bg-[#1E824C] animate-ping"></span>
        <span>Community Task</span>
      </div>

      <!-- Animated Question -->
      <h3 class="anim-question font-mono text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-black text-slate-900 tracking-tight leading-snug max-w-2xl relative z-10">
        How do you speedup your tasks?
      </h3>
    </div>

  </div>
</section>

<!-- Self-Contained Interactive Poll Controller Script -->
<script is:inline>
  (() => {
    const slide = document.getElementById('slide-5-content');
    const btnYes = document.getElementById('pollBtnYes');
    const btnNo = document.getElementById('pollBtnNo');

    if (!slide || !btnYes || !btnNo) return;

    btnYes.addEventListener('click', (e) => {
      e.stopPropagation();
      slide.setAttribute('data-choice', 'yes');
    });

    btnNo.addEventListener('click', (e) => {
      e.stopPropagation();
      slide.setAttribute('data-choice', 'no');
    });

    // Keyboard Hotkeys: [Y] for Yes, [N] for No when on Slide 5
    window.addEventListener('keydown', (e) => {
      const deck = document.getElementById('presentationDeck');
      if (deck && deck.getAttribute('data-current-slide') === '5') {
        if (e.key === 'y' || e.key === 'Y') {
          slide.setAttribute('data-choice', 'yes');
        } else if (e.key === 'n' || e.key === 'N') {
          slide.setAttribute('data-choice', 'no');
        }
      }
    });
  })();
</script>
