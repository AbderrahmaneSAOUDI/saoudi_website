---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- ================= SLIDE 11 PANE (THANK YOU / OUTRO) ================= -->
<section 
  id="slide-11-content" 
  class={`slide-pane slide-pane-11 w-full flex flex-col justify-between items-center text-center my-auto py-3 sm:py-5 h-full relative overflow-hidden ${className}`}
>

  <!-- Top Pill: Closing Tag -->
  <div class="thankyou-header-anim w-full flex flex-col items-center space-y-1.5 shrink-0 pt-1">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border-2 border-emerald-600/30 text-xs sm:text-sm font-bold text-[#006233] uppercase tracking-wider">
      <span class="w-2 h-2 rounded-full bg-[#006233] animate-ping"></span>
      <span>7.77 Program • Digital Productivity</span>
    </div>
  </div>

  <!-- Central Celebratory Thank You Card -->
  <div class="thankyou-card-anim w-full max-w-3xl mx-auto my-auto p-6 sm:p-8 rounded-3xl bg-white/95 border-2 border-emerald-800/20 relative flex flex-col items-center justify-center text-center space-y-4">
    
    <!-- Sparkle Stars Floating around -->
    <div class="absolute -top-3 -left-3 text-2xl text-emerald-500 animate-bounce pointer-events-none">✦</div>
    <div class="absolute -bottom-3 -right-3 text-2xl text-teal-500 animate-pulse pointer-events-none">✧</div>

    <!-- Big Heart / Clapping Icon Orb -->
    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-emerald-50 border-2 border-emerald-200 flex items-center justify-center text-3xl sm:text-4xl">
      <span>🎉</span>
    </div>

    <!-- Main Thank You Heading -->
    <h2 class="font-black text-3xl sm:text-5xl md:text-6xl lg:text-7xl text-slate-900 tracking-tight leading-none">
      Thank You!
    </h2>

    <!-- Empowering Final Quote -->
    <p class="font-medium text-sm sm:text-xl md:text-2xl text-slate-700 max-w-xl leading-relaxed">
      Productivity is a daily craft. <br class="hidden sm:inline" />
      <span class="font-bold text-[#006233]">Start small, automate routine work,</span> and reclaim your time.
    </p>

    <!-- Speaker Bio Strip -->
    <div class="flex items-center gap-3.5 p-2.5 sm:p-3 px-5 sm:px-6 rounded-2xl bg-slate-50 border border-slate-200 mt-2">
      <img 
        src="/profile.webp" 
        alt="Abderrahmane SAOUDI" 
        width="44" 
        height="44" 
        class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover border-2 border-[#1E824C]" 
      />
      <div class="flex flex-col text-left leading-tight">
        <span class="font-bold text-sm sm:text-base text-slate-900">Abderrahmane SAOUDI</span>
        <span class="text-xs text-slate-600">Tech Lead & Creative Engineer</span>
      </div>
    </div>

    <!-- Action Link to Website & Restart Deck -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a 
        href="https://saoudi.online" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1E824C] hover:bg-[#006233] text-white text-xs sm:text-sm font-bold transition-all duration-300 hover:scale-105 select-none"
      >
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span>www.saoudi.online</span>
      </a>

      <button 
        type="button" 
        id="restartDeckBtn"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-bold border border-slate-300 transition-all duration-300 hover:scale-105 cursor-pointer"
        title="Go back to Slide 1"
      >
        <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Replay Presentation</span>
      </button>
    </div>

  </div>

  <!-- Bottom Mini Tag -->
  <div class="thankyou-footer-anim text-xs font-medium text-slate-600 shrink-0 pt-1">
    Made with passion • Algerian Youth Leadership • 7.77 Program
  </div>

</section>

<script is:inline>
  (() => {
    const restartBtn = document.getElementById('restartDeckBtn');
    if (restartBtn) {
      restartBtn.addEventListener('click', () => {
        if (typeof window.setDeckSlide === 'function') {
          window.setDeckSlide(1);
        } else {
          window.location.hash = '#slide-1';
          window.location.reload();
        }
      });
    }
  })();
</script>

<style>
  .thankyou-header-anim {
    animation: tyEnter 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .thankyou-card-anim {
    animation: tyPop 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }
  .thankyou-footer-anim {
    animation: tyEnter 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  @keyframes tyEnter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tyPop {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(24px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
