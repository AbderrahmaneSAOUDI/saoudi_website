---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="12">
  <div class="light-brand-accent-1"></div>

  <SlideHeader category="Pilier 06" topic="AUTOMATE : Google Apps Script & Déclencheurs" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-3">
      <div>
        <span class="text-xs font-bold text-[#006233] tracking-wider uppercase bg-[#E6F4EA] px-2.5 py-1 rounded border border-[#006233]/20">
          Éliminer la Répétition
        </span>
        <h2 class="title-h1 text-slate-900 mt-1 font-cairo">
          « Si vous le faites plus de 3 fois, automatisez-le. »
        </h2>
      </div>
      <button type="button" id="trigger-auto-btn" class="btn-777 btn-777-green text-xs px-3.5 py-2 cursor-pointer">
        <span>⚡ SIMULER L'AUTOMATISATION</span>
      </button>
    </div>

    <!-- Pipeline Flowchart (Light Mode) -->
    <div class="card-777 p-3.5 border-slate-200 bg-slate-50 mb-3">
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 text-center text-xs" id="auto-pipeline">
        <!-- Node 1 -->
        <div class="auto-node p-2.5 rounded-xl bg-white border border-slate-200 transition-all" id="node-1">
          <div class="text-[9px] font-bold text-slate-400 uppercase">1. Entrée</div>
          <div class="font-bold text-slate-900 text-xs mt-0.5 font-cairo">Google Forms</div>
          <div class="text-[10px] text-slate-500 mt-0.5">Nouvelle réponse</div>
        </div>

        <!-- Node 2 -->
        <div class="auto-node p-2.5 rounded-xl bg-white border border-slate-200 transition-all" id="node-2">
          <div class="text-[9px] font-bold text-slate-400 uppercase">2. Données</div>
          <div class="font-bold text-[#006233] text-xs mt-0.5 font-cairo">Google Sheets</div>
          <div class="text-[10px] text-slate-500 mt-0.5">Ligne insérée</div>
        </div>

        <!-- Node 3 -->
        <div class="auto-node p-2.5 rounded-xl bg-white border border-slate-200 transition-all" id="node-3">
          <div class="text-[9px] font-bold text-slate-400 uppercase">3. Déclencheur</div>
          <div class="font-bold text-amber-700 text-xs mt-0.5 font-cairo">Apps Script</div>
          <div class="text-[10px] text-slate-500 mt-0.5">onFormSubmit()</div>
        </div>

        <!-- Node 4 -->
        <div class="auto-node p-2.5 rounded-xl bg-white border border-slate-200 transition-all" id="node-4">
          <div class="text-[9px] font-bold text-slate-400 uppercase">4. Action 1</div>
          <div class="font-bold text-[#0080C8] text-xs mt-0.5 font-cairo">Gmail API</div>
          <div class="text-[10px] text-slate-500 mt-0.5">Email convocation</div>
        </div>

        <!-- Node 5 -->
        <div class="auto-node p-2.5 rounded-xl bg-white border border-slate-200 transition-all" id="node-5">
          <div class="text-[9px] font-bold text-slate-400 uppercase">5. Action 2</div>
          <div class="font-bold text-[#006233] text-xs mt-0.5 font-cairo">Google Drive</div>
          <div class="text-[10px] text-slate-500 mt-0.5">Dossier créé</div>
        </div>
      </div>

      <!-- Real Code Snippet Preview -->
      <div class="mt-2.5 p-2.5 rounded-lg bg-slate-900 border border-slate-800 font-mono text-[10px] text-slate-200 overflow-x-auto">
        <span class="text-purple-400">function</span> <span class="text-blue-400">onFormSubmit</span>(e) &#123;<br />
        &nbsp;&nbsp;<span class="text-slate-500">// Récupération des données du participant 7.77</span><br />
        &nbsp;&nbsp;<span class="text-purple-400">const</span> candidateEmail = e.namedValues[<span class="text-amber-300">'Email'</span>][0];<br />
        &nbsp;&nbsp;<span class="text-slate-500">// Envoi automatique de la confirmation personnalisée</span><br />
        &nbsp;&nbsp;GmailApp.<span class="text-teal-300">sendEmail</span>(candidateEmail, <span class="text-amber-300">'Confirmation Atelier 7.77'</span>, <span class="text-amber-300">'Bienvenue !'</span>);<br />
        &#125;
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-slate-500 pt-3 border-t border-slate-100 relative z-10">
    <span>Votre temps a trop de valeur pour copier-coller des emails manuellement</span>
    <button type="button" class="btn-777 btn-777-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>AU-DELÀ DE GOOGLE : L'ÉCOSYSTÈME →</span>
    </button>
  </div>
</section>

<script>
  const triggerBtn = document.getElementById('trigger-auto-btn');
  const nodes = [
    document.getElementById('node-1'),
    document.getElementById('node-2'),
    document.getElementById('node-3'),
    document.getElementById('node-4'),
    document.getElementById('node-5')
  ];

  triggerBtn?.addEventListener('click', () => {
    nodes.forEach(n => n?.classList.remove('border-[#006233]', 'bg-[#E6F4EA]', 'border-[#0080C8]', 'bg-[#E8F5FD]'));

    nodes.forEach((node, idx) => {
      setTimeout(() => {
        if (node) {
          node.classList.add('border-[#0080C8]', 'bg-[#E8F5FD]');
          setTimeout(() => {
            node.classList.remove('bg-[#E8F5FD]');
            node.classList.add('bg-[#E6F4EA]', 'border-[#006233]');
          }, 350);
        }
      }, idx * 250);
    });
  });
</script>
