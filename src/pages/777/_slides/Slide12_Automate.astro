---
import SlideHeader from '../_components/SlideHeader.astro';
---

<section class="deck-slide justify-between relative overflow-hidden" data-slide-index="12">
  <div class="m3-glow-blue"></div>

  <SlideHeader category="Pilier 04" topic="COLLABORATE : Du Fichier Isolé à la Source Unique de Vérité" />

  <div class="my-auto max-w-5xl w-full relative z-10">
    <div class="flex items-center justify-between mb-3">
      <div>
        <span class="text-xs font-bold text-[#8AB4F8] tracking-wider uppercase bg-[#8AB4F8]/10 px-2.5 py-1 rounded-md border border-[#8AB4F8]/30">
          Collaboration Temps Réel
        </span>
        <h2 class="title-h1 text-white mt-1">
          « Un seul document, zéro pièce jointe par email. »
        </h2>
      </div>
      <button type="button" id="toggle-collab-mode-btn" class="btn-m3 btn-m3-blue text-xs px-3.5 py-2 cursor-pointer">
        <span id="collab-btn-text">🔄 TRANSFORMER LE WORKFLOW</span>
      </button>
    </div>

    <!-- Transformation State Container -->
    <div class="card-m3 p-4 border-white/10 bg-surface-container min-h-[200px] flex items-center justify-center relative overflow-hidden" id="collab-canvas">
      <!-- State 1: Before (Chaotic Serial Workflow) -->
      <div id="collab-before-view" class="w-full flex flex-col items-center justify-center transition-all duration-300">
        <div class="text-xs font-bold text-[#F28B82] uppercase mb-3 bg-[#F28B82]/10 px-3 py-1 rounded-full border border-[#F28B82]/30">
          ❌ Workflow Sériel Ancien (Goulots d'étranglement)
        </div>
        <div class="flex items-center gap-2 sm:gap-4 max-w-2xl w-full justify-between">
          <div class="text-center p-2.5 rounded-xl bg-surface border border-white/10">
            <div class="w-8 h-8 rounded-full bg-[#8AB4F8]/20 text-[#8AB4F8] flex items-center justify-center font-bold text-xs mx-auto mb-1">A</div>
            <div class="font-bold text-xs text-white">Membre A</div>
            <div class="text-[9px] text-white/40 font-mono mt-1">doc_v1.docx</div>
          </div>
          <div class="text-white/40 font-bold text-xs">➔ ✉️ ➔</div>
          <div class="text-center p-2.5 rounded-xl bg-surface border border-white/10">
            <div class="w-8 h-8 rounded-full bg-purple-500/20 text-purple-300 flex items-center justify-center font-bold text-xs mx-auto mb-1">B</div>
            <div class="font-bold text-xs text-white">Membre B</div>
            <div class="text-[9px] text-white/40 font-mono mt-1">doc_v2_mod.docx</div>
          </div>
          <div class="text-white/40 font-bold text-xs">➔ ✉️ ➔</div>
          <div class="text-center p-2.5 rounded-xl bg-surface border border-white/10">
            <div class="w-8 h-8 rounded-full bg-[#81C784]/20 text-[#81C784] flex items-center justify-center font-bold text-xs mx-auto mb-1">C</div>
            <div class="font-bold text-xs text-white">Membre C</div>
            <div class="text-[9px] text-[#F28B82] font-bold font-mono mt-1">doc_conflit.docx</div>
          </div>
        </div>
        <p class="text-xs text-white/50 mt-3 text-center">
          Délai moyen constaté : 48 heures de latence pour fusionner des avis contradictoires.
        </p>
      </div>

      <!-- State 2: After (Modern Live Google Workspace Hub) -->
      <div id="collab-after-view" class="hidden w-full transition-all duration-300">
        <div class="flex items-center justify-between mb-2.5 pb-2 border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-[#81C784] bg-[#81C784]/15 px-3 py-1 rounded-full border border-[#81C784]/30">
              ✅ Source Unique de Vérité (Temps Réel)
            </span>
          </div>
          <!-- Real-time Active Avatars -->
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] text-white/50 font-medium">3 participants en direct :</span>
            <span class="w-6 h-6 rounded-full bg-[#81C784] text-slate-900 font-bold text-[9px] flex items-center justify-center ring-2 ring-[#81C784]/40">AS</span>
            <span class="w-6 h-6 rounded-full bg-[#8AB4F8] text-slate-900 font-bold text-[9px] flex items-center justify-center ring-2 ring-[#8AB4F8]/40">SB</span>
            <span class="w-6 h-6 rounded-full bg-[#FDD663] text-slate-900 font-bold text-[9px] flex items-center justify-center ring-2 ring-[#FDD663]/40">YM</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5">
          <div class="p-2.5 bg-[#8AB4F8]/10 rounded-xl border border-[#8AB4F8]/20">
            <div class="font-bold text-xs text-[#8AB4F8] mb-1">💬 Commentaires Ciblés (@)</div>
            <p class="text-[11px] text-white/70">
              Assignez directement une tâche à un collègue avec <span class="font-mono text-[#8AB4F8] font-bold">@amina</span> sans quitter le document.
            </p>
          </div>

          <div class="p-2.5 bg-[#81C784]/10 rounded-xl border border-[#81C784]/20">
            <div class="font-bold text-xs text-[#81C784] mb-1">✏️ Mode Suggestions</div>
            <p class="text-[11px] text-white/70">
              Proposez des modifications visibles que l'auteur valide en un seul clic.
            </p>
          </div>

          <div class="p-2.5 bg-purple-500/10 rounded-xl border border-purple-500/20">
            <div class="font-bold text-xs text-purple-300 mb-1">🕒 Historique des Versions</div>
            <p class="text-[11px] text-white/70">
              Restaurez n'importe quel état antérieur à la seconde près. Zéro perte.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between text-xs text-white/50 pt-3 border-t border-white/10 relative z-10">
    <span>La collaboration moderne élimine les réunions de relecture superflues</span>
    <button type="button" class="btn-m3 btn-m3-green text-xs px-4 py-2 cursor-pointer" data-deck-next>
      <span>PILIER 5 : GESTION DU TEMPS →</span>
    </button>
  </div>
</section>

<script>
  const toggleBtn = document.getElementById('toggle-collab-mode-btn');
  const btnText = document.getElementById('collab-btn-text');
  const beforeView = document.getElementById('collab-before-view');
  const afterView = document.getElementById('collab-after-view');

  let isAfter = false;

  toggleBtn?.addEventListener('click', () => {
    isAfter = !isAfter;
    if (isAfter) {
      beforeView?.classList.add('hidden');
      afterView?.classList.remove('hidden');
      if (btnText) btnText.textContent = '⏪ VOIR LE MODE ANCIEN';
      toggleBtn.classList.remove('btn-m3-blue');
      toggleBtn.classList.add('btn-m3-green');
    } else {
      afterView?.classList.add('hidden');
      beforeView?.classList.remove('hidden');
      if (btnText) btnText.textContent = '🔄 TRANSFORMER LE WORKFLOW';
      toggleBtn.classList.remove('btn-m3-green');
      toggleBtn.classList.add('btn-m3-blue');
    }
  });
</script>
