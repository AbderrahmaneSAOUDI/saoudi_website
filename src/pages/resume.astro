---

import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeIsland from '../components/ResumeIsland.astro';

---

<BaseLayout title="Resume" description="Download or view the official software engineer resume of Abderrahmane SAOUDI.">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 max-w-7xl">
		<!-- Page Header -->
		<section class="mb-6 text-center animate-fade-in">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
				My <span class="text-primary">Resume</span>
			</h1>
		</section>
		<ResumeIsland />
	</div>
</BaseLayout>
