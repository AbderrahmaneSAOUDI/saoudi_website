---
/**
 * Card Component
 * 
 * Unified card component that handles rendering both design mockups and professional certifications.
 * Supports both public views and interactive admin workspace grids.
 */
import type { Design, Certificate, Project } from '../types';
import Icon from './Icon.astro';

interface Props {
	item: Design | Certificate | Project;
	type: 'design' | 'certificate' | 'project';
	isAdmin?: boolean;
	isLoading?: boolean;
}

const { item, type, isAdmin = false, isLoading = false } = Astro.props;
const design = !isLoading && type === 'design' ? (item as Design) : undefined;
const certificate = !isLoading && type === 'certificate' ? (item as Certificate) : undefined;
const project = !isLoading && type === 'project' ? (item as Project) : undefined;

// Format date dynamically: ISO string / YYYY-MM-DD / YYYY-MM / YYYY
const formatDate = (dateStr?: string) => {
	if (!dateStr || !dateStr.trim()) return '';
	try {
		const parts = dateStr.trim().split('-');
		if (parts.length === 3) {
			const year = parseInt(parts[0], 10);
			const month = parseInt(parts[1], 10) - 1;
			const day = parseInt(parts[2], 10);
			const date = new Date(year, month, day);
			if (!isNaN(date.getTime())) {
				return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
			}
		} else if (parts.length === 2) {
			const year = parseInt(parts[0], 10);
			const month = parseInt(parts[1], 10) - 1;
			const date = new Date(year, month, 1);
			if (!isNaN(date.getTime())) {
				return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
			}
		} else if (parts.length === 1 && parts[0].length === 4) {
			return parts[0];
		}
		const date = new Date(dateStr);
		if (!isNaN(date.getTime())) {
			return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
		}
	} catch (e) {}
	return dateStr;
};

const formattedDate = formatDate(item?.date);
const certType = certificate?.type;

const typeColors = {
	'Online': 'bg-primary/50 border-primary/20 text-white',
	'In-Person': 'bg-[#34A853]/50 border-[#34A853]/20 text-white',
	'Hybrid': 'bg-[#F9AB00]/50 border-[#F9AB00]/20 text-black',
};
---

{isLoading ? (
	<article class="border border-white/10 rounded-3xl p-4 bg-surface-container flex flex-col justify-between h-full">
		<div>
			<div class="aspect-[16/10] rounded-2xl mb-4 skeleton"></div>
			<div class="skeleton h-6 w-3/4 mb-2"></div>
			<div class="flex gap-1.5 mt-2">
				<div class="skeleton h-5 w-16"></div>
				<div class="skeleton h-5 w-12"></div>
				<div class="skeleton h-5 w-10"></div>
			</div>
		</div>
		<div class="mt-4 pt-3 border-t border-white/5 flex justify-between items-center">
			<div class="skeleton h-4 w-20"></div>
			<div class="skeleton h-4 w-16"></div>
		</div>
	</article>
) : null}

{design ? (
	<article
		class={`group border rounded-3xl p-4 transition-all duration-300 flex flex-col justify-between h-full ${
			isAdmin
				? 'design-card border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer'
				: 'bg-surface-container border-white/10 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-primary/10 hover:ring-2 hover:ring-primary/40'
		}`}
		data-id={isAdmin ? design.id : undefined}
	>
		<div>
			<a
				href={design.imageUrl}
				target="_blank"
				data-lightbox-src={design.imageUrl}
				data-lightbox-title={design.title || design.company}
				data-lightbox-subtitle={design.title ? design.company : undefined}
				class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-0 border border-white/10 flex items-center justify-center cursor-pointer image-zoom-trigger block"
			>
				<div class="absolute inset-0 skeleton"></div>
				<img
					src={design.imageUrl}
					alt={design.title || design.company}
					class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-all duration-300 relative z-10 opacity-0"
					loading="lazy"
					decoding="async"
					onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
					onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
				/>
			</a>
		</div>

		<div class="design-card-footer mt-3.5 flex justify-between items-center text-xs">
			{formattedDate ? (
				<span class="text-white/40 flex items-center gap-1 font-medium whitespace-nowrap shrink-0">
					<Icon name="calendar" size={14} />
					{formattedDate}
				</span>
			) : <span />}
			{design.company && (
				<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary">
					{design.company}
				</span>
			)}
		</div>
	</article>
) : null}

{certificate ? (
	<article
		class={`group border rounded-3xl p-5 transition-all duration-300 flex flex-col justify-between h-full ${
			isAdmin
				? 'certificate-card border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer'
				: 'bg-surface-container border-white/10 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-primary/10 hover:ring-2 hover:ring-primary/40'
		}`}
		data-id={isAdmin ? certificate.id : undefined}
	>
		<div class="space-y-4">
			{certificate.imageUrl ? (
				<div class="relative">
					<a
						href={certificate.imageUrl}
						target="_blank"
						data-lightbox-src={certificate.imageUrl}
						data-lightbox-title={certificate.title}
						data-lightbox-subtitle={certificate.issuer}
						class="relative aspect-[16/10] rounded-2xl overflow-hidden border border-white/10 flex items-center justify-center cursor-pointer image-zoom-trigger block bg-[#1D1B20]"
					>
						<div class="absolute inset-0 skeleton"></div>
						<img
							src={certificate.imageUrl}
							alt={certificate.title}
							class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-all duration-300 relative z-10 opacity-0"
							loading="lazy"
							decoding="async"
							onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
							onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
						/>
					</a>
					{certType && (
						<span class={`absolute top-2.5 right-2.5 z-20 px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase border backdrop-blur-md shadow-sm pointer-events-none select-none ${typeColors[certType as keyof typeof typeColors] || ''}`}>
							{certType}
						</span>
					)}
				</div>
			) : (
				<div class="p-3 w-fit rounded-2xl bg-secondary/10 text-secondary border border-secondary/20 group-hover:scale-110 transition-transform duration-300">
					<Icon name="certifications" size={24} />
				</div>
			)}

			<div>
				<h3 class="font-bold text-white text-lg group-hover:text-primary transition-colors line-clamp-2">
					{certificate.title}
				</h3>
			</div>
		</div>

		<div class="mt-4 pt-3 flex justify-between items-center text-xs border-t border-white/5 text-white/40 font-medium">
			<div class="flex items-center gap-2">
				<span class="flex items-center gap-1">
					<Icon name="calendar" size={14} />
					{formattedDate}
				</span>
				{!certificate.imageUrl && certType && (
					<span class={`px-2 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase border ${typeColors[certType as keyof typeof typeColors] || ''}`}>
						{certType}
					</span>
				)}
				{certificate.credentialUrl && (
					<a
						href={certificate.credentialUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={`transition-all duration-300 cursor-pointer text-white/40 hover:text-primary ${
							isAdmin ? 'stop-propagation' : ''
						}`}
						title="Verify Credential"
					>
						<Icon name="open_in_new" size={14} />
					</a>
				)}
			</div>
			{certificate.issuer && (
				<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary">
					{certificate.issuer}
				</span>
			)}
		</div>
	</article>
) : null}

{project ? (
	<article
		class={`group border rounded-3xl p-4 transition-all duration-300 flex flex-col justify-between h-full ${
			isAdmin
				? 'project-card border-[#2B2930] bg-[#1D1B20] hover:ring-2 hover:ring-primary/40 cursor-pointer'
				: 'bg-surface-container border-white/10 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-primary/10 hover:ring-2 hover:ring-primary/40 cursor-pointer'
		}`}
		data-id={isAdmin ? project.id : undefined}
		data-project-card-id={!isAdmin ? project.id : undefined}
	>
		<div>
			{project.imageUrl ? (
				isAdmin ? (
					<a
						href="#global-lightbox"
						data-lightbox-src={project.imageUrl}
						data-lightbox-title={project.title}
						data-lightbox-subtitle={project.tagline || ''}
						class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-3 border border-white/10 flex items-center justify-center cursor-pointer image-zoom-trigger block bg-[#1D1B20]"
					>
						<div class="absolute inset-0 skeleton"></div>
						<img
							src={project.imageUrl}
							alt={project.title}
							class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-all duration-300 relative z-10 opacity-0"
							loading="lazy"
							decoding="async"
							onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
							onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
						/>
					</a>
				) : (
					<div class="relative aspect-[16/10] rounded-2xl overflow-hidden mb-3 border border-white/10 flex items-center justify-center bg-[#1D1B20]">
						<div class="absolute inset-0 skeleton"></div>
						<img
							src={project.imageUrl}
							alt={project.title}
							class="max-w-full max-h-full object-contain group-hover:scale-[1.03] transition-all duration-300 relative z-10 opacity-0"
							loading="lazy"
							decoding="async"
							onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
							onerror="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
						/>
					</div>
				)
			) : (
				<div class="p-3 w-fit rounded-2xl bg-primary/10 text-primary border border-primary/20 mb-3 group-hover:scale-110 transition-transform duration-300">
					<Icon name="projects" size={24} />
				</div>
			)}

			<h3 class="font-bold text-white text-base group-hover:text-primary transition-colors line-clamp-1">
				{project.title}
			</h3>
		</div>

		<div class="mt-3.5 pt-3 flex justify-between items-center text-xs border-t border-white/5 text-white/40 font-medium">
			{formattedDate ? (
				<span class="flex items-center gap-1 font-medium whitespace-nowrap shrink-0">
					<Icon name="calendar" size={14} />
					{formattedDate}
				</span>
			) : <span />}
			{project.field ? (
				<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary line-clamp-1 max-w-[140px]">
					{project.field}
				</span>
			) : project.technologies && project.technologies.length > 0 ? (
				<span class="company-pill px-2.5 py-0.5 rounded-lg text-[10px] font-bold tracking-wide uppercase bg-primary/10 border border-primary/20 text-primary line-clamp-1 max-w-[140px]">
					{project.technologies.slice(0, 2).join(', ')}
				</span>
			) : null}
		</div>
	</article>
) : null}

<script>
	// Cleanup any skeletons for images that loaded instantly from cache
	const removeSkeletons = () => {
		document.querySelectorAll('.skeleton + img').forEach((img) => {
			if (img instanceof HTMLImageElement && img.complete) {
				img.classList.remove('opacity-0');
				const skeleton = img.previousElementSibling;
				if (skeleton && skeleton.classList.contains('skeleton')) {
					skeleton.remove();
				}
			}
		});
	};

	// Run once when the DOM is ready, and once more when all resources have loaded
	// (handles images that finish loading after DOMContentLoaded but before window.load).
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', removeSkeletons, { once: true });
	} else {
		removeSkeletons();
	}
	// Always attach window.load to catch images loaded after DOMContentLoaded
	window.addEventListener('load', removeSkeletons, { once: true });
</script>
