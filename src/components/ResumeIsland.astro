---
/**
 * ResumeIsland — Server Island for Resume Content
 * 
 * Deferred component fetched asynchronously via server:defer.
 * Fetches the resume preview image URL from Firestore.
 * The parent page shows a skeleton placeholder while this loads.
 */
import { getFirebaseAdminDb } from '../lib/server/firebase-admin';
import { CACHE_TTL_MS, getOrSetCached } from '../lib/server/cache';
import { getPublicMediaUrl } from '../lib/media';

interface Props {}

let resumePreviewUrl = '/resume.webp';

const cacheKeyResume = 'resume_config';

try {
	const config = await getOrSetCached(
		cacheKeyResume,
		async () => {
		const db = getFirebaseAdminDb();
		const configDoc = await db.collection('configuration').doc('static_data').get();
			if (configDoc.exists) {
				const data = configDoc.data();
				if (data?.previewUrl) resumePreviewUrl = data.previewUrl;
			}
			return { resumePreviewUrl };
		},
		CACHE_TTL_MS.PUBLIC_DATA,
	);
	resumePreviewUrl = getPublicMediaUrl(
		config.resumePreviewUrl,
		'configuration',
		'static_data',
		'previewUrl',
	) || '/resume.webp';
} catch (error) {
	console.warn('Failed to fetch resume config in public page:', error);
}
---

<div class="mt-8 space-y-6">
	<div class="border border-white/10 rounded-3xl overflow-hidden p-2 bg-surface-container">
		<img
			src={resumePreviewUrl}
			alt="Resume preview"
			width="1530"
			height="1980"
			fetchpriority="high"
			decoding="async"
			class="w-full rounded-2xl object-cover"
			onerror="if(!this.getAttribute('data-fallback-tried')){this.setAttribute('data-fallback-tried','1');this.setAttribute('src','/resume.webp');}"
		/>
	</div>

	<!-- Download Actions -->
	<div class="flex flex-col items-center gap-3">
		<button
			id="btn-trigger-resume-download"
			type="button"
			class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-slate-950 transition hover:bg-primary/90 hover:scale-105 active:scale-95 cursor-pointer shadow-lg shadow-primary/20">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
				<polyline points="7 10 12 15 17 10" />
				<line x1="12" y1="15" x2="12" y2="3" />
			</svg>
			<span>Download PDF</span>
		</button>
	</div>

	<!-- Countdown Modal Overlay -->
	<div
		id="resume-download-modal"
		role="dialog"
		aria-modal="true"
		aria-hidden="true"
		aria-labelledby="resume-download-title"
		inert
		class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300">
		<div class="bg-[#1E1E1E] border border-white/10 rounded-3xl p-6 max-w-sm w-full text-center space-y-4 shadow-2xl transform scale-95 transition-transform duration-300">
			<div class="w-14 h-14 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center mx-auto text-primary font-bold text-xl">
				<span id="countdown-timer-display">3</span>
			</div>
			
			<div class="space-y-1">
				<h3 id="resume-download-title" class="text-base font-bold text-white">Preparing Download...</h3>
				<p class="text-xs text-[#E6E1E5]">Your PDF download will begin automatically.</p>
			</div>

			<div class="pt-2 flex flex-col gap-2">
				<button
					id="btn-skip-countdown"
					type="button"
					class="w-full py-2.5 rounded-xl bg-primary text-slate-950 text-xs font-bold hover:bg-primary/90 transition cursor-pointer">
					Download Now
				</button>
				<button
					id="btn-cancel-countdown"
					type="button"
					class="w-full py-2 rounded-xl bg-white/5 text-[#E6E1E5]/70 text-xs hover:text-white hover:bg-white/10 transition cursor-pointer">
					Cancel
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	if (!(window as any).__resumeDownloadEventsBound) {
		(window as any).__resumeDownloadEventsBound = true;
		let timerInterval: any = null;
		let previouslyFocused: HTMLElement | null = null;

		function triggerDirectDownload() {
			const link = document.createElement('a');
			link.href = '/api/download_resume';
			link.download = 'Abderrahmane_SAOUDI_Resume.pdf';
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		}

		function openModal() {
			const modal = document.getElementById('resume-download-modal');
			if (!modal) return;
			const modalCard = modal.firstElementChild;
			previouslyFocused = document.activeElement as HTMLElement | null;
			modal.removeAttribute('inert');
			modal.setAttribute('aria-hidden', 'false');
			modal.classList.remove('opacity-0', 'pointer-events-none');
			modal.classList.add('opacity-100', 'pointer-events-auto');
			if (modalCard) modalCard.classList.remove('scale-95');
			(document.getElementById('btn-skip-countdown') as HTMLButtonElement | null)?.focus();
		}

		function closeModal(restoreFocus = true) {
			const modal = document.getElementById('resume-download-modal');
			if (!modal) return;
			const modalCard = modal.firstElementChild;
			if (timerInterval) clearInterval(timerInterval);
			timerInterval = null;
			modal.classList.remove('opacity-100', 'pointer-events-auto');
			modal.classList.add('opacity-0', 'pointer-events-none');
			modal.setAttribute('aria-hidden', 'true');
			modal.setAttribute('inert', '');
			if (modalCard) modalCard.classList.add('scale-95');
			if (restoreFocus) previouslyFocused?.focus();
		}

		function startCountdown() {
			openModal();
			let timeLeft = 3;
			const countdownDisplay = document.getElementById('countdown-timer-display');
			if (countdownDisplay) countdownDisplay.textContent = '3';

			timerInterval = setInterval(() => {
				timeLeft -= 1;
				if (countdownDisplay) countdownDisplay.textContent = String(timeLeft);

				if (timeLeft <= 0) {
					clearInterval(timerInterval);
					closeModal(false);
					triggerDirectDownload();
				}
			}, 1000);
		}

		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			if (target?.closest('#btn-trigger-resume-download')) {
				startCountdown();
				return;
			}
			if (target?.closest('#btn-skip-countdown')) {
				closeModal(false);
				triggerDirectDownload();
				return;
			}
			if (target?.closest('#btn-cancel-countdown')) closeModal();
		});

		document.addEventListener('keydown', (event) => {
			const modal = document.getElementById('resume-download-modal');
			if (modal?.getAttribute('aria-hidden') !== 'false') return;
			if (event.key === 'Escape') {
				event.preventDefault();
				closeModal();
				return;
			}
			if (event.key !== 'Tab') return;
			const focusable = [
				document.getElementById('btn-skip-countdown'),
				document.getElementById('btn-cancel-countdown'),
			].filter((element): element is HTMLElement => element instanceof HTMLElement);
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});
	}
</script>
