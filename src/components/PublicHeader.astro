---
/**
 * PublicHeader Component
 * 
 * Renders the primary navigation header for all public routes.
 * Fetches the active resume download URL server-side from Firestore.
 * Produces ZERO client-side JavaScript as per strict architecture requirements.
 */
import NavItem from '../components/NavItem.astro';
import ActionButton from '../components/ActionButton.astro';
import Icon from './Icon.astro';

// Download endpoint that increments download count and redirects to PDF
let resumeUrl = '/api/download_resume';

// Read current request pathname to determine active route highlighting
const { pathname } = Astro.url;

// Define navigation route map
const navLinks = [
	{ href: '/', label: 'Home', iconName: 'home' },
	{ href: '/experience', label: 'Experience', iconName: 'experience' },
	{ href: '/projects', label: 'Projects', iconName: 'projects' },
	{ href: '/designs', label: 'Designs', iconName: 'design' },
	{ href: '/certifications', label: 'Certifications', iconName: 'certifications' },
	{ href: '/resume', label: 'Resume', iconName: 'download' },
];
---

<header class="top-0 z-50 sticky">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
		<div class="flex justify-between items-center h-16">
			{/* Brand Logo Pill Link */}
			<a href="/" class="header-logo group h-11 inline-flex items-center bg-surface/60 hover:bg-surface-container-high backdrop-blur-xl px-5 border border-white/10 hover:border-white/30 rounded-full origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.06] active:scale-95">
				<span class="font-bold text-primary text-lg transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105">saoudi.online</span>
			</a>

			{/* Main Route Navigation Bar */}
			<nav class="flex items-center">
				<div class="flex items-center gap-1.5 sm:gap-2 h-11 bg-surface/60 backdrop-blur-xl px-1.5 border border-white/10 hover:border-white/20 rounded-full shadow-[0_8px_24px_rgba(0,0,0,0.3),inset_0_1px_1px_rgba(255,255,255,0.15)] transition-all duration-300">
					{navLinks.map((link) => {
						const isActive = pathname === link.href;
						return (
							<NavItem href={link.href} isActive={isActive} label={link.label}>
								<span class="nav-icon transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110">
									<Icon name={link.iconName} filled={isActive} size={18} />
								</span>
								<span class="nav-label">{link.label}</span>
							</NavItem>
						);
					})}
				</div>
			</nav>

			{/* My Services Action Pill */}
			<ActionButton href="/services" type="header" ariaLabel="My Services">
				<span class="transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:-translate-y-0.5">
					<Icon name="business" size={16} />
				</span>
				<span class="download-text">My Services</span>
			</ActionButton>
		</div>
	</div>
</header>