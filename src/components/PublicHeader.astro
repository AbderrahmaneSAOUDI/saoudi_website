---
/**
 * PublicHeader Component
 * 
 * Renders the primary navigation header for all public routes.
 * Produces ZERO client-side JavaScript as per strict architecture requirements.
 */
import NavItem from '../components/NavItem.astro';
import ActionButton from '../components/ActionButton.astro';
import Icon from './Icon.astro';

// Read current request pathname to determine active route highlighting
const rawPathname = Astro.url.pathname.toLowerCase();
const pathname = rawPathname === '/' ? '/' : rawPathname.replace(/\/+$/, '');

// Define navigation route map
const navLinks = [
	{ href: '/', label: 'Home', iconName: 'home' },
	{ href: '/experience', label: 'Experience', iconName: 'experience' },
	{ href: '/projects', label: 'Projects', iconName: 'projects' },
	{ href: '/designs', label: 'Designs', iconName: 'design' },
	{ href: '/certifications', label: 'Certifications', iconName: 'certifications' },
	{ href: '/resume', label: 'Resume', iconName: 'download' },
];
const servicesIsActive = pathname === '/services';
---

<header class="top-0 z-50 sticky">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
		<div class="flex justify-between items-center gap-2 h-16">
			{/* Brand Logo Pill Link */}
			<a href="/" class="header-logo group h-11 inline-flex items-center bg-surface/60 hover:bg-surface-container-high backdrop-blur-xl px-5 border border-white/10 hover:border-white/30 rounded-full origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.06] active:scale-95">
				<span class="font-bold text-primary text-lg transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105">saoudi.online</span>
			</a>

			{/* Main Route Navigation Bar */}
			<nav class="flex min-w-0 flex-1 items-center justify-center" aria-label="Primary navigation">
				<div class="flex w-max max-w-full items-center gap-1.5 sm:gap-2 h-11 bg-surface/60 backdrop-blur-xl border border-white/10 hover:border-white/20 rounded-full transition-all duration-300 overflow-visible">
					{navLinks.map((link) => {
						const isActive = pathname === link.href;
						return (
							<NavItem href={link.href} isActive={isActive} label={link.label}>
								<span class="nav-icon transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110">
									<Icon name={link.iconName} filled={isActive} size={18} />
								</span>
								<span class="nav-label">{link.label}</span>
							</NavItem>
						);
					})}
				</div>
			</nav>

			{/* My Services Action Pill */}
			<ActionButton href="/services" type="header" ariaLabel="Explore Services" isActive={servicesIsActive} extraClass="service-action-3d shrink-0">
				<span class={`service-action-3d__icon relative z-10 inline-flex h-7 w-7 items-center justify-center rounded-full border transition-all duration-300 group-hover:rotate-12 group-hover:scale-110 ${servicesIsActive ? 'border-slate-950/15 bg-slate-950/10' : 'border-primary/30 bg-primary/10 group-hover:border-slate-950/15 group-hover:bg-slate-950/10'}`}>
					<Icon name="service" size={16} class={`transition-all duration-200 ${servicesIsActive ? 'opacity-0 scale-75' : 'opacity-100 scale-100 group-hover:opacity-0 group-hover:scale-75'}`} />
					<Icon name="service" filled size={16} class={`absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 transition-all duration-200 ${servicesIsActive ? 'opacity-100 scale-100' : 'opacity-0 scale-75 group-hover:opacity-100 group-hover:scale-100'}`} />
				</span>
				<span class="service-action-3d__label download-text relative z-10 transition-[letter-spacing] duration-300 group-hover:tracking-wide">Services</span>
			</ActionButton>
		</div>
	</div>
</header>

<style>
	:global(.service-action-3d) {
		transform: perspective(560px) rotateX(0deg) rotateY(0deg) translateY(0);
		transform-style: preserve-3d;
		will-change: transform;
	}

	:global(.service-action-3d:hover) {
		transform: perspective(560px) rotateX(-9deg) rotateY(4deg) translateY(-2px) scale(1.04);
	}

	:global(.service-action-3d:active) {
		transform: perspective(560px) rotateX(3deg) rotateY(-2deg) translateY(1px) scale(0.97);
	}

	.service-action-3d__icon {
		transform: translateZ(16px);
	}

	.service-action-3d__label {
		transform: translateZ(10px);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.service-action-3d),
		:global(.service-action-3d:hover),
		:global(.service-action-3d:active),
		.service-action-3d__icon,
		.service-action-3d__label {
			transform: none;
		}
	}
</style>
