---
interface Props {
	href: string;
	type?: 'primary' | 'surface' | 'header';
	download?: boolean;
	extraClass?: string;
	ariaLabel?: string;
	isActive?: boolean;
}

const { href, type = 'primary', download = false, extraClass = '', ariaLabel, isActive = false } = Astro.props;

const base = 'group inline-flex items-center gap-2 rounded-full font-medium origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-95';
const variants = {
	primary: 'bg-primary text-slate-950 font-bold hover:bg-primary/90 hover:scale-[1.03] px-6 py-3',
	surface: 'bg-surface-container text-white hover:bg-surface-container-high hover:scale-[1.03] px-6 py-3 border border-white/10 hover:border-white/20',
	header: `relative isolate h-11 min-h-[44px] min-w-[44px] flex items-center justify-center gap-2.5 px-2 min-[1000px]:pl-2 min-[1000px]:pr-4 border text-sm font-bold backdrop-blur-xl hover:-translate-y-0.5 hover:scale-[1.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface ${
		isActive
			? 'bg-primary text-slate-950 border-primary'
			: 'bg-primary/15 text-primary border-primary/40 hover:bg-primary hover:text-slate-950 hover:border-primary'
	}`,
};
const classes = `${base} ${variants[type] ?? variants.primary} ${extraClass}`.trim();
---

<a href={href} class={classes} download={download} aria-label={ariaLabel} aria-current={isActive ? 'page' : undefined}>
	<slot />
</a>
