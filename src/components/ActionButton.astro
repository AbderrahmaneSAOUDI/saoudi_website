---
interface Props {
	href: string;
	type?: 'primary' | 'surface' | 'header';
	download?: boolean;
	extraClass?: string;
	ariaLabel?: string;
}

const { href, type = 'primary', download = false, extraClass = '', ariaLabel } = Astro.props;

const base = 'group inline-flex items-center gap-2 rounded-full font-medium text-white origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-95';
const variants = {
	primary: 'bg-primary hover:bg-primary/90 hover:scale-[1.03] hover:shadow-[0_8px_20px_rgba(66,133,244,0.3),inset_0_1px_1px_rgba(255,255,255,0.2)] px-6 py-3',
	surface: 'bg-surface-container hover:bg-surface-container-high hover:scale-[1.03] px-6 py-3 border border-white/10 hover:border-white/20 hover:shadow-[0_8px_20px_rgba(0,0,0,0.3),inset_0_1px_1px_rgba(255,255,255,0.15)]',
	header: 'h-11 flex items-center gap-2 bg-primary/80 hover:bg-primary backdrop-blur-xl px-5 border border-primary/40 hover:border-white/30 text-sm hover:scale-[1.06] hover:shadow-[0_8px_20px_rgba(66,133,244,0.35),inset_0_1px_1px_rgba(255,255,255,0.3)]',
};
const classes = `${base} ${variants[type] ?? variants.primary} ${extraClass}`.trim();
---

<a href={href} class={classes} download={download} aria-label={ariaLabel}>
	<slot />
</a>
