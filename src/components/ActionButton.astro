---
interface Props {
	href: string;
	type?: 'primary' | 'surface' | 'header';
	download?: boolean;
	extraClass?: string;
	ariaLabel?: string;
}

const { href, type = 'primary', download = false, extraClass = '', ariaLabel } = Astro.props;

const base = 'group inline-flex items-center gap-2 rounded-full font-medium origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-95';
const variants = {
	primary: 'bg-primary text-slate-950 font-bold hover:bg-primary/90 hover:scale-[1.03] px-6 py-3',
	surface: 'bg-surface-container text-white hover:bg-surface-container-high hover:scale-[1.03] px-6 py-3 border border-white/10 hover:border-white/20',
	header: 'h-11 min-h-[44px] min-w-[44px] flex items-center justify-center gap-2 bg-primary/20 text-primary hover:bg-primary hover:text-slate-950 font-bold backdrop-blur-xl px-3 min-[1000px]:px-5 border border-primary/40 hover:border-white/30 text-sm hover:scale-[1.06]',
};
const classes = `${base} ${variants[type] ?? variants.primary} ${extraClass}`.trim();
---

<a href={href} class={classes} download={download} aria-label={ariaLabel}>
	<slot />
</a>
