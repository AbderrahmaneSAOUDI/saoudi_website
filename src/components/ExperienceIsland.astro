---
import type { Experience } from '../types';
import { getFirebaseAdminDb } from '../lib/server/firebase-admin';
import { CACHE_TTL_MS, getOrSetCached } from '../lib/server/cache';
import { getPublicMediaUrl } from '../lib/media';
import Icon from './Icon.astro';

let experiences: Experience[] = [];
let errorMsg = '';

try {
	experiences = await getOrSetCached(
		'experience_list',
		async () => {
			const db = getFirebaseAdminDb();
			const snapshot = await db.collection('experience').get();
			const list = snapshot.docs.map((doc) => {
				const data = doc.data();
				return {
					id: doc.id,
					order: Number.isFinite(Number(data.order)) ? Number(data.order) : 0,
					role: typeof data.role === 'string' ? data.role : '',
					company: typeof data.company === 'string' ? data.company : '',
					logoUrl: getPublicMediaUrl(data.logoUrl, 'experience', doc.id) ?? null,
					employmentType: typeof data.employmentType === 'string' ? data.employmentType : 'Full-time',
					startDate: typeof data.startDate === 'string' ? data.startDate : '',
					endDate: typeof data.endDate === 'string' ? data.endDate : null,
					responsibilities: typeof data.responsibilities === 'string' ? data.responsibilities : '',
				};
			}) as Experience[];

			list.sort((a, b) => {
				if (b.startDate !== a.startDate) return b.startDate.localeCompare(a.startDate);
				return a.order - b.order;
			});

			return list;
		},
		CACHE_TTL_MS.PUBLIC_DATA,
	);
} catch (error) {
	console.warn('Failed to fetch experiences for public page:', error);
	errorMsg = 'Degraded mode: Professional experience data is currently offline.';
}

function formatDate(dateStr: string | null): string {
	if (!dateStr) return 'Present';
	const [year, month] = dateStr.split('-');
	if (!year) return dateStr;
	if (!month) return year;
	const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
	const mIdx = parseInt(month, 10) - 1;
	return `${months[mIdx] || month} ${year}`;
}
const lazyImagePlaceholder = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
---

{errorMsg && (
	<div class="mb-10 p-4 rounded-2xl bg-error/10 border border-error/30 text-error text-sm text-center">
		{errorMsg}
	</div>
)}

<div class="relative max-w-4xl mx-auto py-8 px-2 sm:px-6">
	<div class="space-y-6 sm:space-y-[-1rem] relative">
		<!-- Animated Center Vertical Timeline Spine Line -->
		{experiences.length > 0 && (
			<>
				<!-- Desktop Center Animated Spine Line -->
				<div 
					class="absolute left-1/2 top-6 bottom-32 w-0.5 bg-gradient-to-b from-primary via-primary/50 to-primary -translate-x-1/2 hidden sm:block rounded-full timeline-line-animated z-0"
				>
					<div class="absolute inset-x-0 w-full h-24 bg-gradient-to-b from-transparent via-white to-transparent opacity-80 timeline-pulse-beam"></div>
				</div>

				<!-- Mobile Animated Spine Line -->
				<div 
					class="absolute left-6 top-6 bottom-32 w-0.5 bg-gradient-to-b from-primary via-primary/50 to-primary -translate-x-1/2 sm:hidden rounded-full timeline-line-animated z-0"
				>
					<div class="absolute inset-x-0 w-full h-24 bg-gradient-to-b from-transparent via-white to-transparent opacity-80 timeline-pulse-beam"></div>
				</div>
			</>
		)}

		{experiences.map((exp, index) => {
			const isEven = index % 2 === 0;
			const formattedStart = formatDate(exp.startDate);
			const formattedEnd = formatDate(exp.endDate);
			const isPresent = !exp.endDate;
			const delaySec = (index * 0.18 + 0.15).toFixed(2);
			const dotDelaySec = (index * 0.18 + 0.05).toFixed(2);

			return (
				<div 
					class={`relative flex flex-col sm:flex-row items-center ${isEven ? 'sm:flex-row-reverse' : ''} group`}
				>
					<!-- Animated Timeline Dot Node -->
					<div 
						class="absolute left-6 sm:left-1/2 top-6 -translate-x-1/2 z-20 w-5 h-5 rounded-full bg-surface border-2 border-primary group-hover:scale-125 transition-all duration-300 flex items-center justify-center timeline-dot-entrance"
						style={`animation-delay: ${dotDelaySec}s;`}
					>
						<div class={`w-1.5 h-1.5 rounded-full ${isPresent ? 'bg-secondary animate-pulse' : 'bg-primary'}`}></div>
					</div>

					<!-- Content Card Wrapper -->
					<div 
						class={`w-full sm:w-[calc(50%-1.5rem)] pl-14 sm:pl-0 timeline-card-entrance ${isEven ? 'timeline-card-even' : 'timeline-card-odd'}`}
						style={`animation-delay: ${delaySec}s;`}
					>
						<div class="bg-surface-container border border-white/10 hover:border-primary/40 rounded-3xl pt-6 px-6 pb-4 transition-all duration-300 hover:-translate-y-1.5 relative overflow-hidden group-hover:bg-surface-container-high/90">
							<!-- Card Header: Logo, Role & Company -->
							<div class="flex items-start justify-between gap-4 mb-4 relative z-10">
								<div class="flex items-center gap-3.5">
									<div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 overflow-hidden flex items-center justify-center shrink-0 group-hover:border-primary/30 group-hover:scale-105 transition-all duration-300">
										{exp.logoUrl ? (
											<img
												src={index === 0 ? exp.logoUrl : lazyImagePlaceholder}
												data-src={index === 0 ? undefined : exp.logoUrl}
												alt={exp.company}
												class="w-full h-full object-contain p-2"
												loading={index === 0 ? 'eager' : 'lazy'}
												decoding="async"
											/>
										) : (
											<div class="relative flex items-center justify-center">
												<Icon name="business" size={24} class="text-white/40 group-hover:!hidden" />
												<Icon name="business" filled size={24} class="text-primary !hidden group-hover:!inline-flex" />
											</div>
										)}
									</div>
									<div>
										<h3 class="font-bold text-white text-lg sm:text-xl tracking-tight leading-tight group-hover:text-primary transition-colors">
											{exp.role}
										</h3>
										<p class="text-xs sm:text-sm text-white/70 font-medium mt-0.5 flex items-center gap-1.5">
											<span>{exp.company}</span>
										</p>
									</div>
								</div>
							</div>

							<!-- Badges: Date Range, Employment Type & Present Pulse -->
							<div class="flex flex-wrap items-center gap-2 mb-4 relative z-10">
								<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold">
									<Icon name="calendar" size={14} class="text-primary" />
									<span>{formattedStart} — {formattedEnd}</span>
								</span>
								<span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/80 text-xs font-medium">
									{exp.employmentType}
								</span>
								{isPresent && (
									<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary/15 border border-secondary/30 text-secondary text-[11px] font-bold tracking-wide uppercase">
										<span class="w-1.5 h-1.5 rounded-full bg-secondary animate-ping"></span>
										Current
									</span>
								)}
							</div>

							<!-- Responsibilities List -->
							{exp.responsibilities && (
								<div class="border-t border-white/10 pt-4 relative z-10">
									<ul class="space-y-2">
										{exp.responsibilities.split('\n').map((line) => {
											const trimmed = line.trim();
											if (!trimmed) return null;
											const cleanText = trimmed.startsWith('-') ? trimmed.substring(1).trim() : trimmed;
											return (
												<li class="flex items-start gap-2.5 text-xs sm:text-sm text-white/80 leading-relaxed group/item">
													<span class="inline-block w-1.5 h-1.5 rounded-full bg-primary/60 mt-2 shrink-0 group-hover/item:bg-primary transition-colors"></span>
													<span>{cleanText}</span>
												</li>
											);
										})}
									</ul>
								</div>
							)}
						</div>
					</div>
				</div>
			);
		})}
	</div>

	{experiences.length === 0 && !errorMsg && (
		<div class="py-20 text-center bg-surface-container rounded-3xl border border-white/10 flex flex-col items-center">
			<Icon name="experience" size={48} class="text-primary mb-3" />
			<p class="font-bold text-white text-lg">No experience entries recorded</p>
			<p class="text-xs text-white/60 mt-1">Please check back soon for professional updates.</p>
		</div>
	)}
</div>

<script>
	import { startDeferredImageLoader } from '../lib/client-deferred-images';
	startDeferredImageLoader();
</script>

<style>
	/* Timeline Line Entrance Animation */
	@keyframes lineGrow {
		0% {
			transform: scaleY(0);
			opacity: 0;
		}
		100% {
			transform: scaleY(1);
			opacity: 1;
		}
	}

	.timeline-line-animated {
		transform-origin: top center;
		animation: lineGrow 1.1s cubic-bezier(0.2, 0.0, 0.2, 1) forwards;
	}

	/* Pulse Beam animation along the line */
	@keyframes pulseBeam {
		0% {
			top: -10%;
			opacity: 0;
		}
		20% {
			opacity: 0.9;
		}
		80% {
			opacity: 0.9;
		}
		100% {
			top: 100%;
			opacity: 0;
		}
	}

	.timeline-pulse-beam {
		animation: pulseBeam 3.5s cubic-bezier(0.4, 0, 0.6, 1) infinite 1.1s;
	}

	/* Timeline Dot Entrance Animation */
	@keyframes dotPop {
		0% {
			opacity: 0;
			transform: scale(0);
		}
		70% {
			transform: scale(1.35);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	.timeline-dot-entrance {
		transform-origin: center;
		animation: dotPop 0.5s cubic-bezier(0.2, 0.0, 0.2, 1) both;
	}

	/* Staggered Card Reveal Animations */
	@keyframes cardEntranceDesktopEven {
		0% {
			opacity: 0;
			transform: translateX(45px) scale(0.95);
		}
		100% {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}

	@keyframes cardEntranceDesktopOdd {
		0% {
			opacity: 0;
			transform: translateX(-45px) scale(0.95);
		}
		100% {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}

	@keyframes cardEntranceMobile {
		0% {
			opacity: 0;
			transform: translateY(35px) scale(0.95);
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	/* Apply responsive animations */
	@media (min-width: 640px) {
		.timeline-card-even {
			animation: cardEntranceDesktopEven 0.65s cubic-bezier(0.2, 0.0, 0.2, 1) both;
		}
		.timeline-card-odd {
			animation: cardEntranceDesktopOdd 0.65s cubic-bezier(0.2, 0.0, 0.2, 1) both;
		}
	}

	@media (max-width: 639px) {
		.timeline-card-entrance {
			animation: cardEntranceMobile 0.65s cubic-bezier(0.2, 0.0, 0.2, 1) both;
		}
	}
</style>
