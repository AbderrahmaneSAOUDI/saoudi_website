---
/**
 * HomeCountsIsland — Server Island for Dashboard Counts
 * 
 * Deferred component fetched asynchronously via server:defer.
 * Renders the statistics grid with live Firestore counts.
 * The parent page shows skeleton cards while this loads.
 */
import Icon from './Icon.astro';
import { getFirebaseAdminDb } from '../lib/server/firebase-admin';
import { CACHE_TTL_MS, getOrSetCached } from '../lib/server/cache';

interface Props {}

type CountsData = { projects: number; experience: number; designs: number; certificates: number; volunteering: number; };

const defaultCounts: CountsData = { projects: 0, experience: 0, designs: 0, certificates: 0, volunteering: 0 };
const cacheKeyCounts = 'public_dashboard_counts';
let counts: CountsData = defaultCounts;

try {
	counts = await getOrSetCached(
		cacheKeyCounts,
		async () => {
		const db = getFirebaseAdminDb();
		const [projectsSnap, experienceSnap, designsSnap, certificatesSnap, volunteeringSnap] = await Promise.all([
			db.collection("projects").count().get(),
			db.collection("experience").count().get(),
			db.collection("designs").count().get(),
			db.collection("certificates").count().get(),
			db.collection("volunteering").count().get(),
		]);

		return {
			projects: projectsSnap.data().count,
			experience: experienceSnap.data().count,
			designs: designsSnap.data().count,
			certificates: certificatesSnap.data().count,
			volunteering: volunteeringSnap.data().count,
		};
		},
		CACHE_TTL_MS.PUBLIC_DATA,
	);
} catch (error) {
	console.warn("Failed to fetch aggregate counts from Firestore for public home page:", error);
}

function formatStatCount(count: number): string {
	if (count < 10) return '0';
	const rounded = Math.floor(count / 10) * 10;
	return `+${rounded}`;
}

const statCards = [
	{ label: 'Projects', value: formatStatCount(counts.projects), icon: 'projects', color: 'primary', href: '/projects', disabled: false },
	{ label: 'Experience', value: formatStatCount(counts.experience), icon: 'experience', color: 'secondary', href: '/experience', disabled: false },
	{ label: 'Designs', value: formatStatCount(counts.designs), icon: 'design', color: 'tertiary', href: '/designs', disabled: false },
	{ label: 'Certificates', value: formatStatCount(counts.certificates), icon: 'certifications', color: 'primary', href: '/certifications', disabled: false },
	{ label: 'Volunteering', value: formatStatCount(counts.volunteering), icon: 'business', color: 'secondary', href: '#', disabled: true },
];
---

<div class="relative grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
	{statCards.map(({ label, value, icon, color, href, disabled }) => 
		disabled ? (
			<button
				type="button"
				class={`btn-disabled-home-card text-left p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/50 border border-white/10 bg-surface-container group cursor-pointer`}
				data-title={label}
			>
				<div class="flex justify-between items-start mb-4">
					<div class={`relative p-2.5 rounded-2xl bg-${color}/10 text-${color}`}>
						<Icon name={icon} size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
						<Icon name={icon} filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
					</div>
					<span class="text-2xl font-black text-white">{value}</span>
				</div>
				<h3 class="font-bold text-[#E6E1E5]">{label}</h3>
			</button>
		) : (
			<a
				href={href}
				class={`block p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/50 border border-white/10 bg-surface-container group cursor-pointer`}
			>
				<div class="flex justify-between items-start mb-4">
					<div class={`relative p-2.5 rounded-2xl bg-${color}/10 text-${color}`}>
						<Icon name={icon} size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
						<Icon name={icon} filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
					</div>
					<span class="text-2xl font-black text-white">{value}</span>
				</div>
				<h3 class="font-bold text-[#E6E1E5]">{label}</h3>
			</a>
		)
	)}
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.btn-disabled-home-card').forEach((btn) => {
			btn.addEventListener('click', () => {
				const title = btn.getAttribute('data-title') || 'This section';
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast(`${title} section coming soon!`, 'info');
				}
			});
		});
	});
</script>
