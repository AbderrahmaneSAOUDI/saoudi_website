---
/**
 * HomeCountsIsland — Server-side Stat Counters
 * 
 * Fetches and computes live aggregate counts from Firestore at build / SSR time.
 * Renders zero-JS statistics cards directly in the HTML response.
 */
import Icon from './Icon.astro';
import { getFirebaseAdminDb } from '../lib/server/firebase-admin';
import { CACHE_TTL_MS, getOrSetCached } from '../lib/server/cache';

interface Props {}

type CountsData = { projects: number; experience: number; designs: number; certificates: number; volunteering: number; };

const defaultCounts: CountsData = { projects: 0, experience: 0, designs: 0, certificates: 0, volunteering: 0 };
const cacheKeyCounts = 'public_dashboard_counts';
let counts: CountsData = defaultCounts;

try {
	counts = await getOrSetCached(
		cacheKeyCounts,
		async () => {
		const db = getFirebaseAdminDb();
		const [projectsSnap, experienceSnap, designsSnap, certificatesSnap, volunteeringSnap] = await Promise.all([
			db.collection("projects").count().get(),
			db.collection("experience").count().get(),
			db.collection("designs").count().get(),
			db.collection("certificates").count().get(),
			db.collection("volunteering").count().get(),
		]);

		return {
			projects: projectsSnap.data().count,
			experience: experienceSnap.data().count,
			designs: designsSnap.data().count,
			certificates: certificatesSnap.data().count,
			volunteering: volunteeringSnap.data().count,
		};
		},
		CACHE_TTL_MS.PUBLIC_DATA,
	);
} catch (error) {
	console.warn("Failed to fetch aggregate counts from Firestore for public home page:", error);
}

function formatStatCount(count: number): string {
	if (count <= 10) return `${Math.max(0, count)}`;
	const floored = Math.floor(count / 10) * 10;
	return `+${floored}`;
}

const statCards = [
	{ label: 'Projects', rawValue: counts.projects, value: formatStatCount(counts.projects), icon: 'projects', color: 'primary', href: '/projects', disabled: false },
	{ label: 'Experience', rawValue: counts.experience, value: formatStatCount(counts.experience), icon: 'experience', color: 'secondary', href: '/experience', disabled: false },
	{ label: 'Designs', rawValue: counts.designs, value: formatStatCount(counts.designs), icon: 'design', color: 'tertiary', href: '/designs', disabled: false },
	{ label: 'Certificates', rawValue: counts.certificates, value: formatStatCount(counts.certificates), icon: 'certifications', color: 'primary', href: '/certifications', disabled: false },
	{ label: 'Volunteering', rawValue: counts.volunteering, value: formatStatCount(counts.volunteering), icon: 'business', color: 'secondary', href: '#', disabled: true },
];
---

<div id="home-counts-island" class="relative grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
	{statCards.map(({ label, rawValue, value, icon, color, href, disabled }) => 
		disabled ? (
			<button
				type="button"
				class={`btn-disabled-home-card text-left p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover-card-border hover:border-primary/80 hover:bg-surface-container-high border border-white/10 bg-surface-container group cursor-pointer shadow-none`}
				data-title={label}
			>
				<div class="flex justify-between items-start mb-4">
					<div class={`relative w-11 h-11 flex items-center justify-center rounded-2xl bg-${color}/10 text-${color} transition-transform duration-300 group-hover:scale-105`}>
						<Icon name={icon} size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
						<Icon name={icon} filled size={24} class="absolute inset-0 m-auto w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
					</div>
					<span class="stat-counter-value text-2xl font-black text-white inline-block transition-transform duration-200" data-target={rawValue}>{value}</span>
				</div>
				<h3 class="font-bold text-[#E6E1E5] transition-colors duration-200 group-hover:text-white">{label}</h3>
			</button>
		) : (
			<a
				href={href}
				class={`block p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover-card-border hover:border-primary/80 hover:bg-surface-container-high border border-white/10 bg-surface-container group cursor-pointer shadow-none`}
			>
				<div class="flex justify-between items-start mb-4">
					<div class={`relative w-11 h-11 flex items-center justify-center rounded-2xl bg-${color}/10 text-${color} transition-transform duration-300 group-hover:scale-105`}>
						<Icon name={icon} size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
						<Icon name={icon} filled size={24} class="absolute inset-0 m-auto w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
					</div>
					<span class="stat-counter-value text-2xl font-black text-white inline-block transition-transform duration-200" data-target={rawValue}>{value}</span>
				</div>
				<h3 class="font-bold text-[#E6E1E5] transition-colors duration-200 group-hover:text-white">{label}</h3>
			</a>
		)
	)}
</div>

<script>
	function formatStatCount(count: number): string {
		if (count <= 10) return `${Math.max(0, count)}`;
		const floored = Math.floor(count / 10) * 10;
		return `+${floored}`;
	}

	function animateCounters() {
		const counterEls = document.querySelectorAll<HTMLElement>('.stat-counter-value:not([data-counter-initialized])');
		if (!counterEls.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const el = entry.target as HTMLElement;
						observer.unobserve(el);

						const targetRaw = parseInt(el.getAttribute('data-target') || '0', 10);
						if (isNaN(targetRaw) || targetRaw <= 0) {
							el.textContent = '0';
							return;
						}

						const isOverTen = targetRaw > 10;
						const targetLimit = isOverTen ? Math.floor(targetRaw / 10) * 10 : targetRaw;
						el.textContent = isOverTen ? '+0' : '0';

						const duration = 1600; // 1.6s smooth easing
						const startTime = performance.now();
						let lastVal = -1;

						function step(now: number) {
							const elapsed = now - startTime;
							const progress = Math.min(elapsed / duration, 1);
							// Quartic ease-out for ultra-smooth deceleration
							const easeProgress = 1 - Math.pow(1 - progress, 4);
							const currentVal = Math.floor(targetLimit * easeProgress);

							if (currentVal !== lastVal) {
								lastVal = currentVal;
								el.textContent = isOverTen ? `+${currentVal}` : `${currentVal}`;
							}

							if (progress < 1) {
								requestAnimationFrame(step);
							} else {
								el.textContent = formatStatCount(targetRaw);
								// Subtle finish pop for visual feedback (shadow-free)
								el.classList.add('scale-110');
								setTimeout(() => {
									el.classList.remove('scale-110');
								}, 200);
							}
						}

						requestAnimationFrame(step);
					}
				});
			},
			{ threshold: 0.2, rootMargin: '0px 0px -20px 0px' }
		);

		counterEls.forEach((el) => {
			el.dataset.counterInitialized = 'true';
			observer.observe(el);
		});
	}

	// Server islands can be inserted after DOMContentLoaded. Initialize both the
	// immediate DOM and the eventual island response without keeping an observer alive.
	animateCounters();
	if (!document.getElementById('home-counts-island')) {
		const islandObserver = new MutationObserver(() => {
			if (!document.getElementById('home-counts-island')) return;
			animateCounters();
			islandObserver.disconnect();
		});
		islandObserver.observe(document.documentElement, { childList: true, subtree: true });
	}

	if (!(window as any).__homeCountsClickHandlerBound) {
		(window as any).__homeCountsClickHandlerBound = true;
		document.addEventListener('click', (event) => {
			const target = event.target as HTMLElement | null;
			const button = target?.closest('.btn-disabled-home-card') as HTMLElement | null;
			if (!button) return;
			const title = button.getAttribute('data-title') || 'This section';
			if (typeof (window as any).showToast === 'function') {
				(window as any).showToast(`${title} section coming soon!`, 'info');
			}
		});
	}
</script>
