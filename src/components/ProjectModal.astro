---
/**
 * ProjectModal Component
 * 
 * Renders a global modal dialog for public project details.
 * Features a blurred background overlay, hidden scrollbars, and compact block spacing.
 */
import type { Project } from '../types';

interface Props {
	projects?: Project[];
}

const { projects = [] } = Astro.props;
---

<div
	id="project-details-modal"
	role="dialog"
	aria-modal="true"
	aria-labelledby="project-modal-title"
	aria-hidden="true"
	inert
	class="hidden fixed inset-0 bg-black/75 backdrop-blur-md z-[100] items-center justify-center p-4 sm:p-6 overflow-y-auto no-scrollbar"
>
	<!-- Backdrop Click to Close -->
	<div id="project-modal-backdrop" class="fixed inset-0 cursor-default"></div>

	<div class="relative w-full max-w-3xl bg-[#1D1B20] border border-[#2B2930] rounded-3xl shadow-2xl z-10 my-auto p-5 sm:p-7 space-y-4 max-h-[90vh] overflow-y-auto no-scrollbar animate-page-slide-up">
		<button
			type="button"
			id="project-modal-close"
			class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-xl leading-none cursor-pointer"
			aria-label="Close project details"
		>×</button>

		<!-- Modal Content Body -->
		<div id="project-modal-content" class="space-y-4">
			<!-- Header: Title, Date, Tech -->
			<div class="space-y-2.5">
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-3">
					<div>
						<h2 id="project-modal-title" class="text-xl sm:text-2xl font-bold text-white tracking-tight"></h2>
					</div>
					<span id="project-modal-date" class="text-xs text-white/50 font-semibold bg-white/5 px-3 py-1 rounded-full border border-white/10"></span>
				</div>

				<div id="project-modal-tech-container" class="flex flex-wrap gap-1.5 pt-0.5">
					<!-- Tech pills inserted here -->
				</div>
			</div>

			<!-- Blocks Section -->
			<div id="project-modal-blocks" class="space-y-2 pt-1">
				<!-- Blocks dynamically inserted here -->
			</div>

			<!-- External Links (Project URL & GitHub) -->
			<div id="project-modal-links" class="flex flex-wrap gap-2.5 pt-3 border-t border-white/10">
				<!-- Links inserted here -->
			</div>
		</div>
	</div>
</div>

<script is:inline define:vars={{ initialProjects: projects }}>
	(function() {
		const projectsMap = new Map();
		let lastFocusedElement = null;
		if (Array.isArray(initialProjects)) {
			initialProjects.forEach(p => {
				if (p && typeof p === 'object' && typeof p.id === 'string') projectsMap.set(p.id, p);
			});
		}

		function openModal() {
			const modal = document.getElementById('project-details-modal');
			if (modal) {
				lastFocusedElement = document.activeElement;
				modal.classList.remove('hidden');
				modal.classList.add('flex');
				modal.removeAttribute('inert');
				modal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
				modal.querySelector('#project-modal-close')?.focus();
			}
		}

		function closeModal() {
			const modal = document.getElementById('project-details-modal');
			if (modal) {
				modal.classList.add('hidden');
				modal.classList.remove('flex');
				modal.setAttribute('inert', '');
				modal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
					lastFocusedElement.focus();
				}
			}
		}

		function openProjectFromTrigger(trigger) {
			const id = trigger?.getAttribute('data-project-card-id');
			const project = projectsMap.get(id);
			if (!project) return;
			populateProjectModal(project);
			openModal();
		}

		document.addEventListener('click', (e) => {
			const backdrop = e.target.closest('#project-modal-backdrop');
			if (backdrop) {
				closeModal();
				return;
			}

			const trigger = e.target.closest('[data-project-card-id]');
			if (!trigger) return;
			
			// Don't open modal if clicking an explicit external link
			if (e.target.closest('a[target="_blank"]')) return;

			e.preventDefault();
			openProjectFromTrigger(trigger);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			const trigger = e.target.closest?.('[data-project-card-id]');
			if (!trigger) return;
			e.preventDefault();
			openProjectFromTrigger(trigger);
		});

		document.getElementById('project-modal-close')?.addEventListener('click', closeModal);

		function getSafeUrl(value, allowImageData = false) {
			if (typeof value !== 'string' || !value.trim()) return null;
			const candidate = value.trim();
			if (allowImageData && /^data:image\/(?:webp|png|jpe?g|gif);base64,/i.test(candidate)) {
				return candidate;
			}
			try {
				const parsed = new URL(candidate, window.location.origin);
				return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : null;
			} catch {
				return null;
			}
		}

		function formatModalDate(dateStr) {
			if (typeof dateStr !== 'string' || !dateStr.trim()) return '';
			try {
				const parts = dateStr.trim().split('-');
				if (parts.length >= 2) {
					const year = parseInt(parts[0], 10);
					const month = parseInt(parts[1], 10) - 1;
					const d = new Date(year, month, 1);
					if (!isNaN(d.getTime())) {
						return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
					}
				} else if (parts.length === 1 && parts[0].length === 4) {
					return parts[0];
				}
			} catch (e) {}
			return dateStr;
		}

		function parseInlineMarkdown(text) {
			if (!text || typeof text !== 'string') return '';
			let escaped = text
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
			escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-[#2B2930] text-[#4285F4] px-1.5 py-0.5 rounded-md font-mono text-xs border border-white/10">$1</code>');
			escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-white">$1</strong>');
			escaped = escaped.replace(/\*([^*]+)\*/g, '<em class="italic text-white/90">$1</em>');
			return escaped;
		}

		function populateProjectModal(project) {
			const modal = document.getElementById('project-details-modal');
			if (!modal) return;

			const title = modal.querySelector('#project-modal-title');
			const date = modal.querySelector('#project-modal-date');
			const techContainer = modal.querySelector('#project-modal-tech-container');
			const blocksContainer = modal.querySelector('#project-modal-blocks');
			const linksContainer = modal.querySelector('#project-modal-links');

			if (title) title.textContent = project.title || '';
			if (date) date.textContent = formatModalDate(project.date);

			if (techContainer) {
				techContainer.innerHTML = '';
				if (Array.isArray(project.technologies)) {
					project.technologies.forEach(tech => {
						if (typeof tech !== 'string') return;
						const pill = document.createElement('span');
						pill.className = 'px-2.5 py-0.5 rounded-lg text-xs font-medium bg-primary/10 text-primary border border-primary/20';
						pill.textContent = tech;
						techContainer.appendChild(pill);
					});
				}
			}

			if (linksContainer) {
				linksContainer.innerHTML = '';
				const projectUrl = getSafeUrl(project.projectUrl);
				if (projectUrl) {
					const btn = document.createElement('a');
					btn.href = projectUrl;
					btn.target = '_blank';
					btn.rel = 'noopener noreferrer';
					btn.className = 'px-3.5 py-1.5 rounded-xl bg-primary hover:bg-primary/90 text-white text-xs font-bold transition-colors flex items-center gap-1.5';
					btn.textContent = 'Project Link ↗';
					linksContainer.appendChild(btn);
				}
				const githubUrl = getSafeUrl(project.githubUrl);
				if (githubUrl) {
					const btn = document.createElement('a');
					btn.href = githubUrl;
					btn.target = '_blank';
					btn.rel = 'noopener noreferrer';
					btn.className = 'px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition-colors flex items-center gap-1.5';
					btn.textContent = 'Source Code ↗';
					linksContainer.appendChild(btn);
				}
			}

			if (blocksContainer) {
				blocksContainer.innerHTML = '';
				if (Array.isArray(project.blocks) && project.blocks.length > 0) {
					project.blocks.forEach(block => {
						const el = renderBlockElement(block);
						if (el) blocksContainer.appendChild(el);
					});
				}
			}
		}

		function renderBlockElement(block) {
			if (!block || typeof block !== 'object' || typeof block.type !== 'string') return null;

			if (block.type === 'heading') {
				const lvl = block.level || 2;
				const h = document.createElement('h' + (lvl >= 1 && lvl <= 6 ? lvl : 2));
				const sizes = {
					1: 'text-xl sm:text-2xl font-extrabold text-white mt-6 mb-3 pt-2',
					2: 'text-lg sm:text-xl font-bold text-white mt-5 mb-2.5 pt-1.5',
					3: 'text-base sm:text-lg font-bold text-white mt-4 mb-2 pt-1',
					4: 'text-sm font-semibold text-white mt-3.5 mb-1.5',
					5: 'text-xs font-semibold text-white/90 mt-3 mb-1',
					6: 'text-[11px] font-semibold text-white/80 mt-2.5 mb-1'
				};
				h.className = sizes[lvl] || sizes[2];
				h.textContent = block.text || '';
				return h;
			} else if (block.type === 'rich_text') {
				const div = document.createElement('div');
				div.className = 'text-xs sm:text-sm text-white/80 leading-relaxed space-y-1.5 whitespace-pre-wrap';
				div.innerHTML = parseInlineMarkdown(block.content || '');
				return div;
			} else if (block.type === 'callout') {
				const div = document.createElement('div');
				const variants = {
					info: 'bg-primary/10 border-primary/30 text-[#4285F4]',
					success: 'bg-[#34A853]/10 border-[#34A853]/30 text-[#34A853]',
					warning: 'bg-[#F9AB00]/10 border-[#F9AB00]/30 text-[#F9AB00]',
					error: 'bg-[#EA4335]/10 border-[#EA4335]/30 text-[#EA4335]'
				};
				const variantClass = variants[block.variant] || variants.info;
				div.className = `p-3 rounded-2xl border ${variantClass} space-y-0.5 my-1`;
				if (block.title) {
					const title = document.createElement('p');
					title.className = 'font-bold text-xs uppercase tracking-wider';
					title.textContent = block.title;
					div.appendChild(title);
				}
				if (block.text) {
					const txt = document.createElement('p');
					txt.className = 'text-xs text-white/90 leading-relaxed whitespace-pre-wrap';
					txt.innerHTML = parseInlineMarkdown(block.text);
					div.appendChild(txt);
				}
				return div;
			} else if (block.type === 'single_image') {
				const imageUrl = getSafeUrl(block.imageUrl, true);
				if (!imageUrl) return null;
				const div = document.createElement('div');
				div.className = 'my-1.5';
				const imageWrapper = document.createElement('div');
				imageWrapper.className = 'rounded-2xl overflow-hidden border border-white/10 bg-black/40';
				const image = document.createElement('img');
				image.src = imageUrl;
				image.alt = '';
				image.className = 'w-full h-auto object-cover';
				image.loading = 'lazy';
				image.decoding = 'async';
				image.onerror = function() {
					if (!this.getAttribute('data-fallback-tried')) {
						this.setAttribute('data-fallback-tried', '1');
						this.src = '/cover.webp';
					}
				};
				imageWrapper.appendChild(image);
				div.appendChild(imageWrapper);
				return div;
			} else if (block.type === 'carousel') {
				if (!Array.isArray(block.images) || block.images.length === 0) return null;
				const div = document.createElement('div');
				div.className = 'my-1.5';
				const grid = document.createElement('div');
				grid.className = 'grid grid-cols-1 sm:grid-cols-2 gap-1.5';
				block.images.forEach(imgUrl => {
					const safeImageUrl = getSafeUrl(imgUrl, true);
					if (!safeImageUrl) return;
					const imgWrapper = document.createElement('div');
					imgWrapper.className = 'aspect-[16/10] rounded-xl overflow-hidden border border-white/10 bg-black/40';
					const image = document.createElement('img');
					image.src = safeImageUrl;
					image.alt = '';
					image.className = 'w-full h-full object-cover';
					image.loading = 'lazy';
					image.decoding = 'async';
					image.onerror = function() {
						if (!this.getAttribute('data-fallback-tried')) {
							this.setAttribute('data-fallback-tried', '1');
							this.src = '/cover.webp';
						}
					};
					imgWrapper.appendChild(image);
					grid.appendChild(imgWrapper);
				});
				div.appendChild(grid);
				return div;
			} else if (block.type === 'metrics_grid') {
				if (!Array.isArray(block.items) || block.items.length === 0) return null;
				const div = document.createElement('div');
				div.className = 'grid grid-cols-2 sm:grid-cols-3 gap-2 my-1.5';
				block.items.forEach(it => {
					if (!it || typeof it !== 'object') return;
					const card = document.createElement('div');
					card.className = 'p-2.5 rounded-2xl bg-white/5 border border-white/10 text-center space-y-0.5';
					const value = document.createElement('p');
					value.className = 'text-sm sm:text-base font-extrabold text-primary';
					value.textContent = String(it.value || '');
					const label = document.createElement('p');
					label.className = 'text-[10px] font-semibold text-white/50 uppercase tracking-wider';
					label.textContent = String(it.label || '');
					card.append(value, label);
					div.appendChild(card);
				});
				return div;
			} else if (block.type === 'action_buttons') {
				if (!Array.isArray(block.buttons) || block.buttons.length === 0) return null;
				const div = document.createElement('div');
				div.className = 'flex flex-wrap gap-1.5 my-1.5';
				block.buttons.forEach(b => {
					if (!b || typeof b !== 'object') return;
					const buttonUrl = getSafeUrl(b.url);
					if (!buttonUrl) return;
					const a = document.createElement('a');
					a.href = buttonUrl;
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
					a.className = 'px-3 py-1 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold transition-colors flex items-center gap-1';
					a.textContent = `${String(b.label || 'Link')} ↗`;
					div.appendChild(a);
				});
				return div;
			} else if (block.type === 'list') {
				const items = Array.isArray(block.items) ? block.items : [];
				if (items.length === 0) return null;
				const isNumbered = block.listType === 'number';
				const listEl = document.createElement(isNumbered ? 'ol' : 'ul');
				listEl.className = `text-xs sm:text-sm text-white/80 space-y-1.5 my-2 pl-5 ${isNumbered ? 'list-decimal' : 'list-disc'}`;
				items.forEach(itemText => {
					if (typeof itemText !== 'string' || !itemText.trim()) return;
					const li = document.createElement('li');
					li.className = 'leading-relaxed';
					li.innerHTML = parseInlineMarkdown(itemText);
					listEl.appendChild(li);
				});
				return listEl;
			}
			return null;
		}

		// Escape key to close modal
		document.addEventListener('keydown', (e) => {
			const modal = document.getElementById('project-details-modal');
			if (!modal || modal.getAttribute('aria-hidden') !== 'false') return;
			if (e.key === 'Escape') {
				e.preventDefault();
				closeModal();
				return;
			}
			if (e.key !== 'Tab') return;
			const focusable = Array.from(modal.querySelectorAll('button, a[href], input, select, textarea, [tabindex]:not([tabindex="-1"])'))
				.filter(element => !element.hasAttribute('disabled'));
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});
	})();
</script>

<style is:global>
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
</style>
