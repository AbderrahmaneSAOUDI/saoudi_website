---
import Icon from "../Icon.astro";

interface Props {
	title?: string;
	systemStatus?: string;
}

const { title = "Dashboard", systemStatus = "Connected" } = Astro.props;

const isConnected = systemStatus.toLowerCase().includes("connected");
const firestoreBadgeStyle = isConnected
	? "bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20"
	: "bg-[#F9AB00]/10 text-[#F9AB00] border-[#F9AB00]/20";
---

<header
	class="sticky top-0 z-40 w-full flex flex-row justify-between items-center gap-3 border-b border-[#2B2930] bg-[#121212]/90 backdrop-blur-md px-4 md:px-8 py-2.5 md:py-3 transition-all duration-200"
>
	<div class="flex items-center gap-2.5 md:gap-3 min-w-0">
		<span
			class="w-2 h-2 rounded-full bg-[#0F9D58] animate-pulse shrink-0"
			title="System Active"
		></span>
		<div class="flex items-center gap-2 min-w-0">
			<span
				class="text-[10px] md:text-xs uppercase tracking-widest text-primary font-bold truncate hidden sm:inline-block shrink-0"
			>
				Admin
			</span>
			<span class="text-white/20 hidden sm:inline-block font-light select-none">/</span>
			<h1
				class="text-base md:text-xl font-bold text-white tracking-tight truncate"
			>
				{title}
			</h1>
		</div>
	</div>

	<div class="flex items-center gap-2 md:gap-3 shrink-0">
		<div class="hidden sm:flex items-center gap-2 md:gap-2.5 text-xs select-none mr-1 md:mr-2">
			<span class="px-2.5 py-1 rounded-full bg-[#211F26] border border-[#2B2930] text-[#E6E1E5]/70 text-[11px] md:text-xs">
				Environment: <strong class="text-white font-semibold">Production</strong>
			</span>
			<span class={`px-2.5 py-1 rounded-full border font-medium text-[11px] md:text-xs flex items-center gap-1.5 group/shield ${firestoreBadgeStyle}`}>
				<Icon name={isConnected ? "shield_protected" : "shield_empty"} size={14} class="w-3.5 h-3.5 group-hover/shield:!hidden" />
				<Icon name={isConnected ? "shield_protected_filled" : "shield_empty_filled"} size={14} class="w-3.5 h-3.5 !hidden group-hover/shield:!inline-flex" />
				<span>Firestore: {systemStatus}</span>
			</span>
		</div>

		<button
			id="toggle-shortcuts-btn"
			type="button"
			class="flex items-center gap-1.5 md:gap-2 px-3 md:px-3.5 py-1.5 rounded-full text-xs md:text-sm font-semibold transition-all duration-300 border border-white/10 bg-[#211F26] text-white/80 hover:text-white hover:bg-white/10 hover:border-white/20 active:scale-95 select-none focus:outline-none focus:ring-2 focus:ring-primary/50 cursor-pointer"
			aria-label="Hide Shortcuts"
			title="Hide Shortcuts"
		>
			<span
				id="shortcuts-icon-hide"
				class="flex items-center justify-center"
			>
				<Icon name="hide" size={14} class="w-3.5 h-3.5 md:w-4 md:h-4" />
			</span>
			<span
				id="shortcuts-icon-show"
				class="hidden items-center justify-center"
			>
				<Icon name="show" size={14} class="w-3.5 h-3.5 md:w-4 md:h-4" />
			</span>
			<span class="hidden md:inline">Shortcuts</span>
		</button>

		<form method="POST" action="/admin/admin_logout">
			<button
				type="submit"
				class="flex items-center gap-1.5 md:gap-2 px-3 md:px-4 py-1.5 rounded-full text-xs md:text-sm font-semibold transition-all duration-300 border border-[#DB4437]/40 text-[#E6E1E5] hover:bg-[#DB4437] hover:text-white hover:border-transparent focus:outline-none focus:ring-2 focus:ring-[#DB4437]/50 cursor-pointer"
				aria-label="Sign Out"
			>
				<Icon name="logout" size={14} class="w-3.5 h-3.5 md:w-4 md:h-4 md:hidden" />
				<span class="hidden md:inline">Sign Out</span>
			</button>
		</form>
	</div>
</header>

<script>
	const STORAGE_KEY = "admin_shortcuts_hidden";
	const btn = document.getElementById("toggle-shortcuts-btn");
	const iconHide = document.getElementById("shortcuts-icon-hide");
	const iconShow = document.getElementById("shortcuts-icon-show");

	function updateShortcutState(isHidden: boolean) {
		if (isHidden) {
			document.documentElement.setAttribute(
				"data-hide-shortcuts",
				"true",
			);
			localStorage.setItem(STORAGE_KEY, "true");
			iconHide?.classList.add("hidden");
			iconHide?.classList.remove("flex");
			iconShow?.classList.remove("hidden");
			iconShow?.classList.add("flex");
			btn?.setAttribute("aria-label", "Show Shortcuts");
			btn?.setAttribute("title", "Show Shortcuts");
		} else {
			document.documentElement.removeAttribute("data-hide-shortcuts");
			localStorage.setItem(STORAGE_KEY, "false");
			iconHide?.classList.remove("hidden");
			iconHide?.classList.add("flex");
			iconShow?.classList.add("hidden");
			iconShow?.classList.remove("flex");
			btn?.setAttribute("aria-label", "Hide Shortcuts");
			btn?.setAttribute("title", "Hide Shortcuts");
		}
	}

	// Initialize state on load
	const initialHidden = localStorage.getItem(STORAGE_KEY) === "true";
	updateShortcutState(initialHidden);

	btn?.addEventListener("click", () => {
		const currentlyHidden =
			document.documentElement.getAttribute("data-hide-shortcuts") ===
			"true";
		updateShortcutState(!currentlyHidden);
	});
</script>
