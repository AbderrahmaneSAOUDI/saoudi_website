---
import Icon from '../Icon.astro';
import type { SystemLog } from '../../types';
import { getEnv } from '../../lib/server/env';
import { canUserAccessLog } from '../../lib/server/system-logs';

interface Props {
	initialLogs?: SystemLog[];
	isPrimaryAdmin?: boolean;
}

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const userEmail = (Astro.locals.adminEmail || '').toLowerCase().trim();
const { initialLogs = [], isPrimaryAdmin = (userEmail === primaryEmail && primaryEmail !== '') } = Astro.props;

const excludedLogActions = new Set([
	'DASHBOARD_OPENED',
	'ADMIN_DOWNLOADS_EXCLUSION_TOGGLED',
	'RESUME_DOWNLOAD',
	'RESUME_DOWNLOADED',
	'EMAIL_REVOKED',
	'ADMIN_RESUME_DOWNLOAD',
	'RESUME_DOWNLOADS_RESET',
	'PRIMARY_ADMIN_LOGIN',
	'EMAIL_ADDED',
]);

const cleanLogs = initialLogs.filter(
	l =>
		!excludedLogActions.has(l.action) &&
		!l.title?.startsWith('Revoked admin access for') &&
		!l.title?.startsWith('Granted admin access to') &&
		l.title !== 'Owner logged into Admin Dashboard' &&
		!((l.type === 'task' || l.type === 'content') && (l.isPrimaryEmail || (primaryEmail !== '' && l.userEmail?.toLowerCase() === primaryEmail)))
);
const filteredLogs = cleanLogs.filter(l => canUserAccessLog(l, userEmail, isPrimaryAdmin));
---

<div id="admin-logs-card" class="p-6 rounded-3xl border border-[#2B2930] bg-[#1D1B20] flex flex-col h-[380px] lg:h-[calc(90vh-420px)] min-h-[360px] relative overflow-hidden transition-all duration-300">
	<!-- Card Header & Title -->
	<div id="logs-card-header" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#2B2930]/80 pb-4 shrink-0 transition-all duration-300">
		<div class="flex items-center gap-3">
			<div class="p-2.5 rounded-2xl bg-primary/10 text-primary border border-primary/20">
				<Icon name="logs" size={24} class="w-6 h-6" />
			</div>
			<div class="flex items-center gap-2">
				<h2 class="text-lg font-bold text-white tracking-tight">Logs</h2>
				<span id="log-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/15 text-primary border border-primary/30">
					{filteredLogs.length}
				</span>
			</div>
		</div>

		<!-- Actions: Search, Export, Refresh, Purge Expired & Collapse -->
		<div class="flex items-center gap-2 flex-wrap">
			<!-- Search Bar (Expandable Icon with Animation) -->
			<div class="relative flex items-center shrink-0">
				<button
					type="button"
					id="btn-search-toggle"
					class="p-2.5 rounded-xl border border-[#2B2930] hover:bg-[#211F26] text-[#E6E1E5]/70 hover:text-white text-xs font-medium transition-all duration-300 ease-out flex items-center justify-center cursor-pointer shrink-0 active:scale-90"
					title="Search logs"
				>
					<svg class="w-3.5 h-3.5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				</button>
				<div id="search-input-wrapper" class="relative overflow-hidden transition-all duration-300 ease-out max-w-0 opacity-0 pointer-events-none">
					<input
						type="text"
						id="log-search-input"
						placeholder="Search logs..."
						class="w-36 sm:w-48 px-3 py-1.5 pl-8 rounded-xl bg-[#211F26] border border-[#2B2930] text-xs text-white placeholder-white/40 focus:outline-none focus:border-primary/50 transition-all"
					/>
					<svg class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-white/40 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				</div>
			</div>

			<!-- Export Button -->
			<button
				type="button"
				id="btn-export-logs"
				class="p-2.5 rounded-xl border border-[#2B2930] hover:bg-[#211F26] text-[#E6E1E5]/70 hover:text-white text-xs font-medium transition-all duration-200 flex items-center justify-center cursor-pointer shrink-0"
				title="Export current logs as JSON"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
			</button>

			{isPrimaryAdmin && (
				<button
					type="button"
					id="btn-purge-logs"
					class="p-2.5 rounded-xl border border-[#2B2930] hover:border-amber-500/40 hover:bg-amber-500/10 text-amber-400 text-xs font-medium transition-all duration-200 flex items-center justify-center cursor-pointer shrink-0"
					title="Purge logs older than retention policy"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
				</button>
			)}
			<button
				type="button"
				id="btn-refresh-logs"
				class="p-2.5 rounded-xl border border-[#2B2930] hover:bg-[#211F26] text-[#E6E1E5]/70 hover:text-white text-xs font-medium transition-all duration-200 flex items-center justify-center cursor-pointer shrink-0"
				title="Refresh system logs"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
			</button>

			<button
				type="button"
				id="btn-collapse-logs"
				class="p-2.5 rounded-xl border border-[#2B2930] hover:bg-[#211F26] text-[#E6E1E5]/70 hover:text-white text-xs font-medium transition-all duration-200 flex items-center justify-center cursor-pointer shrink-0"
				title="Collapse card"
				aria-expanded="true"
			>
				<svg id="chevron-logs" class="w-3.5 h-3.5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
			</button>
		</div>
	</div>

	<!-- Collapsible Content Wrapper -->
	<div id="logs-card-content" class="flex-1 min-h-0 flex flex-col transition-all duration-300">
		<!-- Filter Bar -->
		<div class="mt-3.5 shrink-0 flex items-center justify-between gap-2 flex-wrap">
			<!-- Category Tabs -->
			<div class="flex items-center bg-[#211F26] p-1 rounded-2xl border border-[#2B2930] text-xs font-medium overflow-x-auto scrollbar-hide flex-1 min-w-0">
				{isPrimaryAdmin ? (
					<>
						<button type="button" data-filter="all" class="log-filter-btn px-2.5 py-1 rounded-xl bg-primary text-white font-bold transition-all cursor-pointer whitespace-nowrap">All</button>
						<button type="button" data-filter="auth" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Auth</button>
						<button type="button" data-filter="content" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Content</button>
						<button type="button" data-filter="admin" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Admin</button>
						<button type="button" data-filter="security" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Security</button>
						<button type="button" data-filter="visitor" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Visitors</button>
						<button type="button" data-filter="task" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Tasks</button>
						<button type="button" data-filter="storage" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Storage</button>
						<button type="button" data-filter="system" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">System</button>
					</>
				) : (
					<>
						<button type="button" data-filter="all" class="log-filter-btn px-2.5 py-1 rounded-xl bg-primary text-white font-bold transition-all cursor-pointer whitespace-nowrap">All</button>
						<button type="button" data-filter="content" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Content</button>
						<button type="button" data-filter="visitor" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Visitors</button>
						<button type="button" data-filter="storage" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">Storage</button>
						<button type="button" data-filter="my_activity" class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap">My Activity</button>
					</>
				)}
			</div>

			<!-- Admin Email Filter Dropdown (Primary Admin Only) -->
			{isPrimaryAdmin && (
				<div class="relative shrink-0">
					<select
						id="log-email-filter"
						class="px-2.5 py-1.5 rounded-xl bg-[#211F26] border border-[#2B2930] text-xs text-[#E6E1E5]/80 focus:outline-none focus:border-primary/50 transition-all cursor-pointer max-w-[150px] truncate"
						title="Filter by admin email"
					>
						<option value="all">All Emails</option>
					</select>
				</div>
			)}
		</div>

		<!-- Scrollable Activity Logs Container -->
		<div class="flex-1 min-h-0 pt-3 overflow-hidden flex flex-col">
			<div id="logs-list-container" class="space-y-2.5 overflow-y-auto flex-1 scrollbar-hide pr-1">
				<!-- Logs rendered dynamically via JS -->
			</div>

			<!-- Empty State -->
			<div id="logs-empty-state" class="hidden my-auto py-8 text-center text-[#E6E1E5]/40 bg-[#211F26]/50 rounded-2xl border border-dashed border-[#2B2930]">
				<p class="text-xs font-semibold text-white">No activity logs found</p>
				<p class="text-[11px] mt-0.5">Matching website events will appear here.</p>
			</div>
		</div>
	</div>
</div>

<script is:inline define:vars={{ initialLogsData: filteredLogs, isPrimaryAdminUser: isPrimaryAdmin, primaryAdminEmail: isPrimaryAdmin ? primaryEmail : '' }}>
	Object.assign(window, { 
		initialSystemLogs: initialLogsData || [],
		isPrimaryAdminUser: Boolean(isPrimaryAdminUser),
		primaryAdminEmail: primaryAdminEmail || ''
	});
</script>

<script>
	import { escapeAttribute, escapeHtml } from '../../lib/client-safety';

	document.addEventListener('DOMContentLoaded', () => {
		const listContainer = document.getElementById('logs-list-container') as HTMLDivElement;
		const emptyState = document.getElementById('logs-empty-state') as HTMLDivElement;
		const countBadge = document.getElementById('log-count-badge') as HTMLSpanElement;
		const btnRefresh = document.getElementById('btn-refresh-logs') as HTMLButtonElement;
		const btnExport = document.getElementById('btn-export-logs') as HTMLButtonElement;
		const btnSearchToggle = document.getElementById('btn-search-toggle') as HTMLButtonElement;
		const searchInputWrapper = document.getElementById('search-input-wrapper') as HTMLDivElement;
		const searchInput = document.getElementById('log-search-input') as HTMLInputElement;
		const emailFilterSelect = document.getElementById('log-email-filter') as HTMLSelectElement;
		const filterButtons = document.querySelectorAll('.log-filter-btn') as NodeListOf<HTMLButtonElement>;

		const btnCollapse = document.getElementById('btn-collapse-logs') as HTMLButtonElement;
		const chevronIcon = document.getElementById('chevron-logs') as HTMLElement | null;
		const cardElem = document.getElementById('admin-logs-card') as HTMLDivElement;
		const cardContent = document.getElementById('logs-card-content') as HTMLDivElement;
		const cardHeader = document.getElementById('logs-card-header') as HTMLDivElement;

		const STORAGE_KEY = 'admin_logs_collapsed';
		let isCollapsed = localStorage.getItem(STORAGE_KEY) === 'true';

		function setCollapsedState(collapsed: boolean) {
			isCollapsed = collapsed;
			if (collapsed) {
				cardElem?.classList.remove('h-[380px]', 'lg:h-[calc(90vh-420px)]', 'min-h-[360px]');
				cardElem?.classList.add('h-auto', 'min-h-0');
				cardContent?.classList.add('hidden');
				cardHeader?.classList.remove('border-b', 'pb-4');
				chevronIcon?.classList.add('rotate-180');
				btnCollapse?.setAttribute('aria-expanded', 'false');
				btnCollapse?.setAttribute('title', 'Expand card');
			} else {
				cardElem?.classList.add('h-[380px]', 'lg:h-[calc(90vh-420px)]', 'min-h-[360px]');
				cardElem?.classList.remove('h-auto', 'min-h-0');
				cardContent?.classList.remove('hidden');
				cardHeader?.classList.add('border-b', 'pb-4');
				chevronIcon?.classList.remove('rotate-180');
				btnCollapse?.setAttribute('aria-expanded', 'true');
				btnCollapse?.setAttribute('title', 'Collapse card');
			}
		}

		setCollapsedState(isCollapsed);

		if (btnCollapse) {
			btnCollapse.addEventListener('click', () => {
				const nextState = !isCollapsed;
				localStorage.setItem(STORAGE_KEY, String(nextState));
				setCollapsedState(nextState);
			});
		}

		let currentFilter: string = (window as any).isPrimaryAdminUser ? 'all' : 'content';
		let currentEmailFilter: string = 'all';
		let searchQuery: string = '';
		let logs: any[] = (window as any).initialSystemLogs || [];
		let activeAdminEmails: string[] = [];

		function formatEmailLabel(email: string): string {
			if (!email || typeof email !== 'string') return 'system';
			const primaryOwner = ((window as any).primaryAdminEmail || '').toLowerCase().trim();
			const cleanEmail = email.toLowerCase().trim();

			if (primaryOwner && cleanEmail === primaryOwner) {
				return 'Owner';
			}

			if (cleanEmail.endsWith('@gmail.com')) {
				return cleanEmail.slice(0, -10);
			}

			return email;
		}

		function populateEmailFilterOptions() {
			if (!emailFilterSelect) return;
			const previousVal = currentEmailFilter;

			emailFilterSelect.innerHTML = '<option value="all">All Emails</option>';

			let emailsToDisplay = activeAdminEmails;
			if (emailsToDisplay.length === 0) {
				const set = new Set<string>();
				logs.forEach(l => { if (l.userEmail) set.add(l.userEmail.toLowerCase().trim()); });
				emailsToDisplay = Array.from(set);
			}

			const primaryOwner = ((window as any).primaryAdminEmail || '').toLowerCase().trim();

			const sortedEmails = Array.from(new Set(emailsToDisplay)).sort((a, b) => {
				if (a === primaryOwner) return -1;
				if (b === primaryOwner) return 1;
				return a.localeCompare(b);
			});

			sortedEmails.forEach(email => {
				const opt = document.createElement('option');
				opt.value = email;
				opt.textContent = formatEmailLabel(email);
				emailFilterSelect.appendChild(opt);
			});

			if (sortedEmails.includes(previousVal.toLowerCase())) {
				emailFilterSelect.value = previousVal;
			} else {
				emailFilterSelect.value = 'all';
				currentEmailFilter = 'all';
			}
		}

		async function fetchActiveEmails() {
			if (!(window as any).isPrimaryAdminUser) return;
			try {
				const res = await fetch('/admin/admin_emails_api');
				if (res.ok) {
					const data = await res.json();
					if (data.success && Array.isArray(data.emails)) {
						activeAdminEmails = data.emails.map((item: any) => item.email.toLowerCase().trim());
						populateEmailFilterOptions();
					}
				}
			} catch (err) {
				console.warn('Could not fetch active admin emails:', err);
			}
		}

		// Load live data on mount
		populateEmailFilterOptions();
		renderLogs();

		window.addEventListener('admin-emails-updated', () => {
			fetchActiveEmails();
		});

		async function fetchLogs() {
			try {
				const query = new URLSearchParams();
				if (currentFilter !== 'all') {
					query.set('type', currentFilter);
				}
				query.set('limit', '50');

				const res = await fetch(`/admin/admin_logs_api?${query.toString()}`);
				if (res.ok) {
					const data = await res.json();
					if (data.logs && Array.isArray(data.logs)) {
						logs = data.logs;
						populateEmailFilterOptions();
						renderLogs();
					}
				}
			} catch (err) {
				console.error('Error fetching system logs:', err);
			}
		}

		function formatTimeAgo(timestamp: any): string {
			if (!timestamp) return 'Just now';
			let date: Date;
			if (typeof timestamp === 'number') {
				date = new Date(timestamp);
			} else if (typeof timestamp === 'string') {
				date = new Date(timestamp);
			} else if (timestamp._seconds) {
				date = new Date(timestamp._seconds * 1000);
			} else if (timestamp.seconds) {
				date = new Date(timestamp.seconds * 1000);
			} else {
				date = new Date();
			}

			const now = new Date();
			const seconds = Math.floor((now.getTime() - date.getTime()) / 1000);

			if (seconds < 60) return 'Just now';
			const minutes = Math.floor(seconds / 60);
			if (minutes < 60) return `${minutes}m ago`;
			const hours = Math.floor(minutes / 60);
			if (hours < 24) return `${hours}h ago`;
			const days = Math.floor(hours / 24);
			if (days < 30) return `${days}d ago`;
			return date.toLocaleDateString();
		}

		function getLogTypeStyle(type: string, isNonPrimaryLogin: boolean) {
			if (type === 'auth' && isNonPrimaryLogin) {
				return {
					iconBg: 'bg-[#F9AB00]/15 text-[#F9AB00] border-[#F9AB00]/30 animate-pulse',
					badgeTag: 'Secondary Login',
					badgeStyle: 'bg-[#F9AB00]/20 text-[#F9AB00] border-[#F9AB00]/40 font-bold',
					borderAccent: 'border-[#F9AB00]/40 bg-[#25211B]',
				};
			}

			switch (type) {
				case 'auth':
					return {
						iconBg: 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20',
						badgeTag: 'Auth',
						badgeStyle: 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20',
						borderAccent: 'border-[#2B2930]',
					};
				case 'content':
					return {
						iconBg: 'bg-[#4285F4]/10 text-[#4285F4] border-[#4285F4]/20',
						badgeTag: 'Content',
						badgeStyle: 'bg-[#4285F4]/10 text-[#4285F4] border-[#4285F4]/20',
						borderAccent: 'border-[#2B2930]',
					};
				case 'admin':
					return {
						iconBg: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
						badgeTag: 'Admin',
						badgeStyle: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
						borderAccent: 'border-[#2B2930]',
					};
				case 'security':
					return {
						iconBg: 'bg-[#EA4335]/15 text-[#EA4335] border-[#EA4335]/30',
						badgeTag: 'Security',
						badgeStyle: 'bg-[#EA4335]/15 text-[#EA4335] border-[#EA4335]/30 font-bold',
						borderAccent: 'border-[#EA4335]/30',
					};
				case 'visitor':
					return {
						iconBg: 'bg-[#F9AB00]/15 text-[#F9AB00] border-[#F9AB00]/30',
						badgeTag: 'Visitor',
						badgeStyle: 'bg-[#F9AB00]/15 text-[#F9AB00] border-[#F9AB00]/30',
						borderAccent: 'border-[#2B2930]',
					};
				case 'task':
					return {
						iconBg: 'bg-teal-500/10 text-teal-400 border-teal-500/20',
						badgeTag: 'Task',
						badgeStyle: 'bg-teal-500/10 text-teal-400 border-teal-500/20',
						borderAccent: 'border-[#2B2930]',
					};
				case 'storage':
					return {
						iconBg: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
						badgeTag: 'Storage',
						badgeStyle: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
						borderAccent: 'border-[#2B2930]',
					};
				case 'system':
				default:
					return {
						iconBg: 'bg-white/10 text-white/80 border-white/20',
						badgeTag: 'System',
						badgeStyle: 'bg-white/10 text-white/70 border-white/20',
						borderAccent: 'border-[#2B2930]',
					};
			}
		}

		function getLogTypeIcon(type: string): string {
			switch (type) {
				case 'auth':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>`;
				case 'content':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`;
				case 'admin':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>`;
				case 'security':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`;
				case 'visitor':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;
				case 'task':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`;
				case 'storage':
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L8.6 3.3A2 2 0 0 0 6.9 2.5H4a2 2 0 0 0-2 2v13.5a2 2 0 0 0 2 2z"/></svg>`;
				case 'system':
				default:
					return `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`;
			}
		}

		function getSeverityBadgeStyle(severity?: string) {
			switch (severity) {
				case 'warn':
					return { label: 'WARN', style: 'bg-amber-500/15 text-amber-400 border-amber-500/30' };
				case 'error':
					return { label: 'ERROR', style: 'bg-red-500/15 text-red-400 border-red-500/30' };
				case 'critical':
					return { label: 'CRITICAL', style: 'bg-red-900/40 text-red-300 border-red-500/50 animate-pulse font-black' };
				case 'info':
				default:
					return { label: 'INFO', style: 'bg-blue-500/10 text-blue-400 border-blue-500/20' };
			}
		}

		function renderLogs() {
			listContainer.innerHTML = '';
			const isPrimaryUser = (window as any).isPrimaryAdminUser;

			const excludedActions = new Set([
				'DASHBOARD_OPENED',
				'ADMIN_DOWNLOADS_EXCLUSION_TOGGLED',
				'RESUME_DOWNLOAD',
				'RESUME_DOWNLOADED',
				'EMAIL_REVOKED',
				'ADMIN_RESUME_DOWNLOAD',
				'RESUME_DOWNLOADS_RESET',
				'PRIMARY_ADMIN_LOGIN',
				'EMAIL_ADDED',
			]);

			const filtered = logs.filter(log => {
				if (excludedActions.has(log.action)) return false;
				if (log.title?.startsWith('Revoked admin access for')) return false;
				if (log.title?.startsWith('Granted admin access to')) return false;
				if (log.title === 'Owner logged into Admin Dashboard') return false;
				if (log.title === 'Resume Downloaded by Admin (Count Skipped)') return false;
				if (log.title === 'Resume Downloads Counter Reset') return false;

				// Do not track/show Task and Content logs by owner
				const primaryOwner = ((window as any).primaryAdminEmail || '').toLowerCase().trim();
				const isOwnerLog = log.isPrimaryEmail || (primaryOwner !== '' && String(log.userEmail || '').toLowerCase().trim() === primaryOwner);
				if ((log.type === 'task' || log.type === 'content') && isOwnerLog) return false;
				
				const matchesFilter = currentFilter === 'all' || currentFilter === 'my_activity' || log.type === currentFilter;
				if (!matchesFilter) return false;

				const matchesEmail = currentEmailFilter === 'all' || log.userEmail?.toLowerCase() === currentEmailFilter.toLowerCase();
				if (!matchesEmail) return false;

				if (!searchQuery.trim()) return true;
				const q = searchQuery.toLowerCase().trim();
				return (
					(log.title && log.title.toLowerCase().includes(q)) ||
					(log.details && log.details.toLowerCase().includes(q)) ||
					(log.userEmail && log.userEmail.toLowerCase().includes(q)) ||
					(log.action && log.action.toLowerCase().includes(q)) ||
					(log.type && log.type.toLowerCase().includes(q))
				);
			});

			countBadge.textContent = String(filtered.length);

			if (filtered.length === 0) {
				listContainer.classList.add('hidden');
				emptyState.classList.remove('hidden');
				return;
			}

			emptyState.classList.add('hidden');
			listContainer.classList.remove('hidden');

			filtered.forEach(log => {
				const isNonPrimaryLogin = log.type === 'auth' && log.isPrimaryEmail === false;
				const typeStyle = getLogTypeStyle(log.type, isNonPrimaryLogin);
				const sevStyle = getSeverityBadgeStyle(log.severity);
				const iconSvg = getLogTypeIcon(log.type);

				const displayUserEmail = log.isPrimaryEmail
					? 'Owner'
					: log.userEmail
						? formatEmailLabel(log.userEmail)
						: 'system';

				let displayTitle = log.title || '';
				if (displayTitle.includes('entered Admin Dashboard:')) {
					 displayTitle = displayTitle.split(':')[0].trim();
				}
				const safeTitle = escapeHtml(displayTitle);
				const safeUserEmail = escapeHtml(displayUserEmail);
				const safeLogId = escapeAttribute(log.id);
				const changedFields = Array.isArray(log.changedFields)
					? log.changedFields.map((field: unknown) => String(field)).join(', ')
					: '';

				const card = document.createElement('div');
				card.className = `p-3 rounded-2xl bg-[#211F26] border ${typeStyle.borderAccent} hover:border-white/30 transition-all cursor-pointer flex flex-col gap-2 group`;

				card.innerHTML = `
					<div class="flex items-center justify-between gap-3 min-w-0">
						<div class="flex items-center gap-2.5 min-w-0 flex-1">
							<!-- Event Icon -->
							<div class="w-7 h-7 rounded-xl ${typeStyle.iconBg} border flex items-center justify-center shrink-0">
								${iconSvg}
							</div>

							<!-- Log Title -->
							<p class="text-xs font-semibold text-white truncate min-w-0 flex-1" title="${escapeAttribute(displayTitle)}">
								${safeTitle}
							</p>

							<!-- Email & Time Ago -->
							<div class="flex items-center gap-1.5 text-[10px] text-[#E6E1E5]/40 shrink-0">
								<span class="font-mono ${isNonPrimaryLogin ? 'text-[#F9AB00] font-semibold' : ''}">${safeUserEmail}</span>
								<span>•</span>
								<span>${formatTimeAgo(log.timestamp)}</span>
							</div>
						</div>

						<div class="flex items-center gap-1.5 shrink-0">
							<div class="text-white/30 group-hover:text-white/70 transition-colors">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 chevron-icon transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
							</div>

							${isPrimaryUser && log.id ? `
								<button
									type="button"
									class="delete-log-btn opacity-0 group-hover:opacity-100 p-1 rounded-lg text-white/40 hover:text-red-400 hover:bg-red-500/10 transition-all shrink-0 cursor-pointer"
									data-log-id="${safeLogId}"
									title="Delete log entry"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
								</button>
							` : ''}
						</div>
					</div>

					<div class="card-drawer hidden pt-2 mt-1 border-t border-white/10 text-[11px] space-y-1.5 text-white/70">
						<div class="flex items-center gap-2 mb-1">
							<span class="px-2 py-0.5 rounded-md text-[10px] uppercase font-bold tracking-wider border ${typeStyle.badgeStyle}">
								${typeStyle.badgeTag}
							</span>
							<span class="px-1.5 py-0.5 rounded-md text-[9px] uppercase font-bold border ${sevStyle.style}">
								${sevStyle.label}
							</span>
						</div>
						${log.details ? `<p class="leading-relaxed text-white/80">${escapeHtml(log.details)}</p>` : ''}
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3 gap-y-1 text-[10px] text-white/50 pt-1 font-mono">
							${log.requestPath ? `<div><span class="text-white/30">Path:</span> ${escapeHtml(log.requestPath)}</div>` : ''}
							${log.ip ? `<div><span class="text-white/30">IP:</span> ${escapeHtml(log.ip)}</div>` : ''}
							${log.userAgent ? `<div class="sm:col-span-2 truncate" title="${escapeAttribute(log.userAgent)}"><span class="text-white/30">UA:</span> ${escapeHtml(log.userAgent)}</div>` : ''}
							${changedFields ? `<div class="sm:col-span-2"><span class="text-white/30">Fields:</span> ${escapeHtml(changedFields)}</div>` : ''}
							${log.previousValues ? `<div class="sm:col-span-2"><span class="text-white/30">Prev:</span> ${escapeHtml(JSON.stringify(log.previousValues))}</div>` : ''}
							${log.expiresAt ? `<div class="sm:col-span-2"><span class="text-white/30">Expires:</span> ${new Date(log.expiresAt).toLocaleDateString()}</div>` : ''}
						</div>
					</div>
				`;

				// Attach card toggle event
				card.addEventListener('click', (e) => {
					if ((e.target as HTMLElement).closest('.delete-log-btn')) return;
					const drawer = card.querySelector('.card-drawer');
					const chevron = card.querySelector('.chevron-icon');
					if (drawer) {
						const isHidden = drawer.classList.contains('hidden');
						drawer.classList.toggle('hidden', !isHidden);
						if (chevron) {
							chevron.classList.toggle('rotate-180', isHidden);
						}
					}
				});

				// Attach delete listener if present
				const delBtn = card.querySelector('.delete-log-btn');
				if (delBtn) {
					delBtn.addEventListener('click', async (e) => {
						e.stopPropagation();
						const logId = delBtn.getAttribute('data-log-id');
						if (!logId) return;

						if (!confirm('Are you sure you want to delete this log entry?')) return;

						try {
							const res = await fetch(`/admin/admin_logs_api?id=${encodeURIComponent(logId)}`, {
								method: 'DELETE',
							});

							if (res.ok) {
								logs = logs.filter(l => l.id !== logId);
								populateEmailFilterOptions();
								renderLogs();
							} else {
								const errData = await res.json();
								alert(errData.error || 'Failed to delete log entry.');
							}
						} catch (err) {
							console.error('Error deleting log entry:', err);
							alert('An unexpected error occurred while deleting.');
						}
					});
				}

				listContainer.appendChild(card);
			});
		}

		// Filter Tab Switching
		filterButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				filterButtons.forEach(b => {
					b.classList.remove('bg-primary', 'text-white', 'font-bold');
					b.classList.add('text-[#E6E1E5]/60');
				});
				btn.classList.add('bg-primary', 'text-white', 'font-bold');
				btn.classList.remove('text-[#E6E1E5]/60');

				currentFilter = btn.getAttribute('data-filter') || 'all';
				fetchLogs();
			});
		});

		// Admin Email Filter Listener
		if (emailFilterSelect) {
			emailFilterSelect.addEventListener('change', () => {
				currentEmailFilter = emailFilterSelect.value;
				renderLogs();
			});
		}

		// Search Input & Toggle Listeners (with smooth animation)
		if (btnSearchToggle && searchInputWrapper && searchInput) {
			btnSearchToggle.addEventListener('click', () => {
				btnSearchToggle.classList.add('opacity-0', 'scale-75', 'w-0', 'p-0', 'pointer-events-none', 'overflow-hidden');
				searchInputWrapper.classList.remove('max-w-0', 'opacity-0', 'pointer-events-none');
				searchInputWrapper.classList.add('max-w-[220px]', 'opacity-100', 'pointer-events-auto');
				setTimeout(() => searchInput.focus(), 100);
			});

			searchInput.addEventListener('blur', () => {
				if (!searchInput.value.trim()) {
					searchInputWrapper.classList.remove('max-w-[220px]', 'opacity-100', 'pointer-events-auto');
					searchInputWrapper.classList.add('max-w-0', 'opacity-0', 'pointer-events-none');
					btnSearchToggle.classList.remove('opacity-0', 'scale-75', 'w-0', 'p-0', 'pointer-events-none', 'overflow-hidden');
				}
			});

			searchInput.addEventListener('input', () => {
				searchQuery = searchInput.value;
				renderLogs();
			});
		}

		// Export Button Action
		if (btnExport) {
			btnExport.addEventListener('click', () => {
				const primaryOwner = ((window as any).primaryAdminEmail || '').toLowerCase().trim();
				const filtered = logs.filter(log => {
					const isOwnerLog = log.isPrimaryEmail || (primaryOwner !== '' && String(log.userEmail || '').toLowerCase().trim() === primaryOwner);
					if ((log.type === 'task' || log.type === 'content') && isOwnerLog) return false;

					const matchesFilter = currentFilter === 'all' || currentFilter === 'my_activity' || log.type === currentFilter;
					if (!matchesFilter) return false;
					const matchesEmail = currentEmailFilter === 'all' || log.userEmail?.toLowerCase() === currentEmailFilter.toLowerCase();
					if (!matchesEmail) return false;
					if (!searchQuery.trim()) return true;
					const q = searchQuery.toLowerCase().trim();
					return (
						(log.title && log.title.toLowerCase().includes(q)) ||
						(log.details && log.details.toLowerCase().includes(q)) ||
						(log.userEmail && log.userEmail.toLowerCase().includes(q)) ||
						(log.action && log.action.toLowerCase().includes(q))
					);
				});

				if (filtered.length === 0) {
					alert('No logs available to export.');
					return;
				}

				const exportContent = JSON.stringify(filtered, null, 2);
				const blob = new Blob([exportContent], { type: 'application/json' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = `system_logs_${new Date().toISOString().slice(0, 10)}.json`;
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
			});
		}

		// Refresh button action
		btnRefresh.addEventListener('click', () => {
			fetchLogs();
		});

		// Purge Expired Logs button action
		const btnPurge = document.getElementById('btn-purge-logs') as HTMLButtonElement | null;
		if (btnPurge) {
			btnPurge.addEventListener('click', async () => {
				const confirmPurge = typeof (window as any).showConfirmDialog === 'function'
					? await (window as any).showConfirmDialog('Purge Expired Logs', 'Are you sure you want to purge all log entries older than their retention threshold?')
					: confirm('Are you sure you want to purge all log entries older than their retention threshold?');

				if (!confirmPurge) return;

				try {
					const formData = new FormData();
					formData.append('action', 'purge_expired');
					const res = await fetch('/admin/admin_logs_api', {
						method: 'POST',
						body: formData,
					});
					const data = await res.json();
					if (res.ok && data.success) {
						const count = data.deletedCount || 0;
						if (typeof (window as any).showToast === 'function') {
							(window as any).showToast(count > 0 ? `Purged ${count} expired log(s)!` : 'No expired logs found.', 'success');
						} else {
							alert(count > 0 ? `Purged ${count} expired log(s)!` : 'No expired logs found.');
						}
						fetchLogs();
					} else {
						if (typeof (window as any).showToast === 'function') {
							(window as any).showToast(data.error || 'Failed to purge logs', 'error');
						} else {
							alert(data.error || 'Failed to purge logs');
						}
					}
				} catch (err) {
					console.error('Error purging expired logs:', err);
					if (typeof (window as any).showToast === 'function') {
						(window as any).showToast('Network error while purging logs', 'error');
					}
				}
			});
		}
	});
</script>
