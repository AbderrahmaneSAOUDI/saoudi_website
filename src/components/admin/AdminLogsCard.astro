---
import Icon from '../Icon.astro';
import type { SystemLog } from '../../types';
import { getEnv } from '../../lib/server/env';

interface Props {
	initialLogs?: SystemLog[];
	isPrimaryAdmin?: boolean;
}

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const userEmail = (Astro.locals.adminEmail || '').toLowerCase().trim();
const { initialLogs = [], isPrimaryAdmin = (userEmail === primaryEmail && primaryEmail !== '') } = Astro.props;

const filteredLogs = isPrimaryAdmin ? initialLogs : initialLogs.filter(l => l.type === 'content');
---

<div class="p-6 rounded-3xl border border-[#2B2930] bg-[#1D1B20] flex flex-col h-[380px] lg:h-[calc(90vh-420px)] min-h-[360px] shadow-lg relative overflow-hidden">
	<!-- Card Header & Title -->
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#2B2930]/80 pb-4 shrink-0">
		<div class="flex items-center gap-3">
			<div class="p-2.5 rounded-2xl bg-primary/10 text-primary border border-primary/20">
				<Icon name="logs" size={24} class="w-6 h-6" />
			</div>
			<div class="flex items-center gap-2">
				<h2 class="text-lg font-bold text-white tracking-tight">Website Activity Logs</h2>
				<span id="log-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/15 text-primary border border-primary/30">
					{filteredLogs.length}
				</span>
			</div>
		</div>

		<!-- Refresh Button -->
		<button
			type="button"
			id="btn-refresh-logs"
			class="px-3 py-1.5 rounded-xl border border-[#2B2930] hover:bg-[#211F26] text-[#E6E1E5]/70 hover:text-white text-xs font-medium transition-all duration-200 flex items-center justify-center gap-1.5 cursor-pointer shrink-0"
			title="Refresh system logs"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
			<span>Refresh</span>
		</button>
	</div>

	<!-- Filter Bar -->
	<div class="mt-3.5 shrink-0">
		<!-- Category Tabs -->
		<div class="flex items-center bg-[#211F26] p-1 rounded-2xl border border-[#2B2930] text-xs font-medium overflow-x-auto scrollbar-hide">
			{isPrimaryAdmin ? (
				<>
					<button
						type="button"
						data-filter="all"
						class="log-filter-btn px-2.5 py-1 rounded-xl bg-primary text-white font-bold transition-all cursor-pointer whitespace-nowrap"
					>
						All Events
					</button>
					<button
						type="button"
						data-filter="auth"
						class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap"
					>
						Logins (Auth)
					</button>
					<button
						type="button"
						data-filter="content"
						class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap"
					>
						Card Changes
					</button>
					<button
						type="button"
						data-filter="admin"
						class="log-filter-btn px-2.5 py-1 rounded-xl text-[#E6E1E5]/60 hover:text-white transition-all cursor-pointer whitespace-nowrap"
					>
						Admin Access
					</button>
				</>
			) : (
				<button
					type="button"
					data-filter="content"
					class="log-filter-btn px-2.5 py-1 rounded-xl bg-primary text-white font-bold transition-all cursor-default whitespace-nowrap"
				>
					Card Changes
				</button>
			)}
		</div>
	</div>

	<!-- Scrollable Activity Logs Container -->
	<div class="flex-1 min-h-0 pt-3 overflow-hidden flex flex-col">
		<div id="logs-list-container" class="space-y-2.5 overflow-y-auto flex-1 scrollbar-hide pr-1">
			<!-- Logs rendered dynamically via JS -->
		</div>

		<!-- Empty State -->
		<div id="logs-empty-state" class="hidden my-auto py-8 text-center text-[#E6E1E5]/40 bg-[#211F26]/50 rounded-2xl border border-dashed border-[#2B2930]">
			<p class="text-xs font-semibold text-white">No activity logs found</p>
			<p class="text-[11px] mt-0.5">Matching website events will appear here.</p>
		</div>
	</div>
</div>

<script is:inline define:vars={{ initialLogsData: filteredLogs, isPrimaryAdminUser: isPrimaryAdmin }}>
	Object.assign(window, { 
		initialSystemLogs: initialLogsData || [],
		isPrimaryAdminUser: Boolean(isPrimaryAdminUser)
	});
</script>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const listContainer = document.getElementById('logs-list-container') as HTMLDivElement;
		const emptyState = document.getElementById('logs-empty-state') as HTMLDivElement;
		const countBadge = document.getElementById('log-count-badge') as HTMLSpanElement;
		const btnRefresh = document.getElementById('btn-refresh-logs') as HTMLButtonElement;
		const filterButtons = document.querySelectorAll('.log-filter-btn') as NodeListOf<HTMLButtonElement>;

		let currentFilter: string = (window as any).isPrimaryAdminUser ? 'all' : 'content';
		let logs: any[] = (window as any).initialSystemLogs || [];

		// Load live logs on mount
		fetchLogs();

		async function fetchLogs() {
			try {
				const query = new URLSearchParams();
				if (currentFilter !== 'all') query.append('type', currentFilter);

				const res = await fetch(`/admin/admin_logs_api?${query.toString()}`);
				if (res.ok) {
					const data = await res.json();
					if (data.success && Array.isArray(data.logs)) {
						logs = data.logs;
						renderLogs();
					}
				}
			} catch (err) {
				console.warn('Could not fetch latest system logs:', err);
				renderLogs();
			}
		}

		function formatTimeAgo(isoString: string): string {
			if (!isoString) return '';
			const date = new Date(isoString);
			const now = new Date();
			const diffSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);

			if (diffSeconds < 60) return 'Just now';
			const diffMinutes = Math.floor(diffSeconds / 60);
			if (diffMinutes < 60) return `${diffMinutes}m ago`;
			const diffHours = Math.floor(diffMinutes / 60);
			if (diffHours < 24) return `${diffHours}h ago`;
			const diffDays = Math.floor(diffHours / 24);
			if (diffDays < 7) return `${diffDays}d ago`;

			return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
		}

		function renderLogs() {
			const filtered = logs.filter(log => {
				return currentFilter === 'all' || log.type === currentFilter;
			});

			countBadge.textContent = String(filtered.length);
			listContainer.innerHTML = '';

			if (filtered.length === 0) {
				emptyState.classList.remove('hidden');
				listContainer.classList.add('hidden');
				return;
			}

			emptyState.classList.add('hidden');
			listContainer.classList.remove('hidden');

			filtered.forEach(log => {
				const isNonPrimaryLogin = log.type === 'auth' && log.isPrimaryEmail === false;

				// Determine badge & icon colors
				let iconBg = 'bg-primary/10 text-primary border-primary/20';
				let badgeTag = 'LOG';
				let badgeStyle = 'bg-white/10 text-white/70 border-white/20';

				if (log.type === 'auth') {
					if (isNonPrimaryLogin) {
						iconBg = 'bg-[#F9AB00]/15 text-[#F9AB00] border-[#F9AB00]/30 animate-pulse';
						badgeTag = 'Secondary Email Login';
						badgeStyle = 'bg-[#F9AB00]/20 text-[#F9AB00] border-[#F9AB00]/40 font-bold';
					} else {
						iconBg = 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20';
						badgeTag = 'Owner Login';
						badgeStyle = 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20';
					}
				} else if (log.type === 'content') {
					if (log.action.includes('DELETED') || log.action.includes('REMOVE')) {
						iconBg = 'bg-[#EA4335]/10 text-[#EA4335] border-[#EA4335]/20';
						badgeTag = 'Card Removed';
						badgeStyle = 'bg-[#EA4335]/10 text-[#EA4335] border-[#EA4335]/20';
					} else if (log.action.includes('ADDED') || log.action.includes('CREATE')) {
						iconBg = 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20';
						badgeTag = 'Card Added';
						badgeStyle = 'bg-[#0F9D58]/10 text-[#0F9D58] border-[#0F9D58]/20';
					} else {
						iconBg = 'bg-primary/10 text-primary border-primary/20';
						badgeTag = 'Card Updated';
						badgeStyle = 'bg-primary/10 text-primary border-primary/20';
					}
				} else if (log.type === 'admin') {
					iconBg = 'bg-purple-500/10 text-purple-400 border-purple-500/20';
					badgeTag = 'Admin Access';
					badgeStyle = 'bg-purple-500/10 text-purple-400 border-purple-500/20';
				} else if (log.type === 'system') {
					iconBg = 'bg-white/10 text-white/80 border-white/20';
					badgeTag = 'System';
					badgeStyle = 'bg-white/10 text-white/70 border-white/20';
				}

				const card = document.createElement('div');
				card.className = `p-3 rounded-2xl bg-[#211F26] border ${
					isNonPrimaryLogin ? 'border-[#F9AB00]/40 bg-[#25211B]' : 'border-[#2B2930]'
				} hover:border-white/20 transition-all flex items-start justify-between gap-3 group`;

				card.innerHTML = `
					<div class="flex items-start gap-3 min-w-0 flex-1">
						<!-- Event Icon -->
						<div class="w-8 h-8 rounded-xl ${iconBg} border flex items-center justify-center shrink-0 mt-0.5">
							${log.type === 'auth' ? `
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
							` : log.type === 'content' ? `
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
							` : `
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
							`}
						</div>

						<!-- Log Text & Meta -->
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2 mb-0.5">
								<p class="text-xs font-semibold text-white truncate" title="${log.title}">
									${log.title}
								</p>
								<span class="px-2 py-0.2 rounded-md text-[10px] uppercase font-bold tracking-wider border ${badgeStyle}">
									${badgeTag}
								</span>
							</div>

							${log.details ? `
								<p class="text-[11px] text-[#E6E1E5]/70 truncate" title="${log.details}">
									${log.details}
								</p>
							` : ''}

							<div class="flex items-center gap-2 mt-1 text-[10px] text-[#E6E1E5]/40">
								<span class="font-mono ${isNonPrimaryLogin ? 'text-[#F9AB00] font-semibold' : ''}">${log.userEmail || 'system'}</span>
								<span>•</span>
								<span>${formatTimeAgo(log.timestamp)}</span>
							</div>
						</div>
					</div>
				`;

				listContainer.appendChild(card);
			});
		}

		// Filter Tab Switching
		filterButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				filterButtons.forEach(b => {
					b.classList.remove('bg-primary', 'text-white', 'font-bold');
					b.classList.add('text-[#E6E1E5]/60');
				});
				btn.classList.add('bg-primary', 'text-white', 'font-bold');
				btn.classList.remove('text-[#E6E1E5]/60');

				currentFilter = btn.getAttribute('data-filter') || 'all';
				fetchLogs();
			});
		});

		// Refresh button action
		btnRefresh.addEventListener('click', () => {
			fetchLogs();
		});
	});
</script>
