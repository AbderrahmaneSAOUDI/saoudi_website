---
import Icon from '../Icon.astro';
import type { AcceptedAdminEmail } from '../../types';
import { getEnv } from '../../lib/server/env';

interface Props {
	initialEmails?: AcceptedAdminEmail[];
	isPrimaryAdmin?: boolean;
}

const primaryEmail = (getEnv('ADMIN_EMAIL') || '').toLowerCase().trim();
const userEmail = (Astro.locals.adminEmail || '').toLowerCase().trim();
const { initialEmails = [], isPrimaryAdmin = (userEmail === primaryEmail && primaryEmail !== '') } = Astro.props;
---

<div class="p-6 rounded-3xl border border-[#2B2930] bg-[#1D1B20] flex flex-col h-[380px] lg:h-[calc(90vh-420px)] min-h-[360px] shadow-lg relative overflow-hidden">
	<!-- Card Header -->
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#2B2930]/80 pb-4 shrink-0">
		<div class="flex items-center gap-3">
			<div class="p-2.5 rounded-2xl bg-primary/10 text-primary border border-primary/20 group/shield cursor-pointer">
				<Icon name="shield_protected" size={24} class="w-6 h-6 group-hover/shield:!hidden" />
				<Icon name="shield_protected_filled" size={24} class="w-6 h-6 !hidden group-hover/shield:!inline-flex" />
			</div>
			<div>
				<div class="flex items-center gap-2">
					<h2 class="text-lg font-bold text-white tracking-tight">Admin Emails</h2>
					<span id="email-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-primary/15 text-primary border border-primary/30">
						{initialEmails.length}
					</span>
				</div>
			</div>
		</div>

		{isPrimaryAdmin && (
			<button
				type="button"
				id="btn-toggle-add-email"
				class="px-3.5 py-2 rounded-xl bg-primary hover:bg-primary/90 text-white font-semibold text-xs transition-all duration-300 flex items-center justify-center gap-1.5 cursor-pointer shadow-md shrink-0"
			>
				<Icon name="plus" size={16} class="w-4 h-4" />
				<span>Add Email</span>
			</button>
		)}
	</div>

	<!-- Add Email Inline Drawer / Form -->
	<div id="add-email-form-container" class="hidden mt-4 p-4 rounded-2xl bg-[#211F26] border border-[#2B2930] transition-all duration-300 space-y-3 shrink-0">
		<div class="flex items-center justify-between">
			<h3 class="text-xs font-bold text-white uppercase tracking-wider">Grant Admin Access</h3>
			<button type="button" id="btn-close-add-email" class="group p-1 rounded-lg text-[#E6E1E5]/50 hover:text-white hover:bg-white/5 transition-all cursor-pointer" title="Close">
				<Icon name="close" size={16} class="w-4 h-4 group-hover:!hidden" />
				<Icon name="close_filled" size={16} class="w-4 h-4 !hidden group-hover:!inline-flex" />
			</button>
		</div>
		<form id="add-email-form" class="space-y-3">
			<div>
				<label class="block text-[11px] font-medium text-[#E6E1E5]/70 mb-1">Email Address *</label>
				<input
					type="email"
					id="new-admin-email"
					required
					placeholder="user@example.com"
					class="w-full px-3 py-2 rounded-xl border border-[#2B2930] bg-[#141218] text-white text-xs focus:outline-none focus:border-primary transition-colors"
				/>
			</div>
			<div class="flex justify-end gap-2 pt-1">
				<button
					type="button"
					id="btn-cancel-email"
					class="px-3 py-1.5 rounded-xl border border-[#2B2930] hover:bg-[#2B2930] text-[#E6E1E5]/70 text-xs transition-colors cursor-pointer"
				>
					Cancel
				</button>
				<button
					type="submit"
					id="btn-submit-email"
					class="px-4 py-1.5 rounded-xl bg-[#0F9D58] hover:bg-[#0F9D58]/90 text-white font-semibold text-xs transition-colors flex items-center gap-1 cursor-pointer shadow"
				>
					<Icon name="check" size={14} class="w-3.5 h-3.5" />
					<span>Grant Access</span>
				</button>
			</div>
		</form>
	</div>

	<!-- List of Accepted Emails (Fills remaining height, top-to-bottom, scrollable with hidden scrollbar) -->
	<div class="flex-1 min-h-0 pt-4 overflow-hidden flex flex-col">
		<div id="accepted-emails-list" class="space-y-2.5 overflow-y-auto flex-1 scrollbar-hide pr-1">
			<!-- Rendered via JS and initialized via server props -->
		</div>

		<!-- Empty State -->
		<div id="emails-empty-state" class="hidden my-auto py-8 text-center text-[#E6E1E5]/40 bg-[#211F26]/50 rounded-2xl border border-dashed border-[#2B2930]">
			<p class="text-xs font-semibold text-white">No accepted emails found</p>
			<p class="text-[11px] mt-0.5">Click "Add Email" above to authorize new admin accounts.</p>
		</div>
	</div>
</div>

<script is:inline define:vars={{ initialEmailsData: initialEmails, isPrimaryAdminUser: isPrimaryAdmin }}>
	Object.assign(window, { 
		initialAcceptedEmails: initialEmailsData || [],
		isPrimaryAdminUser: Boolean(isPrimaryAdminUser)
	});
</script>

<script>
	import { escapeAttribute, escapeHtml } from '../../lib/client-safety';

	document.addEventListener('DOMContentLoaded', () => {
		const listContainer = document.getElementById('accepted-emails-list') as HTMLDivElement;
		const emptyState = document.getElementById('emails-empty-state') as HTMLDivElement;
		const countBadge = document.getElementById('email-count-badge') as HTMLSpanElement;

		const btnToggleAdd = document.getElementById('btn-toggle-add-email') as HTMLButtonElement;
		const formContainer = document.getElementById('add-email-form-container') as HTMLDivElement;
		const btnCloseAdd = document.getElementById('btn-close-add-email') as HTMLButtonElement;
		const btnCancel = document.getElementById('btn-cancel-email') as HTMLButtonElement;
		const addEmailForm = document.getElementById('add-email-form') as HTMLFormElement;
		const emailInput = document.getElementById('new-admin-email') as HTMLInputElement;

		let emailsList: any[] = (window as any).initialAcceptedEmails || [];

		// Render SSR-provided data immediately; explicit actions refresh from API.
		renderEmails();

		async function fetchEmails() {
			try {
				const res = await fetch('/admin/admin_emails_api');
				if (res.ok) {
					const data = await res.json();
					if (data.success && Array.isArray(data.emails)) {
						emailsList = data.emails;
						renderEmails();
					}
				}
			} catch (err) {
				console.warn('Could not fetch latest accepted admin emails:', err);
				renderEmails();
			}
		}

		function showStatus(msg: string, type: 'success' | 'error') {
			if (typeof (window as any).showToast === 'function') {
				(window as any).showToast(msg, type);
			}
		}

		function renderEmails() {
			countBadge.textContent = String(emailsList.length);
			listContainer.innerHTML = '';

			if (emailsList.length === 0) {
				emptyState.classList.remove('hidden');
				listContainer.classList.add('hidden');
				return;
			}

			emptyState.classList.add('hidden');
			listContainer.classList.remove('hidden');

			function obfuscateEmail(email: string): string {
				if (!email || typeof email !== 'string' || !email.includes('@')) return email;
				const parts = email.split('@');
				const local = parts[0];
				const domain = parts.slice(1).join('@');
				if (local.length <= 2) {
					return `${local[0]}***@${domain}`;
				}
				return `${local[0]}***${local[local.length - 1]}@${domain}`;
			}

			emailsList.forEach(item => {
				const isPrimary = item.isPrimary;
				const isPrimaryUser = (window as any).isPrimaryAdminUser;
				const displayEmail = isPrimaryUser ? item.email : obfuscateEmail(item.email);
				const safeDisplayEmail = escapeHtml(displayEmail);
				const safeDisplayEmailAttribute = escapeAttribute(displayEmail);
				const safeEmailAttribute = escapeAttribute(item.email);

				const card = document.createElement('div');
				card.className = 'p-3 rounded-2xl bg-[#211F26] border border-[#2B2930] hover:border-white/20 transition-all flex items-center justify-between gap-3 group';

				card.innerHTML = `
					<div class="flex items-center gap-3 min-w-0">
						<div class="w-8 h-8 rounded-full ${isPrimary ? 'bg-primary/20 text-primary border border-primary/30' : 'bg-[#0F9D58]/20 text-[#0F9D58] border border-[#0F9D58]/30'} flex items-center justify-center font-bold text-xs shrink-0">
							${escapeHtml(displayEmail.substring(0, 2).toUpperCase())}
						</div>
						<div class="min-w-0">
							<div class="flex items-center gap-2">
								<p class="text-xs font-semibold text-white truncate" title="${safeDisplayEmailAttribute}">${safeDisplayEmail}</p>
								${isPrimary ? `
									<span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 shrink-0">
										Owner (Env)
									</span>
								` : `
									<span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 shrink-0">
										Granted
									</span>
								`}
							</div>
						</div>
					</div>

					<div class="flex items-center gap-1 shrink-0">
						<button
							type="button"
							class="btn-copy-email p-1.5 rounded-lg transition-colors ${isPrimaryUser ? 'text-[#E6E1E5]/60 hover:text-white hover:bg-white/10 cursor-pointer' : 'text-[#E6E1E5]/30 cursor-not-allowed'}"
							data-email="${safeDisplayEmailAttribute}"
							title="${isPrimaryUser ? 'Copy Email' : 'Email hidden for security'}"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
						</button>
						${item.isPrimary ? '' : `
							<button
								type="button"
								class="btn-delete-email p-1.5 rounded-lg transition-colors ${isPrimaryUser ? 'text-[#DB4437]/70 hover:text-[#DB4437] hover:bg-[#DB4437]/10 cursor-pointer' : 'text-[#DB4437]/30 opacity-40 cursor-not-allowed'}"
								data-email="${safeEmailAttribute}"
								data-disabled="${!isPrimaryUser}"
								title="${isPrimaryUser ? 'Revoke Admin Access' : 'Only website owner can do this action'}"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
							</button>
						`}
					</div>
				`;

				listContainer.appendChild(card);
			});

			attachCardActions();
		}

		function attachCardActions() {
			listContainer.querySelectorAll('.btn-copy-email').forEach(btn => {
				btn.addEventListener('click', () => {
					const email = btn.getAttribute('data-email');
					if (email) {
						navigator.clipboard.writeText(email);
						showStatus(`Copied ${email} to clipboard!`, 'success');
					}
				});
			});

			listContainer.querySelectorAll('.btn-delete-email').forEach(btn => {
				btn.addEventListener('click', async () => {
					if (btn.getAttribute('data-disabled') === 'true' || !(window as any).isPrimaryAdminUser) {
						showStatus('Permission denied. Only the website owner can do this action.', 'error');
						return;
					}

					const email = btn.getAttribute('data-email');
					if (!email) return;

					const confirmed = typeof (window as any).showConfirmDialog === 'function'
						? await (window as any).showConfirmDialog('Revoke Access', `Are you sure you want to revoke admin access for ${email}?`)
						: confirm(`Are you sure you want to revoke admin access for ${email}?`);

					if (confirmed) {
						try {
							const formData = new FormData();
							formData.append('action', 'delete');
							formData.append('email', email);

							const res = await fetch('/admin/admin_emails_api', {
								method: 'POST',
								body: formData,
							});
							const data = await res.json();
							if (res.ok && data.success) {
								emailsList = emailsList.filter(item => item.email.toLowerCase() !== email.toLowerCase());
								renderEmails();
								showStatus(`Revoked access for ${email}`, 'success');
								window.dispatchEvent(new CustomEvent('admin-emails-updated'));
							} else {
								showStatus(data.error || 'Failed to revoke access.', 'error');
							}
						} catch (err) {
							showStatus('Server error revoking email access.', 'error');
						}
					}
				});
			});
		}

		if (btnToggleAdd) {
			btnToggleAdd.addEventListener('click', () => {
				if (!(window as any).isPrimaryAdminUser) {
					showStatus('Permission denied. Only the website owner can do this action.', 'error');
					return;
				}
				formContainer.classList.toggle('hidden');
				if (!formContainer.classList.contains('hidden')) {
					emailInput.focus();
				}
			});
		}

		btnCloseAdd.addEventListener('click', () => {
			formContainer.classList.add('hidden');
		});

		btnCancel.addEventListener('click', () => {
			formContainer.classList.add('hidden');
		});

		addEmailForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = emailInput.value.trim();

			if (!email) return;

			try {
				const formData = new FormData();
				formData.append('action', 'add');
				formData.append('email', email);

				const res = await fetch('/admin/admin_emails_api', {
					method: 'POST',
					body: formData,
				});

				const data = await res.json();
				if (res.ok && data.success) {
					showStatus(`Granted admin access to ${email}`, 'success');
					emailInput.value = '';
					formContainer.classList.add('hidden');
					window.dispatchEvent(new CustomEvent('admin-emails-updated'));
					await fetchEmails();
				} else {
					showStatus(data.error || 'Failed to grant admin access.', 'error');
				}
			} catch (err) {
				showStatus('Error communicating with server.', 'error');
			}
		});
	});
</script>
