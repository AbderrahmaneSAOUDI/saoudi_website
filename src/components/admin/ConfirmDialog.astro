---
/**
 * ConfirmDialog.astro — Custom M3 Dark Mode Confirmation Modal
 * 
 * Replaces default browser confirm() with an animated Material 3 dark-mode dialog.
 * Exposes window.showConfirmDialog(title, message) returning a Promise<boolean>.
 */
---
<div
	id="custom-confirm-dialog-backdrop"
	class="fixed inset-0 bg-black/75 backdrop-blur-sm z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
>
	<div
		id="custom-confirm-dialog-card"
		class="bg-[#1E1E1E] border border-white/10 rounded-3xl p-6 max-w-sm w-full space-y-4 shadow-2xl transform scale-95 translate-y-4 transition-all duration-300"
	>
		<div class="flex items-start gap-3">
			<div class="w-10 h-10 rounded-2xl bg-[#EA4335]/15 border border-[#EA4335]/30 text-[#EA4335] flex items-center justify-center shrink-0 mt-0.5">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
					<line x1="12" y1="9" x2="12" y2="13"/>
					<line x1="12" y1="17" x2="12.01" y2="17"/>
				</svg>
			</div>
			<div class="min-w-0 flex-1">
				<h3 id="confirm-dialog-title" class="text-base font-bold text-white tracking-tight leading-snug">Confirm Action</h3>
				<p id="confirm-dialog-message" class="text-xs text-[#E6E1E5]/70 mt-1 leading-relaxed">Are you sure you want to proceed?</p>
			</div>
		</div>

		<div class="flex items-center justify-end gap-2 pt-3 border-t border-white/5">
			<button
				id="confirm-dialog-btn-cancel"
				type="button"
				class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-[#E6E1E5]/80 hover:text-white transition cursor-pointer"
			>
				Cancel
			</button>
			<button
				id="confirm-dialog-btn-confirm"
				type="button"
				class="px-4 py-2 rounded-xl bg-[#EA4335] hover:bg-[#EA4335]/90 text-xs font-semibold text-white transition cursor-pointer shadow-lg shadow-[#EA4335]/20"
			>
				Confirm
			</button>
		</div>
	</div>
</div>

<script>
	let currentResolver: ((value: boolean) => void) | null = null;

	const backdrop = document.getElementById('custom-confirm-dialog-backdrop') as HTMLDivElement;
	const card = document.getElementById('custom-confirm-dialog-card') as HTMLDivElement;
	const titleEl = document.getElementById('confirm-dialog-title') as HTMLHeadingElement;
	const messageEl = document.getElementById('confirm-dialog-message') as HTMLParagraphElement;
	const btnCancel = document.getElementById('confirm-dialog-btn-cancel') as HTMLButtonElement;
	const btnConfirm = document.getElementById('confirm-dialog-btn-confirm') as HTMLButtonElement;

	function closeDialog(result: boolean) {
		if (!backdrop || !card) return;
		card.classList.add('scale-95', 'translate-y-4');
		card.classList.remove('scale-100', 'translate-y-0');
		backdrop.classList.add('opacity-0', 'pointer-events-none');
		backdrop.classList.remove('opacity-100', 'pointer-events-auto');

		if (currentResolver) {
			currentResolver(result);
			currentResolver = null;
		}
	}

	function showConfirmDialog(title: string, message: string): Promise<boolean> {
		return new Promise((resolve) => {
			if (currentResolver) currentResolver(false);
			currentResolver = resolve;

			if (titleEl) titleEl.textContent = title || 'Confirm Action';
			if (messageEl) messageEl.textContent = message || 'Are you sure you want to proceed?';

			if (backdrop && card) {
				backdrop.classList.remove('opacity-0', 'pointer-events-none');
				backdrop.classList.add('opacity-100', 'pointer-events-auto');
				card.classList.remove('scale-95', 'translate-y-4');
				card.classList.add('scale-100', 'translate-y-0');
			}
		});
	}

	if (btnCancel) {
		btnCancel.addEventListener('click', () => closeDialog(false));
	}

	if (btnConfirm) {
		btnConfirm.addEventListener('click', () => closeDialog(true));
	}

	if (backdrop) {
		backdrop.addEventListener('click', (e) => {
			if (e.target === backdrop) closeDialog(false);
		});
	}

	// Attach to global window object
	(window as any).showConfirmDialog = showConfirmDialog;
</script>
