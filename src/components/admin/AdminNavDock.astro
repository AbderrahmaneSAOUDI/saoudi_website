---
import Icon from '../Icon.astro';

interface Props {
	currentPath?: string;
}

const { currentPath = '/admin' } = Astro.props;

const navItems = [
	{ label: 'Overview', path: '/admin', iconName: 'home', shortcutKey: '1' },
	{ label: 'Experience', path: '/admin/admin_experience', iconName: 'experience', shortcutKey: '2' },
	{ label: 'Projects', path: '/admin/admin_projects', iconName: 'projects', shortcutKey: '3' },
	{ label: 'Designs', path: '/admin/admin_designs', iconName: 'design', shortcutKey: '4' },
	{ label: 'Certifications', path: '/admin/admin_certifications', iconName: 'certifications', shortcutKey: '5' },
	{ label: 'Services', path: '/admin/admin_services', iconName: 'service', shortcutKey: '6' },
	{ label: 'Volunteering', path: '/admin/admin_volunteering', iconName: 'business', disabled: true, shortcutKey: '7' },
	{ label: 'Resume', path: '/admin/admin_resume', iconName: 'document', shortcutKey: '8' },
	{ label: 'Timeline', path: '/admin/admin_timeline', iconName: 'calendar', disabled: true, shortcutKey: '9' },
];
---

<div
	id="admin-nav-dock"
	class="admin-dock-wrapper bottom-0 left-1/2 z-50 fixed -translate-x-1/2 w-full px-0"
>
	<!-- Floating Navigation Dock -->
	<div
		class="admin-dock-inner flex items-center gap-2 bg-[#211F26]/90 backdrop-blur-xl px-3 py-2 border border-white/10 rounded-t-2xl justify-center overflow-hidden"
	>
		<!-- Center Slot: Navigation Links -->
		<nav class="flex items-center gap-0.5 overflow-x-auto overflow-y-hidden scrollbar-hide py-1.5 px-1 max-w-full">
			{
				navItems.map((item) => {
					const isActive =
						item.path === '/admin'
							? currentPath === '/admin' || currentPath === '/admin/'
							: currentPath === item.path;

					return (
						<a
							href={item.disabled ? '#' : item.path}
							data-disabled={item.disabled ? 'true' : undefined}
							data-label={item.label}
							class={`admin-nav-item group flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-sm font-medium origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-95 shrink-0 ${
								item.disabled
									? 'text-white/30 cursor-not-allowed'
									: isActive
									? 'bg-primary text-white scale-[1.02]'
									: 'text-white/70 hover:text-white hover:bg-white/15 hover:scale-[1.04] border border-transparent hover:border-white/20'
							}`}
							aria-label={item.label}
						>
							<span class="admin-nav-icon transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110">
								<Icon name={item.iconName} size={16} class="w-4 h-4" />
							</span>
							<span class="admin-nav-label">{item.label}</span>
							{item.shortcutKey && (
								<kbd class={`hidden md:inline-flex items-center justify-center px-1.5 py-0.2 text-[9px] font-mono rounded border ${isActive ? 'bg-white/20 text-white border-white/30' : item.disabled ? 'bg-white/5 text-white/20 border-white/5' : 'bg-white/10 text-white/40 border-white/10'}`}>
									{item.shortcutKey}
								</kbd>
							)}
						</a>
					);
				})
			}
		</nav>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Attach click listener for disabled nav dock items
		document.querySelectorAll('.admin-nav-item[data-disabled="true"]').forEach((link) => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const label = link.getAttribute('data-label') || 'This section';
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast(`${label} page is still not ready yet.`, 'info');
				}
			});
		});
	});

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		const activeEl = document.activeElement as HTMLElement | null;
		const isEditingText = activeEl && (
			['INPUT', 'TEXTAREA', 'SELECT'].includes(activeEl.tagName) ||
			activeEl.isContentEditable
		);

		if (isEditingText) return;

		// Number shortcuts to switch workspace or show notification
		const workspaceRoutes: Record<string, { path: string; label: string; disabled?: boolean }> = {
			'1': { path: '/admin', label: 'Overview' },
			'2': { path: '/admin/admin_experience', label: 'Experience' },
			'3': { path: '/admin/admin_projects', label: 'Projects' },
			'4': { path: '/admin/admin_designs', label: 'Designs' },
			'5': { path: '/admin/admin_certifications', label: 'Certifications' },
			'6': { path: '/admin/admin_services', label: 'Services' },
			'7': { path: '/admin/admin_volunteering', label: 'Volunteering', disabled: true },
			'8': { path: '/admin/admin_resume', label: 'Resume' },
			'9': { path: '/admin/admin_timeline', label: 'Timeline', disabled: true },
		};

		const route = workspaceRoutes[e.key];
		if (route) {
			e.preventDefault();
			if (route.disabled) {
				if (typeof (window as any).showToast === 'function') {
					(window as any).showToast(`${route.label} page is still not ready yet.`, 'info');
				}
			} else {
				const currentPath = window.location.pathname;
				if (currentPath !== route.path && currentPath !== route.path + '/') {
					window.location.href = route.path;
				}
			}
		}
	});
</script>
