---
/**
 * AdminNavDock Component
 * 
 * Floating bottom navigation dock for the protected admin workspace.
 * Mirrors the exact design, geometry, and CSS-only animations of PublicHeader navbar,
 * with overflow-visible hover scaling, flush edge alignment, and keyboard shortcuts (1-7).
 */
import Icon from '../Icon.astro';

interface Props {
	currentPath?: string;
}

const { currentPath = '/admin' } = Astro.props;

// Normalize path for active route resolution
const rawPathname = currentPath.toLowerCase();
const pathname = rawPathname === '/' ? '/' : rawPathname.replace(/\/+$/, '');

const navItems = [
	{ label: 'Overview', path: '/admin', iconName: 'home', shortcutKey: '1' },
	{ label: 'Experience', path: '/admin/admin_experience', iconName: 'experience', shortcutKey: '2' },
	{ label: 'Projects', path: '/admin/admin_projects', iconName: 'projects', shortcutKey: '3' },
	{ label: 'Designs', path: '/admin/admin_designs', iconName: 'design', shortcutKey: '4' },
	{ label: 'Certifications', path: '/admin/admin_certifications', iconName: 'certifications', shortcutKey: '5' },
	{ label: 'Services', path: '/admin/admin_services', iconName: 'service', shortcutKey: '6' },
	{ label: 'Resume', path: '/admin/admin_resume', iconName: 'document', shortcutKey: '7' },
];
---

<div
	id="admin-nav-dock"
	class="admin-dock-wrapper fixed bottom-4 md:bottom-6 left-1/2 z-50 -translate-x-1/2 max-w-[calc(100vw-1.5rem)] flex justify-center pointer-events-none"
>
	<!-- Floating Pill Navigation Dock matching PublicHeader design -->
	<nav
		aria-label="Admin workspace navigation"
		class="admin-dock-inner pointer-events-auto flex items-center gap-1.5 sm:gap-2 h-11 bg-surface/60 backdrop-blur-xl border border-white/10 hover:border-white/20 rounded-full p-0 transition-all duration-300 max-w-full overflow-visible select-none"
	>
		{
			navItems.map((item) => {
				const isActive =
					item.path === '/admin'
						? pathname === '/admin' || pathname === '/admin/'
						: pathname === item.path || pathname.startsWith(item.path + '/');

				return (
					<a
						href={item.path}
						data-label={item.label}
						class={`admin-nav-item group h-11 min-h-[44px] min-w-[44px] flex items-center justify-center gap-2 px-2.5 min-[920px]:px-4 rounded-full font-medium text-sm whitespace-nowrap origin-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary shrink-0 first:ml-0 last:mr-0 ${
							isActive
								? 'bg-primary text-white scale-[1.02]'
								: 'text-white/70 hover:text-white hover:bg-white/15 hover:scale-[1.06] border border-transparent hover:border-white/20'
						}`}
						aria-label={item.label}
						aria-current={isActive ? 'page' : undefined}
					>
						<span class="admin-nav-icon transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 shrink-0">
							<Icon name={item.iconName} filled={isActive} size={18} />
						</span>
						<span class="admin-nav-label">{item.label}</span>
						{item.shortcutKey && (
							<kbd class={`hidden md:inline-flex items-center justify-center px-1.5 py-0.5 text-[9px] font-mono font-semibold rounded border transition-all duration-300 ${
								isActive
									? 'bg-white/20 text-white border-white/30'
									: 'bg-white/10 text-white/50 border-white/10 group-hover:border-white/20 group-hover:text-white/80'
							}`}>
								{item.shortcutKey}
							</kbd>
						)}
					</a>
				);
			})
		}
	</nav>
</div>

<script>
	document.addEventListener('keydown', (e: KeyboardEvent) => {
		const activeEl = document.activeElement as HTMLElement | null;
		const isEditingText = activeEl && (
			['INPUT', 'TEXTAREA', 'SELECT'].includes(activeEl.tagName) ||
			activeEl.isContentEditable
		);

		if (isEditingText) return;

		// Number shortcuts to switch workspace
		const workspaceRoutes: Record<string, { path: string; label: string }> = {
			'1': { path: '/admin', label: 'Overview' },
			'2': { path: '/admin/admin_experience', label: 'Experience' },
			'3': { path: '/admin/admin_projects', label: 'Projects' },
			'4': { path: '/admin/admin_designs', label: 'Designs' },
			'5': { path: '/admin/admin_certifications', label: 'Certifications' },
			'6': { path: '/admin/admin_services', label: 'Services' },
			'7': { path: '/admin/admin_resume', label: 'Resume' },
		};

		const route = workspaceRoutes[e.key];
		if (route) {
			e.preventDefault();
			const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
			if (currentPath !== route.path) {
				window.location.href = route.path;
			}
		}
	});
</script>
