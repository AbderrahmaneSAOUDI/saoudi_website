---
import IconComponent from './Icon.astro';
import AcceptedAdminEmailsCard from './admin/AcceptedAdminEmailsCard.astro';
import AdminLogsCard from './admin/AdminLogsCard.astro';
import AdminTodoCard from './admin/AdminTodoCard.astro';
import type { AcceptedAdminEmail, AdminTodo, SystemLog } from '../types';

/**
 * AdminDashboard Component
 * Displays a summary of system status, collection counts, accepted emails, website activity logs, and todo brainstorming tasks for the admin workspace.
 */
interface DashboardMetrics {
  counts: {
    projects: number;
    experience: number;
    designs: number;
    certificates: number;
    volunteering: number;
    resumeDownloads?: number;
  };
  systemStatus: string;
}

interface Props {
  metrics: DashboardMetrics;
  initialAcceptedEmails?: AcceptedAdminEmail[];
  initialTodos?: AdminTodo[];
  initialLogs?: SystemLog[];
  isPrimaryAdmin?: boolean;
}

const { metrics, initialAcceptedEmails = [], initialTodos = [], initialLogs = [], isPrimaryAdmin = true } = Astro.props;
const { counts, systemStatus } = metrics;
---

<div class="text-[#E6E1E5] flex flex-col justify-between space-y-8">
  <div>

    <!-- System Status Banner -->
    <div class="mb-6 p-4 rounded-2xl bg-[#1D1B20] border border-[#2B2930] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-[#0F9D58]/10 text-[#0F9D58]">
          <IconComponent name="security" size={24} class="w-6 h-6" />
        </div>
        <div>
          <p class="text-sm font-bold text-white">System Security & Infrastructure</p>
          <p class="text-xs text-[#E6E1E5]/50">Middleware protection is active. Secure cookies are enforced.</p>
        </div>
      </div>
      <div class="flex items-center gap-4 text-xs">
        <span class="px-3 py-1 rounded-full bg-[#211F26] border border-[#2B2930] text-[#E6E1E5]/70">
          Environment: <strong class="text-white">Production</strong>
        </span>
        <span class="px-3 py-1 rounded-full bg-[#0F9D58]/10 text-[#0F9D58] border border-[#0F9D58]/20 font-medium">
          Firestore: {systemStatus}
        </span>
      </div>
    </div>

    <!-- Grid Statistics -->
    <section class="mb-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <!-- Projects Card (Active) -->
        <a
          href="/admin/admin_projects"
          class="block p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:ring-2 hover:ring-primary/40 border border-[#2B2930] group cursor-pointer"
          style="background: #1D1B20"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="relative p-2.5 rounded-2xl bg-primary/10 text-primary">
              <IconComponent name="projects" size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
              <IconComponent name="projects" filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
            </div>
            <span class="text-2xl font-black text-white">{counts.projects}</span>
          </div>
          <h3 class="font-bold text-[#E6E1E5]">Projects</h3>
        </a>

        <!-- Experience Card (Disabled) -->
        <button
          type="button"
          class="btn-disabled-admin-card text-left p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:ring-2 hover:ring-[#0F9D58]/40 border border-[#2B2930] group cursor-pointer"
          style="background: #1D1B20"
          data-title="Experience"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="relative p-2.5 rounded-2xl bg-[#0F9D58]/10 text-[#0F9D58]">
              <IconComponent name="experience" size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
              <IconComponent name="experience" filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
            </div>
            <span class="text-2xl font-black text-white">{counts.experience}</span>
          </div>
          <h3 class="font-bold text-[#E6E1E5]">Experience</h3>
        </button>

        <!-- Designs Card (Active) -->
        <a
          href="/admin/admin_designs"
          class="block p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:ring-2 hover:ring-[#F4B400]/40 border border-[#2B2930] group cursor-pointer"
          style="background: #1D1B20"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="relative p-2.5 rounded-2xl bg-[#F4B400]/10 text-[#F4B400]">
              <IconComponent name="design" size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
              <IconComponent name="design" filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
            </div>
            <span class="text-2xl font-black text-white">{counts.designs}</span>
          </div>
          <h3 class="font-bold text-[#E6E1E5]">Designs</h3>
        </a>

        <!-- Certifications Card (Active) -->
        <a
          href="/admin/admin_certifications"
          class="block p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:ring-2 hover:ring-primary/40 border border-[#2B2930] group cursor-pointer"
          style="background: #1D1B20"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="relative p-2.5 rounded-2xl bg-primary/10 text-primary">
              <IconComponent name="certifications" size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
              <IconComponent name="certifications" filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
            </div>
            <span class="text-2xl font-black text-white">{counts.certificates}</span>
          </div>
          <h3 class="font-bold text-[#E6E1E5]">Certifications</h3>
        </a>

        <!-- Volunteering Card (Disabled) -->
        <button
          type="button"
          class="btn-disabled-admin-card text-left p-5 rounded-3xl transition-all duration-300 hover:-translate-y-1.5 hover:ring-2 hover:ring-[#0F9D58]/40 border border-[#2B2930] group cursor-pointer"
          style="background: #1D1B20"
          data-title="Volunteering"
        >
          <div class="flex justify-between items-start mb-4">
            <div class="relative p-2.5 rounded-2xl bg-[#0F9D58]/10 text-[#0F9D58]">
              <IconComponent name="business" size={24} class="w-6 h-6 transition-all duration-200 group-hover:opacity-0 group-hover:scale-90" />
              <IconComponent name="business" filled size={24} class="absolute top-2.5 left-2.5 w-6 h-6 opacity-0 transition-all duration-200 scale-90 group-hover:opacity-100 group-hover:scale-100" />
            </div>
            <span class="text-2xl font-black text-white">{counts.volunteering}</span>
          </div>
          <h3 class="font-bold text-[#E6E1E5]">Volunteering</h3>
        </button>

        <!-- Resume Downloads Card (Live Real-Time Count) -->
        <div
          class="p-5 rounded-3xl transition-all duration-300 border border-[#2B2930] group relative flex flex-col justify-between"
          style="background: #1D1B20"
        >
          <div>
            <div class="flex justify-between items-start mb-3">
              <div class="relative p-2.5 rounded-2xl bg-[#0F9D58]/10 text-[#0F9D58]">
                <IconComponent name="download" size={24} class="w-6 h-6 transition-all duration-200" />
              </div>
              <div class="flex items-center gap-2">
                <span id="resume-downloads-count" class="text-2xl font-black text-white">{counts.resumeDownloads ?? 0}</span>
                <button
                  type="button"
                  id="btn-reset-downloads"
                  class={`p-1.5 rounded-xl transition-all ${isPrimaryAdmin ? 'text-[#E6E1E5]/40 hover:text-white hover:bg-white/10 cursor-pointer' : 'text-[#E6E1E5]/20 opacity-40 cursor-not-allowed'}`}
                  title={isPrimaryAdmin ? 'Reset download counter' : 'Only website owner can do this action'}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </button>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-[#E6E1E5]">Downloads</h3>
              <span id="exclude-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#4285F4]/10 text-[#4285F4] border border-[#4285F4]/20 transition-all">
                Excluded
              </span>
            </div>
          </div>

          <div class="mt-3 pt-2.5 border-t border-[#2B2930] flex items-center justify-between gap-2">
            <span class="text-[11px] font-medium text-[#E6E1E5]/70">Exclude Admin</span>
            
            <button
              type="button"
              id="btn-save-exclude-downloads"
              class="relative flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-xs font-semibold bg-primary/10 text-primary border border-primary/30 hover:bg-primary/20 active:scale-95 transition-all duration-200 cursor-pointer shadow-sm"
              title="Click to save and toggle admin download exclusion"
            >
              <!-- State 1: Save Icon -->
              <svg id="icon-save-exclude" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>

              <!-- State 2: Loading Spinner -->
              <svg id="icon-spinner-exclude" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>

              <!-- State 3: Checked Mark Icon -->
              <svg id="icon-check-exclude" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#34A853] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>

              <span id="btn-text-exclude" class="font-medium">Save</span>
            </button>
          </div>
        </div>
      </div>
    </section>

<script is:inline define:vars={{ isPrimaryAdmin }}>
  window.isPrimaryAdminUser = isPrimaryAdmin;
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.btn-disabled-admin-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title') || 'This section';
        if (typeof (window as any).showToast === 'function') {
          (window as any).showToast(`${title} admin management coming soon!`, 'error');
        }
      });
    });

    // Real-time live polling for dashboard metrics (resume downloads count)
    const downloadCountElem = document.getElementById('resume-downloads-count');
    const btnResetDownloads = document.getElementById('btn-reset-downloads');
    const statusBadge = document.getElementById('exclude-status-badge');
    
    let currentExcludedState = true;

    function updateBadge(excluded: boolean) {
      if (!statusBadge) return;
      if (excluded) {
        statusBadge.textContent = 'Excluded';
        statusBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#4285F4]/10 text-[#4285F4] border border-[#4285F4]/20 transition-all';
      } else {
        statusBadge.textContent = 'Counted';
        statusBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#F4B400]/10 text-[#F4B400] border border-[#F4B400]/20 transition-all';
      }
    }

    async function updateLiveStats() {
      try {
        const res = await fetch(`/admin/admin_stats_api?t=${Date.now()}`);
        if (res.ok) {
          const data = await res.json();
          if (data.success && data.counts) {
            if (downloadCountElem) downloadCountElem.textContent = String(data.counts.resumeDownloads ?? 0);
            if (typeof data.counts.excludeAdminDownloads === 'boolean') {
              currentExcludedState = data.counts.excludeAdminDownloads;
              updateBadge(currentExcludedState);
            }
          }
        }
      } catch (err) {
        // Silent catch for background polling
      }
    }

    // Initial check and 5-second polling interval
    updateLiveStats();
    setInterval(updateLiveStats, 5000);

    // Reset download counter button handler
    if (btnResetDownloads) {
      btnResetDownloads.addEventListener('click', async () => {
        if (!(window as any).isPrimaryAdminUser) {
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Permission denied. Only the website owner can do this action.', 'error');
          }
          return;
        }

        const confirmed = typeof (window as any).showConfirmDialog === 'function'
          ? await (window as any).showConfirmDialog('Reset Download Counter', 'Are you sure you want to reset the resume download counter to 0?')
          : confirm('Are you sure you want to reset the download counter to 0?');

        if (confirmed) {
          try {
            const formData = new FormData();
            formData.append('action', 'reset_downloads');

            const res = await fetch('/admin/admin_stats_api', {
              method: 'POST',
              body: formData,
            });

            const data = await res.json();
            if (res.ok && data.success) {
              if (downloadCountElem) downloadCountElem.textContent = '0';
              if (typeof (window as any).showToast === 'function') {
                (window as any).showToast('Download counter reset to 0!', 'success');
              }
            } else {
              if (typeof (window as any).showToast === 'function') {
                (window as any).showToast(data.error || 'Failed to reset count', 'error');
              }
            }
          } catch (err) {
            console.error('Error resetting downloads count:', err);
          }
        }
      });
    }

    // Save Exclude Downloads button handler (Save icon -> Spinner -> Checkmark icon)
    const btnSaveExclude = document.getElementById('btn-save-exclude-downloads') as HTMLButtonElement | null;
    const iconSave = document.getElementById('icon-save-exclude');
    const iconSpinner = document.getElementById('icon-spinner-exclude');
    const iconCheck = document.getElementById('icon-check-exclude');
    const btnText = document.getElementById('btn-text-exclude');

    if (btnSaveExclude) {
      btnSaveExclude.addEventListener('click', async () => {
        if (btnSaveExclude.disabled) return;

        // 1. Show Loading State (Spinner)
        btnSaveExclude.disabled = true;
        if (iconSave) iconSave.classList.add('hidden');
        if (iconCheck) iconCheck.classList.add('hidden');
        if (iconSpinner) iconSpinner.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Saving...';

        try {
          const nextState = !currentExcludedState;
          const formData = new FormData();
          formData.append('action', 'toggle_exclude_downloads');
          formData.append('exclude', String(nextState));

          const res = await fetch('/admin/admin_stats_api', {
            method: 'POST',
            body: formData,
          });

          const data = await res.json();
          if (res.ok && data.success) {
            currentExcludedState = Boolean(data.excludeAdminDownloads);
            updateBadge(currentExcludedState);

            // 2. Show Success State (Checkmark / Mark Yes Icon)
            if (iconSpinner) iconSpinner.classList.add('hidden');
            if (iconCheck) iconCheck.classList.remove('hidden');
            if (btnText) btnText.textContent = 'Saved!';

            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast(
                currentExcludedState ? 'Admin downloads are now excluded!' : 'Admin downloads will now be counted!',
                'success'
              );
            }

            // 3. Reset back to Save state after 2 seconds
            setTimeout(() => {
              if (iconCheck) iconCheck.classList.add('hidden');
              if (iconSave) iconSave.classList.remove('hidden');
              if (btnText) btnText.textContent = 'Save';
              btnSaveExclude.disabled = false;
            }, 2000);
          } else {
            throw new Error(data.error || 'Failed to save setting');
          }
        } catch (err) {
          console.error('Error saving admin download exclusion setting:', err);
          if (iconSpinner) iconSpinner.classList.add('hidden');
          if (iconSave) iconSave.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Retry';
          btnSaveExclude.disabled = false;
          if (typeof (window as any).showToast === 'function') {
            (window as any).showToast('Failed to save setting', 'error');
          }
        }
      });
    }
  });
</script>

    <!-- Admin Tools & Overview Cards -->
    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
      <AcceptedAdminEmailsCard initialEmails={initialAcceptedEmails} isPrimaryAdmin={isPrimaryAdmin} />
      <AdminLogsCard initialLogs={initialLogs} isPrimaryAdmin={isPrimaryAdmin} />
      <AdminTodoCard initialTodos={initialTodos} isPrimaryAdmin={isPrimaryAdmin} />
    </section>
  </div>
</div>
