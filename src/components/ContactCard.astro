---
/**
 * ContactCard — Reusable Contact & Social Links Card
 *
 * Renders the phone/WhatsApp, obfuscated email, and social links grid.
 * Used on the Home page and Services page.
 */
import Icon from "./Icon.astro";

interface Props {
  title?: string;
  animationDelay?: string;
}

const { title = "Contact", animationDelay = "0.7s" } = Astro.props;

const socialLinks = [
	{ iconName: 'gdg', href: 'https://gdg.community.dev/u/mcmwd6/', label: 'GDG profile', size: 34 },
	{ iconName: 'facebook', href: 'https://www.facebook.com/saoudi26/', label: 'Facebook' },
	{ iconName: 'telegram', href: 'https://t.me/saoudi26/', label: 'Telegram' },
	{ iconName: 'linkedin', href: 'https://www.linkedin.com/in/abderrahmane-saoudi/', label: 'LinkedIn' },
	{ iconName: 'github', href: 'https://github.com/AbderrahmaneSAOUDI/', label: 'Github' },
	{ iconName: 'google', href: 'https://g.dev/saoudi26/', label: 'GDP Profile' },
];
---

<section class="my-6 animate-fade-in" style={`animation-delay: ${animationDelay};`}>
	<div class="relative">
		<div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-tertiary/5 blur-3xl"></div>
		<div class="relative bg-surface-container border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl hover-card-border hover:border-primary/80 transition-all duration-300">
			<h2 class="text-3xl md:text-4xl font-bold text-primary mb-8 flex items-center gap-3">
				{title}
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<a
					href="#"
					onclick="this.setAttribute('href', atob('aHR0cHM6Ly93YS5tZS8yMTM1NjEzNzc3NjE='))"
					target="_blank"
					rel="noopener noreferrer"
					class="bg-surface-container-high border border-white/10 rounded-2xl p-6 flex items-start gap-4 hover-card-border hover:border-primary/60 transition-all duration-300 hover:-translate-y-1 block group cursor-pointer"
				>
					<div class="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center text-primary flex-shrink-0 shadow-lg shadow-primary/10 group-hover:scale-105 transition-transform duration-300">
						<Icon name="phone" size={28} class="group-hover:!hidden" />
						<Icon name="phone" filled size={28} class="!hidden group-hover:!inline-flex" />
					</div>
					<div>
						<h3 class="text-white font-semibold flex items-center gap-2">
							Phone & WhatsApp
						</h3>
						<p class="text-white/70 mt-1">
							<span class="obfuscated">16 77 73 165 312+</span>
						</p>
						<p class="text-white/70">
							<span class="obfuscated">31 65 98 676 312+</span>
						</p>
					</div>
				</a>
				<a
					href="#"
					onclick="this.setAttribute('href','mailto:'+atob('YWJkZXJyYWhtYW5lLnNhb3VkaS4yNkBnbWFpbC5jb20='))"
					class="bg-surface-container-high border border-white/10 rounded-2xl p-6 flex items-start gap-4 hover-card-border hover:border-secondary/60 transition-all duration-300 hover:-translate-y-1 block group cursor-pointer"
				>
					<div class="w-12 h-12 bg-secondary/20 rounded-xl flex items-center justify-center text-secondary flex-shrink-0 shadow-lg shadow-secondary/10 group-hover:scale-105 transition-transform duration-300">
						<Icon name="mail" size={28} class="group-hover:!hidden" />
						<Icon name="mail" filled size={28} class="!hidden group-hover:!inline-flex" />
					</div>
					<div>
						<h3 class="text-white font-semibold flex items-center gap-2">
							Email
						</h3>
						<p class="text-white/70 mt-1">
							<span class="obfuscated">moc.kcud@62iduoas</span>
						</p>
					</div>
				</a>
			</div>

			<!-- Social Media Links Row Grid -->
			<div class="mt-6">
				<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
					{socialLinks.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
							class="bg-surface-container-high border border-white/10 hover-card-border hover:border-primary/70 hover:bg-primary/10 rounded-2xl p-5 md:p-6 flex flex-col items-center justify-center text-center gap-3 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 group cursor-pointer"
						>
							<div class="relative w-9 h-9 flex items-center justify-center text-primary transition-transform duration-300 ease-out group-hover:scale-135">
								<span class="absolute inset-0 flex items-center justify-center transition-all duration-300 ease-out group-hover:opacity-0">
									<Icon name={social.iconName} size={social.size || 28} />
								</span>
								<span class="absolute inset-0 flex items-center justify-center opacity-0 transition-all duration-300 ease-out group-hover:opacity-100">
									<Icon name={social.iconName} filled size={social.size || 28} />
								</span>
							</div>
							<span class="text-white/80 group-hover:text-white text-xs sm:text-sm font-semibold tracking-wide transition-colors duration-300">
								{social.label}
							</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</section>
