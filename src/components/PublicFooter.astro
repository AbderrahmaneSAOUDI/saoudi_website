---
/**
 * PublicFooter Component
 * 
 * Displays the copyright notice and application version.
 * Adheres to strict zero client-side JavaScript guidelines.
 */
import pkg from '../../package.json';
---

<footer class="bg-surface-container mx-4 my-4 py-6 border-white/10 border-t rounded-3xl">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
		<div class="flex flex-col sm:flex-row justify-between items-center gap-4">
			{/* Copyright and signature text with logo */}
			<div class="flex items-center gap-3">
				<img src="/favicon.svg" alt="saoudi.online logo" class="w-6 h-6 object-contain" width="24" height="24" />
				<p class="text-white/50 text-sm text-center sm:text-left">
					2026 - all rights reserved to Abderrahmane SAOUDI
				</p>
			</div>

			{/* Website version */}
			<p class="text-white/40 text-xs font-mono text-center sm:text-right">
				v{pkg.version}
			</p>
		</div>
	</div>
</footer>