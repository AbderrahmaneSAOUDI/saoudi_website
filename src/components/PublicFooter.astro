---
/**
 * PublicFooter Component
 * 
 * Displays the copyright notice and application version.
 * Long press on version opens the admin section.
 */
import pkg from '../../package.json';
---

<footer class="bg-surface-container mx-4 my-4 py-6 border-white/10 border-t rounded-3xl">
	<div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
		<div class="flex flex-col sm:flex-row justify-between items-center gap-4">
			{/* Copyright and signature text with logo */}
			<div class="flex items-center gap-3">
				<img src="/favicon.svg" alt="saoudi.online logo" class="w-6 h-6 object-contain" width="24" height="24" />
				<p class="text-white/50 text-sm text-center sm:text-left">
					2026 - all rights reserved to Abderrahmane SAOUDI
				</p>
			</div>

			{/* Website version */}
			<p class="text-white/40 hover:text-white/70 text-xs font-mono text-center sm:text-right transition-colors duration-200 cursor-pointer select-none py-1 px-2.5 rounded-lg hover:bg-white/5 active:scale-95" id="footer-version">
				v{pkg.version}
			</p>
		</div>
	</div>
</footer>

<script>
	const versionEl = document.getElementById('footer-version');
	if (versionEl) {
		let timer: ReturnType<typeof setTimeout> | null = null;
		let isLongPress = false;
		const LONG_PRESS_DURATION = 600;

		const startPress = (e: PointerEvent) => {
			if (e.button !== 0) return; // Only primary press
			isLongPress = false;
			if (timer) clearTimeout(timer);

			timer = setTimeout(() => {
				isLongPress = true;
				window.location.href = '/admin';
			}, LONG_PRESS_DURATION);
		};

		const cancelPress = () => {
			if (timer) {
				clearTimeout(timer);
				timer = null;
			}
		};

		versionEl.addEventListener('pointerdown', startPress);
		versionEl.addEventListener('pointerup', cancelPress);
		versionEl.addEventListener('pointerleave', cancelPress);
		versionEl.addEventListener('pointercancel', cancelPress);

		versionEl.addEventListener('contextmenu', (e) => {
			if (isLongPress) {
				e.preventDefault();
			}
		});
	}
</script>