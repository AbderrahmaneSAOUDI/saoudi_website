---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
}

const {
	title = 'saoudi.online',
	description = 'Abderrahmane SAOUDI — Software Engineer, Community Leader, and Graphic Designer from Ghardaia, Algeria.',
	canonical,
	image = '/profile.webp',
} = Astro.props;

const pageTitle = title === 'saoudi.online' ? title : `${title} | saoudi.online`;

const siteUrl = Astro.site?.href ?? 'https://www.saoudi.online';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = image.startsWith('http://') || image.startsWith('https://')
	? image
	: new URL(image, siteUrl).href;

const isLocalhost =
	Astro.url.hostname === 'localhost' ||
	Astro.url.hostname === '127.0.0.1' ||
	Astro.url.hostname === '0.0.0.0' ||
	Astro.url.hostname.endsWith('.localhost') ||
	import.meta.env.DEV;

const isAdmin = Astro.url.pathname.startsWith('/admin');

let faviconHref = '/favicon.svg';
if (isAdmin) {
	faviconHref = isLocalhost ? '/favicon-admin-dev.svg' : '/favicon-admin.svg';
} else {
	faviconHref = isLocalhost ? '/favicon-dev.svg' : '/favicon.svg';
}
---

<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="alternate icon" href={faviconHref} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* SEO: Meta description for search engine results */}
    <meta name="description" content={description} />

    {/* SEO: Canonical URL prevents duplicate content */}
    <link rel="canonical" href={canonicalUrl} />

    {/* OpenGraph tags for social sharing */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter/X Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* SECURITY: X-Content-Type-Options prevents MIME sniffing */}
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />


    {/* PERFORMANCE: Preconnect + dns-prefetch to Firebase Storage for faster image loads */}
    <link rel="preconnect" href="https://storage.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://storage.googleapis.com" />

    {/* PERFORMANCE: Preload WOFF2 core fonts */}
    <link rel="preload" href="/fonts/GoogleSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GoogleSans-Bold.woff2" as="font" type="font/woff2" crossorigin />

    {/* ADMIN PREFERENCE: Restore shortcuts visibility state prior to render */}
    <script is:inline>
        (function() {
            try {
                if (localStorage.getItem('admin_shortcuts_hidden') === 'true') {
                    document.documentElement.setAttribute('data-hide-shortcuts', 'true');
                }
            } catch (e) {}
        })();
    </script>

    <title>{pageTitle}</title>
</head>
